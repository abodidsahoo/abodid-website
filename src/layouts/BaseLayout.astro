---
import "../styles/global.css";
import "../styles/brands.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SEO from "../components/SEO.astro";
import NewsletterPopup from "../components/NewsletterPopup.jsx";
import MagneticCursorFollower from "../components/MagneticCursorFollower.jsx";
import RouteLoadingOverlay from "../components/RouteLoadingOverlay.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { ClientRouter } from "astro:transitions";
import { getPageMetadata } from "../lib/api";
import {
  createWebPageStructuredData,
  resolvePageSeo,
} from "../lib/seoMetadata.js";
import { shouldNoindex } from "../lib/searchVisibility.ts";
import {
  ACTIVE_NAVIGATION_LAYOUT,
  ACTIVE_POINTER_VARIANT,
  NAVIGATION_LAYOUTS,
  POINTER_VARIANTS,
} from "../config/siteVariants.js";

const {
  title,
  description,
  image,
  imageAlt,
  type,
  useDynamicOgImage = true,
  noindex,
  robots,
  structuredData,
  hideHeader = false,
  hideSideMenuRail = false,
  hideFooter = false,
  showFooterNavigation = true,
  hideWhatsAppButton = false,
  fullWidth = false,
  hideThemeToggle = false,
  altTextLogo = null,
  showNewsletterPopup = true,
  showGlobalGrid = true,
  bodyClass = "",
  showCursor,
  showCursorFollower,
  navigationLayout = ACTIVE_NAVIGATION_LAYOUT,
  pointerVariant = ACTIVE_POINTER_VARIANT,
  gridVariant = "default",
  initialBackgroundColor = null,
  moodboardSurface = null,
  analyticsProjectId = null,
  navigationVariant = "legacy",
} = Astro.props;
const useNextNavigation = navigationVariant === "next";
const activeNavigationLayout =
  navigationLayout === NAVIGATION_LAYOUTS.leftRail.id
    ? NAVIGATION_LAYOUTS.leftRail.id
    : NAVIGATION_LAYOUTS.topBar.id;
const activePointerVariant =
  pointerVariant === POINTER_VARIANTS.customMagneticFollower.id
    ? POINTER_VARIANTS.customMagneticFollower.id
    : POINTER_VARIANTS.nativeDefault.id;
const legacyCursorRequested = showCursor === true || showCursorFollower === true;
const cursorFollowerEnabled =
  activePointerVariant === POINTER_VARIANTS.customMagneticFollower.id ||
  legacyCursorRequested;
const renderedPointerVariant = cursorFollowerEnabled
  ? POINTER_VARIANTS.customMagneticFollower.id
  : POINTER_VARIANTS.nativeDefault.id;
// Resolve one authoritative SEO object. A published admin override wins,
// followed by the page's own defaults.
const pagePath = Astro.url.pathname;
const dbMetadata = await getPageMetadata(pagePath);
const resolvedSeo = resolvePageSeo({
  metadata: dbMetadata,
  defaults: { title, description, image, imageAlt, type },
});
const finalOgType = resolvedSeo.type === "article" ? "article" : "website";
const finalNoindex =
  shouldNoindex(pagePath) ||
  noindex === true ||
  resolvedSeo.noindex;
const automaticStructuredData = dbMetadata
  ? createWebPageStructuredData({
      pagePath,
      title: resolvedSeo.title,
      description: resolvedSeo.description,
      focusKeyword: resolvedSeo.focusKeyword,
    })
  : undefined;
const finalStructuredData = structuredData || automaticStructuredData;
const finalUseDynamicOgImage = resolvedSeo.hasCustomSocialImage
  ? false
  : useDynamicOgImage;
const googleFontsUrl =
  "https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,300..700;1,300..700&family=Inconsolata:wght@400;700&family=Montserrat:wght@400;500;600;700&family=Pixelify+Sans:wght@400..700&family=Poppins:wght@300;400;500;600;700;800&family=Space+Mono:wght@400;700&family=VT323&display=swap";
---

<html lang="en">
  <head>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-V07Z22DSVH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-V07Z22DSVH');
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter fallback="swap" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Abodid Blog"
      href="/rss.xml"
    />
    <link
      rel="alternate"
      type="text/markdown"
      title="AI-readable Site Guide"
      href="/llms.txt"
    />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={googleFontsUrl} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={googleFontsUrl} /></noscript>

    <SEO
      title={resolvedSeo.title}
      description={resolvedSeo.description}
      image={resolvedSeo.image}
      imageAlt={resolvedSeo.imageAlt}
      type={finalOgType}
      useDynamicOgImage={finalUseDynamicOgImage}
      noindex={finalNoindex}
      robots={robots}
      structuredData={finalStructuredData}
    />
    <!-- Dynamic SEO & Social Images applied -->
    <slot name="head" />

    {initialBackgroundColor && (
      <style is:inline define:vars={{ initialBackgroundColor }}>
        html, body { background-color: var(--initialBackgroundColor) !important; }
      </style>
    )}

    <!-- Theme Initialization to prevent FOUC -->
    <script is:inline>
      (function () {
        const prefersLight =
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: light)").matches;

        let nextTheme = prefersLight ? "light" : "dark";
        try {
          const savedTheme = localStorage.getItem("theme");
          if (savedTheme === "light" || savedTheme === "dark") {
            nextTheme = savedTheme;
          } else {
            localStorage.setItem("theme", nextTheme);
          }
        } catch (_error) {
          // no-op
        }

        document.documentElement.setAttribute("data-theme", nextTheme);
        document.documentElement.style.colorScheme = nextTheme;
      })();
    </script>
  </head>
  <body
    data-grid-variant={gridVariant}
    data-moodboard-surface={moodboardSurface || undefined}
    data-page-path={pagePath}
    data-navigation-layout={activeNavigationLayout}
    data-pointer-variant={renderedPointerVariant}
    data-analytics-project-id={analyticsProjectId || undefined}
    data-navigation-variant={useNextNavigation ? "next" : "legacy"}
    class={bodyClass}
  >
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <RouteLoadingOverlay />
    {!hideHeader && <SiteHeader />}
    {showGlobalGrid && <div class="global-grid-bg"></div>}
    {showGlobalGrid && <div class="global-glow-bg"></div>}
    <main
      id="main-content"
      class={`${fullWidth ? "page-content-full" : "container page-content"} ${!hideHeader ? "header-padding" : ""}`}
    >
      <slot />
    </main>
    {showNewsletterPopup && <NewsletterPopup client:idle />}
    {cursorFollowerEnabled && <MagneticCursorFollower client:idle />}
    {!finalNoindex && !hideWhatsAppButton && <WhatsAppButton />}

    <script src="/scripts/journey-tracker.js" defer></script>
    {!hideFooter && <SiteFooter showNavigation={showFooterNavigation} />}
  </body>
</html>

<style>
  body {
    /* Background handled by global.css theme variables */
  }

  .page-content {
    /* Padding handled by .header-padding if header visible */
    padding-bottom: 6rem;
    position: relative;
    z-index: 1; /* Ensure content is above grid */
  }

  .page-content-full {
    padding: 0;
    width: 100%;
    max-width: 100%;
    position: relative;
    z-index: 1;
  }

  /* Universal Header Clearance Rule */
  /* Applied if !hideHeader is true */
  .header-padding {
    padding-top: 0 !important; /* Header is now a floating add-on, no padding needed */
  }

  .global-grid-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0; /* Behind content but check base layout stacking */
    pointer-events: none;

    /* Subtle Grid Background */
    background-image:
      linear-gradient(to right, var(--grid-color-2) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-color-2) 1px, transparent 1px);
    background-size: 60px 60px; /* PERFECT SQUARE as requested */
    background-position: center -1px;

    /* Soft fade on edges */
    -webkit-mask-image: radial-gradient(
      ellipse at center,
      black 30%,
      transparent 80%
    );
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
  }

  /* Ensure Footer is above grid */
  :global(.site-footer) {
    position: relative;
    z-index: 10;
    background-color: var(--bg-surface);
  }

  .global-glow-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0; /* Same layer as grid, interactions managed by opacity */
    pointer-events: none;
    opacity: var(--glow-intensity, 1);
    transition: opacity 0.3s ease-out;

    /* Brighter Grid for Glow - Reduced power */
    background-image:
      linear-gradient(to right, var(--grid-color-1) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-color-1) 1px, transparent 1px);
    background-size: 60px 60px; /* PERFECT SQUARE */
    background-position: center -1px;

    /* Reveal only near mouse AND faded at edges (Global Mask) */
    -webkit-mask-image:
      radial-gradient(
        circle var(--glow-radius, 300px) at var(--mouse-x, -500px)
          var(--mouse-y, -500px),
        black,
        transparent
      ),
      radial-gradient(ellipse at center, black 30%, transparent 80%);
    mask-image:
      radial-gradient(
        circle var(--glow-radius, 300px) at var(--mouse-x, -500px)
          var(--mouse-y, -500px),
        black,
        transparent
      ),
      radial-gradient(ellipse at center, black 30%, transparent 80%);

    /* Composite: Intersect them so glow fades at edges */
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  .skip-link {
    position: absolute;
    top: -200px;
    left: 0;
    background: #000;
    color: #fff;
    padding: 8px;
    z-index: 9999;
    transition: top 0.2s;
  }

  .skip-link:focus {
    top: 0;
  }

</style>

<script>
  function initGlobalEffects() {
    const glowBg = document.querySelector(".global-glow-bg") as HTMLElement;
    if (!glowBg) return;
    const gridVariant = document.body?.dataset?.gridVariant || "default";
    const isLandingPage = document.body?.classList.contains("landing-page");

    // Mouse Tracking
    window.addEventListener(
      "mousemove",
      (e) => {
        glowBg.style.setProperty("--mouse-x", `${e.clientX}px`);
        glowBg.style.setProperty("--mouse-y", `${e.clientY}px`);
      },
      { passive: true },
    );

    // Scroll Intensity Tracking
    const updateIntensity = () => {
      // Universal Glow - Apply logic to all pages
      // Check if we are on the homepage for specific intensity tuning if needed,
      // but user requested "universal pointer for all pages".

      const isHome =
        window.location.pathname === "/" ||
        window.location.pathname === "" ||
        window.location.pathname === "/test-landing";

      // If NOT home, maybe we want it slightly less intense?
      // User said "universal pointer", "affect things in this testimonial page".
      // Let's keep it consistent but maybe respect the scroll fade only on Home if it has the typewriter?
      // Or just let it be persistent.

      // Let's try enabling it fully first.
      // We'll use the scroll logic only for Home (fade out) but keep it active on others.
      if (isLandingPage) {
        glowBg.style.setProperty("--glow-intensity", "1");
        return;
      }

      if (!isHome) {
        const variantIntensity = gridVariant === "moodboard" ? "1" : "0.8";
        glowBg.style.setProperty("--glow-intensity", variantIntensity);
        return; // EXIT HERE so scroll logic doesn't override it
      }

      // Homepage Logic: Targeted for typewriter area (top)
      // ...

      // Homepage Logic: Targeted for typewriter area (top)
      const scrollY = window.scrollY;
      const windowHeight = window.innerHeight;

      // Faster fade out to ensure it's mainly for the top area
      const fadeDistance = windowHeight * 1.0;
      const minIntensity = 0.05; // "Hardly visible"

      let intensity = 1 - scrollY / fadeDistance;
      if (intensity < minIntensity) intensity = minIntensity;

      glowBg.style.setProperty("--glow-intensity", intensity.toString());
    };

    window.addEventListener("scroll", updateIntensity, { passive: true });
    updateIntensity(); // Initial call
  }

  // Init
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGlobalEffects);
  } else {
    initGlobalEffects();
  }

</script>

<script>
  import {
    hasOwnerExclusionRequest,
    shouldLoadGoogleAnalytics,
  } from "../lib/analytics/google-tag-policy.js";

  const measurementId = "G-V07Z22DSVH";

  const excludeThisDevice = () => {
    const isAbodidHost = /(^|\.)abodid\.com$/i.test(window.location.hostname);
    const domain = isAbodidHost ? "; Domain=.abodid.com" : "";
    const secure = window.location.protocol === "https:" ? "; Secure" : "";
    document.cookie = `abodid_analytics_exclude=1; Path=/; Max-Age=31536000; SameSite=Lax${secure}${domain}`;
    try {
      window.localStorage.setItem("abodid_analytics_exclude", "1");
    } catch (_error) {
      // Cookie exclusion remains available when storage is blocked.
    }
    (window as any)[`ga-disable-${measurementId}`] = true;
  };

  if (hasOwnerExclusionRequest(window.location.search)) excludeThisDevice();

  const analyticsAllowedForCurrentPage = () => {
    let storageExcluded = false;
    try {
      storageExcluded = window.localStorage.getItem("abodid_analytics_exclude") === "1";
    } catch (_error) {
      // Use the cookie-only result.
    }

    return shouldLoadGoogleAnalytics({
      hostname: window.location.hostname,
      pathname: window.location.pathname,
      cookie: document.cookie,
      storageExcluded,
    });
  };

  const shouldLoad = analyticsAllowedForCurrentPage();

  (window as any).__abodidAnalyticsPrivacy = {
    excluded: !shouldLoad,
    excludeThisDevice,
  };

  if (shouldLoad) {
    (window as any).dataLayer = (window as any).dataLayer || [];
    // Keep Google's exact command-queue shape. The previous rest-argument
    // array was not the official gtag bootstrap and could fail silently.
    (window as any).gtag = (window as any).gtag || function gtag() {
      (window as any).dataLayer.push(arguments);
    };
    (window as any).gtag("js", new Date());
    (window as any).gtag("config", measurementId, { send_page_view: true });

    if (!document.querySelector(`script[data-abodid-ga4="${measurementId}"]`)) {
      const script = document.createElement("script");
      script.async = true;
      script.dataset.abodidGa4 = measurementId;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
      document.head.appendChild(script);
    }

    // Astro client-side navigation does not reload the Google tag. Send one
    // page view whenever the public URL actually changes.
    let lastTrackedLocation = window.location.href;
    document.addEventListener("astro:page-load", () => {
      const nextLocation = window.location.href;
      if (nextLocation === lastTrackedLocation || !analyticsAllowedForCurrentPage()) return;
      lastTrackedLocation = nextLocation;
      (window as any).gtag("event", "page_view", {
        page_location: nextLocation,
        page_path: `${window.location.pathname}${window.location.search}`,
        page_title: document.title,
      });
    });
  }
</script>

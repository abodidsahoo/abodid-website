---
interface Props {
  src: string;
  label: string;
  width?: number;
  height?: number;
  allowSmudge?: boolean;
}

const {
  src,
  label,
  width = 1600,
  height = 900,
  allowSmudge = false,
} = Astro.props;
// Native lazy loading for media is newer than Astro's current HTML typings.
// The IntersectionObserver below remains the cross-browser bandwidth fallback.
const lazyMediaAttributes = { loading: "lazy" } as any;
---

<video
  {...lazyMediaAttributes}
  data-lazy-autoplay-video
  data-src={src}
  data-smudge-video={allowSmudge ? "" : undefined}
  preload="none"
  muted
  loop
  playsinline
  width={width}
  height={height}
  aria-label={label}
></video>
<noscript>
  <video
    src={src}
    preload="metadata"
    muted
    loop
    playsinline
    controls
    width={width}
    height={height}
    aria-label={label}
  ></video>
</noscript>

<script>
  import { canUseSmudgeMedia, smudgeMediaUrl, smudgeMotionQuery } from "../lib/landing-smudge/media";

  let lazyVideoObserver: IntersectionObserver | null = null;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const loadVideo = (video: HTMLVideoElement) => {
    const play = () => {
      if (!reducedMotion.matches) void video.play().catch(() => {});
    };

    if (!video.src && video.dataset.src) {
      const source = video.dataset.src;
      delete video.dataset.src;
      if (video.hasAttribute("data-smudge-video") && matchMedia(smudgeMotionQuery).matches &&
          canUseSmudgeMedia(source)) {
        const textureUrl = smudgeMediaUrl(source);
        if (new URL(textureUrl, location.href).origin !== location.origin) {
          video.crossOrigin = "anonymous";
        }
        if (video.crossOrigin || textureUrl !== source) {
          video.addEventListener("error", () => {
            video.removeAttribute("crossorigin");
            video.src = source;
            video.addEventListener("canplay", play, { once: true });
            video.load();
          }, { once: true });
        }
        video.src = textureUrl;
      } else {
        video.src = source;
      }
      video.preload = "metadata";
      video.load();
    }

    if (reducedMotion.matches) {
      video.pause();
      return;
    }

    if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
      play();
    } else {
      video.addEventListener("canplay", play, { once: true });
    }
  };

  const initialiseLazyVideos = () => {
    lazyVideoObserver?.disconnect();

    const videos = Array.from(
      document.querySelectorAll<HTMLVideoElement>("video[data-lazy-autoplay-video]"),
    );
    if (videos.length === 0) return;

    if (!("IntersectionObserver" in window)) {
      videos.forEach(loadVideo);
      return;
    }

    lazyVideoObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            loadVideo(video);
          } else if (!video.paused) {
            video.pause();
          }
        });
      },
      { rootMargin: "100px 0px", threshold: 0.01 },
    );

    videos.forEach((video) => lazyVideoObserver?.observe(video));
  };

  reducedMotion.addEventListener("change", initialiseLazyVideos);
  document.addEventListener("astro:page-load", initialiseLazyVideos);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initialiseLazyVideos, { once: true });
  } else {
    initialiseLazyVideos();
  }
</script>

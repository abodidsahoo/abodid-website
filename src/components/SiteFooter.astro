---
import PwaInstallPrompt from "./PwaInstallPrompt.astro";
import { CV_DOWNLOAD_URL } from "../lib/cv";

interface Props {
  showNavigation?: boolean;
}

const { showNavigation = true } = Astro.props;

const brandHref = "/";
const brandLabel = "abodid.com";
const privacyHref = "/privacy";
const sitemapHref = "/sitemap";
const architectureHref = "/architecture";
---

<footer
  class:list={["story-footer", { "story-footer--bottom-only": !showNavigation }]}
  aria-label={showNavigation ? "Site directory and footer" : "Site footer"}
  data-site-footer
>
  {showNavigation && <div class="story-footer__grid">
    <div class="story-footer__card story-footer__card--work">
      <div class="story-footer__card-header">
        <h3 class="story-footer__title">Work</h3>
        <span class="story-footer__index">01</span>
      </div>
      <nav aria-label="Work links">
        <a href="/research">Research <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
        <a href="/photography">Photography <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
        <a href="/films">Filmmaking <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
        <a href="/blog">Writing <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
        <a href="/obsidian-vault">Obsidian Vault <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
      </nav>
    </div>

    <div class="story-footer__card story-footer__card--curation">
      <div class="story-footer__card-header">
        <h3 class="story-footer__title">Curation</h3>
        <span class="story-footer__index">02</span>
      </div>
      <nav aria-label="Curation links">
        <a href="/resources">Resources <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
        <a href="/tools">Tools <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
        <a href="/moodboard">Moodboard <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
        <a href="/reading">Morning Digest <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
        <a href="/xr-showcase">XR Showcase <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
        <a href="/curated-videos">Must Watch Videos <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
      </nav>
    </div>

    <div class="story-footer__card story-footer__card--workshops">
      <div class="story-footer__card-header">
        <h3 class="story-footer__title">Workshops</h3>
        <span class="story-footer__index">03</span>
      </div>
      <nav aria-label="Workshops links">
        <a href="/obsidian-tutoring">Obsidian Tutoring <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
        <a href="/video-editing-workshop">Video Editing <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
        <a href="/photography-workshop">Photography <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
        <a href="/filmmaking-workshop">Filmmaking <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
        <a href="/autoethnography-workshop">Autoethnography <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
      </nav>
    </div>

    <div class="story-footer__card story-footer__card--about">
      <div class="story-footer__card-header">
        <h3 class="story-footer__title">About</h3>
        <span class="story-footer__index">04</span>
      </div>
      <nav aria-label="About links">
        <a href="/about">About <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
        <a href="/awards">Awards <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
        <a href="/press">Press Mentions <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
        <a href="/manifesto">Manifesto <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
        <a href={CV_DOWNLOAD_URL} target="_blank" rel="noopener noreferrer">CV/Resume <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </div>}

  <div class="story-footer__bottom-card">
    <div class="story-footer__brand-group">
      <a class="story-footer__brand" href={brandHref} aria-label="Abodid Sahoo homepage">{brandLabel}</a>
      <span class="story-footer__copyright">© {new Date().getFullYear()} Abodid Sahoo. All rights reserved.</span>
    </div>

    <div class="story-footer__social">
      <a href="https://www.instagram.com/abodid.sahoo" target="_blank" rel="noopener noreferrer">Instagram <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
      <a href="https://uk.linkedin.com/in/abodidsahoo" target="_blank" rel="noopener noreferrer">LinkedIn <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
      <a href="https://vimeo.com/abodidsahoo" target="_blank" rel="noopener noreferrer">Vimeo <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
      <a href="https://github.com/abodid.sahoo" target="_blank" rel="noopener noreferrer">GitHub <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
    </div>

    <div class="story-footer__legal">
      <PwaInstallPrompt />
      <span aria-hidden="true">·</span>
      <a href={privacyHref}>Privacy Policy</a>
      <span aria-hidden="true">·</span>
      <a href={sitemapHref}>Sitemap</a>
      <span aria-hidden="true">·</span>
      <a href={architectureHref}>Architecture</a>
    </div>
  </div>
</footer>

<style>
  .story-footer {
    --home-next-gap: 8px;
    --home-next-border: 1px solid color-mix(in srgb, var(--color-text) 78%, transparent);
    --home-next-radius-panel: clamp(18px, 2vw, 28px);
    --home-next-radius-control: 14px;
    --home-next-motion: 180ms ease;
    padding: clamp(2.5rem, 5vw, 4.5rem) max(var(--home-next-gap), env(safe-area-inset-right, 0px)) max(var(--home-next-gap), calc(var(--home-next-gap) + env(safe-area-inset-bottom, 0px))) max(var(--home-next-gap), env(safe-area-inset-left, 0px));
    border-top: 0;
    background: var(--color-secondary);
    color: var(--color-text);
  }

  .story-footer a {
    color: inherit;
    text-decoration: none;
  }

  .story-footer.story-footer--bottom-only {
    padding: var(--home-next-gap) max(var(--home-next-gap), env(safe-area-inset-right, 0px)) max(var(--home-next-gap), calc(var(--home-next-gap) + env(safe-area-inset-bottom, 0px))) max(var(--home-next-gap), env(safe-area-inset-left, 0px));
  }

  .story-footer--bottom-only .story-footer__bottom-card {
    margin-top: 0;
  }

  .story-footer__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--home-next-gap);
  }

  .story-footer__card {
    --footer-card-text: var(--color-text);
    color: var(--footer-card-text);
    padding: clamp(1.4rem, 2.4vw, 2.2rem);
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    border: var(--home-next-border);
    border-radius: var(--home-next-radius-panel);
    transition: transform var(--home-next-motion), box-shadow var(--home-next-motion);
  }

  .story-footer__card--work { --footer-card-text: var(--color-button-text); background: var(--color-button); }

  .story-footer__card--curation {
    --footer-card-text: var(--color-primary-text);
    border-color: color-mix(in srgb, var(--color-primary-text) 45%, transparent);
    background: var(--color-primary);
    color: var(--color-primary-text);
  }

  .story-footer__card--workshops { background: var(--color-accent); }
  .story-footer__card--about { background: var(--color-background); }

  .story-footer__card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px color-mix(in srgb, var(--color-text) 8%, transparent);
  }

  .story-footer__card--curation:hover {
    box-shadow: 0 6px 18px color-mix(in srgb, var(--ui-shadow-color) 18%, transparent);
  }

  .story-footer__card-header {
    padding-bottom: 0.85rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    border-bottom: 1.5px solid currentColor;
  }

  .story-footer__title,
  .story-footer__index {
    margin: 0;
    color: inherit;
    font: 750 clamp(1.3rem, 1.8vw, 1.85rem)/1 var(--font-display, sans-serif);
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .story-footer__index { opacity: 0.92; }

  .story-footer__card nav {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .story-footer__card nav a {
    padding: 0.52rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 22%, transparent);
    color: var(--footer-card-text);
    font: 750 clamp(0.75rem, 0.88vw, 0.84rem)/1.35 var(--font-mono, monospace);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: transform var(--home-next-motion), color var(--home-next-motion);
  }

  .story-footer__card--curation nav a {
    border-bottom-color: color-mix(in srgb, var(--color-primary-text) 28%, transparent);
    color: var(--color-primary-text);
  }

  .story-footer__card nav a:last-child { border-bottom: 0; }
  .story-footer__card nav a:hover { transform: translateX(4px); }
  .story-footer__card--curation nav a:hover { color: var(--color-button); }

  .story-footer__card nav a span {
    opacity: 0.75;
    font-size: 0.88rem;
    transition: transform var(--home-next-motion), opacity var(--home-next-motion);
  }

  .story-footer__card nav a:hover span {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  .story-footer__bottom-card {
    margin-top: var(--home-next-gap);
    padding: clamp(1rem, 1.8vw, 1.35rem) clamp(1.2rem, 2.5vw, 2.2rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.25rem;
    border: var(--home-next-border);
    border-radius: var(--home-next-radius-panel);
    background: var(--color-background);
  }

  .story-footer__brand-group,
  .story-footer__social,
  .story-footer__legal {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  .story-footer__brand-group { gap: 1.25rem; }
  .story-footer__social { gap: 0.5rem; }

  .story-footer__brand {
    min-height: 38px;
    padding: 0 0.9rem;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-text);
    border-radius: var(--home-next-radius-control);
    background: var(--color-button);
    color: var(--color-button-text) !important;
    font: 750 0.74rem/1 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: transform var(--home-next-motion), box-shadow var(--home-next-motion);
  }

  .story-footer__brand:hover {
    transform: translateY(-2px);
    box-shadow: 0 3px 0 var(--color-text);
  }

  .story-footer__copyright {
    color: color-mix(in srgb, var(--color-text) 82%, transparent);
    font: 600 0.72rem/1.35 var(--font-mono, monospace);
  }

  .story-footer__social a {
    min-height: 34px;
    padding: 0 0.75rem;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-text);
    border-radius: var(--home-next-radius-control);
    background: var(--color-surface);
    color: var(--color-text);
    font: 700 0.68rem/1 var(--font-mono, monospace);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: background-color var(--home-next-motion), transform var(--home-next-motion);
  }

  .story-footer__social a:hover {
    transform: translateY(-2px);
    background: var(--color-secondary);
  }

  .story-footer__legal {
    gap: 0.85rem;
    color: color-mix(in srgb, var(--color-text) 75%, transparent);
    font: 650 0.7rem/1.3 var(--font-mono, monospace);
    text-transform: uppercase;
  }

  .story-footer__legal a { color: inherit; }

  .story-footer__legal a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  @media (max-width: 980px) {
    .story-footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 720px) {
    .story-footer {
      padding-top: 2rem;
    }

    .story-footer__grid { grid-template-columns: 1fr; }

    .story-footer__bottom-card {
      align-items: flex-start;
      flex-direction: column;
    }

    .story-footer__brand-group {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.5rem;
    }

    .story-footer__social { width: 100%; }

    .story-footer__legal {
      gap: 0.6rem 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story-footer *,
    .story-footer *::before,
    .story-footer *::after {
      transition-duration: 0.01ms !important;
    }
  }
</style>

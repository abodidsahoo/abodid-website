---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroVaultTagsCard from "../HeroVaultTagsCard.jsx";
import InlineInquiryForm from "../InlineInquiryForm.astro";
import ChromaticStoryFooter from "./ChromaticStoryFooter.astro";
import ObsidianPaymentDialog from "./ObsidianPaymentDialog.astro";
import {
  breadcrumbJsonLd,
  personJsonLd,
  serviceJsonLd,
} from "../../lib/seoData";

interface PriceLine {
  text: string;
  strong?: boolean;
  small?: boolean;
  strike?: boolean;
}

interface AccordionItem {
  title: string;
  body: string;
}

interface HubLink {
  title: string;
  body: string;
  href: string;
}

interface CrossLink {
  label: string;
  title: string;
  href: string;
}

interface Props {
  pageTitle: string;
  description: string;
  path: string;
  eyebrow: string;
  headingLines?: string[];
  body?: string;
  bodyBeforeStrong?: string;
  bodyStrong?: string;
  bodyAfterStrong?: string;
  bodyEmphasis?: string;
  workflow?: string[];
  workflowConnector?: string;
  priceLines?: PriceLine[];
  showPayment?: boolean;
  secondaryCta?: string;
  secondHeading: string;
  supportingLines?: string[];
  supportStrong?: boolean;
  visualHeading: string;
  visualCta: string;
  visualDetails?: string[];
  accordions?: AccordionItem[];
  closingLines?: string[];
  hubHeading?: string;
  hubLinks?: HubLink[];
  endPrompt?: string;
  crossLink?: CrossLink | null;
  sourceName: string;
  contactInterest: string;
}

const {
  pageTitle,
  description,
  path,
  eyebrow,
  headingLines = [],
  body,
  bodyBeforeStrong = "",
  bodyStrong = "",
  bodyAfterStrong = "",
  bodyEmphasis = "",
  workflow = [],
  workflowConnector = "→",
  priceLines = [],
  showPayment = false,
  secondaryCta = "",
  secondHeading,
  supportingLines = [],
  supportStrong = false,
  visualHeading,
  visualCta,
  visualDetails = [],
  accordions = [],
  closingLines = [],
  hubHeading = "",
  hubLinks = [],
  endPrompt = "",
  crossLink = null,
  sourceName,
  contactInterest,
} = Astro.props as Props;

const videoUrl = "https://jwipqbjxpmgyevfzpjjx.supabase.co/storage/v1/object/public/misc/video-clips/Obsidian_Timelapse.mp4";
const structuredData = [
  personJsonLd(),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: pageTitle, path },
  ]),
  serviceJsonLd({
    path,
    name: pageTitle,
    description,
    serviceType: "Obsidian tutoring and knowledge management consulting",
  }),
];

const pageTone = path.includes("researchers")
  ? "research"
  : path.includes("filmmakers")
    ? "creative"
    : path.includes("writers")
      ? "writing"
      : "tutoring";
const headingParts = headingLines.map((line) => {
  const words = line.trim().split(/\s+/);
  return words.length > 2
    ? { lead: words.slice(0, -2).join(" "), keep: words.slice(-2).join(" ") }
    : { lead: "", keep: line };
});
---

<BaseLayout
  title={pageTitle}
  description={description}
  structuredData={structuredData}
  fullWidth={true}
  hideHeader={true}
  hideFooter={true}
  bodyClass="obsidian-landing-page"
  showNewsletterPopup={false}
>
  {
    showPayment && (
      <script
        slot="head"
        is:inline
        data-astro-rerun
        src="https://www.paypal.com/sdk/js?client-id=BAAttsc6sE2ZkLVzJoPcVG15j0pqEpXApDZoUGhEZNQeCJgmigK9JATqcL-2lIUyZ9AzTLV9Qo3BorAYaY&components=hosted-buttons&disable-funding=venmo&currency=GBP"
      />
    )
  }

  <header class="story-nav">
    <a class="story-nav__brand" href="/" aria-label="Abodid Sahoo homepage">abodid.com</a>
    <nav class="story-nav__links" aria-label="Primary navigation">
      <a href="/#selected-work">Work</a>
      <a href="/research">Research</a>
      <a href="/services" class="is-active">Services</a>
      <a href="/experience">Experience</a>
      <a href="/about">About</a>
    </nav>
    <a class="story-nav__contact" href="/#enquiry">Hire me <span aria-hidden="true">↗</span></a>
    <details class="story-nav__mobile">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        <a href="/#selected-work">Work</a>
        <a href="/research">Research</a>
        <a href="/services" class="is-active">Services</a>
        <a href="/experience">Experience</a>
        <a href="/about">About</a>
        <a href="/#enquiry">Hire me ↗</a>
      </nav>
    </details>
  </header>

  <div class={`obsidian-site obsidian-site--${pageTone}`}>
    <section class="obsidian-hero" aria-labelledby="obsidian-page-heading">
      <div class="obsidian-hero__copy">
        <p class="obsidian-eyebrow">{eyebrow}</p>
        <h1 id="obsidian-page-heading">
          {headingParts.map((line) => (
            <span>{line.lead}{line.lead && " "}<span class="obsidian-heading__keep">{line.keep}</span></span>
          ))}
        </h1>
        <p class="obsidian-hero__body">
          {
            bodyStrong ? (
              <>{bodyBeforeStrong}<strong>{bodyStrong}</strong>{bodyAfterStrong}</>
            ) : body
          }
        </p>
        {bodyEmphasis && <p class="obsidian-hero__emphasis">{bodyEmphasis}</p>}

        {
          workflow.length > 0 && (
            <div class="obsidian-workflow" aria-label={workflow.join(` ${workflowConnector} `)}>
              {workflow.map((step, index) => (
                <span class="obsidian-workflow__step">
                  <code>{step}</code>
                  {index < workflow.length - 1 && <b aria-hidden="true">{workflowConnector}</b>}
                </span>
              ))}
            </div>
          )
        }

        <div class="obsidian-hero__actions">
          <a class="btn-primary obsidian-primary-cta" href="#discovery-call">Book a free 15-minute discovery call</a>
          {
            showPayment && secondaryCta && (
              <button class="btn-secondary obsidian-secondary-cta" type="button" data-obsidian-payment-open>
                {secondaryCta}
              </button>
            )
          }
        </div>

        {
          priceLines.length > 0 && (
            <div class="obsidian-price" aria-label="Price">
              {priceLines.map((line) => (
                <p class:list={{ "is-strong": line.strong, "is-small": line.small }}>
                  {line.strike ? <s>{line.text}</s> : line.text}
                </p>
              ))}
            </div>
          )
        }
      </div>

      <figure class="obsidian-hero__video">
        <video
          data-obsidian-vault-video
          src={videoUrl}
          width="1920"
          height="1241"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-label="Timelapse preview of Abodid's Obsidian vault"
        >
          Your browser does not support embedded video.
        </video>
        <figcaption><span>Inside my real vault</span><span>Live note system</span></figcaption>
      </figure>
    </section>

    <section class="obsidian-system" aria-labelledby="obsidian-system-heading">
      <div class:list={["obsidian-system__heading", { "has-support": supportingLines.length > 0 }]}>
        <h2 id="obsidian-system-heading">{secondHeading}</h2>
        {
          supportingLines.length > 0 && (
            <div class:list={["obsidian-system__support", { "is-strong": supportStrong }]}>
              {supportingLines.map((line) => <p>{line}</p>)}
            </div>
          )
        }
      </div>

      <div class="obsidian-system__grid">
        <div class="obsidian-proof">
          <HeroVaultTagsCard
            client:load
            heading={visualHeading}
            cta={visualCta}
            details={visualDetails}
            ariaLabel={`${pageTitle} connected-note example. Move the cursor over the card to reveal live vault tags.`}
          />
        </div>

        <div class="obsidian-accordions" aria-label="What we will cover">
          {
            accordions.map((item, index) => (
              <details>
                <summary>
                  <span class="obsidian-accordion__index">{String(index + 1).padStart(2, "0")}</span>
                  <span class="obsidian-accordion__title">{item.title}</span>
                  <span class="obsidian-accordion__label">Open note</span>
                  <span class="obsidian-accordion__toggle" aria-hidden="true"><span></span></span>
                </summary>
                <div class="obsidian-accordion__body"><p>{item.body}</p></div>
              </details>
            ))
          }
        </div>
      </div>

      {
        closingLines.length > 0 && (
          <div class="obsidian-closing">
            {closingLines.map((line) => <p>{line}</p>)}
          </div>
        )
      }

      {
        hubLinks.length > 0 && (
          <div class="obsidian-hub">
            <h2>{hubHeading}</h2>
            <div class="obsidian-hub__grid">
              {hubLinks.map((link) => (
                <a href={link.href}>
                  <strong>{link.title} <span aria-hidden="true">→</span></strong>
                  <span>{link.body}</span>
                </a>
              ))}
            </div>
          </div>
        )
      }

      <div class="obsidian-end">
        <div>
          {endPrompt && <p>{endPrompt}</p>}
          <a class="btn-primary obsidian-primary-cta" href="#discovery-call">Book a free 15-minute discovery call</a>
        </div>
        {
          crossLink && (
            <p class="obsidian-cross-link">
              <span>{crossLink.label}</span>
              <a href={crossLink.href}>{crossLink.title} <span aria-hidden="true">→</span></a>
            </p>
          )
        }
      </div>

      <InlineInquiryForm
        id="discovery-call"
  heading="Book your call today."
        eyebrow="Discovery call"
        sourceName={sourceName}
        defaultInterest={contactInterest}
        variant="obsidian"
        compact={true}
        messageLabel="What are you trying to organise?"
        messagePlaceholder="Tell me what is scattered, stuck or difficult to recall."
        submitLabel="Book my free 15 minutes"
        showEmailLink={false}
      />
    </section>
  </div>

  <ChromaticStoryFooter />

  {showPayment && <ObsidianPaymentDialog />}

  <script is:inline data-astro-rerun>
    (() => {
      const controllerKey = "__obsidianVaultVideoPlayback";
      const existingController = window[controllerKey];
      if (existingController && typeof existingController.ensureVideosPlay === "function") {
        window.requestAnimationFrame(existingController.ensureVideosPlay);
        return;
      }

      const trackedVideos = new WeakSet();
      const pendingVideos = new WeakSet();
      const loadingVideos = new WeakSet();
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.target instanceof HTMLVideoElement) {
            ensurePlayback(entry.target);
          }
        });
      }, { threshold: 0.08 });

      const isVisible = (video) => {
        if (document.visibilityState !== "visible" || !video.isConnected) return false;
        const rect = video.getBoundingClientRect();
        return rect.bottom > 0 && rect.top < window.innerHeight && rect.right > 0 && rect.left < window.innerWidth;
      };

      const startVideo = (video) => {
        if (!isVisible(video)) return;
        const playPromise = video.play();
        if (playPromise && typeof playPromise.catch === "function") {
          playPromise.catch(() => undefined);
        }
      };

      const ensurePlayback = (video) => {
        video.muted = true;
        video.defaultMuted = true;
        video.loop = true;
        video.playsInline = true;

        if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
          startVideo(video);
          return;
        }

        if (!pendingVideos.has(video)) {
          pendingVideos.add(video);
          const resumeWhenReady = () => {
            pendingVideos.delete(video);
            loadingVideos.delete(video);
            startVideo(video);
          };
          video.addEventListener("loadeddata", resumeWhenReady, { once: true });
          video.addEventListener("canplay", resumeWhenReady, { once: true });
        }

        if (!loadingVideos.has(video)) {
          loadingVideos.add(video);
          video.load();
        }
      };

      const registerVideo = (video) => {
        if (trackedVideos.has(video)) return;
        trackedVideos.add(video);
        observer.observe(video);

        video.addEventListener("pause", () => {
          if (!isVisible(video)) return;
          window.setTimeout(() => ensurePlayback(video), 80);
        });

        video.addEventListener("stalled", () => {
          if (!isVisible(video)) return;
          loadingVideos.delete(video);
          window.setTimeout(() => ensurePlayback(video), 160);
        });
      };

      const ensureVideosPlay = () => {
        document.querySelectorAll("video[data-obsidian-vault-video]").forEach((video) => {
          if (!(video instanceof HTMLVideoElement)) return;
          registerVideo(video);
          ensurePlayback(video);
        });
      };

      const resumeVisibleVideos = () => {
        if (document.visibilityState === "visible") {
          window.requestAnimationFrame(ensureVideosPlay);
        }
      };

      const mutationObserver = new MutationObserver(() => {
        window.requestAnimationFrame(ensureVideosPlay);
      });
      mutationObserver.observe(document.documentElement, { childList: true, subtree: true });

      window[controllerKey] = { ensureVideosPlay };
      document.addEventListener("visibilitychange", resumeVisibleVideos);
      document.addEventListener("astro:page-load", ensureVideosPlay);
      document.addEventListener("astro:after-swap", ensureVideosPlay);
      window.addEventListener("focus", resumeVisibleVideos);
      window.addEventListener("pageshow", resumeVisibleVideos);

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", ensureVideosPlay, { once: true });
      } else {
        window.requestAnimationFrame(ensureVideosPlay);
      }
    })();
  </script>
</BaseLayout>

<style>
  .obsidian-site {
    width: min(100%, 1480px);
    margin: 0 auto;
    padding: 0 clamp(1rem, 3.2vw, 3.5rem) clamp(2rem, 5vw, 4rem);
  }

  .obsidian-eyebrow {
    margin: 0 0 1rem;
    color: var(--accent-primary);
    font: var(--type-weight-label) var(--type-label)/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .obsidian-hero {
    min-height: min(820px, calc(100svh - var(--next-nav-height, 72px)));
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(22rem, 0.96fr);
    gap: clamp(1.25rem, 4vw, 4.5rem);
    align-items: center;
    padding: clamp(2.5rem, 7vh, 5rem) 0;
  }

  .obsidian-hero__copy {
    min-width: 0;
  }

  .obsidian-hero h1 {
    max-width: 14ch;
    margin: 0;
    font: var(--type-weight-display) clamp(3.1rem, 6.6vw, 7rem)/0.88 var(--font-display);
    letter-spacing: -0.065em;
    text-wrap: balance;
  }

  .obsidian-hero h1 > span {
    display: block;
  }

  .obsidian-hero__body {
    max-width: 42rem;
    margin: clamp(1.2rem, 2.5vw, 2rem) 0 0;
    color: var(--text-secondary);
    font-size: clamp(1.03rem, 1.45vw, 1.28rem);
    line-height: 1.52;
  }

  .obsidian-hero__body strong { color: var(--text-primary); }

  .obsidian-hero__emphasis {
    max-width: 40rem;
    margin: 0.85rem 0 0;
    color: var(--text-primary);
    font-weight: var(--type-weight-strong);
    line-height: 1.45;
  }

  .obsidian-workflow {
    max-width: 50rem;
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.55rem;
  }

  .obsidian-workflow__step {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .obsidian-workflow code {
    padding: 0.42rem 0.62rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    color: var(--text-primary);
    font: 700 0.72rem/1 var(--font-mono);
  }

  .obsidian-workflow b {
    color: var(--text-tertiary);
    font: 700 0.9rem/1 var(--font-mono);
  }

  .obsidian-hero__actions {
    margin-top: clamp(1.4rem, 3vw, 2rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    align-items: center;
  }

  .obsidian-primary-cta,
  .obsidian-secondary-cta {
    min-height: 50px;
    padding: 0.85rem 1.05rem !important;
    border-radius: var(--radius-base) !important;
    font-size: 0.75rem !important;
    font-weight: 740;
    letter-spacing: 0.035em !important;
    line-height: 1.15 !important;
    text-align: center;
  }

  .obsidian-secondary-cta { font-family: var(--font-ui); }

  .obsidian-price {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.8rem;
    align-items: baseline;
  }

  .obsidian-price p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.35;
  }

  .obsidian-price .is-strong {
    color: var(--text-primary);
    font-weight: var(--type-weight-strong);
  }

  .obsidian-price .is-small {
    flex-basis: 100%;
    color: var(--text-tertiary);
    font-size: 0.78rem;
  }

  .obsidian-hero__video,
  .obsidian-hero__signal {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.22);
  }

  .obsidian-hero__video {
    margin: 0;
  }

  .obsidian-hero__video video {
    width: 100%;
    aspect-ratio: 1.38;
    display: block;
    object-fit: cover;
    background: #050505;
  }

  .obsidian-hero__video figcaption {
    min-height: 46px;
    padding: 0.75rem 1rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--text-secondary);
    font: 700 0.68rem/1.25 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .obsidian-hero__signal {
    min-height: clamp(310px, 43vw, 590px);
    padding: clamp(1.4rem, 4vw, 3.2rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--accent-primary) 90%, #0b0b0b), var(--accent-primary));
    color: #fff;
  }

  .obsidian-hero__signal p,
  .obsidian-hero__signal strong {
    max-width: 10ch;
    margin: 0;
    color: inherit;
    font: var(--type-weight-display) clamp(2.5rem, 5vw, 5.6rem)/0.88 var(--font-display);
    letter-spacing: -0.06em;
  }

  .obsidian-hero__signal strong { font-weight: 730; }

  .obsidian-hero__signal > span {
    margin-top: 1.3rem;
    font: 700 0.7rem/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .obsidian-system {
    padding: clamp(3rem, 7vw, 6rem) 0 0;
    border-top: 1px solid var(--border-subtle);
  }

  .obsidian-system__heading {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(16rem, 0.75fr);
    gap: 1.5rem clamp(2rem, 8vw, 8rem);
    align-items: end;
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }

  .obsidian-system__heading h2,
  .obsidian-hub h2 {
    max-width: 15ch;
    margin: 0;
    font: var(--type-weight-heading-strong) clamp(2.45rem, 5.2vw, 5.6rem)/0.92 var(--font-display);
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .obsidian-system__support p {
    margin: 0;
    color: var(--text-secondary);
    font-size: clamp(0.98rem, 1.25vw, 1.12rem);
    line-height: 1.5;
  }

  .obsidian-system__support p + p { margin-top: 0.4rem; }

  .obsidian-system__support.is-strong p {
    color: var(--text-primary);
    font-weight: var(--type-weight-strong);
  }

  .obsidian-system__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr);
    gap: 1rem;
    align-items: stretch;
  }

  .obsidian-proof {
    min-height: 450px;
  }

  .obsidian-accordions {
    display: grid;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
  }

  .obsidian-accordions details {
    min-height: 0;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-base);
    background: var(--bg-surface);
  }

  .obsidian-accordions summary {
    min-height: 100%;
    padding: 1.1rem 1.2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--text-primary);
    font: var(--type-weight-label) 0.78rem/1.2 var(--font-mono);
    letter-spacing: 0.1em;
    list-style: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .obsidian-accordions summary::-webkit-details-marker { display: none; }

  .obsidian-accordions details[open] summary {
    min-height: auto;
    padding-bottom: 0.7rem;
  }

  .obsidian-accordions details p {
    max-width: 40rem;
    margin: 0;
    padding: 0 1.2rem 1.2rem;
    color: var(--text-secondary);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .obsidian-closing {
    margin: clamp(2rem, 5vw, 4rem) 0 0;
    padding: clamp(1.4rem, 3vw, 2.5rem);
    border-left: 4px solid var(--accent-primary);
    background: var(--bg-surface);
  }

  .obsidian-closing p {
    max-width: 22ch;
    margin: 0;
    color: var(--text-primary);
    font: var(--type-weight-heading-strong) clamp(1.8rem, 4vw, 3.8rem)/0.98 var(--font-display);
    letter-spacing: -0.045em;
  }

  .obsidian-hub {
    margin-top: clamp(2.2rem, 5vw, 4rem);
  }

  .obsidian-hub h2 {
    font-size: clamp(2rem, 4vw, 4rem);
  }

  .obsidian-hub__grid {
    margin-top: 1.4rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .obsidian-hub__grid a {
    min-height: 160px;
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-base);
    background: var(--bg-surface);
    color: var(--text-primary);
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .obsidian-hub__grid a:hover {
    transform: translateY(-3px);
    border-color: var(--accent-primary);
  }

  .obsidian-hub__grid strong {
    font-size: 1.08rem;
    line-height: 1.15;
  }

  .obsidian-hub__grid a > span {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .obsidian-end {
    margin: clamp(2rem, 5vw, 4rem) 0 1rem;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .obsidian-end > div > p,
  .obsidian-cross-link {

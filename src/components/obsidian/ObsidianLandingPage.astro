---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroVaultTagsCard from "../HeroVaultTagsCard.jsx";
import InlineInquiryForm from "../InlineInquiryForm.astro";
import ObsidianPaymentDialog from "./ObsidianPaymentDialog.astro";
import {
  breadcrumbJsonLd,
  personJsonLd,
  serviceJsonLd,
} from "../../lib/seoData";

interface PriceLine {
  text: string;
  strong?: boolean;
  small?: boolean;
  strike?: boolean;
}

interface AccordionItem {
  title: string;
  body: string;
}

interface HubLink {
  title: string;
  body: string;
  href: string;
}

interface CrossLink {
  label: string;
  title: string;
  href: string;
}

interface Props {
  pageTitle: string;
  description: string;
  path: string;
  eyebrow: string;
  headingLines?: string[];
  body?: string;
  bodyBeforeStrong?: string;
  bodyStrong?: string;
  bodyAfterStrong?: string;
  bodyEmphasis?: string;
  workflow?: string[];
  workflowConnector?: string;
  priceLines?: PriceLine[];
  showPayment?: boolean;
  secondaryCta?: string;
  secondHeading?: string;
  supportingLines?: string[];
  supportStrong?: boolean;
  visualHeading?: string;
  visualCta?: string;
  visualDetails?: string[];
  accordions?: AccordionItem[];
  closingLines?: string[];
  hubHeading?: string;
  hubLinks?: HubLink[];
  endPrompt?: string;
  crossLink?: CrossLink | null;
  discoveryHeading?: string;
  discoveryIntro?: string;
  submitLabel?: string;
  finalAppealText?: string;
  sourceName: string;
  contactInterest: string;
}

const {
  pageTitle,
  description,
  path,
  eyebrow,
  headingLines = [],
  body,
  bodyBeforeStrong = "",
  bodyStrong = "",
  bodyAfterStrong = "",
  bodyEmphasis = "",
  workflow = [],
  workflowConnector = "→",
  priceLines = [],
  showPayment = false,
  secondaryCta = "",
  secondHeading = "",
  supportingLines = [],
  supportStrong = false,
  visualHeading = "",
  visualCta = "",
  visualDetails = [],
  accordions = [],
  closingLines = [],
  hubHeading = "",
  hubLinks = [],
  endPrompt = "",
  crossLink = null,
  discoveryHeading = "",
  discoveryIntro = "",
  submitLabel = "",
  finalAppealText = "",
  sourceName,
  contactInterest,
} = Astro.props as Props;

const videoUrl = "https://jwipqbjxpmgyevfzpjjx.supabase.co/storage/v1/object/public/misc/video-clips/Obsidian_Timelapse.mp4";
const structuredData = [
  personJsonLd(),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: pageTitle, path },
  ]),
  serviceJsonLd({
    path,
    name: pageTitle,
    description,
    serviceType: "Obsidian tutoring and knowledge management consulting",
  }),
];

const pageTone = path.includes("researchers")
  ? "research"
  : path.includes("filmmakers")
    ? "creative"
    : path.includes("writers")
      ? "writing"
      : "tutoring";
const headingParts = headingLines.map((line) => {
  const words = line.trim().split(/\s+/);
  return words.length > 2
    ? { lead: words.slice(0, -2).join(" "), keep: words.slice(-2).join(" ") }
    : { lead: "", keep: line };
});
---

<BaseLayout
  title={pageTitle}
  description={description}
  structuredData={structuredData}
  fullWidth={true}
  bodyClass="obsidian-landing-page"
  showNewsletterPopup={false}
>
  <link
    slot="head"
    rel="preload"
    href={videoUrl}
    as="video"
    type="video/mp4"
    crossorigin="anonymous"
  />
  <link
    slot="head"
    rel="preload"
    href="/images/obsidian-timelapse/frame-1.webp"
    as="image"
    type="image/webp"
  />
  {
    showPayment && (
      <script
        slot="head"
        is:inline
        data-astro-rerun
        src="https://www.paypal.com/sdk/js?client-id=BAAttsc6sE2ZkLVzJoPcVG15j0pqEpXApDZoUGhEZNQeCJgmigK9JATqcL-2lIUyZ9AzTLV9Qo3BorAYaY&components=hosted-buttons&disable-funding=venmo&currency=GBP"
      />
    )
  }

  <div class={`obsidian-site obsidian-site--${pageTone}`}>
    <section class="obsidian-hero" aria-labelledby="obsidian-page-heading">
      <div class="obsidian-hero__copy">
        <p class="obsidian-eyebrow">{eyebrow}</p>
        <h1 id="obsidian-page-heading">
          {headingParts.map((line) => (
            <span>{line.lead}{line.lead && " "}<span class="obsidian-heading__keep">{line.keep}</span></span>
          ))}
        </h1>
        <p class="obsidian-hero__body">
          {
            bodyStrong ? (
              <>{bodyBeforeStrong}<strong>{bodyStrong}</strong>{bodyAfterStrong}</>
            ) : body
          }
        </p>
        {bodyEmphasis && <p class="obsidian-hero__emphasis">{bodyEmphasis}</p>}

        {
          workflow.length > 0 && (
            <div class="obsidian-workflow" aria-label={workflow.join(` ${workflowConnector} `)}>
              {workflow.map((step, index) => (
                <span class="obsidian-workflow__step">
                  <code>{step}</code>
                  {index < workflow.length - 1 && <b aria-hidden="true">{workflowConnector}</b>}
                </span>
              ))}
            </div>
          )
        }

        <div class="obsidian-hero__actions">
          <a class="btn-primary obsidian-primary-cta" href="#discovery-call">Book a free 15-minute discovery call</a>
          {
            showPayment && secondaryCta && (
              <button class="btn-secondary obsidian-secondary-cta" type="button" data-obsidian-payment-open>
                {secondaryCta}
              </button>
            )
          }
        </div>

        {
          priceLines.length > 0 && (
            <div class="obsidian-price" aria-label="Price">
              {priceLines.map((line) => (
                <p class:list={{ "is-strong": line.strong, "is-small": line.small }}>
                  {line.strike ? <s>{line.text}</s> : line.text}
                </p>
              ))}
            </div>
          )
        }
      </div>

      <figure class="obsidian-hero__video" data-obsidian-vault-stage>
        <div class="obsidian-hero__fallback-slides" data-obsidian-fallback-slides aria-hidden="true">
          <img src="/images/obsidian-timelapse/frame-1.webp" alt="" class="obsidian-fallback-slide is-active" />
          <img src="/images/obsidian-timelapse/frame-2.webp" alt="" class="obsidian-fallback-slide" loading="eager" />
          <img src="/images/obsidian-timelapse/frame-3.webp" alt="" class="obsidian-fallback-slide" loading="eager" />
          <img src="/images/obsidian-timelapse/frame-4.webp" alt="" class="obsidian-fallback-slide" loading="eager" />
          <img src="/images/obsidian-timelapse/frame-5.webp" alt="" class="obsidian-fallback-slide" loading="eager" />
        </div>
        <video
          data-obsidian-vault-video
          src={videoUrl}
          width="1920"
          height="1241"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          aria-label="Timelapse preview of Abodid's Obsidian vault"
        >
          Your browser does not support embedded video.
        </video>
        <figcaption>
          <a href="/obsidian-vault" class="obsidian-hero__vault-link">
            <span>Look into Abodid's Obsidian vault</span>
            <span class="obsidian-hero__vault-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </figcaption>
      </figure>
    </section>

    <section class="obsidian-system" aria-labelledby="obsidian-system-heading">
      {
        secondHeading && (
          <div class:list={["obsidian-system__heading", { "has-support": supportingLines.length > 0 }]}>
            <h2 id="obsidian-system-heading">
              {secondHeading.includes(". ") ? (
                secondHeading.split(/(?<=\.)\s+/).map((sentence) => (
                  <span class="obsidian-heading-sentence">{sentence}</span>
                ))
              ) : (
                secondHeading
              )}
            </h2>
            {
              supportingLines.length > 0 && (
                <div class:list={["obsidian-system__support", { "is-strong": supportStrong }]}>
                  {supportingLines.map((line) => <p>{line}</p>)}
                </div>
              )
            }
          </div>
        )
      }

      {
        (accordions.length > 0 || visualHeading) && (
          <div class:list={["obsidian-system__grid", { "is-pillars-only": !visualHeading }]}>
            {
              accordions.length > 0 && (
                <div class="obsidian-pillars" aria-label="Core system workflows">
                  {
                    accordions.map((item, index) => (
                      <article class="obsidian-pillar-card">
                        <div class="obsidian-pillar-card__header">
                          <span class="obsidian-pillar-card__index">{String(index + 1).padStart(2, "0")}</span>
                          <h3 class="obsidian-pillar-card__title">{item.title}</h3>
                        </div>
                        <p class="obsidian-pillar-card__body">{item.body}</p>
                      </article>
                    ))
                  }
                </div>
              )
            }

            {
              visualHeading && (
                <div class="obsidian-proof">
                  <div class="obsidian-proof__sticky">
                    <HeroVaultTagsCard
                      client:load
                      heading={visualHeading}
                      cta={visualCta}
                      details={visualDetails}
                      ariaLabel={`${pageTitle} connected-note example. Move the cursor over the card to reveal live vault tags.`}
                    />
                  </div>
                </div>
              )
            }
          </div>
        )
      }

      {
        closingLines.length > 0 && (
          <div class="obsidian-closing">
            {closingLines.map((line) => <p>{line}</p>)}
          </div>
        )
      }

      {
        hubLinks.length > 0 && (
          <div class="obsidian-hub">
            <h2>{hubHeading}</h2>
            <div class="obsidian-hub__grid">
              {hubLinks.map((link) => (
                <a href={link.href}>
                  <strong>{link.title} <span aria-hidden="true">→</span></strong>
                  <span>{link.body}</span>
                </a>
              ))}
            </div>
          </div>
        )
      }

      <InlineInquiryForm
        id="discovery-call"
        heading={discoveryHeading || "Book your free discovery call today."}
        eyebrow="Discovery call"
        intro={discoveryIntro}
        sourceName={sourceName}
        defaultInterest={contactInterest}
        variant="obsidian"
        compact={true}
        messageLabel="What are you trying to organise?"
        messagePlaceholder="Tell me what is scattered, stuck or difficult to recall."
        submitLabel={submitLabel || "Yes, I'm Interested"}
        showEmailLink={false}
      />

      {
        crossLink && (
          <div class="obsidian-cross-link-wrap">
            <p class="obsidian-cross-link">
              <span>{crossLink.label}</span>
              <a href={crossLink.href}>{crossLink.title} <span aria-hidden="true">→</span></a>
            </p>
          </div>
        )
      }

      {
        finalAppealText && (
          <div class="obsidian-final-appeal">
            <blockquote>
              <h2 class="obsidian-final-appeal__quote">
                <span class="obsidian-final-appeal__line">"Your notes should find their way back to you</span>
                <span class="obsidian-final-appeal__line">when you need them the most."</span>
              </h2>
              <cite class="obsidian-final-appeal__author">Abodid Sahoo</cite>
            </blockquote>
          </div>
        )
      }
    </section>
  </div>

  {showPayment && <ObsidianPaymentDialog />}

  <script is:inline data-astro-rerun>
    (() => {
      // 1. Fallback 1-second slideshow rotation
      const setupFallbackSlideshow = () => {
        document.querySelectorAll("[data-obsidian-vault-stage]").forEach((stage) => {
          if (!(stage instanceof HTMLElement) || stage.dataset.slideshowInit === "true") return;
          stage.dataset.slideshowInit = "true";

          const slides = Array.from(stage.querySelectorAll(".obsidian-fallback-slide"));
          if (slides.length <= 1) return;

          let activeIndex = 0;
          const slideInterval = window.setInterval(() => {
            if (stage.classList.contains("is-video-ready")) {
              window.clearInterval(slideInterval);
              return;
            }
            slides[activeIndex]?.classList.remove("is-active");
            activeIndex = (activeIndex + 1) % slides.length;
            slides[activeIndex]?.classList.add("is-active");
          }, 1000);

          stage.__fallbackInterval = slideInterval;
        });
      };

      // 2. Video Playback & Instant Transition
      const controllerKey = "__obsidianVaultVideoPlayback";
      const trackedVideos = new WeakSet();

      const markVideoReady = (video) => {
        const stage = video.closest("[data-obsidian-vault-stage]");
        if (stage instanceof HTMLElement) {
          stage.classList.add("is-video-ready");
          if (stage.__fallbackInterval) {
            window.clearInterval(stage.__fallbackInterval);
          }
        }
      };

      const startVideo = (video) => {
        video.muted = true;
        video.defaultMuted = true;
        video.loop = true;
        video.playsInline = true;

        const playPromise = video.play();
        if (playPromise && typeof playPromise.catch === "function") {
          playPromise.then(() => markVideoReady(video)).catch(() => undefined);
        }
      };

      const ensurePlayback = (video) => {
        video.muted = true;
        video.defaultMuted = true;
        video.loop = true;
        video.playsInline = true;

        if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
          startVideo(video);
          if (video.currentTime > 0 || !video.paused) {
            markVideoReady(video);
          }
        } else {
          video.load();
        }
      };

      const registerVideo = (video) => {
        if (trackedVideos.has(video)) return;
        trackedVideos.add(video);

        video.addEventListener("playing", () => markVideoReady(video));
        video.addEventListener("timeupdate", () => {
          if (video.currentTime > 0.05) markVideoReady(video);
        });
        video.addEventListener("loadeddata", () => {
          startVideo(video);
          markVideoReady(video);
        });
        video.addEventListener("canplay", () => {
          startVideo(video);
          markVideoReady(video);
        });
        video.addEventListener("pause", () => {
          if (document.visibilityState === "visible") {
            window.setTimeout(() => startVideo(video), 60);
          }
        });
      };

      const initAll = () => {
        setupFallbackSlideshow();
        document.querySelectorAll("video[data-obsidian-vault-video]").forEach((video) => {
          if (!(video instanceof HTMLVideoElement)) return;
          registerVideo(video);
          ensurePlayback(video);
        });
      };

      window[controllerKey] = { initAll, ensureVideosPlay: initAll };
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") window.requestAnimationFrame(initAll);
      });
      document.addEventListener("astro:page-load", initAll);
      document.addEventListener("astro:after-swap", initAll);
      window.addEventListener("focus", initAll);
      window.addEventListener("pageshow", initAll);

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initAll, { once: true });
      } else {
        window.requestAnimationFrame(initAll);
      }
    })();
  </script>
</BaseLayout>

<style>
  .obsidian-site {
    width: min(100%, 1480px);
    margin: 0 auto;
    padding: 0 clamp(1rem, 3.2vw, 3.5rem) clamp(2rem, 5vw, 4rem);
  }

  .obsidian-eyebrow {
    margin: 0 0 1rem;
    color: var(--accent-primary);
    font: var(--type-weight-label) var(--type-label)/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .obsidian-hero {
    min-height: min(820px, calc(100svh - var(--next-nav-height, 72px)));
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(22rem, 0.96fr);
    gap: clamp(1.25rem, 4vw, 4.5rem);
    align-items: center;
    padding: clamp(2.5rem, 7vh, 5rem) 0;
  }

  .obsidian-hero__copy {
    min-width: 0;
  }

  .obsidian-hero h1 {
    max-width: 14ch;
    margin: 0;
    font: var(--type-weight-display) clamp(3.1rem, 6.6vw, 7rem)/0.88 var(--font-display);
    letter-spacing: -0.065em;
    text-wrap: balance;
  }

  .obsidian-hero h1 > span {
    display: block;
  }

  .obsidian-hero__body {
    max-width: 42rem;
    margin: clamp(1.2rem, 2.5vw, 2rem) 0 0;
    color: var(--text-secondary);
    font-size: clamp(1.03rem, 1.45vw, 1.28rem);
    line-height: 1.52;
  }

  .obsidian-hero__body strong { color: var(--text-primary); }

  .obsidian-hero__emphasis {
    max-width: 40rem;
    margin: 0.85rem 0 0;
    color: var(--text-primary);
    font-weight: var(--type-weight-strong);
    line-height: 1.45;
  }

  .obsidian-workflow {
    max-width: 50rem;
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.55rem;
  }

  .obsidian-workflow__step {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .obsidian-workflow code {
    padding: 0.42rem 0.62rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    color: var(--text-primary);
    font: 700 0.72rem/1 var(--font-mono);
  }

  .obsidian-workflow b {
    color: var(--text-tertiary);
    font: 700 0.9rem/1 var(--font-mono);
  }

  .obsidian-hero__actions {
    margin-top: clamp(1.4rem, 3vw, 2rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    align-items: center;
  }

  .obsidian-primary-cta,
  .obsidian-secondary-cta {
    min-height: 50px;
    padding: 0.85rem 1.05rem !important;
    border-radius: var(--radius-base) !important;
    font-size: 0.75rem !important;
    font-weight: 740;
    letter-spacing: 0.035em !important;
    line-height: 1.15 !important;
    text-align: center;
  }

  .obsidian-secondary-cta { font-family: var(--font-ui); }

  .obsidian-price {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.8rem;
    align-items: baseline;
  }

  .obsidian-price p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.35;
  }

  .obsidian-price .is-strong {
    color: var(--text-primary);
    font-weight: var(--type-weight-strong);
  }

  .obsidian-price .is-small {
    flex-basis: 100%;
    color: var(--text-tertiary);
    font-size: 0.78rem;
  }

  .obsidian-hero__video,
  .obsidian-hero__signal {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.22);
  }

  .obsidian-hero__video {
    margin: 0;
    position: relative;
    background: #050505;
  }

  .obsidian-hero__fallback-slides {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 46px;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    transition: opacity 350ms ease;
    background: #050505;
  }

  .obsidian-fallback-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 350ms ease;
  }

  .obsidian-fallback-slide.is-active {
    opacity: 1;
  }

  .obsidian-hero__video video {
    position: relative;
    z-index: 2;
    width: 100%;
    aspect-ratio: 1.38;
    display: block;
    object-fit: cover;
    background: transparent;
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .obsidian-hero__video.is-video-ready video {
    opacity: 1;
  }

  .obsidian-hero__video.is-video-ready .obsidian-hero__fallback-slides {
    opacity: 0;
  }

  .obsidian-hero__video figcaption {
    min-height: 46px;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    color: var(--text-secondary);
    font: 700 0.68rem/1.25 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .obsidian-hero__vault-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
    transition: opacity 0.15s ease;
  }

  .obsidian-hero__vault-link:hover,
  .obsidian-hero__vault-link:focus-visible {
    opacity: 0.75;
  }

  .obsidian-hero__vault-arrow {
    display: inline-block;
    font-size: 1.15em;
    line-height: 1;
    transition: transform 0.15s ease;
  }

  .obsidian-hero__vault-link:hover .obsidian-hero__vault-arrow {
    transform: translateX(4px);
  }

  .obsidian-hero__signal {
    min-height: clamp(310px, 43vw, 590px);
    padding: clamp(1.4rem, 4vw, 3.2rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--accent-primary) 90%, #0b0b0b), var(--accent-primary));
    color: #fff;
  }

  .obsidian-hero__signal p,
  .obsidian-hero__signal strong {
    max-width: 10ch;
    margin: 0;
    color: inherit;
    font: var(--type-weight-display) clamp(2.5rem, 5vw, 5.6rem)/0.88 var(--font-display);
    letter-spacing: -0.06em;
  }

  .obsidian-hero__signal strong { font-weight: 730; }

  .obsidian-hero__signal > span {
    margin-top: 1.3rem;
    font: 700 0.7rem/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .obsidian-system {
    padding: clamp(3rem, 7vw, 6rem) 0 0;
    border-top: 1px solid var(--border-subtle);
  }

  .obsidian-system__heading {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(16rem, 0.75fr);
    gap: 1.5rem clamp(2rem, 8vw, 8rem);
    align-items: end;
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }

  .obsidian-system__heading h2,
  .obsidian-hub h2 {
    max-width: 15ch;
    margin: 0;
    font: var(--type-weight-heading-strong) clamp(2.45rem, 5.2vw, 5.6rem)/0.92 var(--font-display);
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .obsidian-system__support p {
    margin: 0;
    color: var(--text-secondary);
    font-size: clamp(0.98rem, 1.25vw, 1.12rem);
    line-height: 1.5;
  }

  .obsidian-system__support p + p { margin-top: 0.4rem; }

  .obsidian-system__support.is-strong p {
    color: var(--text-primary);
    font-weight: var(--type-weight-strong);
  }

  .obsidian-system__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr);
    gap: 1rem;
    align-items: stretch;
  }

  .obsidian-proof {
    min-height: 450px;
  }

  .obsidian-accordions {
    display: grid;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
  }

  .obsidian-accordions details {
    min-height: 0;

<dialog class="obsidian-payment-dialog" data-obsidian-payment-dialog aria-labelledby="obsidian-payment-title">
  <div class="obsidian-payment-dialog__surface">
    <button class="obsidian-payment-dialog__close" type="button" data-obsidian-payment-close aria-label="Close payment window">×</button>
    <p class="obsidian-payment-dialog__eyebrow">1:1 Obsidian tutoring</p>
    <h2 id="obsidian-payment-title">Book your tutoring session.</h2>
    <p class="obsidian-payment-dialog__price"><s>£90/hour</s> <strong>£60/hour until 31 December 2026</strong></p>
    <div
      id="paypal-container-7GPVW8RZD86W4"
      class="obsidian-payment-dialog__paypal"
      data-paypal-hosted-button
    ></div>
    <p class="obsidian-payment-dialog__status" data-paypal-status hidden>Loading secure PayPal checkout…</p>
    <p class="obsidian-payment-dialog__note">PayPal-hosted checkout in GBP. You can use PayPal or a supported card.</p>
  </div>
</dialog>

<script is:inline>
  (() => {
    const initialisePayment = () => {
      const dialog = document.querySelector("[data-obsidian-payment-dialog]");
      const openButtons = document.querySelectorAll("[data-obsidian-payment-open]");
      const closeButton = dialog?.querySelector("[data-obsidian-payment-close]");
      const container = dialog?.querySelector("[data-paypal-hosted-button]");
      const status = dialog?.querySelector("[data-paypal-status]");

      if (!(dialog instanceof HTMLDialogElement) || !(container instanceof HTMLElement)) return;
      if (dialog.dataset.ready === "true") return;
      dialog.dataset.ready = "true";

      const setStatus = (message) => {
        if (!(status instanceof HTMLElement)) return;
        status.hidden = !message;
        status.textContent = message || "";
      };

      const renderPayPal = () => {
        if (container.dataset.rendered === "true") return true;
        if (!window.paypal?.HostedButtons) return false;
        window.paypal.HostedButtons({ hostedButtonId: "7GPVW8RZD86W4" }).render("#paypal-container-7GPVW8RZD86W4");
        container.dataset.rendered = "true";
        setStatus("");
        return true;
      };

      const ensurePayPal = () => {
        if (renderPayPal()) return;
        setStatus("Loading secure PayPal checkout…");
        const intervalId = window.setInterval(() => {
          if (renderPayPal()) window.clearInterval(intervalId);
        }, 200);
        window.setTimeout(() => {
          if (renderPayPal()) return;
          window.clearInterval(intervalId);
          setStatus("PayPal is taking longer than expected. Refresh the page or book a discovery call first.");
        }, 5000);
      };

      openButtons.forEach((button) => button.addEventListener("click", () => {
        if (!dialog.open) dialog.showModal();
        ensurePayPal();
      }));
      closeButton?.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
    };

    initialisePayment();
    document.addEventListener("astro:page-load", initialisePayment);
  })();
</script>


    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .obsidian-payment-dialog h2 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(2rem, 6vw, 3.3rem);
    line-height: 0.98;
  }

  .obsidian-payment-dialog__price {
    display: grid;
    gap: 0.25rem;
    margin: 1.1rem 0 1.5rem;
    color: var(--text-secondary);
  }

  .obsidian-payment-dialog__price strong { color: var(--text-primary); }
  .obsidian-payment-dialog__paypal { min-height: 48px; }

  .obsidian-payment-dialog__status,

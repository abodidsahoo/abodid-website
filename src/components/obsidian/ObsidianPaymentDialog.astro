<dialog class="obsidian-payment-dialog" data-obsidian-payment-dialog aria-labelledby="obsidian-payment-title">
  <div class="obsidian-payment-dialog__surface">
    <button class="obsidian-payment-dialog__close" type="button" data-obsidian-payment-close aria-label="Close booking window">×</button>
    <p class="obsidian-payment-dialog__eyebrow">1:1 Obsidian Tutoring</p>
    <h2 id="obsidian-payment-title">Book your tutoring session.</h2>
    <div class="obsidian-payment-dialog__price">
      <s>£90/hour</s>
      <strong>£60/hour until 31 December 2026</strong>
    </div>

    <form class="obsidian-booking-form" data-obsidian-booking-form>
      <label class="obsidian-booking-field">
        <span>Email Address</span>
        <input type="email" name="email" placeholder="you@example.com" required />
      </label>

      <button type="submit" class="obsidian-booking-submit-btn" data-booking-submit-btn>
        Submit Booking Request →
      </button>
    </form>

    <div class="obsidian-booking-success-message" data-booking-success-message style="display: none;">
      <div class="success-badge">✓ Request Received!</div>
      <p class="success-text">I will reach out to you within the next 24 hours to take this ahead.</p>
    </div>
  </div>
</dialog>

<script is:inline>
  (() => {
    const initialiseBookingDialog = () => {
      const dialog = document.querySelector("[data-obsidian-payment-dialog]");
      const openButtons = document.querySelectorAll("[data-obsidian-payment-open]");
      const closeButton = dialog?.querySelector("[data-obsidian-payment-close]");
      const form = dialog?.querySelector("[data-obsidian-booking-form]");
      const successMsg = dialog?.querySelector("[data-booking-success-message]");
      const submitBtn = dialog?.querySelector("[data-booking-submit-btn]");

      if (!(dialog instanceof HTMLDialogElement)) return;
      if (dialog.dataset.ready === "true") return;
      dialog.dataset.ready = "true";

      openButtons.forEach((button) => {
        button.addEventListener("click", () => {
          if (!dialog.open) {
            if (form) form.style.display = "flex";
            if (successMsg) successMsg.style.display = "none";
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = "Submit Booking Request →";
            }
            dialog.showModal();
          }
        });
      });

      closeButton?.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });

      if (form) {
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = "Submitting...";
          }

          const formData = new FormData(form);
          const email = formData.get("email");

          try {
            await fetch("/api/contact", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                email: email,
                name: "1:1 Tutoring Session Request",
                interest: "Obsidian 1:1 Tutoring Session (£60/hour)",
                message: "1:1 Obsidian tutoring booking request",
                sourceName: "obsidian-tutoring-dialog"
              })
            });
          } catch (err) {
            console.error("Submission error:", err);
          }

          if (form) form.style.display = "none";
          if (successMsg) successMsg.style.display = "block";
        });
      }
    };

    initialiseBookingDialog();
    document.addEventListener("astro:page-load", initialiseBookingDialog);
  })();
</script>


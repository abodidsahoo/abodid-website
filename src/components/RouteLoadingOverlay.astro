---
import script from "../../podcast/src/assets/destination-navigation.js?raw";
import styles from "../../podcast/src/assets/destination-navigation.css?raw";
import { pages } from "../lib/siteNavigation.js";

const destinations = Object.fromEntries(Object.values(pages).map(({ href, label }) => [href, label]));
destinations["/"] = "Abodid Sahoo";
---
<style is:inline set:html={styles}></style>
<script is:inline data-destinations={JSON.stringify(destinations)} data-destination-headings="build" data-catalog={import.meta.env.PROD ? "/destination-headings.json" : undefined} set:html={script}></script>

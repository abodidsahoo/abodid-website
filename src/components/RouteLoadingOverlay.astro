<div
  class="route-loading-overlay"
  data-route-loading-overlay
  role="status"
  aria-live="polite"
  aria-hidden="true"
>
  <span class="route-loading-status">Opening page</span>
  <div class="route-loading-fallback-track" aria-hidden="true">
    <span data-route-loading-fallback-bar></span>
  </div>
</div>

<script is:inline>
  (() => {
    // Disabled route loading progress bar overlay
    document.documentElement.removeAttribute("data-route-loading");
    document.documentElement.removeAttribute("aria-busy");
  })();
</script>

<style is:global>
  .route-loading-overlay,
  .route-loading-fallback-track,
  [data-route-loading-fallback-bar] {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
</style>
</style>

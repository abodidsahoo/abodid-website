---
const {
  id = "enquiry",
  heading = "Tell me what you have in mind.",
  intro = "",
  sourceName = "home-next",
  defaultInterest = "",
  variant = "default",
} = Astro.props;

const interests = [
  "Creative direction and technology",
  "Exhibition documentation",
  "Event photography",
  "Editorial or fashion photography",
  "Obsidian tutoring",
  "Research workflow consulting",
  "Organisational vault design",
  "Visual Storytelling Masterclass",
  "Teaching, talks or collaboration",
  "Something else",
];
---

<section class={`inline-enquiry inline-enquiry--${variant}`} id={id} data-inline-enquiry>
  <div class="inline-enquiry__intro">
    <p class="inline-enquiry__eyebrow t-label">Enquiry</p>
    <h2 class="t-display">{heading}</h2>
    {intro && <p class="t-body">{intro}</p>}
    <a class="t-label" href="mailto:hello@abodid.com">Or email hello@abodid.com</a>
  </div>

  <form class="inline-enquiry__form" data-inline-enquiry-form data-source-name={sourceName}>
    <div class="inline-enquiry__field-row">
      <label>
        <span class="t-label">Name</span>
        <input class="t-body" name="name" type="text" autocomplete="name" maxlength="120" required />
      </label>
      <label>
        <span class="t-label">Email</span>
        <input class="t-body" name="email" type="email" autocomplete="email" maxlength="254" required />
      </label>
    </div>

    <label>
      <span class="t-label">I am interested in</span>
      <select class="t-body" name="interest" required>
        <option value="" selected={!defaultInterest} disabled>Choose one</option>
        {interests.map((interest) => <option value={interest} selected={defaultInterest === interest}>{interest}</option>)}
      </select>
    </label>

    <label>
      <span class="t-label">Message</span>
      <textarea
        class="t-body"
        name="message"
        rows="5"
        maxlength="4800"
        required
        placeholder="What are you making, organising, learning or documenting?"
      ></textarea>
    </label>

    <div class="inline-enquiry__submit-row">
      <button class="t-label" type="submit">Send enquiry</button>
      <p class="t-label" role="status" aria-live="polite" data-inline-enquiry-status></p>
    </div>
  </form>
</section>

<script is:inline>
  (() => {
    const initialiseForms = () => {
      document.querySelectorAll("[data-inline-enquiry-form]").forEach((form) => {
        if (!(form instanceof HTMLFormElement) || form.dataset.ready === "true") return;
        form.dataset.ready = "true";
        const status = form.querySelector("[data-inline-enquiry-status]");
        const submit = form.querySelector("button[type='submit']");

        const getTracking = () => ({
          sessionId: typeof window.__abodidAnalytics?.getSessionId === "function"
            ? window.__abodidAnalytics.getSessionId()
            : "",
          enquiryPath: window.location.pathname,
          sourceName: form.dataset.sourceName || "inline-enquiry",
          cta: "inline-enquiry",
        });

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (!(status instanceof HTMLElement) || !(submit instanceof HTMLButtonElement)) return;

          const formData = new FormData(form);
          const interest = String(formData.get("interest") || "").trim();
          const note = String(formData.get("message") || "").trim();
          const payload = {
            name: String(formData.get("name") || "").trim(),
            email: String(formData.get("email") || "").trim(),
            message: `${interest}\n\n${note}`.trim(),
            tracking: getTracking(),
          };

          const defaultLabel = submit.textContent || "Send enquiry";
          submit.disabled = true;
          submit.textContent = "Sending…";
          status.textContent = "";
          status.removeAttribute("data-state");

          try {
            if (typeof window.__abodidAnalytics?.prepareSubmission === "function") {
              await window.__abodidAnalytics.prepareSubmission();
              payload.tracking = getTracking();
            }

            const response = await fetch("/api/contact", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });
            const result = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(result.error || "I could not send this message yet.");

            form.reset();
            status.textContent = "Sent. I will get back to you soon.";
            status.dataset.state = "success";
          } catch (error) {
            status.textContent = error instanceof Error
              ? error.message
              : "I could not send this message. Please email hello@abodid.com.";
            status.dataset.state = "error";
          } finally {
            submit.disabled = false;
            submit.textContent = defaultLabel;
          }
        });
      });
    };

    initialiseForms();
    document.addEventListener("astro:page-load", initialiseForms);
  })();
</script>

<style>
  .inline-enquiry {
    scroll-margin-top: calc(var(--next-nav-height, 72px) + 1rem);
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(2rem, 7vw, 7rem);
    padding: clamp(2rem, 5vw, 5rem);
    border-radius: clamp(18px, 2vw, 30px);
    background: #171512;
    color: #f8f4ec;
  }

  .inline-enquiry__intro {
    align-self: start;
    position: sticky;
    top: calc(var(--next-nav-height, 72px) + 1.5rem);
  }

  .inline-enquiry__eyebrow {
    margin: 0 0 1rem !important;
    color: #ff6c65 !important;
    text-transform: uppercase;
  }

  .inline-enquiry h2 {
    margin: 0;
    max-width: 12ch;
  }

  .inline-enquiry__intro > p:not(.inline-enquiry__eyebrow) {
    max-width: 34rem;
    margin: 1.4rem 0 0;
    color: rgba(248, 244, 236, 0.68);
  }

  .inline-enquiry__intro > a {
    min-height: 48px;
    margin-top: 1rem;
    display: inline-flex;
    align-items: center;
    color: #f8f4ec;
    text-underline-offset: 0.25em;
  }

  .inline-enquiry__form {
    display: grid;
    gap: 1.1rem;
  }

  .inline-enquiry__field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .inline-enquiry label {
    display: grid;
    gap: 0.55rem;
  }

  .inline-enquiry label > span {
    color: rgba(248, 244, 236, 0.72);
  }

  .inline-enquiry input,
  .inline-enquiry select,
  .inline-enquiry textarea {
    width: 100%;
    min-height: 52px;
    box-sizing: border-box;
    border: 1px solid rgba(248, 244, 236, 0.22);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.055);
    color: #fff;
  }

  .inline-enquiry input,
  .inline-enquiry select {
    padding: 0 0.9rem;
  }

  .inline-enquiry textarea {
    min-height: 140px;
    padding: 0.85rem 0.9rem;
    resize: vertical;
  }

  .inline-enquiry select option {
    background: #171512;
  }

  .inline-enquiry input:focus,
  .inline-enquiry select:focus,
  .inline-enquiry textarea:focus {
    border-color: #ff6c65;
    outline: 2px solid rgba(255, 108, 101, 0.3);
    outline-offset: 2px;
  }

  .inline-enquiry__submit-row {
    min-height: 56px;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .inline-enquiry__submit-row button {
    min-width: 148px;
    min-height: 52px;
    padding: 0 1.2rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-brand-red, #a30021);
    color: #fff;
    cursor: pointer;
  }

  .inline-enquiry__submit-row button:disabled {
    cursor: progress;
    opacity: 0.7;
  }

  .inline-enquiry__submit-row p {
    margin: 0;
    color: rgba(248, 244, 236, 0.68);
  }

  .inline-enquiry__submit-row p[data-state="success"] { color: #a8e7b2; }
  .inline-enquiry__submit-row p[data-state="error"] { color: #ffaaa5; }

  .inline-enquiry--pop {
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #fff8e8;
    box-shadow: none;
    padding: 0;
    width: 100%;
    max-width: 1480px;
    margin-inline: auto;
    box-sizing: border-box;
  }

  .inline-enquiry--pop .inline-enquiry__eyebrow {
    color: #ffe44f !important;
  }

  .inline-enquiry--pop .inline-enquiry__intro > p:not(.inline-enquiry__eyebrow),
  .inline-enquiry--pop label > span,
  .inline-enquiry--pop .inline-enquiry__submit-row p {
    color: #fff8e8;
  }

  .inline-enquiry--pop input,
  .inline-enquiry--pop select,
  .inline-enquiry--pop textarea {
    border-color: #15130f;
    border-radius: 15px;
    background: #fff8e8;
    color: #15130f;
  }

  .inline-enquiry--pop textarea::placeholder {
    color: #5a534a;
    opacity: 1;
  }

  .inline-enquiry--pop input:focus,
  .inline-enquiry--pop select:focus,
  .inline-enquiry--pop textarea:focus {
    border-color: #ffe44f;
    outline-color: #fff8e8;
  }

  .inline-enquiry--pop select option {
    background: #fff8e8;
    color: #15130f;
  }

  .inline-enquiry--pop .inline-enquiry__submit-row button {
    border: 1px solid #15130f;
    background: #ffe44f;
    color: #15130f;
  }

  @media (max-width: 980px) {
    .inline-enquiry {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .inline-enquiry:not(.inline-enquiry--pop) {
      padding: 1.4rem;
    }

    .inline-enquiry__intro { position: static; }
    .inline-enquiry__field-row { grid-template-columns: 1fr; }
    .inline-enquiry__submit-row { align-items: flex-start; flex-direction: column; }
    .inline-enquiry__submit-row button { width: 100%; }
  }
</style>

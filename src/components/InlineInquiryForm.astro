---
const {
  id = "enquiry",
  heading = "Tell me what you have in mind.",
  intro = "",
  sourceName = "home-next",
  defaultInterest = "",
  variant = "default",
  interestOptions = [],
  compact = false,
  eyebrow = "Enquiry",
  messageLabel = "Message",
  messagePlaceholder = "What are you making, organising, learning or documenting?",
  submitLabel = "Send enquiry",
  showEmailLink = true,
} = Astro.props;

const defaultInterests = [
  "Creative direction and technology",
  "Exhibition documentation",
  "Event photography",
  "Editorial or fashion photography",
  "Obsidian tutoring",
  "Research workflow consulting",
  "Organisational vault design",
  "Visual Storytelling Masterclass",
  "Teaching, talks or collaboration",
  "Something else",
];

const interests = Array.isArray(interestOptions) && interestOptions.length
  ? interestOptions
  : defaultInterests;
---

<section class={`inline-enquiry inline-enquiry--${variant}`} id={id} data-inline-enquiry>
  <div class="inline-enquiry__intro">
    <p class="inline-enquiry__eyebrow t-label">{eyebrow}</p>
    <h2 class="t-display">{heading}</h2>
    {intro && <p class="t-body">{intro}</p>}
    {showEmailLink && <a class="t-label" href="mailto:hello@abodid.com">Or email hello@abodid.com</a>}
  </div>

  <form class="inline-enquiry__form" data-inline-enquiry-form data-source-name={sourceName}>
    <div class="inline-enquiry__field-row">
      <label>
        <span class="t-label">Name</span>
        <input class="t-body" name="name" type="text" autocomplete="name" maxlength="120" required />
      </label>
      <label>
        <span class="t-label">Email</span>
        <input class="t-body" name="email" type="email" autocomplete="email" maxlength="254" required />
      </label>
    </div>

    {
      compact ? (
        <input type="hidden" name="interest" value={defaultInterest || sourceName} />
      ) : (
        <div class="custom-select" data-custom-select>
          <label class="custom-select__label-wrap" id={`${id}-interest-label`}>
            <span class="t-label">I am interested in</span>
          </label>
          <select class="custom-select__native sr-only" name="interest" required tabindex="-1" aria-hidden="true">
            <option value="" selected={!defaultInterest} disabled>Choose one</option>
            {interests.map((interest) => <option value={interest} selected={defaultInterest === interest}>{interest}</option>)}
          </select>
          <div class="custom-select__control">
            <button
              type="button"
              class="custom-select__trigger t-body"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-labelledby={`${id}-interest-label`}
              data-custom-select-trigger
            >
              <span class={`custom-select__selected-text ${defaultInterest ? "has-value" : ""}`} data-custom-select-text>
                {defaultInterest || "Choose one"}
              </span>
              <span class="custom-select__chevron" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>
            <div class="custom-select__menu-wrap" data-custom-select-menu>
              <ul class="custom-select__options" role="listbox" aria-labelledby={`${id}-interest-label`}>
                {interests.map((interest) => (
                  <li
                    role="option"
                    class={`custom-select__option ${defaultInterest === interest ? "is-selected" : ""}`}
                    data-value={interest}
                    aria-selected={defaultInterest === interest ? "true" : "false"}
                    tabindex="-1"
                  >
                    <span class="custom-select__option-label">{interest}</span>
                    <span class="custom-select__option-icon" aria-hidden="true">✓</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      )
    }

    <label>
      <span class="t-label">{messageLabel}</span>
      <textarea
        class="t-body"
        name="message"
        rows={compact ? 3 : 5}
        maxlength="4800"
        required
        placeholder={messagePlaceholder}
      ></textarea>
    </label>

    <div class="inline-enquiry__submit-row">
      <button class="t-label" type="submit">{submitLabel}</button>
      <p class="t-label" role="status" aria-live="polite" data-inline-enquiry-status></p>
    </div>
  </form>
</section>

<script is:inline>
  (() => {
    const initialiseForms = () => {
      document.querySelectorAll("[data-custom-select]").forEach((container) => {
        if (!(container instanceof HTMLElement) || container.dataset.ready === "true") return;
        container.dataset.ready = "true";

        const trigger = container.querySelector("[data-custom-select-trigger]");
        const textSpan = container.querySelector("[data-custom-select-text]");
        const menuWrap = container.querySelector("[data-custom-select-menu]");
        const nativeSelect = container.querySelector("select");
        const options = Array.from(container.querySelectorAll(".custom-select__option"));
        const form = container.closest("form");

        if (!(trigger instanceof HTMLButtonElement) || !(nativeSelect instanceof HTMLSelectElement) || !(menuWrap instanceof HTMLElement)) return;

        let activeIndex = options.findIndex((opt) => opt.classList.contains("is-selected"));

        const openMenu = () => {
          container.classList.add("is-open");
          trigger.setAttribute("aria-expanded", "true");
          const selectedOption = options[activeIndex >= 0 ? activeIndex : 0];
          selectedOption?.scrollIntoView({ block: "nearest" });
        };

        const closeMenu = (focusTrigger = true) => {
          container.classList.remove("is-open");
          trigger.setAttribute("aria-expanded", "false");
          if (focusTrigger) trigger.focus();
        };

        const selectOption = (option, focusTrigger = true) => {
          const value = option.dataset.value || "";
          nativeSelect.value = value;
          nativeSelect.dispatchEvent(new Event("change", { bubbles: true }));
          if (textSpan) textSpan.textContent = value;
          textSpan?.classList.add("has-value");

          options.forEach((opt, idx) => {
            const isMatch = opt === option;
            opt.classList.toggle("is-selected", isMatch);
            opt.setAttribute("aria-selected", String(isMatch));
            if (isMatch) activeIndex = idx;
          });

          closeMenu(focusTrigger);
        };

        trigger.addEventListener("click", (e) => {
          e.preventDefault();
          container.classList.contains("is-open") ? closeMenu() : openMenu();
        });

        options.forEach((opt) => {
          opt.addEventListener("click", (e) => {
            e.stopPropagation();
            selectOption(opt);
          });
        });

        trigger.addEventListener("keydown", (e) => {
          if (e.key === "ArrowDown" || e.key === "ArrowUp" || e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            if (!container.classList.contains("is-open")) {
              openMenu();
            } else if (e.key === "ArrowDown") {
              activeIndex = (activeIndex + 1) % options.length;
              options[activeIndex]?.scrollIntoView({ block: "nearest" });
              options.forEach((o, i) => o.classList.toggle("is-focused", i === activeIndex));
            } else if (e.key === "ArrowUp") {
              activeIndex = (activeIndex - 1 + options.length) % options.length;
              options[activeIndex]?.scrollIntoView({ block: "nearest" });
              options.forEach((o, i) => o.classList.toggle("is-focused", i === activeIndex));
            } else if (e.key === "Enter" || e.key === " ") {
              if (options[activeIndex]) selectOption(options[activeIndex]);
            }
          } else if (e.key === "Escape" && container.classList.contains("is-open")) {
            e.preventDefault();
            closeMenu();
          }
        });

        const handleOutsideClick = (e) => {
          if (container.classList.contains("is-open") && !container.contains(e.target)) {
            closeMenu(false);
          }
        };

        document.addEventListener("click", handleOutsideClick, true);
        document.addEventListener("touchstart", handleOutsideClick, { capture: true, passive: true });

        if (form) {
          form.addEventListener("reset", () => {
            setTimeout(() => {
              if (textSpan) textSpan.textContent = "Choose one";
              textSpan?.classList.remove("has-value");
              options.forEach((opt) => {
                opt.classList.remove("is-selected", "is-focused");
                opt.setAttribute("aria-selected", "false");
              });
              activeIndex = -1;
            }, 0);
          });
        }
      });

      document.querySelectorAll("[data-inline-enquiry-form]").forEach((form) => {
        if (!(form instanceof HTMLFormElement) || form.dataset.ready === "true") return;
        form.dataset.ready = "true";
        const status = form.querySelector("[data-inline-enquiry-status]");
        const submit = form.querySelector("button[type='submit']");

        const getTracking = () => ({
          sessionId: typeof window.__abodidAnalytics?.getSessionId === "function"
            ? window.__abodidAnalytics.getSessionId()
            : "",
          enquiryPath: window.location.pathname,
          sourceName: form.dataset.sourceName || "inline-enquiry",
          cta: "inline-enquiry",
        });

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (!(status instanceof HTMLElement) || !(submit instanceof HTMLButtonElement)) return;

          const formData = new FormData(form);
          const interest = String(formData.get("interest") || "").trim();
          const note = String(formData.get("message") || "").trim();
          const payload = {
            name: String(formData.get("name") || "").trim(),
            email: String(formData.get("email") || "").trim(),
            message: `${interest}\n\n${note}`.trim(),
            tracking: getTracking(),
          };

          const defaultLabel = submit.textContent || "Send enquiry";
          submit.disabled = true;
          submit.textContent = "Sending…";
          status.textContent = "";
          status.removeAttribute("data-state");

          try {
            if (typeof window.__abodidAnalytics?.prepareSubmission === "function") {
              await window.__abodidAnalytics.prepareSubmission();
              payload.tracking = getTracking();
            }

            const response = await fetch("/api/contact", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });
            const result = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(result.error || "I could not send this message yet.");

            form.reset();
            status.textContent = "Sent. I will get back to you soon.";
            status.dataset.state = "success";
          } catch (error) {
            status.textContent = error instanceof Error
              ? error.message
              : "I could not send this message. Please email hello@abodid.com.";
            status.dataset.state = "error";
          } finally {
            submit.disabled = false;
            submit.textContent = defaultLabel;
          }
        });
      });
    };

    initialiseForms();
    document.addEventListener("astro:page-load", initialiseForms);
  })();
</script>

<style>
  .inline-enquiry {
    scroll-margin-top: calc(var(--next-nav-height, 72px) + 1rem);
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(2rem, 7vw, 7rem);
    padding: clamp(2rem, 5vw, 5rem);
    border-radius: clamp(18px, 2vw, 30px);
    background: #171512;
    color: #f8f4ec;
  }

  .inline-enquiry__intro {
    align-self: start;
    position: sticky;
    top: calc(var(--next-nav-height, 72px) + 1.5rem);
  }

  .inline-enquiry__eyebrow {
    margin: 0 0 1rem !important;
    color: #ff6c65 !important;
    text-transform: uppercase;
  }

  .inline-enquiry h2 {
    margin: 0;
    max-width: 12ch;
  }

  .inline-enquiry__intro > p:not(.inline-enquiry__eyebrow) {
    max-width: 34rem;
    margin: 1.4rem 0 0;
    color: rgba(248, 244, 236, 0.68);
  }

  .inline-enquiry__intro > a {
    min-height: 48px;
    margin-top: 1rem;
    display: inline-flex;
    align-items: center;
    color: #f8f4ec;
    text-underline-offset: 0.25em;
  }

  .inline-enquiry__form {
    display: grid;
    gap: 1.1rem;
  }

  .inline-enquiry__field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .inline-enquiry label {
    display: grid;
    gap: 0.55rem;
  }

  .inline-enquiry label > span {
    color: rgba(248, 244, 236, 0.72);
  }

  .inline-enquiry input,
  .inline-enquiry select,
  .inline-enquiry textarea {
    width: 100%;
    min-height: 52px;
    box-sizing: border-box;
    border: 1px solid rgba(248, 244, 236, 0.22);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.055);
    color: #fff;
  }

  .inline-enquiry input,
  .inline-enquiry select {
    padding: 0 0.9rem;
  }

  .custom-select {
    position: relative;
    display: grid;
    gap: 0.55rem;
    width: 100%;
  }

  .custom-select__control {
    position: relative;
    width: 100%;
  }

  .custom-select__native {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .custom-select__trigger {
    width: 100%;
    min-height: 52px;
    padding: 0 1rem;
    box-sizing: border-box;
    border: 1px solid rgba(248, 244, 236, 0.22);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.055);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 500;
    transition: border-color 160ms ease, box-shadow 160ms ease;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .custom-select__trigger:focus-visible {
    border-color: #ff6c65;
    outline: 2px solid rgba(255, 108, 101, 0.3);
    outline-offset: 2px;
  }

  .custom-select__selected-text {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0.7;
  }

  .custom-select__selected-text.has-value {
    opacity: 1;
  }

  .custom-select__chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: currentColor;
    opacity: 0.75;
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
  }

  .custom-select.is-open .custom-select__chevron {
    transform: rotate(180deg);
  }

  .custom-select__menu-wrap {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    z-index: 10000;
    opacity: 0;
    transform: translateY(-6px) scale(0.985);
    transform-origin: top center;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 180ms ease, transform 180ms cubic-bezier(0.16, 1, 0.3, 1), visibility 180ms;
  }

  .custom-select.is-open .custom-select__menu-wrap {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    visibility: visible;
  }

  .custom-select__options {
    margin: 0;
    padding: 6px;
    list-style: none;
    max-height: 320px;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: 16px;
    background: #23201b;
    border: 1px solid rgba(248, 244, 236, 0.22);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    display: grid;
    gap: 3px;
    scrollbar-width: thin;
    scrollbar-color: rgba(248, 244, 236, 0.25) transparent;
  }

  .custom-select__options::-webkit-scrollbar {
    width: 4px;
  }
  .custom-select__options::-webkit-scrollbar-thumb {
    background: rgba(248, 244, 236, 0.25);
    border-radius: 4px;
  }

  .custom-select__option {
    min-height: 44px;
    padding: 0.65rem 0.95rem;
    border-radius: 10px;
    color: #f8f4ec;
    font-family: inherit;
    font-size: 0.96rem;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    transition: background 140ms ease, color 140ms ease, transform 140ms ease;
    user-select: none;
  }

  .custom-select__option:hover,
  .custom-select__option.is-focused {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    transform: translateX(2px);
  }

  .custom-select__option.is-selected {
    background: #ff6c65;
    color: #fff;
    font-weight: 600;
    transform: none;
  }

  .custom-select__option-icon {
    display: none;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .custom-select__option.is-selected .custom-select__option-icon {
    display: inline-block;
  }

  .inline-enquiry textarea {
    min-height: 140px;
    padding: 0.85rem 0.9rem;
    resize: vertical;
  }

  .inline-enquiry select option {
    background: #171512;
  }

  .inline-enquiry input:focus,
  .inline-enquiry select:focus,
  .inline-enquiry textarea:focus {
    border-color: #ff6c65;
    outline: 2px solid rgba(255, 108, 101, 0.3);
    outline-offset: 2px;
  }

  .inline-enquiry__submit-row {
    min-height: 56px;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .inline-enquiry__submit-row button {
    min-width: 148px;
    min-height: 52px;
    padding: 0 1.2rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-brand-red, #a30021);
    color: #fff;
    cursor: pointer;
  }

  .inline-enquiry__submit-row button:disabled {
    cursor: progress;
    opacity: 0.7;
  }

  .inline-enquiry__submit-row p {
    margin: 0;
    color: rgba(248, 244, 236, 0.68);
  }

  .inline-enquiry__submit-row p[data-state="success"] { color: #a8e7b2; }
  .inline-enquiry__submit-row p[data-state="error"] { color: #ffaaa5; }

  .inline-enquiry--pop {
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #fff8e8;
    box-shadow: none;
    padding: 0;
    width: 100%;
    max-width: 1480px;
    margin-inline: auto;
    box-sizing: border-box;
  }

  .inline-enquiry--pop .inline-enquiry__eyebrow {
    color: #ffe44f !important;
  }

  .inline-enquiry--pop .inline-enquiry__intro > p:not(.inline-enquiry__eyebrow),
  .inline-enquiry--pop label > span,
  .inline-enquiry--pop .custom-select__label-wrap > span,
  .inline-enquiry--pop .inline-enquiry__submit-row p {
    color: #fff8e8;
  }

  .inline-enquiry--pop input,
  .inline-enquiry--pop select,
  .inline-enquiry--pop textarea {
    border-color: #15130f;
    border-radius: 15px;
    background: #fff8e8;
    color: #15130f;
  }

  .inline-enquiry--pop textarea::placeholder {
    color: #5a534a;
    opacity: 1;
  }

  .inline-enquiry--pop input:focus,
  .inline-enquiry--pop select:focus,
  .inline-enquiry--pop textarea:focus {
    border-color: #ffe44f;
    outline-color: #fff8e8;
  }

  .inline-enquiry--pop .custom-select__trigger {
    border: 1.5px solid #15130f;
    border-radius: 15px;
    background: #fff8e8;
    color: #15130f;
    font-size: 1.05rem;
    font-weight: 520;
    box-shadow: 0 2px 0 rgba(21, 19, 15, 0.12);
  }

  .inline-enquiry--pop .custom-select__trigger:focus-visible,
  .inline-enquiry--pop .custom-select.is-open .custom-select__trigger {
    border-color: #15130f;
    outline: none;
    box-shadow: 0 0 0 3px rgba(255, 228, 79, 0.8), 0 2px 0 rgba(21, 19, 15, 0.12);
  }

  .inline-enquiry--pop .custom-select__selected-text {
    opacity: 0.65;
    color: #15130f;
  }

  .inline-enquiry--pop .custom-select__selected-text.has-value {
    opacity: 1;
  }

  .inline-enquiry--pop .custom-select__options {
    background: #fff8e8;
    border: 2px solid #15130f;
    border-radius: 18px;
    box-shadow: 0 16px 40px rgba(21, 19, 15, 0.22);
    scrollbar-color: rgba(21, 19, 15, 0.3) transparent;
  }

  .inline-enquiry--pop .custom-select__options::-webkit-scrollbar-thumb {
    background: rgba(21, 19, 15, 0.3);
  }

  .inline-enquiry--pop .custom-select__option {
    color: #15130f;
    font-size: 1rem;
    font-weight: 520;
    border-radius: 12px;
  }

  .inline-enquiry--pop .custom-select__option:hover,
  .inline-enquiry--pop .custom-select__option.is-focused {
    background: #ffe44f;
    color: #15130f;
    transform: translateX(3px);
  }

  .inline-enquiry--pop .custom-select__option.is-selected {
    background: #15130f;
    color: #fff8e8;
    font-weight: 650;
    transform: none;
  }

  .inline-enquiry--pop .custom-select__option.is-selected .custom-select__option-icon {
    color: #ffe44f;
  }

  .inline-enquiry--pop .inline-enquiry__submit-row button {
    border: 1px solid #15130f;
    background: #ffe44f;
    color: #15130f;
  }

  .inline-enquiry--obsidian {
    grid-template-columns: minmax(15rem, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(1.25rem, 4vw, 3.5rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    color: var(--text-primary);
  }

  .inline-enquiry--obsidian .inline-enquiry__intro {
    position: static;
  }

  .inline-enquiry--obsidian .inline-enquiry__eyebrow {
    margin-bottom: 0.65rem !important;
    color: var(--accent-primary) !important;
  }

  .inline-enquiry--obsidian h2 {
    max-width: 11ch;
    font-size: clamp(1.7rem, 3vw, 2.55rem);
    line-height: 0.98;
  }

  .inline-enquiry--obsidian .inline-enquiry__form {
    gap: 0.8rem;
  }

  .inline-enquiry--obsidian label > span,
  .inline-enquiry--obsidian .inline-enquiry__submit-row p {
    color: var(--text-secondary);
  }

  .inline-enquiry--obsidian input,
  .inline-enquiry--obsidian textarea {
    border-color: var(--border-subtle);
    border-radius: var(--radius-base);
    background: var(--bg-canvas);
    color: var(--text-primary);
  }

  .inline-enquiry--obsidian textarea {
    min-height: 88px;
  }

  .inline-enquiry--obsidian input:focus,
  .inline-enquiry--obsidian textarea:focus {
    border-color: var(--accent-primary);
    outline-color: color-mix(in srgb, var(--accent-primary) 35%, transparent);
  }

  .inline-enquiry--obsidian .inline-enquiry__submit-row {
    min-height: 48px;
  }

  .inline-enquiry--obsidian .inline-enquiry__submit-row button {
    min-height: 48px;
    border-radius: var(--radius-base);
    background: var(--btn-primary-bg);
    color: var(--btn-primary-text);
  }

  @media (max-width: 980px) {
    .inline-enquiry {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .inline-enquiry:not(.inline-enquiry--pop) {
      padding: 1.4rem;
    }


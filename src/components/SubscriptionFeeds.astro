---
import { SUBSCRIPTION_FEEDS, feedUrl, readerLinks } from '../lib/subscriptions/catalog.js';
const { prefix = 'subscribe' } = Astro.props;
---
<div class="subscription-feeds" data-subscription-feeds>
  <ol class="subscription-feed-list">
    {SUBSCRIPTION_FEEDS.map((feed, index) => {
      const url = feedUrl(feed, String(Astro.site || 'https://abodid.com'));
      const readers = readerLinks(url);
      const heading = `${prefix}-${feed.id}`;
      return <li class:list={['subscription-feed', { 'subscription-feed--primary': index === 0 }]}>
        <div class="subscription-feed-copy">
          {index === 0 && <span class="subscription-feed-kicker">The complete collection</span>}
          <h2 id={heading}>{feed.title}</h2>
          <p>{feed.description}</p>
        </div>
        <div class="subscription-feed-actions">
          <label for={`${heading}-url`}>Feed URL for {feed.title}</label>
          <div class="subscription-feed-url">
            <input id={`${heading}-url`} type="text" inputmode="url" value={url} readonly spellcheck="false" />
            <button type="button" data-copy-feed={url} data-feed-title={feed.title} aria-label={`Copy URL for ${feed.title}`} hidden>Copy URL</button>
            <span class="subscription-copy-feedback" data-copy-feedback aria-hidden="true"></span>
          </div>
          <nav aria-label={`Subscribe to ${feed.title}`}>
            <a href={feed.path} data-astro-reload data-astro-prefetch="false">Open RSS<span class="subscription-sr-only"> for {feed.title}</span></a>
            <a href={readers.feedly} target="_blank" rel="noopener noreferrer">Feedly<span class="subscription-sr-only">: {feed.title} (new tab)</span></a>
            <a href={readers.inoreader} target="_blank" rel="noopener noreferrer">Inoreader<span class="subscription-sr-only">: {feed.title} (new tab)</span></a>
          </nav>
        </div>
      </li>;
    })}
  </ol>
  <p class="subscription-copy-status" role="status" aria-atomic="true" data-copy-status></p>
</div>

<script>
  function initFeedCopy() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-feed]').forEach((button) => {
      if (button.dataset.ready) return;
      button.dataset.ready = 'true';
      button.hidden = false;
      button.addEventListener('click', async () => {
        const root = button.closest('[data-subscription-feeds]');
        const status = root?.querySelector<HTMLElement>('[data-copy-status]');
        const input = button.parentElement?.querySelector('input');
        const feedback = button.parentElement?.querySelector<HTMLElement>('[data-copy-feedback]');
        try {
          await navigator.clipboard.writeText(button.dataset.copyFeed || '');
          if (status) status.textContent = `${button.dataset.feedTitle} feed URL copied.`;
          if (feedback) feedback.textContent = 'Copied';
        } catch {
          input?.focus();
          input?.select();
          if (status) status.textContent = 'Copy is unavailable. The feed URL is selected; use your device’s Copy command.';
          if (feedback) feedback.textContent = 'URL selected';
        }
      });
    });
  }
  initFeedCopy();
  document.addEventListener('astro:page-load', initFeedCopy);
</script>

<style is:global>
  .subscription-feed-list { list-style: none; margin: 0; padding: 0; }
  .subscription-feed { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; padding: 1.5rem; border: 1px solid var(--ui-border); margin-block-start: -1px; background: var(--color-background); color: var(--color-text); }
  .subscription-feed--primary { background: var(--color-primary); color: var(--color-primary-text); border-color: currentColor; }
  .subscription-feed-kicker { display: block; font-family: var(--font-mono); font-size: .875rem; margin-block-end: .5rem; }
  .subscription-feed h2 { font-family: var(--font-display); font-size: 1.5rem; letter-spacing: -.03em; line-height: 1.1; margin: 0 0 .5rem; color: inherit; }
  .subscription-feed p { font-size: 1rem; line-height: 1.5; margin: 0; color: inherit; }
  .subscription-feed-actions { min-width: 0; }
  .subscription-feed-actions label { display: block; font-size: .875rem; margin-block-end: .35rem; }
  .subscription-feed-url { display: flex; flex-wrap: wrap; gap: .5rem; }
  .subscription-feed-url input { width: 100%; min-width: 0; min-height: 2.75rem; padding: .5rem; border: 1px solid currentColor; border-radius: var(--design-radius-control, 0); font: .875rem var(--font-mono); background: var(--ui-field-bg); color: var(--ui-field-text); }
  .subscription-feed-url button { min-height: 2.75rem; padding: .5rem 1rem; border: 1px solid var(--ui-button-text); border-radius: var(--design-radius-control, 0); background: var(--ui-button-bg); color: var(--ui-button-text); font: inherit; cursor: pointer; }
  .subscription-feed-url button:hover { background: var(--ui-button-hover-bg); }
  .subscription-feed-url button:active { background: var(--ui-button-active-bg); }
  .subscription-copy-feedback { align-self: center; font-size: .875rem; }
  .subscription-feed-actions nav { display: flex; flex-wrap: wrap; gap: .25rem 1rem; margin-block-start: .5rem; }
  .subscription-feed-actions a { display: inline-flex; align-items: center; min-height: 2.75rem; color: inherit; text-decoration: underline; text-underline-offset: .2em; font-size: .875rem; }
  .subscription-feeds :is(a, button, input):focus-visible { outline: 3px solid currentColor; outline-offset: 3px; }
  .subscription-copy-status { min-height: 1.5em; font-size: .875rem; line-height: 1.5; margin: 1rem 0 0; }
  .subscription-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 40rem) { .subscription-feed { grid-template-columns: 1fr; gap: 1rem; padding: 1.25rem; } }
</style>

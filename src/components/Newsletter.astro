---
interface Props {
    showName?: boolean;
    nameRequired?: boolean;
    buttonLabel?: string;
    source?: string;
    variant?: "compact" | "editorial" | "postcard";
    labelledBy?: string;
    idPrefix?: string;
}

const {
    showName = false,
    nameRequired = false,
    buttonLabel = "",
    source = "footer-newsletter",
    variant = "compact",
    labelledBy,
    idPrefix = "newsletter",
} = Astro.props;
const editorial = variant === "editorial";
const postcard = variant === "postcard";
---

<newsletter-signup
    class:list={["newsletter-form-wrapper", `newsletter-form-wrapper--${variant}`]}
    data-newsletter-inline-form
>
    <form
        class="newsletter-form"
        id={`${idPrefix}-form`}
        method="post"
        action="/api/subscribe"
        data-astro-reload
        aria-labelledby={labelledBy}
    >
        <input type="hidden" name="source" value={source} />
        <div class="newsletter-honeypot" aria-hidden="true">
            <label for={`${idPrefix}-company`}>Company</label>
            <input
                id={`${idPrefix}-company`}
                type="text"
                name="company"
                tabindex="-1"
                autocomplete="off"
            />
        </div>
        {
            showName && (
                <div class="newsletter-field">
                    {editorial && <label for={`${idPrefix}-name`}>Your name</label>}
                    <input
                        class="t-body"
                        id={`${idPrefix}-name`}
                        type="text"
                        name="name"
                        placeholder={editorial ? undefined : "Your name"}
                        aria-label={editorial ? undefined : "Name"}
                        autocomplete="name"
                        required={nameRequired}
                    />
                </div>
            )
        }
        <div class:list={["newsletter-field", { "newsletter-field--full": !showName }]}>
            <label for={`${idPrefix}-email`} class:list={{ "sr-only": !editorial && !postcard }}>Email address</label>
            <input
                class="t-body"
                id={`${idPrefix}-email`}
                type="email"
                name="email"
                placeholder={editorial ? undefined : postcard ? "you@example.com" : "Your email address"}
                autocomplete="email"
                required
            />
        </div>
        <button type="submit" aria-label={buttonLabel || "Subscribe"} disabled>
            {
                buttonLabel ? (
                    <><span>{buttonLabel}</span>{postcard && <span aria-hidden="true">→</span>}</>
                ) : (
                    <svg
                        class="arrow-icon"
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                )
            }
        </button>
    </form>
    <p class="message t-label" id={`${idPrefix}-message`} role="status"></p>
    <noscript>Enable JavaScript to subscribe.</noscript>
</newsletter-signup>

<script>
    const trackGaEvent = (eventName, params = {}) => {
        try {
            if (typeof window.gtag === "function") {
                window.gtag("event", eventName, params);
            }
        } catch (_error) {
            // no-op
        }
    };

    const getJourneyTracking = () => {
        try {
            if (
                window.__abodidAnalytics &&
                typeof window.__abodidAnalytics.getSessionId === "function"
            ) {
                return { sessionId: window.__abodidAnalytics.getSessionId() };
            }
        } catch (_error) {
            // no-op
        }

        return { sessionId: "" };
    };

    class NewsletterSignup extends HTMLElement {
        connectedCallback() {
            const form = this.querySelector("form");
            const button = form?.querySelector("button");
            const message = this.querySelector<HTMLElement>('[role="status"]');
            if (!form || !button || !message) return;

            const formRenderedAt = Date.now();
            button.disabled = false;
            form.onsubmit = async event => {
                event.preventDefault();
                if (button.disabled) return;
                button.disabled = true;
                button.classList.add("loading");
                message.classList.remove("success", "error");
                message.textContent = "Subscribing…";

                const formData = new FormData(form);
                formData.set("jsEnabled", "1");
                formData.set("formStartedAt", String(formRenderedAt));

                try {
                    await window.__abodidAnalytics?.prepareSubmission?.();
                    formData.set("tracking", JSON.stringify(getJourneyTracking()));
                    const response = await fetch(form.action, { method: "POST", body: formData });
                    const data = await response.json();
                    message.textContent = data.message;
                    message.classList.add(response.ok ? "success" : "error");

                    if (response.ok) {
                        form.reset();
                        trackGaEvent("sign_up", {
                            method: "newsletter",
                            source_page: window.location.pathname,
                            destination_page: window.location.pathname,
                        });
                    }
                } catch {
                    message.textContent = "Something went wrong. Please try again.";
                    message.classList.add("error");
                } finally {
                    button.disabled = false;
                    button.classList.remove("loading");
                }
            };
        }
    }
    if (!customElements.get("newsletter-signup")) customElements.define("newsletter-signup", NewsletterSignup);
</script>

<style>
    .newsletter-form-wrapper {
        display: block;
        margin-top: 0.5rem;
        width: 100%;
        max-width: 350px;
    }

    .newsletter-form-wrapper--postcard {
        --postcard-action-bg: var(--site-palette-ink, var(--ui-button-bg));
        --postcard-action-fg: var(--site-palette-paper, var(--ui-button-text));
        width: 100%;
        max-width: 28rem;
        margin-block: 0;
    }

    .newsletter-form-wrapper--postcard .newsletter-form {
        display: grid;
        justify-items: stretch;
        width: 100%;
        gap: .75rem;
        border: 0;
        border-radius: 0;
        overflow: visible;
        background: transparent;
    }

    .newsletter-form-wrapper--postcard .newsletter-field {
        width: 100%;
    }

    .newsletter-form-wrapper--postcard label {
        display: block;
        margin-block-end: .4rem;
        font: var(--type-role-label-font);
        letter-spacing: var(--type-role-label-track);
    }

    .newsletter-form-wrapper--postcard input[type="email"] {
        width: 100%;
        min-height: 48px;
        padding: .75rem 1rem;
        border: 1px solid var(--ui-border-strong);
        border-radius: var(--design-radius-control, 4px);
        background: var(--ui-field-bg);
        color: var(--ui-field-text);
        font: var(--type-role-ui-font);
        letter-spacing: var(--type-role-ui-track);
    }

    .newsletter-form-wrapper--postcard button {
        width: 100%;
        min-height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .65rem;
        padding: .75rem 1.25rem;
        border: 1px solid transparent;
        border-radius: var(--design-radius-control, 4px);
        background: var(--site-palette-ink, var(--ui-button-bg));
        color: var(--site-palette-paper, var(--ui-button-text));
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.2s ease, transform 0.15s ease;
        font: var(--type-role-ui-font);
        letter-spacing: var(--type-role-ui-track);
    }

    .newsletter-form-wrapper--postcard button:hover:enabled {
        opacity: 1;
        background: color-mix(in srgb, var(--postcard-action-bg) 92%, var(--postcard-action-fg));
    }

    .newsletter-form-wrapper--postcard button:active:enabled {
        background: color-mix(in srgb, var(--postcard-action-bg) 86%, var(--postcard-action-fg));
    }

    .newsletter-form-wrapper--postcard :is(input[type="email"], button):focus-visible {
        outline: 2px solid var(--ui-border-strong);
        outline-offset: 2px;
    }

    .newsletter-form {
        display: flex;
        align-items: stretch;
        background: transparent;
        border: 1px solid color-mix(in srgb, currentColor 45%, transparent);
        border-radius: 8px; /* Clean box */
        overflow: hidden;
        transition: all 0.3s ease;
        padding: 0;
        position: relative;
    }

    .newsletter-form:focus-within {
        border-color: inherit;
        background: color-mix(in srgb, var(--color-surface) 5%, transparent); /* Bit of glue/fill */
    }

    .newsletter-form-wrapper--compact .newsletter-field {
        display: contents;
    }

    :where(.newsletter-form-wrapper--compact) input {
        flex: 1;
        background: transparent;
        border: none;
        border-radius: 0;
        padding: 0.8rem 1rem;
        color: inherit;
        outline: none;
        min-width: 0; /* Prevent overflow */
    }

    input::placeholder {
        color: color-mix(in srgb, currentColor 78%, transparent);
    }

    :where(.newsletter-form-wrapper--compact) input:-webkit-autofill,
    :where(.newsletter-form-wrapper--compact) input:-webkit-autofill:hover,
    :where(.newsletter-form-wrapper--compact) input:-webkit-autofill:focus,
    :where(.newsletter-form-wrapper--compact) input:-webkit-autofill:active {
        -webkit-box-shadow: 0 0 0 1000px color-mix(in srgb, var(--color-surface) 8%, transparent) inset;
        box-shadow: 0 0 0 1000px color-mix(in srgb, var(--color-surface) 8%, transparent) inset;
        -webkit-text-fill-color: inherit;
        caret-color: inherit;
        transition: background-color 5000s ease-in-out 0s;
    }

    .newsletter-honeypot {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        overflow: hidden;
        opacity: 0;
        pointer-events: none;
    }

    button {
        background: transparent;
        border: none;
        color: inherit;
        cursor: pointer;
        padding: 0.8rem 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.3s ease;
    }

    button:hover {
        opacity: 0.8;
    }

    /* Animated Arrow logic */
    .arrow-icon {
        display: block;
        animation: arrowMove 2s infinite ease-in-out;
    }

    @keyframes arrowMove {
        0%,
        100% {
            transform: translateX(0);
        }
        50% {
            transform: translateX(3px); /* Subtle right movement */
        }
    }

    button.loading .arrow-icon {
        animation: none;
        opacity: 0.5;
    }

    .message {
        margin-top: 0.35rem;
        min-height: 1.1em; /* Keep slight reserved space when message exists */
        transition: all 0.3s ease;
    }

    .message:empty {
        margin: 0;
        min-height: 0;
    }

    .message.success {
        color: var(--ui-success-text);
    }
    .message.error {
        color: var(--ui-error-text);
    }

    /* LIGHT MODE OVERRIDES */
    :global([data-theme="light"]) :where(.newsletter-form-wrapper--compact) .newsletter-form {
        border-color: color-mix(in srgb, var(--ui-shadow-color) 20%, transparent);
        background: color-mix(in srgb, currentColor 78%, transparent);
    }
    :global([data-theme="light"]) :where(.newsletter-form-wrapper--compact) .newsletter-form:focus-within {
        border-color: var(--color-text);
        background: color-mix(in srgb, var(--ui-shadow-color) 5%, transparent);
    }
    :global([data-theme="light"]) :where(.newsletter-form-wrapper--compact) input {
        color: var(--color-text);
        font-weight: var(--type-weight-regular);
    }
    :global([data-theme="light"]) :where(.newsletter-form-wrapper--compact) input::placeholder {
        color: color-mix(in srgb, currentColor 78%, transparent);
    }
    :global([data-theme="light"]) :where(.newsletter-form-wrapper--compact) input:-webkit-autofill,
    :global([data-theme="light"]) :where(.newsletter-form-wrapper--compact) input:-webkit-autofill:hover,
    :global([data-theme="light"]) :where(.newsletter-form-wrapper--compact) input:-webkit-autofill:focus,
    :global([data-theme="light"]) :where(.newsletter-form-wrapper--compact) input:-webkit-autofill:active {
        -webkit-box-shadow: 0 0 0 1000px color-mix(in srgb, var(--color-surface) 90%, transparent) inset !important;
        box-shadow: 0 0 0 1000px color-mix(in srgb, var(--color-surface) 90%, transparent) inset !important;
        -webkit-text-fill-color: currentColor !important;
        caret-color: currentColor !important;
    }
    :global([data-theme="light"]) :where(.newsletter-form-wrapper--compact) button {
        color: var(--color-text);
    }
    :global([data-theme="light"]) :where(.newsletter-form-wrapper--compact) .message {
        color: var(--color-text);
    }

    .newsletter-form-wrapper--editorial {
        container: newsletter / inline-size;
        max-width: none;
        margin: 0;
    }

    .newsletter-form-wrapper--editorial .newsletter-form {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 12px 8px;
        overflow: visible;
        border: 0;
        background: transparent;
    }

    @container newsletter (min-width: 26rem) {
        .newsletter-form-wrapper--editorial .newsletter-form {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    .newsletter-form-wrapper--editorial .newsletter-field {
        display: grid;
        gap: 4px;
        min-width: 0;
    }

    .newsletter-form-wrapper--editorial :is(.newsletter-field--full, button) {
        grid-column: 1 / -1;
    }

    .newsletter-form-wrapper--editorial .newsletter-field label {
        text-transform: uppercase;
        font: var(--type-role-label-font);
        letter-spacing: var(--type-role-label-track);
    }

    .newsletter-form-wrapper--editorial :is(.newsletter-field input, button) {
        box-sizing: border-box;
        width: 100%;
        min-height: 52px;
        padding: 0.75rem 1rem;
        border: 1px solid var(--ui-border-strong);
        border-radius: var(--design-radius-control, 14px);
    }

    .newsletter-form-wrapper--editorial .newsletter-field input {
        min-width: 0;
        background: var(--color-surface);
        color: var(--ui-field-text);
        font: var(--type-role-ui-font);
        letter-spacing: var(--type-role-ui-track);
    }

    .newsletter-form-wrapper--editorial .newsletter-field input:is(:autofill, :-webkit-autofill) {
        box-shadow: inset 0 0 0 2px var(--ui-border-strong);
    }

    .newsletter-form-wrapper--editorial button {
        background: var(--ui-button-bg);
        color: var(--ui-button-text);
        text-transform: uppercase;
        transition: background-color 160ms ease;
        font: var(--type-role-ui-font);
        letter-spacing: var(--type-role-ui-track);
    }

    .newsletter-form-wrapper--editorial button:hover {
        background: var(--ui-button-hover-bg);
        opacity: 1;
    }

    .newsletter-form-wrapper--editorial button:active {
        background: var(--ui-button-active-bg);
    }

    .newsletter-form-wrapper--editorial :is(.newsletter-field input, button):focus-visible {
        outline: 2px solid var(--ui-field-text);
        outline-offset: 2px;
    }
</style>

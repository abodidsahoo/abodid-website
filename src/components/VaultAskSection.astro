<section class="vault-ask-section" data-vault-ask>
    <form class="vault-ask-box" data-vault-form aria-describedby="vault-search-status vault-search-error">
        <textarea
            data-vault-input
            name="question"
            autocomplete="off"
            rows="1"
            required
            minlength="2"
            maxlength="800"
            placeholder="Ask Abodid's Vault anything..."
            aria-label="Ask Abodid's Vault anything"
        ></textarea>
        <button class="vault-ask-submit" data-vault-submit type="submit" disabled>
            <span>Ask</span>
        </button>
    </form>
    <noscript><p class="vault-ask-error">Enable JavaScript to ask the vault a question.</p></noscript>

    <div id="vault-search-status" class="vault-ask-status" data-vault-status role="status" aria-live="polite" hidden>
        <div class="vault-ask-status__inner">
            <span class="vault-ask-status__icon" aria-hidden="true">✦</span>
            <span class="vault-ask-status__text" data-vault-status-text>Browsing through Abodid's personal notes & journals</span>
            <span class="vault-ask-status__dots" aria-hidden="true">
                <span class="dot dot-1">.</span><span class="dot dot-2">.</span><span class="dot dot-3">.</span>
            </span>
        </div>
    </div>
    <p id="vault-search-error" class="vault-ask-error" data-vault-error role="alert" hidden></p>

    <article class="vault-result" data-vault-result aria-live="polite" hidden>
        <div class="vault-result__layout">
            <section class="vault-answer" data-vault-answer>
                <header class="vault-result__header">
                    <p class="vault-result__label">Answer from the vault</p>
                </header>
                <div class="vault-answer-text" data-vault-answer-text></div>
                <button
                    class="vault-answer-toggle"
                    data-vault-answer-toggle
                    type="button"
                    aria-expanded="false"
                    hidden
                >
                    <span data-vault-answer-toggle-label>Continue reading</span>
                    <span aria-hidden="true">↓</span>
                </button>
            </section>

            <aside class="vault-context-space" data-vault-context-space aria-label="Citation context">
                <section
                    id="vault-source-inspector"
                    class="vault-source-inspector"
                    data-vault-source-inspector
                    tabindex="-1"
                    aria-live="polite"
                    hidden
                >
                    <div class="vault-source-inspector__topline">
                        <p class="vault-source-inspector__label" data-inspector-label>Source</p>
                        <button
                            class="vault-source-inspector__close"
                            data-inspector-close
                            type="button"
                            aria-label="Close source preview"
                        >×</button>
                    </div>
                    <h3 data-inspector-title></h3>
                    <p class="vault-source-inspector__meta" data-inspector-meta></p>
                    <blockquote data-inspector-excerpt></blockquote>
                    <a class="vault-source-inspector__link" data-inspector-link href="#">
                        <span>Open note</span><span aria-hidden="true">↗</span>
                    </a>
                </section>
            </aside>
        </div>

        <details class="vault-bibliography" data-vault-sources hidden>
            <summary>
                <span data-vault-sources-label>Sources</span>
                <span class="vault-bibliography__count" data-vault-sources-count aria-hidden="true">00</span>
                <span class="vault-bibliography__arrow" aria-hidden="true">↓</span>
            </summary>
            <ol class="vault-source-list" data-vault-source-list></ol>
        </details>
    </article>
</section>

<script>
    import { marked } from "marked";

    (() => {
        const STORAGE_PREFIX = "vault-chat-state:";
        const ACTIVE_SEARCH_KEY = "vault-chat-active-search";
        const SAFE_MARKDOWN_TAGS = new Set([
            "A", "BLOCKQUOTE", "BR", "CODE", "DEL", "EM", "H1", "H2", "H3",
            "H4", "H5", "H6", "HR", "LI", "OL", "P", "PRE", "STRONG",
            "TABLE", "TBODY", "TD", "TH", "THEAD", "TR", "UL",
        ]);

        const sanitizeMarkdown = (html) => {
            const template = document.createElement("template");
            template.innerHTML = String(html || "");

            Array.from(template.content.querySelectorAll("*")).forEach((element) => {
                if (!SAFE_MARKDOWN_TAGS.has(element.tagName)) {
                    element.replaceWith(document.createTextNode(element.textContent || ""));
                    return;
                }

                Array.from(element.attributes).forEach((attribute) => {
                    if (element.tagName !== "A" || !["href", "title"].includes(attribute.name)) {
                        element.removeAttribute(attribute.name);
                    }
                });

                if (element.tagName !== "A") return;
                const href = (element.getAttribute("href") || "").trim();
                const isSafeHref =
                    href.startsWith("/") ||
                    href.startsWith("#") ||
                    /^https?:\/\//i.test(href) ||
                    /^mailto:/i.test(href);

                if (!isSafeHref) {
                    element.removeAttribute("href");
                    return;
                }

                if (/^https?:\/\//i.test(href)) {
                    try {
                        const url = new URL(href, window.location.origin);
                        if (url.origin !== window.location.origin) {
                            element.setAttribute("target", "_blank");
                            element.setAttribute("rel", "noopener noreferrer");
                        }
                    } catch {
                        element.removeAttribute("href");
                    }
                }
            });

            return template.content;
        };

        const createSearchId = () => {
            if (window.crypto?.randomUUID) return window.crypto.randomUUID();
            return `${Date.now()}-${Math.random().toString(36).slice(2)}`;
        };

        const getSearchIdFromUrl = () => {
            const params = new URLSearchParams(window.location.search);
            return params.get("vaultSearch") || "";
        };

        const updateSearchUrl = (searchId, replace = false) => {
            const url = new URL(window.location.href);
            url.searchParams.delete("question");
            url.searchParams.set("vaultSearch", searchId);
            const method = replace ? "replaceState" : "pushState";
            window.history[method]({ ...window.history.state, vaultSearch: searchId }, "", url);
        };

        const loadStoredState = (searchId) => {
            if (!searchId) return null;
            try {
                return JSON.parse(
                    sessionStorage.getItem(`${STORAGE_PREFIX}${searchId}`) || "null",
                );
            } catch {
                return null;
            }
        };

        const saveStoredState = (searchId, state) => {
            if (!searchId || !state) return;
            try {
                sessionStorage.setItem(
                    `${STORAGE_PREFIX}${searchId}`,
                    JSON.stringify({
                        ...state,
                        searchId,
                        savedAt: Date.now(),
                        scrollY: window.scrollY,
                    }),
                );
                sessionStorage.setItem(ACTIVE_SEARCH_KEY, searchId);
            } catch {
                // A full or blocked browser store must not turn a valid answer into an error.
            }
        };

        const initializeVaultAsk = () => document.querySelectorAll("[data-vault-ask]").forEach((root) => {
            if (root.dataset.initialized === "true") return;

            const form = root.querySelector("[data-vault-form]");
            const input = root.querySelector("[data-vault-input]");
            const submitButton = root.querySelector("[data-vault-submit]");
            const statusNode = root.querySelector("[data-vault-status]");
            const statusTextNode = root.querySelector("[data-vault-status-text]");
            const errorNode = root.querySelector("[data-vault-error]");
            const resultPanel = root.querySelector("[data-vault-result]");
            const answerPanel = root.querySelector("[data-vault-answer]");
            const answerText = root.querySelector("[data-vault-answer-text]");
            const answerToggle = root.querySelector("[data-vault-answer-toggle]");
            const answerToggleLabel = root.querySelector("[data-vault-answer-toggle-label]");
            const sourcesPanel = root.querySelector("[data-vault-sources]");
            const sourcesLabel = root.querySelector("[data-vault-sources-label]");
            const sourcesCount = root.querySelector("[data-vault-sources-count]");
            const sourceList = root.querySelector("[data-vault-source-list]");
            const resultLayout = root.querySelector(".vault-result__layout");
            const contextSpace = root.querySelector("[data-vault-context-space]");
            const sourceInspector = root.querySelector("[data-vault-source-inspector]");
            const inspectorLabel = root.querySelector("[data-inspector-label]");
            const inspectorTitle = root.querySelector("[data-inspector-title]");
            const inspectorMeta = root.querySelector("[data-inspector-meta]");
            const inspectorExcerpt = root.querySelector("[data-inspector-excerpt]");
            const inspectorLink = root.querySelector("[data-inspector-link]");
            const inspectorClose = root.querySelector("[data-inspector-close]");
            if (!form || !input || !submitButton) return;
            root.dataset.initialized = "true";

            const SEARCH_STATUS_MESSAGES = [
                "Browsing through Abodid's personal notes & journals",
                "Connecting related thoughts, essays, and ideas",
                "Distilling insights from the second brain",
                "Synthesizing references and citations for you",
            ];
            let statusInterval = null;
            let statusMessageIndex = 0;

            const updateStatusText = (text) => {
                if (!statusTextNode) return;
                statusTextNode.classList.add("is-switching");
                setTimeout(() => {
                    if (statusTextNode) {
                        statusTextNode.textContent = text;
                        statusTextNode.classList.remove("is-switching");
                    }
                }, 220);
            };

            const startStatusRotation = () => {
                stopStatusRotation();
                statusMessageIndex = 0;
                if (statusTextNode) {
                    statusTextNode.textContent = SEARCH_STATUS_MESSAGES[0];
                    statusTextNode.classList.remove("is-switching");
                }
                statusInterval = setInterval(() => {
                    statusMessageIndex = (statusMessageIndex + 1) % SEARCH_STATUS_MESSAGES.length;
                    updateStatusText(SEARCH_STATUS_MESSAGES[statusMessageIndex]);
                }, 2600);
            };

            const stopStatusRotation = () => {
                if (statusInterval) {
                    clearInterval(statusInterval);
                    statusInterval = null;
                }
            };

            const lifecycle = new AbortController();
            const listenerOptions = { signal: lifecycle.signal };
            let pendingRequest = null;
            const history = [];
            let activePayload = null;
            let activeQuestion = "";
            let activeSearchId = getSearchIdFromUrl();
            let citedCitationNumbers = new Set();
            let activeCitationButton = null;
            let pinnedCitationButton = null;
            let suppressNextCitationFocusPreview = false;
            let inspectorPositionFrame = 0;

            const sourceByCitation = new Map();

            const setLoading = (isLoading) => {
                if (submitButton) submitButton.disabled = isLoading;
                if (input) input.disabled = isLoading;
                if (statusNode) statusNode.hidden = !isLoading;
                if (isLoading) {
                    startStatusRotation();
                } else {
                    stopStatusRotation();
                }
                root.setAttribute("aria-busy", String(isLoading));
                root.classList.toggle("is-loading", isLoading);
            };

            const setError = (message) => {
                if (!errorNode) return;
                errorNode.textContent = message || "";
                errorNode.hidden = !message;
            };

            const resizeQuestionInput = () => {
                if (!input) return;
                input.style.height = "auto";
                input.style.height = `${input.scrollHeight}px`;
            };

            const clearSources = () => {
                if (sourceList) sourceList.replaceChildren();
                if (sourcesPanel) {
                    sourcesPanel.hidden = true;
                    sourcesPanel.open = false;
                }
                if (sourcesLabel) sourcesLabel.textContent = "Sources";
                if (sourcesCount) sourcesCount.textContent = "00";
            };

            const closeSourceInspector = ({ restoreFocus = false, clearPinned = true } = {}) => {
                if (!sourceInspector) return;
                const previousButton = activeCitationButton;
                if (previousButton) {
                    previousButton.classList.remove("is-active");
                    previousButton.setAttribute("aria-expanded", "false");
                }
                if (clearPinned && pinnedCitationButton) {
                    pinnedCitationButton.classList.remove("is-pinned");
                    pinnedCitationButton.setAttribute("aria-expanded", "false");
                    pinnedCitationButton = null;
                }
                activeCitationButton = null;
                sourceInspector.hidden = true;
                sourceInspector.classList.remove("is-fixed");
                sourceInspector.style.removeProperty("--vault-inspector-top");
                sourceInspector.style.removeProperty("--vault-inspector-left");
                sourceInspector.style.removeProperty("--vault-inspector-width");
                if (contextSpace && sourceInspector.parentElement !== contextSpace) {
                    contextSpace.appendChild(sourceInspector);
                }
                if (restoreFocus && previousButton) {
                    suppressNextCitationFocusPreview = true;
                    previousButton.focus();
                    window.requestAnimationFrame(() => {
                        suppressNextCitationFocusPreview = false;
                    });
                }
            };

            const clearResult = () => {
                closeSourceInspector();
                if (answerText) answerText.replaceChildren();
                if (answerPanel) {
                    answerPanel.classList.remove("is-collapsible", "is-expanded");
                }
                if (answerToggle) {
                    answerToggle.hidden = true;
                    answerToggle.setAttribute("aria-expanded", "false");
                    if (answerToggleLabel) answerToggleLabel.textContent = "Continue reading";
                    const arrow = answerToggle.querySelector("[aria-hidden='true']");
                    if (arrow) arrow.textContent = "↓";
                }
                clearSources();
                if (resultPanel) resultPanel.hidden = true;
            };

            const resetAnswerDisclosure = () => {
                if (!answerPanel || !answerText || !answerToggle) return;

                answerPanel.classList.remove("is-expanded");
                answerToggle.hidden = true;
                answerToggle.setAttribute("aria-expanded", "false");
                if (answerToggleLabel) answerToggleLabel.textContent = "Continue reading";
                const disclosureArrow = answerToggle.querySelector("[aria-hidden='true']");
                if (disclosureArrow) disclosureArrow.textContent = "↓";

                const meaningfulTags = new Set(["P", "UL", "OL", "BLOCKQUOTE", "TABLE", "PRE"]);
                const blocks = Array.from(answerText.children).filter((element) =>
                    element.textContent?.trim(),
                );
                let meaningfulCount = 0;
                let cutIndex = -1;

                blocks.forEach((block, index) => {
                    block.removeAttribute("data-vault-continuation");
                    block.hidden = false;
                    if (meaningfulTags.has(block.tagName)) meaningfulCount += 1;
                    if (meaningfulCount === 3 && cutIndex === -1) cutIndex = index + 1;
                });

                const continuation = cutIndex > 0 ? blocks.slice(cutIndex) : [];
                const hasMeaningfulContinuation = continuation.some((block) =>
                    meaningfulTags.has(block.tagName) && block.textContent?.trim(),
                );

                if (!hasMeaningfulContinuation) {
                    answerPanel.classList.remove("is-collapsible");
                    return;
                }

                continuation.forEach((block) => {
                    block.dataset.vaultContinuation = "true";
                    block.hidden = true;
                });
                answerPanel.classList.add("is-collapsible");
                answerToggle.hidden = false;
            };

            const makeSearchAwareHref = (href) => {
                if (!href || !activeSearchId) return href || "#";
                const url = new URL(href, window.location.origin);
                url.searchParams.set("fromVaultSearch", activeSearchId);
                return `${url.pathname}${url.search}${url.hash}`;
            };

            const attachSourceLinkHandler = (link) => {
                if (!link || link.dataset.searchHandlerAttached === "true") return;
                link.dataset.searchHandlerAttached = "true";
                link.addEventListener("click", () => {
                    if (!activeSearchId || !activePayload) return;
                    saveStoredState(activeSearchId, {
                        question: activeQuestion,
                        payload: activePayload,
                        history,
                    });
                });
            };

            const renderCitationPill = (citationNumber) => {
                const button = document.createElement("button");
                button.type = "button";
                button.className = "vault-citation";
                button.textContent = `[${citationNumber}]`;
                button.setAttribute("aria-label", `Show source ${citationNumber}`);
                button.setAttribute("aria-controls", "vault-source-inspector");
                button.setAttribute("aria-expanded", "false");
                button.dataset.citation = String(citationNumber);
                button.addEventListener("pointerenter", () => {
                    if (getEvidenceMode() !== "margin") return;
                    showSourceInspector(button);
                });
                button.addEventListener("pointerleave", () => {
                    if (getEvidenceMode() !== "margin" || pinnedCitationButton === button) return;
                    if (pinnedCitationButton) {
                        showSourceInspector(pinnedCitationButton, { pin: true });
                    } else if (activeCitationButton === button) {
                        closeSourceInspector({ clearPinned: false });
                    }
                });
                button.addEventListener("focus", () => {
                    if (suppressNextCitationFocusPreview) {
                        suppressNextCitationFocusPreview = false;
                        return;
                    }
                    if (getEvidenceMode() === "margin") showSourceInspector(button);
                });
                button.addEventListener("blur", () => {
                    if (getEvidenceMode() !== "margin" || pinnedCitationButton === button) return;
                    if (pinnedCitationButton) {
                        showSourceInspector(pinnedCitationButton, { pin: true });
                    } else if (activeCitationButton === button) {
                        closeSourceInspector({ clearPinned: false });
                    }
                });
                button.addEventListener("click", (event) => {
                    event.preventDefault();
                    showSourceInspector(button, {
                        moveFocus: event.detail === 0,
                        pin: true,
                    });
                });
                return button;
            };

            const renderAnswerText = (answer, sources) => {
                if (!answerText) return;
                answerText.replaceChildren();
                sourceByCitation.clear();
                citedCitationNumbers = new Set();

                (sources || []).forEach((source) => {
                    if (Number.isInteger(source.citation_number)) {
                        sourceByCitation.set(source.citation_number, source);
                    }
                });

                const renderedMarkdown = marked.parse(String(answer || ""), {
                    async: false,
                    breaks: true,
                    gfm: true,
                });
                answerText.appendChild(sanitizeMarkdown(renderedMarkdown));

                const textNodes = [];
                const walker = document.createTreeWalker(answerText, NodeFilter.SHOW_TEXT);
                let textNode = walker.nextNode();
                while (textNode) {
                    if (!textNode.parentElement?.closest("code, pre")) textNodes.push(textNode);
                    textNode = walker.nextNode();
                }

                textNodes.forEach((node) => {
                    const text = node.nodeValue || "";
                    const pattern = /\[(\d+)\]/g;
                    let cursor = 0;
                    let match = pattern.exec(text);
                    if (!match) return;

                    const fragment = document.createDocumentFragment();
                    while (match) {
                        if (match.index > cursor) {
                            fragment.appendChild(
                                document.createTextNode(text.slice(cursor, match.index)),
                            );
                        }

                        const citationNumber = Number.parseInt(match[1], 10);
                        if (sourceByCitation.has(citationNumber)) {
                            citedCitationNumbers.add(citationNumber);
                            fragment.appendChild(renderCitationPill(citationNumber));
                        } else {
                            fragment.appendChild(document.createTextNode(match[0]));
                        }

                        cursor = match.index + match[0].length;
                        match = pattern.exec(text);
                    }

                    if (cursor < text.length) {
                        fragment.appendChild(document.createTextNode(text.slice(cursor)));
                    }
                    node.replaceWith(fragment);
                });
            };

            const groupSources = (payload) => {
                const groups = new Map();
                (payload.sources || []).forEach((source) => {
                    if (!citedCitationNumbers.has(source.citation_number)) return;
                    const key = source.note_id || source.href || source.note_title;
                    if (!key) return;
                    if (!groups.has(key)) {
                        groups.set(key, {
                            note_title: source.note_title,
                            href: source.href,
                            headings: [],
                            citations: [],
                        });
                    }
                    const group = groups.get(key);
                    if (source.heading && !group.headings.includes(source.heading)) {
                        group.headings.push(source.heading);
                    }
                    if (
                        Number.isInteger(source.citation_number) &&
                        !group.citations.includes(source.citation_number)
                    ) {
                        group.citations.push(source.citation_number);
                    }
                });
                return Array.from(groups.values());
            };

            const renderSources = (payload) => {
                clearSources();
                if (!sourceList) return;

                const groups = groupSources(payload);
                if (!groups.length) return;

                const fragment = document.createDocumentFragment();

                groups.forEach((group, index) => {
                    const item = document.createElement("li");
                    item.className = "vault-source-row";

                    const indexNode = document.createElement("span");
                    indexNode.className = "vault-source-index";
                    indexNode.textContent = String(index + 1).padStart(2, "0");
                    indexNode.setAttribute("aria-hidden", "true");
                    item.appendChild(indexNode);

                    const sourceCopy = document.createElement("div");
                    sourceCopy.className = "vault-source-copy";

                    const link = document.createElement("a");
                    link.className = "vault-source-title";
                    link.href = makeSearchAwareHref(group.href);
                    link.textContent = group.note_title || "Untitled note";
                    attachSourceLinkHandler(link);
                    sourceCopy.appendChild(link);

                    const reference = document.createElement("span");
                    reference.className = "vault-source-reference";
                    reference.textContent = `Cited ${group.citations.map((number) => `[${number}]`).join(", ")}`;
                    sourceCopy.appendChild(reference);

                    item.appendChild(sourceCopy);

                    fragment.appendChild(item);
                });

                sourceList.appendChild(fragment);
                if (sourcesLabel) {
                    sourcesLabel.textContent = "Sources";
                }
                if (sourcesCount) sourcesCount.textContent = String(groups.length).padStart(2, "0");
                if (sourcesPanel) {
                    sourcesPanel.querySelector("summary")?.setAttribute(
                        "aria-label",
                        `Sources, ${groups.length} ${groups.length === 1 ? "note" : "notes"}`,
                    );
                }
                if (sourcesPanel) sourcesPanel.hidden = false;
            };

            const renderAnswer = (payload, question = activeQuestion) => {
                activePayload = payload;
                activeQuestion = question;
                renderAnswerText(payload.answer || "", payload.sources || []);
                renderSources(payload);
                if (answerPanel) answerPanel.hidden = false;
                if (resultPanel) resultPanel.hidden = false;
                resetAnswerDisclosure();
            };

            const getEvidenceMode = () => {
                if (!resultLayout) return "inline";
                return getComputedStyle(resultLayout)
                    .getPropertyValue("--vault-evidence-mode")
                    .trim() || "inline";
            };

            const getTopLevelAnswerBlock = (anchor) => {
                if (!answerText) return null;
                let block = anchor.parentElement;
                while (block && block.parentElement !== answerText) {
                    block = block.parentElement;
                }
                return block?.parentElement === answerText ? block : null;
            };

            const clearInspectorPositioning = () => {
                if (!sourceInspector) return;
                sourceInspector.classList.remove("is-fixed");
                sourceInspector.style.removeProperty("--vault-inspector-top");
                sourceInspector.style.removeProperty("--vault-inspector-left");
                sourceInspector.style.removeProperty("--vault-inspector-width");
            };

            const updateMarginInspectorPosition = () => {
                if (
                    !sourceInspector ||
                    !contextSpace ||
                    sourceInspector.hidden ||
                    getEvidenceMode() !== "margin"
                ) {
                    clearInspectorPositioning();
                    return;
                }

                const contextRect = contextSpace.getBoundingClientRect();
                const contextStyle = getComputedStyle(contextSpace);
                const paddingLeft = Number.parseFloat(contextStyle.paddingLeft) || 0;
                const paddingRight = Number.parseFloat(contextStyle.paddingRight) || 0;
                const inspectorHeight = sourceInspector.offsetHeight;
                const stickyTop = Math.min(112, Math.max(88, window.innerHeight * 0.09));
                const endBound = contextRect.bottom - inspectorHeight;
                const top = Math.max(contextRect.top, Math.min(stickyTop, endBound));
                const width = Math.min(480, contextRect.width - paddingLeft - paddingRight);

                sourceInspector.style.setProperty("--vault-inspector-top", `${Math.round(top)}px`);
                sourceInspector.style.setProperty("--vault-inspector-left", `${Math.round(contextRect.left + paddingLeft)}px`);
                sourceInspector.style.setProperty("--vault-inspector-width", `${Math.max(0, Math.round(width))}px`);
                sourceInspector.classList.add("is-fixed");
            };

            const requestInspectorPositionUpdate = () => {
                if (inspectorPositionFrame) return;
                inspectorPositionFrame = window.requestAnimationFrame(() => {
                    inspectorPositionFrame = 0;
                    updateMarginInspectorPosition();
                });
            };

            const placeSourceInspector = (anchor = activeCitationButton) => {
                if (!sourceInspector || !contextSpace) return;
                if (getEvidenceMode() === "margin") {
                    if (sourceInspector.parentElement !== contextSpace) {
                        contextSpace.appendChild(sourceInspector);
                    }
                    requestInspectorPositionUpdate();
                    return;
                }

                clearInspectorPositioning();
                const block = anchor ? getTopLevelAnswerBlock(anchor) : null;
                if (block) block.insertAdjacentElement("afterend", sourceInspector);
            };

            const showSourceInspector = (anchor, { moveFocus = false, pin = false } = {}) => {
                if (!sourceInspector) return;
                const citationNumber = Number.parseInt(anchor.dataset.citation || "", 10);
                const source = sourceByCitation.get(citationNumber);
                if (!source) return;

                if (activeCitationButton && activeCitationButton !== anchor) {
                    activeCitationButton.classList.remove("is-active");
                    activeCitationButton.setAttribute("aria-expanded", "false");
                }
                activeCitationButton = anchor;
                anchor.classList.add("is-active");
                anchor.setAttribute("aria-expanded", "true");

                if (pin) {
                    if (pinnedCitationButton && pinnedCitationButton !== anchor) {
                        pinnedCitationButton.classList.remove("is-pinned");
                        pinnedCitationButton.setAttribute("aria-expanded", "false");
                    }
                    pinnedCitationButton = anchor;
                    anchor.classList.add("is-pinned");
                }

                if (inspectorLabel) inspectorLabel.textContent = `Source [${citationNumber}]`;
                if (inspectorTitle) inspectorTitle.textContent = source.note_title || "Untitled note";
                if (inspectorMeta) {
                    inspectorMeta.textContent = source.heading ? `From: ${source.heading}` : "";
                    inspectorMeta.hidden = !source.heading;
                }
                if (inspectorExcerpt) {
                    inspectorExcerpt.textContent = source.excerpt || "No excerpt is available for this reference.";
                }
                if (inspectorLink) {
                    inspectorLink.href = makeSearchAwareHref(source.href);
                    attachSourceLinkHandler(inspectorLink);
                }

                placeSourceInspector(anchor);
                sourceInspector.hidden = false;
                requestInspectorPositionUpdate();
                if (moveFocus) window.requestAnimationFrame(() => sourceInspector.focus());
            };

            const submitQuestion = async (question) => {
                if (pendingRequest || lifecycle.signal.aborted) return;
                pendingRequest = new AbortController();
                setLoading(true);
                setError("");
                clearResult();

                try {
                    const response = await fetch("/api/vault-chat", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify({
                            question,
                            history,
                        }),
                        signal: pendingRequest.signal,
                    });

                    const payload = await response.json().catch(() => ({}));
                    if (lifecycle.signal.aborted) return;
                    if (!response.ok) {
                        throw new Error(payload.error || "Vault search failed.");
                    }
                    if (typeof payload.answer !== "string" || !payload.answer.trim()) {
                        throw new Error("The vault returned an empty answer. Please try again.");
                    }

                    activeSearchId = createSearchId();
                    renderAnswer(payload, question);
                    history.push({ role: "user", content: question });
                    history.push({ role: "assistant", content: payload.answer || "" });
                    while (history.length > 6) history.shift();
                    saveStoredState(activeSearchId, {
                        question,
                        payload,
                        history,
                    });
                    updateSearchUrl(activeSearchId);
                } catch (error) {
                    if (lifecycle.signal.aborted) return;
                    const message = error instanceof Error
                        ? error.message
                        : "Vault search failed.";
                    setError(message);
                } finally {
                    pendingRequest = null;
                    if (!lifecycle.signal.aborted) {
                        setLoading(false);
                        input.focus();
                    }
                }
            };

            const restoreSearchState = () => {
                const searchId = activeSearchId || "";
                const stored = loadStoredState(searchId);
                if (!stored?.payload) return;

                activeSearchId = searchId;
                if (input && stored.question) {
                    input.value = stored.question;
                    resizeQuestionInput();
                }
                history.splice(0, history.length, ...(stored.history || []));
                renderAnswer(stored.payload, stored.question || "");
                updateSearchUrl(searchId, true);

                if (Number.isFinite(stored.scrollY)) {
                    window.requestAnimationFrame(() => {
                        window.scrollTo(0, stored.scrollY);
                    });
                }
            };

            const resultResizeObserver = typeof ResizeObserver === "undefined" || !resultPanel
                ? null
                : new ResizeObserver(() => {
                    if (activeCitationButton && !sourceInspector?.hidden) {
                        placeSourceInspector(activeCitationButton);
                    }
                });
            if (resultPanel) resultResizeObserver?.observe(resultPanel);

            inspectorClose?.addEventListener("click", () => {
                closeSourceInspector({ restoreFocus: true });
            }, listenerOptions);

            window.addEventListener("scroll", requestInspectorPositionUpdate, {
                ...listenerOptions,
                passive: true,
            });
            window.addEventListener("resize", requestInspectorPositionUpdate, listenerOptions);

            window.addEventListener("beforeunload", () => {
                if (!activeSearchId || !activePayload) return;
                saveStoredState(activeSearchId, {
                    question: activeQuestion,
                    payload: activePayload,
                    history,
                });
            }, listenerOptions);

            window.addEventListener("popstate", () => {
                activeSearchId = getSearchIdFromUrl();
                restoreSearchState();
            }, listenerOptions);

            document.addEventListener("astro:before-swap", () => {
                if (activeSearchId && activePayload) {
                    saveStoredState(activeSearchId, {
                        question: activeQuestion,
                        payload: activePayload,
                        history,
                    });
                }
                pendingRequest?.abort();
                resultResizeObserver?.disconnect();
                if (inspectorPositionFrame) window.cancelAnimationFrame(inspectorPositionFrame);
                lifecycle.abort();
                stopStatusRotation();
                submitButton.disabled = true;
                delete root.dataset.initialized;
            }, { once: true, signal: lifecycle.signal });

            input.addEventListener("input", resizeQuestionInput, listenerOptions);
            input.addEventListener("keydown", (event) => {
                if (event.isComposing) return;
                if (event.key !== "Enter" || event.shiftKey) return;
                event.preventDefault();
                form.requestSubmit();
            }, listenerOptions);

            form.addEventListener("submit", (event) => {
                event.preventDefault();
                const question = input.value.trim();
                if (!question) return;
                submitQuestion(question);
            }, listenerOptions);

            answerToggle?.addEventListener("click", () => {
                if (!answerPanel || !answerText) return;
                const isExpanded = answerPanel.classList.toggle("is-expanded");
                answerToggle.setAttribute("aria-expanded", String(isExpanded));
                answerText.querySelectorAll("[data-vault-continuation]").forEach((block) => {
                    block.hidden = !isExpanded;
                });
                if (!isExpanded && activeCitationButton?.closest("[data-vault-continuation]")) {
                    closeSourceInspector();
                }
                if (answerToggleLabel) {
                    answerToggleLabel.textContent = isExpanded ? "Show less" : "Continue reading";
                }
                const arrow = answerToggle.querySelector("[aria-hidden='true']");
                if (arrow) arrow.textContent = isExpanded ? "↑" : "↓";
            }, listenerOptions);

            // Recover the question from URLs produced by the old native GET submission.
            const url = new URL(window.location.href);
            const legacyQuestion = url.searchParams.get("question");
            if (legacyQuestion) {
                input.value = legacyQuestion.trim();
                url.searchParams.delete("question");
                window.history.replaceState(window.history.state, "", url);
            }
            resizeQuestionInput();
            restoreSearchState();
            submitButton.disabled = false;
        });

        // Astro's ClientRouter replaces the DOM without rerunning bundled scripts.
        // Initialize each new Vault form, including returns from notes and browser history.
        initializeVaultAsk();
        document.addEventListener("astro:page-load", initializeVaultAsk);
    })();
</script>


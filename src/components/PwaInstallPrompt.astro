---
// PwaInstallPrompt.astro
---

<div id="pwa-install-container" class="pwa-install-container" style="display: none;">
  <button
    id="pwa-install-btn"
    class="pwa-install-btn"
    type="button"
    aria-label="Install Abodid Sahoo app on your device"
  >
    <svg class="pwa-install-btn__icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
      <polyline points="7 10 12 15 17 10" />
      <line x1="12" y1="15" x2="12" y2="3" />
    </svg>
    <span class="pwa-install-btn__text">Install App</span>
  </button>

  <!-- iOS Safari Install Modal / Popover -->
  <div id="pwa-ios-modal" class="pwa-ios-modal" role="dialog" aria-modal="true" aria-labelledby="pwa-modal-title" style="display: none;">
    <div class="pwa-ios-modal__backdrop" id="pwa-modal-backdrop"></div>
    <div class="pwa-ios-modal__card">
      <div class="pwa-ios-modal__header">
        <div class="pwa-ios-modal__brand">
          <img src="/icons/apple-touch-icon.png" alt="Abodid Sahoo Icon" width="40" height="40" class="pwa-ios-modal__icon" />
          <div>
            <h3 id="pwa-modal-title" class="pwa-ios-modal__title">Install on iPhone</h3>
            <p class="pwa-ios-modal__subtitle">Add to your Home Screen for a fast, full-screen app experience.</p>
          </div>
        </div>
        <button type="button" class="pwa-ios-modal__close" id="pwa-modal-close" aria-label="Close instructions">×</button>
      </div>

      <ol class="pwa-ios-modal__steps">
        <li class="pwa-ios-modal__step">
          <span class="pwa-ios-modal__step-num">1</span>
          <span class="pwa-ios-modal__step-text">Tap the <strong>Share</strong> button <svg class="pwa-inline-icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg> at the bottom of Safari.</span>
        </li>
        <li class="pwa-ios-modal__step">
          <span class="pwa-ios-modal__step-num">2</span>
          <span class="pwa-ios-modal__step-text">Scroll down the menu and tap <strong>Add to Home Screen</strong> <svg class="pwa-inline-icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>.</span>
        </li>
        <li class="pwa-ios-modal__step">
          <span class="pwa-ios-modal__step-num">3</span>
          <span class="pwa-ios-modal__step-text">Tap <strong>Add</strong> in the top-right corner.</span>
        </li>
      </ol>

      <button type="button" class="pwa-ios-modal__action-btn" id="pwa-modal-ok">Got it</button>
    </div>
  </div>
</div>

<style>
  .pwa-install-container {
    display: inline-flex;
    align-items: center;
  }

  .pwa-install-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    font-size: 0.8rem;
    font-weight: 600;
    font-family: inherit;
    color: var(--pop-ink, #15130f);
    background: var(--pop-yellow, #ffe44f);
    border: 1px solid rgba(21, 19, 15, 0.78);
    border-radius: 999px;
    cursor: pointer;
    transition: transform 0.15s ease, background-color 0.15s ease;
    text-decoration: none;
    line-height: 1;
  }

  .pwa-install-btn:hover {
    transform: translateY(-1px);
    background: #ffdb1a;
  }

  .pwa-install-btn:active {
    transform: translateY(0);
  }

  .pwa-install-btn__icon {
    flex-shrink: 0;
  }

  /* Modal */
  .pwa-ios-modal {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 1rem;
    padding-bottom: max(1rem, env(safe-area-inset-bottom, 1rem));
  }

  @media (min-width: 640px) {
    .pwa-ios-modal {
      align-items: center;
    }
  }

  .pwa-ios-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .pwa-ios-modal__card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 440px;
    background: var(--pop-cream, #fff8e8);
    color: var(--pop-ink, #15130f);
    border: 1.5px solid rgba(21, 19, 15, 0.9);
    border-radius: 20px;
    padding: 1.5rem;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    animation: pwaSlideUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes pwaSlideUp {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .pwa-ios-modal__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 1.25rem;
  }

  .pwa-ios-modal__brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pwa-ios-modal__icon {
    border-radius: 10px;
    border: 1px solid rgba(21, 19, 15, 0.2);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  }

  .pwa-ios-modal__title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--pop-ink, #15130f);
    line-height: 1.2;
  }

  .pwa-ios-modal__subtitle {
    margin: 4px 0 0;
    font-size: 0.825rem;
    color: rgba(21, 19, 15, 0.7);
    line-height: 1.35;
  }

  .pwa-ios-modal__close {
    background: transparent;
    border: none;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--pop-ink, #15130f);
    cursor: pointer;
    padding: 0 4px;
  }

  .pwa-ios-modal__steps {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pwa-ios-modal__step {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(21, 19, 15, 0.12);
    border-radius: 12px;
    padding: 10px 12px;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .pwa-ios-modal__step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--pop-blue, #2444ca);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.75rem;
    flex-shrink: 0;
  }

  .pwa-ios-modal__step-text {
    flex: 1;
    color: var(--pop-ink, #15130f);
  }

  .pwa-inline-icon {
    display: inline-block;
    vertical-align: -2px;
    margin: 0 2px;
  }

  .pwa-ios-modal__action-btn {
    width: 100%;
    padding: 12px;
    border-radius: 12px;
    border: 1px solid rgba(21, 19, 15, 0.8);
    background: var(--pop-blue, #2444ca);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .pwa-ios-modal__action-btn:hover {
    opacity: 0.92;
  }
</style>

<script>
  function setupPwaPrompt() {
    const isStandalone =
      window.matchMedia('(display-mode: standalone)').matches ||
      (window.navigator as unknown as { standalone?: boolean }).standalone === true ||
      document.referrer.includes('android-app://');

    const container = document.getElementById('pwa-install-container');
    const btn = document.getElementById('pwa-install-btn');
    const modal = document.getElementById('pwa-ios-modal');
    const backdrop = document.getElementById('pwa-modal-backdrop');
    const closeBtn = document.getElementById('pwa-modal-close');
    const okBtn = document.getElementById('pwa-modal-ok');

    if (!container || !btn || !modal) return;

    // If already running in standalone PWA, keep completely hidden
    if (isStandalone) {
      container.style.display = 'none';
      return;
    }

    let deferredPrompt: any = null;

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      container.style.display = 'inline-flex';
    });

    // Detect iOS
    const isIos = /iPad|iPhone|iPod/.test(navigator.userAgent) && !(window as any).MSStream;
    const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);

    // Show button on mobile or when deferred prompt is ready
    if (isIos || deferredPrompt || window.innerWidth <= 768) {
      container.style.display = 'inline-flex';
    }

    const openModal = () => {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        deferredPrompt.userChoice.then((choiceResult: { outcome: string }) => {
          if (choiceResult.outcome === 'accepted') {
            container.style.display = 'none';
          }
          deferredPrompt = null;
        });
      } else {
        modal.style.display = 'flex';
      }
    };

    const closeModal = () => {
      modal.style.display = 'none';
    };

    btn.onclick = (e) => {
      e.preventDefault();
      openModal();
    };

    if (backdrop) backdrop.onclick = closeModal;
    if (closeBtn) closeBtn.onclick = closeModal;
    if (okBtn) okBtn.onclick = closeModal;
  }

  // Initialize and attach to Astro page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPwaPrompt);
  } else {
    setupPwaPrompt();
  }

  document.addEventListener('astro:page-load', setupPwaPrompt);
</script>

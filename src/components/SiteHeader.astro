---
import PwaInstallPrompt from "./PwaInstallPrompt.astro";
import MultilingualPalette from "./MultilingualPalette.astro";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const onHomepage = pathname === "/";

// Primary Desktop & Mobile Navigation
const navigationItems = [
  { href: "/work", label: "Work", active: pathname === "/work" || pathname.startsWith("/work/") },
  { href: "/research", label: "Research", active: pathname === "/research" || pathname.startsWith("/research/") },
  { href: "/lab", label: "Lab", active: pathname === "/lab" || pathname.startsWith("/lab/") },
  { href: "/about", label: "About", active: pathname === "/about" || pathname.startsWith("/about/") },
];

// Mobile Secondary Navigation Group (Lower emphasis: Photography, Films, Writing, Workshops, Curation, CV)
const mobileSecondaryItems = [
  { href: "/photography", label: "Photography", active: pathname === "/photography" || pathname.startsWith("/photography/") },
  { href: "/films", label: "Films", active: pathname === "/films" || pathname.startsWith("/films/") },
  { href: "/blog", label: "Writing", active: pathname === "/blog" || pathname.startsWith("/blog/") },
  { href: "/reading", label: "Reading", active: pathname === "/reading" || pathname.startsWith("/reading/") },
  { href: "/workshops", label: "Workshops", active: pathname === "/workshops" || pathname.startsWith("/workshops/") },
  { href: "/resources", label: "Curation", active: pathname === "/resources" || pathname.startsWith("/resources/") },
  { href: "/cv", label: "CV", active: pathname === "/cv" || pathname.startsWith("/cv/") },
  { href: "/academic-portfolio", label: "Academic portfolio", active: pathname === "/academic-portfolio" },
];

const contactHref = onHomepage ? "#enquiry" : "/#enquiry";
const brandHref = "/";
const brandLabel = "abodid.com";
const contactLabel = "Hire me";
---

<header class="site-header">
  <div class="site-header__card">
    <a class="site-header__brand" href={brandHref} aria-label="Abodid Sahoo homepage">{brandLabel}</a>

    <nav class="site-header__links" aria-label="Primary navigation">
      {navigationItems.map((item) => (
        <a href={item.href} class:list={{ "is-active": item.active }} aria-current={item.active ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__actions">
      <a class="site-header__contact" href={contactHref}>
        <span class="site-header__contact-label">{contactLabel}</span> <span class="link-destination-arrow" aria-hidden="true">↗</span>
      </a>

      <details class="site-header__menu-toggle" id="site-header-menu">
        <summary class="site-header__menu-trigger" aria-label="Toggle site menu and language palette">
          <span class="site-header__menu-trigger-text">Menu</span>
        </summary>
        <nav class="site-header__menu-dropdown" aria-label="Extended navigation and tools">
          <div class="site-header__mobile-primary">
            {navigationItems.map((item) => (
              <a href={item.href} class:list={{ "is-active": item.active }} aria-current={item.active ? "page" : undefined}>
                {item.label}
              </a>
            ))}
            <a class="site-header__mobile-contact" href={contactHref}>
              <span class="site-header__contact-label">{contactLabel}</span> <span class="link-destination-arrow" aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="site-header__menu-section">
            <span class="site-header__mobile-heading">Explore</span>
            <div class="site-header__mobile-sublinks">
              {mobileSecondaryItems.map((item) => (
                <a
                  href={item.href}
                  class:list={{ "is-active": item.active }}
                  aria-current={item.active ? "page" : undefined}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                >
                  {item.label} {item.external && <span class="link-destination-arrow" aria-hidden="true">↗</span>}
                </a>
              ))}
            </div>
          </div>

          <div class="site-header__menu-palette">
            <MultilingualPalette variant="menu" />
          </div>

          <div class="site-header__mobile-pwa">
            <PwaInstallPrompt />
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  /* ==========================================================================
     ACTIVE HEADER: Matching the small footer bar aesthetic (Pill & panel styling)
     ========================================================================== */
  .site-header {
    --home-next-gap: 8px;
    --home-next-border: 1px solid color-mix(in srgb, var(--color-text) 78%, transparent);
    --home-next-radius-panel: clamp(18px, 2vw, 28px);
    --home-next-radius-control: 14px;
    --home-next-motion: 180ms ease;

    position: sticky;
    top: 0;
    z-index: 50;
    padding: max(var(--home-next-gap), env(safe-area-inset-top, 0px)) max(var(--home-next-gap), env(safe-area-inset-right, 0px)) 0 max(var(--home-next-gap), env(safe-area-inset-left, 0px));
    background: transparent; /* always transparent — cream card is the only visible part */
    color: var(--color-text);
    pointer-events: none;
  }

  .site-header__mobile-pwa {
    margin-top: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
    display: flex;
  }

  .site-header__card {
    pointer-events: auto;
    padding: clamp(0.75rem, 1.4vw, 1.1rem) clamp(1.2rem, 2.5vw, 2.2rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    border: var(--home-next-border);
    border-radius: var(--home-next-radius-panel);
    background: var(--color-background);
    color: var(--color-text);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--color-text) 8%, transparent);
  }

  .site-header a,
  .site-header summary {
    color: var(--color-text);
    font: 700 0.68rem/1 var(--font-mono, monospace);
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }

  /* Brand Pill - exact match with story-footer__brand */
  .site-header__brand {
    min-height: 38px;
    padding: 0 0.9rem;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-text);
    border-radius: var(--home-next-radius-control);
    background: var(--color-button);
    color: var(--site-header-action-text, var(--color-button-text)) !important;
    font: 750 0.74rem/1 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: transform var(--home-next-motion), box-shadow var(--home-next-motion);
  }

  .site-header__brand:hover {
    transform: translateY(-2px);
    box-shadow: 0 3px 0 var(--color-text);
  }

  /* Nav Links - exact pill style matching story-footer__social */
  .site-header__links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .site-header__links a {
    min-height: 34px;
    padding: 0 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-text);
    border-radius: var(--home-next-radius-control);
    background: var(--color-surface);
    color: var(--color-text) !important;
    font: 700 0.68rem/1 var(--font-mono, monospace);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: background-color var(--home-next-motion), transform var(--home-next-motion), box-shadow var(--home-next-motion);
  }

  .site-header__links a:hover {
    transform: translateY(-2px);
    background: var(--color-secondary);
    box-shadow: 0 3px 0 var(--color-text);
  }

  .site-header__links a.is-active {
    color: var(--site-header-action-text, var(--ui-button-text)) !important;
    background: var(--color-button);
    font-weight: 750;
    box-shadow: 0 2px 0 var(--color-text);
  }

  /* Actions Container */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Hire Me Button - Clean, separately floating button */
  .site-header__contact {
    min-height: 38px;
    padding: 0 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid var(--color-text);
    border-radius: var(--home-next-radius-control);
    background: var(--ui-button-bg);
    color: var(--site-header-action-text, var(--ui-button-text)) !important;
    font: 750 0.72rem/1 var(--font-mono, monospace);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: 0 2px 0 var(--color-text);
    transition: transform var(--home-next-motion), box-shadow var(--home-next-motion), background-color var(--home-next-motion);
  }

  .site-header__contact:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 0 var(--color-text);
    background: var(--ui-button-hover-bg);
  }

  /* Menu Toggle & Dropdown */
  .site-header__menu-toggle {
    position: relative;
  }

  .site-header__menu-trigger {
    min-height: 38px;
    padding: 0 0.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    border: 1px solid var(--color-text);
    border-radius: var(--home-next-radius-control);
    background: var(--color-button);
    color: var(--site-header-action-text, var(--color-button-text)) !important;
    font: 750 0.72rem/1 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: transform var(--home-next-motion), box-shadow var(--home-next-motion), background-color var(--home-next-motion);
  }

  .site-header__menu-trigger-text {
    color: var(--site-header-action-text, var(--ui-button-text)) !important;
  }

  .site-header__menu-trigger:hover {
    transform: translateY(-2px);
    box-shadow: 0 3px 0 var(--color-text);
    background: var(--color-accent);
  }

  .site-header__menu-trigger::-webkit-details-marker {
    display: none;
  }

  .site-header__menu-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: clamp(280px, 85vw, 330px);
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border: var(--home-next-border);
    border-radius: var(--home-next-radius-panel);
    background: var(--color-background);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--color-text) 16%, transparent);
    z-index: 100;
  }

  .site-header__mobile-primary {
    display: none;
    flex-direction: column;
    gap: 0.45rem;
  }

  .site-header__menu-section {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .site-header__mobile-heading {
    font: 700 0.62rem/1 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text) 60%, transparent);
    padding-left: 0.25rem;
  }

  .site-header__mobile-sublinks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .site-header__mobile-sublinks a {
    min-height: 28px;
    padding: 0 0.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    border: 1px solid color-mix(in srgb, var(--color-text) 40%, transparent);
    border-radius: var(--home-next-radius-control);
    background: color-mix(in srgb, var(--color-surface) 70%, transparent);
    color: color-mix(in srgb, var(--color-text) 85%, transparent);
    font: 650 0.62rem/1 var(--font-mono, monospace);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color var(--home-next-motion), color var(--home-next-motion);
  }

  .site-header__mobile-sublinks a:hover {
    background: var(--color-secondary);
    color: var(--color-text);
    border-color: var(--color-text);
  }

  .site-header__mobile-sublinks a.is-active {
    color: var(--site-header-action-text, var(--ui-button-text)) !important;
    background: var(--color-button);

    border-color: var(--color-text);
    font-weight: 750;
  }

  .site-header__menu-palette {
    padding-top: 0.25rem;
  }

  @media (max-width: 980px) {
    .site-header__links,
    .site-header__contact {
      display: none;
    }

    .site-header__mobile-primary {
      display: flex;
      padding-bottom: 0.5rem;
      border-bottom: 1px dashed color-mix(in srgb, var(--color-text) 20%, transparent);
    }

    .site-header__mobile-primary a {
      min-height: 36px;
      padding: 0 0.85rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border: 1px solid var(--color-text);
      border-radius: var(--home-next-radius-control);
      background: var(--color-surface);
      color: var(--color-text);
      font: 700 0.7rem/1 var(--font-mono, monospace);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      text-decoration: none;
      transition: background-color var(--home-next-motion);
    }

    .site-header__mobile-primary a:hover {
      background: var(--color-secondary);
    }

    .site-header__mobile-primary a.is-active {
      color: var(--site-header-action-text, var(--ui-button-text)) !important;
      background: var(--color-button);
    }

    .site-header__mobile-primary a.site-header__mobile-contact {
      background: var(--ui-button-bg);
      color: var(--ui-button-text);
      font-weight: 750;
    }
  }

  :global(html[data-divider-navigation]) .site-header {
    --site-header-action-text: var(--color-text);
    --site-header-gutter: var(--design-page-gutter);
    padding-block: env(safe-area-inset-top, 0px) 0;
    padding-inline: max(var(--site-header-gutter), env(safe-area-inset-left, 0px))
      max(var(--site-header-gutter), env(safe-area-inset-right, 0px));
    border-block-end: 1px solid var(--ui-border-strong);
    background: var(--color-background);
    color: var(--color-text);
    pointer-events: auto;
    container: site-header / inline-size;
  }

  :global(html[data-divider-navigation]) .site-header__card {
    max-inline-size: var(--max-width);
    margin-inline: auto;
    padding: 0.35rem 0;
    flex-wrap: nowrap;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  :global(html[data-divider-navigation]) .site-header__card :is(
    .site-header__brand,
    .site-header__links a,
    .site-header__contact,
    .site-header__menu-trigger,
    .site-header__mobile-primary a,
    .site-header__mobile-sublinks a
  ) {
    min-block-size: 2.75rem;
    padding-inline: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-text);
    box-shadow: none;
    transform: none;
    text-underline-offset: 0.36em;
  }

  :global(html[data-divider-navigation]) .site-header__card :is(
    .site-header__brand,
    .site-header__links a,
    .site-header__menu-trigger,
    .site-header__mobile-primary a,
    .site-header__mobile-sublinks a
  ):hover,
  :global(html[data-divider-navigation]) :is(.site-header__contact, .site-header__mobile-contact):hover .site-header__contact-label,
  :global(html[data-divider-navigation]) .site-header__card [aria-current="page"],
  :global(html[data-divider-navigation]) .site-header__menu-toggle[open] > summary {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  :global(html[data-divider-navigation]) .site-header :is(a, summary):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  :global(html[data-divider-navigation]) .site-header__brand {
    font-size: 0.88rem;
    white-space: nowrap;
  }

  :global(html[data-divider-navigation]) :is(.site-header__links, .site-header__contact) { display: none; }

  :global(html[data-divider-navigation]) .site-header__actions {
    gap: clamp(0.75rem, 2vw, 1.8rem);
  }

  :global(html[data-divider-navigation]) :is(.site-header__contact, .site-header__menu-trigger) {
    white-space: nowrap;
  }

  :global(html[data-divider-navigation]) .site-header__menu-toggle { position: static; }

  :global(html[data-divider-navigation]) .site-header__menu-dropdown {
    inset-block-start: 100%;
    inset-inline: 0;
    inline-size: auto;
    max-block-size: 72vh;
    max-block-size: 72dvh;
    overflow: auto;
    padding: 0.8rem max(var(--site-header-gutter), env(safe-area-inset-right, 0px))
      1rem max(var(--site-header-gutter), env(safe-area-inset-left, 0px));
    border: 0;
    border-block-end: 1px solid var(--ui-border-strong);
    border-radius: 0;
    box-shadow: none;
  }

  :global(html[data-divider-navigation]) .site-header__mobile-primary {
    display: flex;
    gap: 0;
    border-block-end: 1px solid var(--ui-border);
  }

  :global(html[data-divider-navigation]) .site-header__mobile-heading {
    padding-inline-start: 0;
    color: var(--color-text);
  }

  :global(html[data-divider-navigation]) .site-header__mobile-sublinks { gap: 0 clamp(0.8rem, 3vw, 1.5rem); }

  :global(html[data-divider-navigation]) .site-header__menu-palette {
    padding-block-start: 0.75rem;
    border-block-start: 1px solid var(--ui-border);
  }

  :global(html[data-divider-navigation]) .site-header__mobile-pwa {
    margin: 0;
    padding: 0;
    border: 0;
  }

  @container site-header (min-width: 44rem) {
    :global(html[data-divider-navigation]) .site-header__card {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    }

    :global(html[data-divider-navigation]) .site-header__brand { justify-self: start; }

    :global(html[data-divider-navigation]) .site-header__links {
      display: flex;
      gap: clamp(0.8rem, 2.1vw, 2rem);
    }

    :global(html[data-divider-navigation]) .site-header__actions { justify-self: end; }
    :global(html[data-divider-navigation]) .site-header__contact { display: inline-flex; }
    :global(html[data-divider-navigation]) .site-header__mobile-primary { display: none; }

    :global(html[data-divider-navigation]) .site-header__menu-dropdown {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
      column-gap: clamp(1rem, 5vw, 5rem);
      padding-inline: max(var(--site-header-gutter), calc((100% - var(--max-width)) / 2), env(safe-area-inset-left, 0px))
        max(var(--site-header-gutter), calc((100% - var(--max-width)) / 2), env(safe-area-inset-right, 0px));
    }

    :global(html[data-divider-navigation]) .site-header__menu-palette {
      padding-block-start: 0;
      border-block-start: 0;
    }

    :global(html[data-divider-navigation]) .site-header__mobile-pwa { grid-column: 1 / -1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header *,
    .site-header *::before,
    .site-header *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>

<script is:inline>
  (function initHeaderMenuBehavior() {
    if (window.__siteHeaderMenuBound) return;
    window.__siteHeaderMenuBound = true;

    document.addEventListener("click", (event) => {
      const menu = document.querySelector("#site-header-menu[open]");
      if (menu && !menu.contains(event.target)) menu.removeAttribute("open");
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || event.defaultPrevented) return;
      const menu = document.querySelector("#site-header-menu[open]");
      if (!menu) return;
      const restoreFocus = menu.contains(document.activeElement);
      menu.removeAttribute("open");
      if (restoreFocus) menu.querySelector("summary")?.focus();
    });
  })();
</script>

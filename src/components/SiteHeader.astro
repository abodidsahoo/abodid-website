---
import {
  isCurationHostname,
  legacyResourcePathToCurationPath,
} from "../lib/curationRoutes.js";

const hostname = Astro.url.hostname;
const isCuration = isCurationHostname(hostname);
const isLab = hostname === "lab.abodid.com";
const isPhotos = hostname === "photos.abodid.com";
const isSubdomain = isCuration || isLab || isPhotos;

const internalPathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const pathname = isCuration
  ? legacyResourcePathToCurationPath(internalPathname) || internalPathname
  : internalPathname;
const onHomepage = pathname === "/";

const mainOrigin = "https://abodid.com";
const mainUrl = (path: string) => isSubdomain ? `${mainOrigin}${path}` : path;

// Primary Desktop & Mobile Navigation
const personalNavigationItems = [
  { href: mainUrl("/work"), label: "Work", active: !isLab && (pathname === "/work" || pathname.startsWith("/work/")) },
  { href: mainUrl("/research"), label: "Research", active: !isLab && (pathname === "/research" || pathname.startsWith("/research/")) },
  { href: mainUrl("/lab"), label: "Lab", active: !isLab && (pathname === "/lab" || pathname.startsWith("/lab/")) },
  { href: mainUrl("/about"), label: "About", active: !isLab && (pathname === "/about" || pathname.startsWith("/about/")) },
];
const curationNavigationItems = [
  { href: "/", label: "Explore", active: pathname === "/" },
  { href: "/submit", label: "Submit", active: pathname === "/submit" },
  { href: "/saved", label: "Saved", active: pathname === "/saved" },
  { href: "/dashboard", label: "Dashboard", active: pathname === "/dashboard" || pathname.startsWith("/admin") },
];
const navigationItems = isCuration ? curationNavigationItems : personalNavigationItems;

// Mobile Secondary Navigation Group (Lower emphasis: Experience, CV, Writing, Workshops, Curation ↗)
const mobileSecondaryItems = [
  { href: mainUrl("/experience"), label: "Experience", active: pathname === "/experience" || pathname.startsWith("/experience/") },
  { href: mainUrl("/cv"), label: "CV", active: pathname === "/cv" || pathname.startsWith("/cv/") },
  { href: mainUrl("/blog"), label: "Writing", active: pathname === "/blog" || pathname.startsWith("/blog/") },
  { href: mainUrl("/workshops"), label: "Workshops", active: pathname === "/workshops" || pathname.startsWith("/workshops/") },
  { href: mainUrl("/resources"), label: "Curation" },
];

const contactHref = isCuration ? "https://abodid.com" : isSubdomain ? "https://abodid.com/#enquiry" : onHomepage ? "#enquiry" : "/#enquiry";
const brandHref = isCuration ? "/" : isLab ? "/" : isSubdomain ? "https://abodid.com" : "/";
const brandLabel = isCuration ? "curation.abodid.com" : isLab ? "lab.abodid.com" : "abodid.com";
const contactLabel = isCuration ? "About Abodid" : "Hire me";
---

<header class="site-header">
  <div class="site-header__card">
    <a class="site-header__brand" href={brandHref} aria-label={isCuration ? "Curation by Abodid homepage" : "Abodid Sahoo homepage"}>{brandLabel}</a>

    <nav class="site-header__links" aria-label="Primary navigation">
      {navigationItems.map((item) => (
        <a href={item.href} class:list={{ "is-active": item.active }} aria-current={item.active ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <a class="site-header__contact" href={contactHref}>
      {contactLabel} <span class="link-destination-arrow" aria-hidden="true">↗</span>
    </a>

    <details class="site-header__mobile">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        <div class="site-header__mobile-primary">
          {navigationItems.map((item) => (
            <a href={item.href} class:list={{ "is-active": item.active }} aria-current={item.active ? "page" : undefined}>
              {item.label}
            </a>
          ))}
          <a class="site-header__mobile-contact" href={contactHref}>
            {contactLabel} <span class="link-destination-arrow" aria-hidden="true">↗</span>
          </a>
        </div>

        {!isCuration && (
          <div class="site-header__mobile-secondary">
            <span class="site-header__mobile-heading">More</span>
            <div class="site-header__mobile-sublinks">
              {mobileSecondaryItems.map((item) => (
                <a
                  href={item.href}
                  class:list={{ "is-active": item.active }}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                >
                  {item.label} {item.external && <span class="link-destination-arrow" aria-hidden="true">↗</span>}
                </a>
              ))}
            </div>
          </div>
        )}
      </nav>
    </details>
  </div>
</header>

<style>
  /* ==========================================================================
     ACTIVE HEADER: Matching the small footer bar aesthetic (Pill & panel styling)
     ========================================================================== */
  .site-header {
    --pop-blue: #2444ca;
    --pop-pink: #ff7eb5;
    --pop-yellow: #ffe44f;
    --pop-lime: #caff48;
    --pop-cream: #fff8e8;
    --pop-ink: #15130f;
    --home-next-gap: 8px;
    --home-next-border: 1px solid rgba(21, 19, 15, 0.78);
    --home-next-radius-panel: clamp(18px, 2vw, 28px);
    --home-next-radius-control: 14px;
    --home-next-motion: 180ms ease;

    position: sticky;
    top: 0;
    z-index: 50;
    padding: var(--home-next-gap) var(--home-next-gap) 0;
    background: transparent;
    pointer-events: none;
  }

  .site-header__card {
    pointer-events: auto;
    padding: clamp(0.75rem, 1.4vw, 1.1rem) clamp(1.2rem, 2.5vw, 2.2rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    border: var(--home-next-border);
    border-radius: var(--home-next-radius-panel);
    background: var(--pop-cream);
    box-shadow: 0 4px 16px rgba(21, 19, 15, 0.08);
  }

  .site-header a,
  .site-header summary {
    color: inherit;
    font: 700 0.68rem/1 var(--font-mono, monospace);
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }

  /* Brand Pill - exact match with story-footer__brand */
  .site-header__brand {
    min-height: 38px;
    padding: 0 0.9rem;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--pop-ink);
    border-radius: var(--home-next-radius-control);
    background: var(--pop-yellow);
    color: var(--pop-ink) !important;
    font: 750 0.74rem/1 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: transform var(--home-next-motion), box-shadow var(--home-next-motion);
  }

  .site-header__brand:hover {
    transform: translateY(-2px);
    box-shadow: 0 3px 0 var(--pop-ink);
  }

  /* Nav Links - exact pill style matching story-footer__social */
  .site-header__links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .site-header__links a {
    min-height: 34px;
    padding: 0 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--pop-ink);
    border-radius: var(--home-next-radius-control);
    background: #fff;
    color: var(--pop-ink);
    font: 700 0.68rem/1 var(--font-mono, monospace);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: background-color var(--home-next-motion), transform var(--home-next-motion), box-shadow var(--home-next-motion);
  }

  .site-header__links a:hover {
    transform: translateY(-2px);
    background: var(--pop-pink);
    box-shadow: 0 3px 0 var(--pop-ink);
  }

  .site-header__links a.is-active {
    background: var(--pop-yellow);
    font-weight: 750;
    box-shadow: 0 2px 0 var(--pop-ink);
  }

  /* Hire Me Button - Clean, separately floating button */
  .site-header__contact {
    min-height: 38px;
    padding: 0 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid var(--pop-ink);
    border-radius: var(--home-next-radius-control);
    background: var(--pop-pink);
    color: var(--pop-ink) !important;
    font: 750 0.72rem/1 var(--font-mono, monospace);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: 0 2px 0 var(--pop-ink);
    transition: transform var(--home-next-motion), box-shadow var(--home-next-motion), background-color var(--home-next-motion);
  }

  .site-header__contact:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 0 var(--pop-ink);
    background: var(--pop-lime);
  }

  .site-header__mobile {
    display: none;
    position: relative;
  }

  @media (max-width: 980px) {
    .site-header__links,
    .site-header__contact {
      display: none;
    }

    .site-header__mobile {
      display: block;
    }

    .site-header__mobile summary {
      min-height: 38px;
      padding: 0 0.9rem;
      display: flex;
      align-items: center;
      border: 1px solid var(--pop-ink);
      border-radius: var(--home-next-radius-control);
      background: var(--pop-yellow);
      color: var(--pop-ink);
      font: 750 0.74rem/1 var(--font-mono, monospace);
      letter-spacing: 0.08em;
      cursor: pointer;
      list-style: none;
      transition: transform var(--home-next-motion), box-shadow var(--home-next-motion);
    }

    .site-header__mobile summary:hover {
      transform: translateY(-2px);
      box-shadow: 0 3px 0 var(--pop-ink);
    }

    .site-header__mobile summary::-webkit-details-marker {
      display: none;
    }

    .site-header__mobile nav {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      min-width: 240px;
      padding: 0.85rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      border: var(--home-next-border);
      border-radius: var(--home-next-radius-panel);
      background: var(--pop-cream);
      box-shadow: 0 8px 24px rgba(21, 19, 15, 0.15);
      z-index: 100;
    }

    .site-header__mobile-primary {
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
    }

    .site-header__mobile-primary a {
      min-height: 36px;
      padding: 0 0.85rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border: 1px solid var(--pop-ink);
      border-radius: var(--home-next-radius-control);
      background: #fff;
      color: var(--pop-ink);
      font: 700 0.7rem/1 var(--font-mono, monospace);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      text-decoration: none;
      transition: background-color var(--home-next-motion);
    }

    .site-header__mobile-primary a:hover {
      background: var(--pop-pink);
    }

    .site-header__mobile-primary a.is-active {
      background: var(--pop-yellow);
    }

    .site-header__mobile-contact {
      background: var(--pop-pink) !important;
      font-weight: 750 !important;
    }

    .site-header__mobile-secondary {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      padding-top: 0.65rem;
      border-top: 1px dashed rgba(21, 19, 15, 0.25);
    }

    .site-header__mobile-heading {
      font: 700 0.62rem/1 var(--font-mono, monospace);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(21, 19, 15, 0.6);
      padding-left: 0.25rem;
    }

    .site-header__mobile-sublinks {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }

    .site-header__mobile-sublinks a {
      min-height: 28px;
      padding: 0 0.6rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.25rem;
      border: 1px solid rgba(21, 19, 15, 0.4);
      border-radius: var(--home-next-radius-control);
      background: rgba(255, 255, 255, 0.7);
      color: rgba(21, 19, 15, 0.85);
      font: 650 0.62rem/1 var(--font-mono, monospace);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-decoration: none;
      transition: background-color var(--home-next-motion), color var(--home-next-motion);
    }

    .site-header__mobile-sublinks a:hover {
      background: var(--pop-pink);
      color: var(--pop-ink);
      border-color: var(--pop-ink);
    }

    .site-header__mobile-sublinks a.is-active {
      background: var(--pop-yellow);
      color: var(--pop-ink);
      border-color: var(--pop-ink);
      font-weight: 750;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header *,
    .site-header *::before,
    .site-header *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }

  /* ==========================================================================
     PREVIOUS FULL-BLEED BLUE HEADER STYLES (Preserved for easy rollback)
     ==========================================================================
     .site-header--legacy-blue {
       --site-blue: #2444ca;
       --site-pink: #ff7eb5;
       --site-yellow: #ffe44f;
       --site-cream: #fff8e8;
       --site-ink: #15130f;
       --site-gutter: clamp(1rem, 3vw, 3.5rem);
       --site-control-radius: 14px;
       position: sticky;
       top: 0;
       z-index: 50;
       min-height: 72px;
       padding: 0 var(--site-gutter);
       display: grid;
       grid-template-columns: minmax(140px, 1fr) auto minmax(220px, 1fr);
       align-items: center;
       gap: 1.5rem;
       border-bottom: 0;
       background: var(--site-blue);
       color: var(--site-cream);
     }
     .site-header--legacy-blue .site-header__brand {
       width: fit-content;
       min-height: 42px;
       padding: 0 0.9rem;
       display: inline-flex;
       align-items: center;
       border: 1px solid var(--site-ink);
       border-radius: var(--site-control-radius);
       background: var(--site-yellow);
       color: var(--site-ink) !important;
     }
     .site-header--legacy-blue .site-header__links {
       display: flex;
       align-items: center;
       gap: clamp(1.2rem, 2.5vw, 2.5rem);
     }
     .site-header--legacy-blue .site-header__links a {
       opacity: 1;
       transition: text-decoration-color 160ms ease;
     }
     .site-header--legacy-blue .site-header__links a.is-active,
     .site-header--legacy-blue .site-header__links a:hover {
       text-decoration: underline;
       text-underline-offset: 4px;
       text-decoration-thickness: 2px;
     }
     .site-header--legacy-blue .site-header__contact {
       justify-self: end;
       min-height: 44px;
       padding: 0 1rem;
       display: inline-flex;
       align-items: center;
       gap: 0.5rem;
       border: 1px solid var(--site-ink);
       border-radius: var(--site-control-radius);
       background: var(--site-pink);
       color: var(--site-ink) !important;
     }
     ========================================================================== */
</style>

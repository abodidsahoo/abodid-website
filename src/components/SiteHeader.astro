---
import PwaInstallPrompt from "./PwaInstallPrompt.astro";
import MultilingualPalette from "./MultilingualPalette.astro";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const onHomepage = pathname === "/";

// Primary Desktop & Mobile Navigation
const navigationItems = [
  { href: "/work", label: "Work", active: pathname === "/work" || pathname.startsWith("/work/") },
  { href: "/research", label: "Research", active: pathname === "/research" || pathname.startsWith("/research/") },
  { href: "/lab", label: "Lab", active: pathname === "/lab" || pathname.startsWith("/lab/") },
  { href: "/about", label: "About", active: pathname === "/about" || pathname.startsWith("/about/") },
];

// Mobile Secondary Navigation Group (Lower emphasis: Photography, Films, Writing, Workshops, Curation, CV)
const mobileSecondaryItems = [
  { href: "/photography", label: "Photography", active: pathname === "/photography" || pathname.startsWith("/photography/") },
  { href: "/films", label: "Films", active: pathname === "/films" || pathname.startsWith("/films/") },
  { href: "/blog", label: "Writing", active: pathname === "/blog" || pathname.startsWith("/blog/") },
  { href: "/reading", label: "Reading", active: pathname === "/reading" || pathname.startsWith("/reading/") },
  { href: "/workshops", label: "Workshops", active: pathname === "/workshops" || pathname.startsWith("/workshops/") },
  { href: "/resources", label: "Curation", active: pathname === "/resources" || pathname.startsWith("/resources/") },
  { href: "/cv", label: "CV", active: pathname === "/cv" || pathname.startsWith("/cv/") },
];

const contactHref = onHomepage ? "#enquiry" : "/#enquiry";
const brandHref = "/";
const brandLabel = "abodid.com";
const contactLabel = "Hire me";
---

<header class="site-header">
  <div class="site-header__card">
    <a class="site-header__brand" href={brandHref} aria-label="Abodid Sahoo homepage">{brandLabel}</a>

    <nav class="site-header__links" aria-label="Primary navigation">
      {navigationItems.map((item) => (
        <a href={item.href} class:list={{ "is-active": item.active }} aria-current={item.active ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__actions">
      <a class="site-header__contact" href={contactHref}>
        {contactLabel} <span class="link-destination-arrow" aria-hidden="true">↗</span>
      </a>

      <details class="site-header__menu-toggle" id="site-header-menu">
        <summary class="site-header__menu-trigger" aria-label="Toggle site menu and language palette">
          <span class="site-header__menu-trigger-text">Menu</span>
          <span class="site-header__menu-trigger-icon" aria-hidden="true">▾</span>
        </summary>
        <nav class="site-header__menu-dropdown" aria-label="Extended navigation and tools">
          <div class="site-header__mobile-primary">
            {navigationItems.map((item) => (
              <a href={item.href} class:list={{ "is-active": item.active }} aria-current={item.active ? "page" : undefined}>
                {item.label}
              </a>
            ))}
            <a class="site-header__mobile-contact" href={contactHref}>
              {contactLabel} <span class="link-destination-arrow" aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="site-header__menu-section">
            <span class="site-header__mobile-heading">Explore</span>
            <div class="site-header__mobile-sublinks">
              {mobileSecondaryItems.map((item) => (
                <a
                  href={item.href}
                  class:list={{ "is-active": item.active }}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                >
                  {item.label} {item.external && <span class="link-destination-arrow" aria-hidden="true">↗</span>}
                </a>
              ))}
            </div>
          </div>

          <div class="site-header__menu-palette">
            <MultilingualPalette variant="menu" />
          </div>

          <div class="site-header__mobile-pwa">
            <PwaInstallPrompt />
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  /* ==========================================================================
     ACTIVE HEADER: Matching the small footer bar aesthetic (Pill & panel styling)
     ========================================================================== */
  .site-header {
    --home-next-gap: 8px;
    --home-next-border: 1px solid rgba(21, 19, 15, 0.78);
    --home-next-radius-panel: clamp(18px, 2vw, 28px);
    --home-next-radius-control: 14px;
    --home-next-motion: 180ms ease;

    position: sticky;
    top: 0;
    z-index: 50;
    padding: max(var(--home-next-gap), env(safe-area-inset-top, 0px)) max(var(--home-next-gap), env(safe-area-inset-right, 0px)) 0 max(var(--home-next-gap), env(safe-area-inset-left, 0px));
    background: transparent; /* always transparent — cream card is the only visible part */
    pointer-events: none;
  }

  .site-header__mobile-pwa {
    margin-top: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(21, 19, 15, 0.12);
    display: flex;
  }

  .site-header__card {
    pointer-events: auto;
    padding: clamp(0.75rem, 1.4vw, 1.1rem) clamp(1.2rem, 2.5vw, 2.2rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    border: var(--home-next-border);
    border-radius: var(--home-next-radius-panel);
    background: var(--pop-cream);
    box-shadow: 0 4px 16px rgba(21, 19, 15, 0.08);
  }

  .site-header a,
  .site-header summary {
    color: inherit;
    font: 700 0.68rem/1 var(--font-mono, monospace);
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }

  /* Brand Pill - exact match with story-footer__brand */
  .site-header__brand {
    min-height: 38px;
    padding: 0 0.9rem;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--pop-ink);
    border-radius: var(--home-next-radius-control);
    background: var(--pop-yellow);
    color: var(--pop-ink) !important;
    font: 750 0.74rem/1 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: transform var(--home-next-motion), box-shadow var(--home-next-motion);
  }

  .site-header__brand:hover {
    transform: translateY(-2px);
    box-shadow: 0 3px 0 var(--pop-ink);
  }

  /* Nav Links - exact pill style matching story-footer__social */
  .site-header__links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .site-header__links a {
    min-height: 34px;
    padding: 0 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--pop-ink);
    border-radius: var(--home-next-radius-control);
    background: #fff;
    color: var(--pop-ink);
    font: 700 0.68rem/1 var(--font-mono, monospace);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: background-color var(--home-next-motion), transform var(--home-next-motion), box-shadow var(--home-next-motion);
  }

  .site-header__links a:hover {
    transform: translateY(-2px);
    background: var(--pop-pink);
    box-shadow: 0 3px 0 var(--pop-ink);
  }

  .site-header__links a.is-active {
    background: var(--pop-yellow);
    font-weight: 750;
    box-shadow: 0 2px 0 var(--pop-ink);
  }

  /* Actions Container */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Hire Me Button - Clean, separately floating button */
  .site-header__contact {
    min-height: 38px;
    padding: 0 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid var(--pop-ink);
    border-radius: var(--home-next-radius-control);
    background: var(--pop-pink);
    color: var(--pop-ink) !important;
    font: 750 0.72rem/1 var(--font-mono, monospace);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: 0 2px 0 var(--pop-ink);
    transition: transform var(--home-next-motion), box-shadow var(--home-next-motion), background-color var(--home-next-motion);
  }

  .site-header__contact:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 0 var(--pop-ink);
    background: var(--pop-lime);
  }

  /* Menu Toggle & Dropdown */
  .site-header__menu-toggle {
    position: relative;
  }

  .site-header__menu-trigger {
    min-height: 38px;
    padding: 0 0.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    border: 1px solid var(--pop-ink);
    border-radius: var(--home-next-radius-control);
    background: var(--pop-yellow);
    color: var(--pop-ink);
    font: 750 0.72rem/1 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: transform var(--home-next-motion), box-shadow var(--home-next-motion), background-color var(--home-next-motion);
  }

  .site-header__menu-trigger:hover {
    transform: translateY(-2px);
    box-shadow: 0 3px 0 var(--pop-ink);
    background: var(--pop-lime);
  }

  .site-header__menu-trigger::-webkit-details-marker {
    display: none;
  }

  .site-header__menu-trigger-icon {
    font-size: 0.65rem;
    transition: transform var(--home-next-motion);
  }

  .site-header__menu-toggle[open] .site-header__menu-trigger-icon {
    transform: rotate(180deg);
  }

  .site-header__menu-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: clamp(280px, 85vw, 330px);
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border: var(--home-next-border);
    border-radius: var(--home-next-radius-panel);
    background: var(--pop-cream);
    box-shadow: 0 10px 30px rgba(21, 19, 15, 0.16);
    z-index: 100;
  }

  .site-header__mobile-primary {
    display: none;
    flex-direction: column;
    gap: 0.45rem;
  }

  .site-header__menu-section {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .site-header__mobile-heading {
    font: 700 0.62rem/1 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(21, 19, 15, 0.6);
    padding-left: 0.25rem;
  }

  .site-header__mobile-sublinks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .site-header__mobile-sublinks a {
    min-height: 28px;
    padding: 0 0.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    border: 1px solid rgba(21, 19, 15, 0.4);
    border-radius: var(--home-next-radius-control);
    background: rgba(255, 255, 255, 0.7);
    color: rgba(21, 19, 15, 0.85);
    font: 650 0.62rem/1 var(--font-mono, monospace);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color var(--home-next-motion), color var(--home-next-motion);
  }

  .site-header__mobile-sublinks a:hover {
    background: var(--pop-pink);
    color: var(--pop-ink);
    border-color: var(--pop-ink);
  }

  .site-header__mobile-sublinks a.is-active {
    background: var(--pop-yellow);
    color: var(--pop-ink);
    border-color: var(--pop-ink);
    font-weight: 750;
  }

  .site-header__menu-palette {
    padding-top: 0.25rem;
  }

  @media (max-width: 980px) {
    .site-header__links,
    .site-header__contact {
      display: none;
    }

    .site-header__mobile-primary {
      display: flex;
      padding-bottom: 0.5rem;
      border-bottom: 1px dashed rgba(21, 19, 15, 0.2);
    }

    .site-header__mobile-primary a {
      min-height: 36px;
      padding: 0 0.85rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border: 1px solid var(--pop-ink);
      border-radius: var(--home-next-radius-control);
      background: #fff;
      color: var(--pop-ink);
      font: 700 0.7rem/1 var(--font-mono, monospace);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      text-decoration: none;
      transition: background-color var(--home-next-motion);
    }

    .site-header__mobile-primary a:hover {
      background: var(--pop-pink);
    }

    .site-header__mobile-primary a.is-active {
      background: var(--pop-yellow);
    }

    .site-header__mobile-contact {
      background: var(--pop-pink) !important;
      font-weight: 750 !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header *,
    .site-header *::before,
    .site-header *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>

<script is:inline>
  (function initHeaderMenuBehavior() {
    function setupMenu() {
      const menu = document.getElementById("site-header-menu");
      if (!menu) return;

      function onDocClick(e) {
        if (menu.hasAttribute("open") && !menu.contains(e.target)) {
          menu.removeAttribute("open");
        }
      }

      function onKeyDown(e) {
        if (e.key === "Escape" && menu.hasAttribute("open")) {
          menu.removeAttribute("open");
        }
      }

      document.removeEventListener("click", onDocClick);
      document.addEventListener("click", onDocClick);

      document.removeEventListener("keydown", onKeyDown);
      document.addEventListener("keydown", onKeyDown);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupMenu);
    } else {
      setupMenu();
    }
    document.addEventListener("astro:page-load", setupMenu);
  })();
</script>

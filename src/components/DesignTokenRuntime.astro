---
import { DESIGN_TOKEN_NAMES, LEGACY_COLOR_TOKENS, DEFAULT_DESIGN_TOKENS } from "../lib/designTokens.js";

import { EDITORIAL_CURSOR_SVG } from "../lib/editorialCursor.js";

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || "";
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "";
const tokenNames = DESIGN_TOKEN_NAMES;
const legacyColorTokens = LEGACY_COLOR_TOKENS;
const editorialCursorSvg = EDITORIAL_CURSOR_SVG;
const tokenDefaults = DEFAULT_DESIGN_TOKENS;
---

<script is:inline define:vars={{ supabaseUrl, supabaseAnonKey, tokenNames, legacyColorTokens, editorialCursorSvg, tokenDefaults }}>
  (() => {
    const cacheKey = "abodid-published-design-tokens-v1";
    const allowedNames = new Set(tokenNames);

    const isSafeValue = (value) => {
      const text = String(value).trim();
      return /^#[0-9a-f]{6}$/i.test(text) || /^-?\d+(\.\d+)?$/.test(text);
    };

    const applyTokens = (tokens) => {
      if (!tokens || typeof tokens !== "object") return;
      for (const [name, value] of [
        ...Object.entries(legacyColorTokens).map(([legacy, name]) => [name, tokens[legacy]]),
        ...Object.entries(tokens),
      ]) {
        if (!allowedNames.has(name) || !isSafeValue(value)) continue;
        document.documentElement.style.setProperty(name, String(value));
      }
      const styles = getComputedStyle(document.documentElement);
      const cursorSvg = editorialCursorSvg.replace(/\{(background|secondary|text|button)\}/g, (_match, role) => {
        const name = "--color-" + role;
        const value = styles.getPropertyValue(name).trim();
        return /^#[0-9a-f]{6}$/i.test(value) ? value : tokenDefaults[name];
      });
      document.documentElement.style.setProperty(
        "--ui-editorial-cursor",
        'url("data:image/svg+xml,' + encodeURIComponent(cursorSvg) + '") 5 5, auto',
      );

      // Publications saved before foreground roles inherit the original pairing.
      if (!isSafeValue(tokens["--color-button-text"])) {
        document.documentElement.style.setProperty("--color-button-text", "var(--color-text)");
      }
      if (!isSafeValue(tokens["--color-primary-text"])) {
        document.documentElement.style.setProperty("--color-primary-text", "var(--color-background)");
      }
    };

    try {
      const cached = JSON.parse(localStorage.getItem(cacheKey) || "null");
      applyTokens(cached?.tokens);
    } catch (_error) {
      // Defaults in design-system.css remain active.
    }

    window.addEventListener("design-tokens:published", (event) => {
      applyTokens(event.detail?.tokens);
    });

    if (!supabaseUrl || !supabaseAnonKey) return;

    fetch(`${supabaseUrl}/rest/v1/design_system_settings?id=eq.global&select=published_tokens,published_version,updated_at`, {
      headers: {
        apikey: supabaseAnonKey,
        Authorization: `Bearer ${supabaseAnonKey}`,
        Accept: "application/json",
      },
      cache: "no-store",
    })
      .then((response) => response.ok ? response.json() : [])
      .then((rows) => {
        const settings = rows?.[0];
        if (!settings?.published_tokens) return;
        applyTokens(settings.published_tokens);
        window.dispatchEvent(new CustomEvent("design-tokens:loaded", {
          detail: { tokens: settings.published_tokens },
        }));
        try {
          localStorage.setItem(cacheKey, JSON.stringify({
            tokens: settings.published_tokens,
            version: settings.published_version,
            updatedAt: settings.updated_at,
          }));
        } catch (_error) {
          // A private browsing quota should not block the live theme.
        }
      })
      .catch(() => {
        // Keep cached or bundled defaults if Supabase is unavailable.
      });
  })();
</script>

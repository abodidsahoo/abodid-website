---
import HeroVaultTagsCard from "../HeroVaultTagsCard";
import { getLabExperiments } from "../../data/labExperiments";
import { labUrl } from "../../lib/labRoutes.js";

interface Props {
  title?: string;
  introduction?: string;
  absoluteLinks?: boolean;
}

const {
  title = "Selected Experiments",
  introduction = "This is where I play with images, code, and culture to build interactive storytelling experiences.",
  absoluteLinks = false,
} = Astro.props;

const experimentHref = (href: string) =>
  absoluteLinks ? labUrl(href) : href;

const labExperiments = await getLabExperiments();
---

<section class="lab-catalogue" aria-labelledby="lab-catalogue-title">
  <header class="lab-catalogue__header">
    <p class="lab-label">Current collection · 2026</p>
    <h1 id="lab-catalogue-title">{title}</h1>
    <p>{introduction}</p>
  </header>

  <div class="lab-catalogue__grid">
    {
      labExperiments.map((experiment) => {
        const isInteractiveCard = experiment.cardVariant === "vault-tags";
        const href = experimentHref(experiment.href);

        return (
          <article class:list={["lab-card", `lab-card--${experiment.surface}`]}>
            <a class="lab-card__shell" href={href}>
              <figure class:list={["lab-card__media", { "lab-card__media--interactive": isInteractiveCard }]}>
                {isInteractiveCard ? (
                  <HeroVaultTagsCard
                    client:load
                    embedded={true}
                    href={href}
                    heading={experiment.previewHeading || experiment.title}
                    cta={experiment.previewCta || experiment.destinationLabel}
                    ariaLabel={`Interactive preview of ${experiment.title}`}
                  />
                ) : experiment.video || experiment.thumbnail?.endsWith(".mp4") ? (
                  <video
                    src={experiment.video || experiment.thumbnail}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="auto"
                    aria-label={experiment.thumbnailAlt}
                  />
                ) : (
                  <img
                    src={experiment.thumbnail}
                    alt={experiment.thumbnailAlt}
                    loading={experiment.index === "01" ? "eager" : "lazy"}
                    decoding="async"
                  />
                )}
              </figure>

              <div class="lab-card__copy">
                <div class="lab-card__meta">
                  <span class="lab-card__index">{experiment.index}</span>
                  <span class="lab-card__discipline">{experiment.discipline}</span>
                </div>
                <h3>{experiment.title}</h3>
                <p>{experiment.description}</p>
                <span class="lab-card__destination">
                  <span>{experiment.destinationLabel}</span>
                  <span aria-hidden="true">↗</span>
                </span>
              </div>
            </a>
          </article>
        );
      })
    }
  </div>
  {labExperiments.length === 0 && (
    <p class="lab-catalogue__empty">Lab projects are temporarily unavailable.</p>
  )}
</section>

<script>
  const ensureVideosPlay = () => {
    document.querySelectorAll<HTMLVideoElement>(".lab-card__media video[autoplay]").forEach((video) => {
      const playVideo = () => {
        if (video.paused) video.play().catch(() => {});
      };

      if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
        playVideo();
      } else {
        video.addEventListener("canplay", playVideo, { once: true });
        if (video.readyState === HTMLMediaElement.HAVE_NOTHING) video.load();
      }

      if (video.dataset.viewportPlaybackReady !== "true") {
        video.dataset.viewportPlaybackReady = "true";
        const observer = new IntersectionObserver((entries) => {
          if (entries.some((entry) => entry.isIntersecting)) playVideo();
        }, { threshold: 0.1 });
        observer.observe(video);
      }
    });
  };

  document.addEventListener("astro:page-load", ensureVideosPlay);
  window.addEventListener("pageshow", ensureVideosPlay);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", ensureVideosPlay, { once: true });
  } else {
    ensureVideosPlay();
  }
</script>

<style>
  .lab-catalogue {
    --pop-blue: #2444ca;
    --pop-pink: #ff7eb5;
    --pop-yellow: #ffe44f;
    --pop-lime: #caff48;
    --pop-cream: #fff8e8;
    --pop-ink: #15130f;
    --pop-border: rgba(21, 19, 15, 0.78);
    padding: clamp(3.5rem, 6vw, 5.5rem) clamp(1rem, 6vw, 6rem) 8px;
    background: var(--pop-blue);
    color: var(--pop-cream);
  }

  .lab-catalogue__header {
    width: min(100%, 1480px);
    margin: 0 auto clamp(5rem, 8vw, 8.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: 8px clamp(2rem, 6vw, 7rem);
    align-items: end;
    color: var(--pop-cream);
  }

  .lab-catalogue__header :is(h1, h2, p) {
    color: inherit;
  }

  .lab-label {
    grid-column: 1 / -1;
    margin: 0;
    font: 750 clamp(0.68rem, 0.9vw, 0.78rem)/1.35 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pop-yellow);
  }

  .lab-catalogue__header :is(h1, h2) {
    margin: 0;
    font: 620 clamp(3.2rem, 6.5vw, 6.5rem)/0.9 var(--font-display);
    letter-spacing: -0.055em;
    text-wrap: balance;
    color: var(--pop-cream);
  }

  .lab-catalogue__header > p:last-child {
    max-width: 40rem;
    margin: 0;
    font: 450 clamp(1.15rem, 1.5vw, 1.5rem)/1.42 var(--font-display);
    letter-spacing: -0.015em;
    text-wrap: pretty;
    color: rgba(255, 248, 232, 0.9);
  }

  .lab-catalogue__grid {
    width: min(100%, 1480px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 8px;
  }

  .lab-card {
    min-height: clamp(520px, 58vw, 680px);
    border: 1px solid var(--pop-border);
    border-radius: clamp(18px, 2vw, 28px);
    overflow: hidden;
  }

  .lab-card:nth-child(4n + 1) {
    grid-column: span 7;
  }

  .lab-card:nth-child(4n + 2) {
    grid-column: span 5;
  }

  .lab-card:nth-child(4n + 3) {
    grid-column: span 5;
  }

  .lab-card:nth-child(4n) {
    grid-column: span 7;
  }

  .lab-card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .lab-card--pink {
    background: var(--pop-pink);
    color: var(--pop-ink);
  }

  .lab-card--blue {
    background: var(--pop-blue);
    color: var(--pop-cream);
  }

  .lab-card--yellow {
    background: var(--pop-yellow);
    color: var(--pop-ink);
  }

  .lab-card--cream {
    background: var(--pop-cream);
    color: var(--pop-ink);
  }

  .lab-card--lime {
    background: var(--pop-lime);
    color: var(--pop-ink);
  }

  .lab-card :is(h3, p, .lab-card__meta, .lab-card__destination) {
    color: inherit;
  }

  .lab-card__shell {
    min-height: inherit;
    padding: 10px;
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  a.lab-card__shell:is(:hover, :focus-visible) {
    color: inherit;
  }

  .lab-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9.5;
    min-height: 260px;
    flex: 1 1 auto;
    margin: 0;
    border: 1px solid currentColor;
    border-radius: clamp(10px, 1.2vw, 16px);
    overflow: hidden;
    background: var(--pop-ink);
  }

  .lab-card__media :is(img, video) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    transition: transform 550ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .lab-card__media--interactive {
    --home-next-border: 0;
    --home-next-radius-panel: 0;
    background: var(--pop-blue);
  }

  .lab-card__copy {
    padding: clamp(1.2rem, 2.2vw, 2rem) clamp(0.65rem, 1.4vw, 1.25rem) clamp(0.75rem, 1.4vw, 1.25rem);
  }

  .lab-card__meta {
    padding-bottom: 0.9rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    border-bottom: 1px solid currentColor;
    font: 750 clamp(0.68rem, 0.9vw, 0.78rem)/1.35 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lab-card__discipline {
    text-align: right;
  }

  .lab-card h3 {
    margin: 1.35rem 0 0.75rem;
    font: 620 clamp(2rem, 4vw, 4.4rem)/0.92 var(--font-display);
    letter-spacing: -0.055em;
  }

  .lab-card p {
    max-width: 44rem;
    margin: 0;
    font: 450 clamp(1rem, 1.12vw, 1.1rem)/1.5 var(--font-body);
    text-wrap: pretty;
  }

  .lab-card__destination {
    min-height: 44px;
    margin-top: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font: 750 0.78rem/1.35 var(--font-mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .lab-card__destination > span:first-child {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  .lab-card__destination > span:last-child {
    display: inline-block;
    text-decoration: none;
    transition: transform 180ms ease;
  }

  .lab-card__shell:hover .lab-card__media :is(img, video),
  .lab-card__shell:focus-visible .lab-card__media :is(img, video) {
    transform: scale(1.025);
  }

  .lab-card__shell:hover .lab-card__destination > span:first-child,
  .lab-card__shell:focus-visible .lab-card__destination > span:first-child,
  .lab-card__destination:hover > span:first-child,
  .lab-card__destination:focus-visible > span:first-child {
    text-decoration-color: currentColor;
  }

  .lab-card__shell:hover .lab-card__destination > span:last-child,
  .lab-card__shell:focus-visible .lab-card__destination > span:last-child,
  .lab-card__destination:hover > span:last-child,
  .lab-card__destination:focus-visible > span:last-child {
    transform: translate(2px, -2px);
  }

  a.lab-card__shell:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: -6px;
  }

  a.lab-card__destination {
    width: fit-content;
    color: inherit;
    text-decoration: none;
  }

  @media (max-width: 980px) {
    .lab-catalogue__header {
      grid-template-columns: 1fr;
    }

    .lab-card:nth-child(n) {
      grid-column: span 6;
    }

    .lab-card:nth-child(3) {
      grid-column: span 12;
    }
  }

  @media (max-width: 720px) {
    .lab-catalogue {
      padding-inline: 1rem;
    }

    .lab-card:nth-child(n) {
      grid-column: 1 / -1;
      min-height: 560px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lab-card__media :is(img, video),
    .lab-card__destination > span:last-child {
      transition-duration: 0.01ms;
    }

    .lab-card__shell:hover .lab-card__media :is(img, video),
    .lab-card__shell:focus-visible .lab-card__media :is(img, video),
    .lab-card__shell:hover .lab-card__destination > span:last-child,
    .lab-card__shell:focus-visible .lab-card__destination > span:last-child {
      transform: none;
    }
  }
</style>

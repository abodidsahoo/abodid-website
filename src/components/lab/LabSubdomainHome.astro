---
import LabExperimentCards from "./LabExperimentCards.astro";
---

<div class="lab-home">
  <section class="lab-home__hero" aria-labelledby="lab-home-title">
    <div class="lab-home__identity">
      <p class="lab-home__label">Abodid Lab · Field notes & prototypes</p>
      <h1 id="lab-home-title">Experiments are how I think in public.</h1>
      <p class="lab-home__lede">
        I’m Abodid Sahoo—a photographer, filmmaker, researcher, and creative
        technologist. This is where images become interfaces, questions become
        prototypes, and unfinished ideas are allowed to stay alive.
      </p>
    </div>

    <aside class="lab-home__cta">
      <p>Everything here is made to be entered, moved, tested, and reconsidered.</p>
      <a href="https://abodid.com/lab">
        <span>Open the experiments</span>
        <span aria-hidden="true">→</span>
      </a>
    </aside>
  </section>

  <section class="lab-home__ethos" aria-labelledby="lab-ethos-title">
    <header>
      <p class="lab-home__label">Why a lab?</p>
      <h2 id="lab-ethos-title">A place for curiosity without a client brief.</h2>
    </header>

    <div class="lab-home__principles">
      <article>
        <span>01</span>
        <h3>Look closer</h3>
        <p>Attention is never neutral. Small details can hold memory, culture, and feeling.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Move differently</h3>
        <p>Interfaces can begin with gesture, rhythm, and the body—not only with clicks.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Keep it playful</h3>
        <p>A prototype can ask a serious question while still inviting wonder and surprise.</p>
      </article>
    </div>
  </section>

  <LabExperimentCards
    title="Selected experiments"
    introduction="A changing set of public prototypes. Each card takes you to the canonical live experiment on abodid.com."
    absoluteLinks={true}
  />

  <section class="lab-home__closing">
    <p class="lab-home__label">The collection will keep changing</p>
    <h2>Follow the questions,<br />then touch the work.</h2>
    <a href="https://abodid.com/lab">
      <span>Visit abodid.com/lab</span>
      <span aria-hidden="true">↗</span>
    </a>
  </section>
</div>

<style>
  .lab-home {
    --pop-blue: #2444ca;
    --pop-pink: #ff7eb5;
    --pop-yellow: #ffe44f;
    --pop-purple: #5524c7;
    --pop-cream: #fff8e8;
    --pop-ink: #15130f;
    color: var(--pop-ink);
  }

  .lab-home__hero {
    min-height: clamp(720px, calc(100svh - 72px), 1000px);
    padding: 8px;
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(360px, 0.72fr);
    gap: 8px;
    background: var(--pop-blue);
  }

  .lab-home__identity,
  .lab-home__cta {
    border: 1px solid rgba(21, 19, 15, 0.78);
    border-radius: clamp(18px, 2vw, 28px);
  }

  .lab-home__identity {
    padding: clamp(2rem, 5vw, 5.5rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--pop-pink);
    color: var(--pop-ink);
  }

  .lab-home__identity :is(h1, p) {
    color: inherit;
  }

  .lab-home__label {
    margin: 0;
    font: 750 clamp(0.68rem, 0.9vw, 0.78rem)/1.35 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .lab-home h1 {
    max-width: 10ch;
    margin: clamp(3rem, 8vw, 8rem) 0 2.5rem;
    font: 620 clamp(3.5rem, 8vw, 8.5rem)/0.84 var(--font-display);
    letter-spacing: -0.075em;
    text-wrap: balance;
  }

  .lab-home__lede {
    max-width: 42rem;
    margin: 0;
    font: 400 clamp(1.35rem, 2vw, 2.1rem)/1.18 var(--font-display);
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }

  .lab-home__cta {
    padding: clamp(1.5rem, 3vw, 3rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--pop-yellow);
    color: var(--pop-ink);
  }

  .lab-home__cta p {
    color: inherit;
  }

  .lab-home__cta p {
    margin: 0;
    font: 480 clamp(1.6rem, 2.8vw, 3.2rem)/1.02 var(--font-display);
    letter-spacing: -0.045em;
    text-wrap: pretty;
  }

  .lab-home__cta a,
  .lab-home__closing a {
    min-height: 52px;
    width: fit-content;
    padding: 0 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid currentColor;
    border-radius: 14px;
    color: inherit;
    font: 750 0.78rem/1.35 var(--font-mono);
    letter-spacing: 0.09em;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .lab-home__cta a:is(:hover, :focus-visible),
  .lab-home__closing a:is(:hover, :focus-visible) {
    color: inherit;
  }

  .lab-home__cta a:hover,
  .lab-home__cta a:focus-visible,
  .lab-home__closing a:hover,
  .lab-home__closing a:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 4px 0 currentColor;
  }

  .lab-home__cta a:focus-visible,
  .lab-home__closing a:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 3px;
  }

  .lab-home__ethos {
    padding: clamp(4rem, 6.5vw, 7rem) clamp(1rem, 6vw, 6rem);
    background: var(--pop-blue);
    color: var(--pop-cream);
  }

  .lab-home__ethos :is(h2, h3, p) {
    color: inherit;
  }

  .lab-home__ethos > header,
  .lab-home__principles {
    width: min(100%, 1480px);
    margin-inline: auto;
  }

  .lab-home__ethos h2,
  .lab-home__closing h2 {
    max-width: 12ch;
    margin: 1.25rem 0 clamp(3rem, 5vw, 5rem);
    font: 620 clamp(3rem, 6.7vw, 7rem)/0.9 var(--font-display);
    letter-spacing: -0.065em;
    text-wrap: balance;
  }

  .lab-home__principles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .lab-home__principles article {
    min-height: 330px;
    padding: clamp(1.5rem, 2.8vw, 2.75rem);
    display: flex;
    flex-direction: column;
    border: 1px solid currentColor;
    border-radius: clamp(14px, 1.5vw, 22px);
  }

  .lab-home__principles article:nth-child(2) {
    background: var(--pop-purple);
  }

  .lab-home__principles span {
    font: 750 0.78rem/1.35 var(--font-mono);
    letter-spacing: 0.1em;
  }

  .lab-home__principles h3 {
    margin: auto 0 0.75rem;
    font: 620 clamp(1.8rem, 3vw, 3.2rem)/0.96 var(--font-display);
    letter-spacing: -0.045em;
  }

  .lab-home__principles p {
    margin: 0;
    font: 450 1rem/1.5 var(--font-body);
  }

  .lab-home__closing {
    min-height: 520px;
    padding: clamp(4rem, 6.5vw, 7rem) clamp(1rem, 6vw, 6rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    background: var(--pop-yellow);
    color: var(--pop-ink);
  }

  .lab-home__closing :is(h2, p) {
    color: inherit;
  }

  .lab-home__closing h2 {
    max-width: 14ch;
  }

  @media (max-width: 980px) {
    .lab-home__hero {
      grid-template-columns: 1fr;
    }

    .lab-home__identity {
      min-height: 620px;
    }

    .lab-home__cta {
      min-height: 320px;
    }

    .lab-home__principles {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .lab-home h1 {
      font-size: clamp(3rem, 15vw, 5rem);
      line-height: 0.88;
    }

    .lab-home__identity {
      min-height: 560px;
    }

    .lab-home__cta a,
    .lab-home__closing a {
      width: 100%;
      justify-content: space-between;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lab-home__cta a,
    .lab-home__closing a {
      transition-duration: 0.01ms;
    }

    .lab-home__cta a:hover,
    .lab-home__cta a:focus-visible,
    .lab-home__closing a:hover,
    .lab-home__closing a:focus-visible {
      transform: none;
    }
  }
</style>

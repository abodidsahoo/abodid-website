---
import LabExperimentCards from "./LabExperimentCards.astro";
---

<div class="lab-index">
  <section class="lab-index__hero" aria-labelledby="lab-index-title">
    <div class="lab-index__title-block">
      <p class="lab-index__label">Abodid.com · Lab</p>
      <h1 id="lab-index-title">Small experiments.<br />Serious questions.</h1>
    </div>
    <div class="lab-index__intro">
      <p>
        A working collection of interactive studies in photography, attention,
        gesture, and visual storytelling.
      </p>
      <span>Choose an experiment below.</span>
    </div>
  </section>

  <LabExperimentCards
    title="Enter the experiments"
    introduction="Each project opens directly into the live experience. No showcase layer between you and the interaction."
  />
</div>

<style>
  .lab-index {
    --pop-blue: #2444ca;
    --pop-pink: #ff7eb5;
    --pop-yellow: #ffe44f;
    --pop-cream: #fff8e8;
    --pop-ink: #15130f;
  }

  .lab-index__hero {
    min-height: clamp(620px, calc(100svh - 72px), 900px);
    padding: clamp(4rem, 7vw, 7rem) clamp(1rem, 6vw, 6rem);
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(320px, 0.7fr);
    gap: 8px;
    background: var(--pop-blue);
    color: var(--pop-cream);
  }

  .lab-index__title-block,
  .lab-index__intro {
    border: 1px solid rgba(255, 248, 232, 0.78);
    border-radius: clamp(18px, 2vw, 28px);
  }

  .lab-index__title-block {
    padding: clamp(1.5rem, 4vw, 4rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: var(--pop-cream);
  }

  .lab-index__title-block :is(h1, p) {
    color: inherit;
  }

  .lab-index__label,
  .lab-index__intro span {
    margin: 0;
    font: 750 clamp(0.68rem, 0.9vw, 0.78rem)/1.35 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .lab-index h1 {
    max-width: 12ch;
    margin: clamp(4rem, 9vw, 9rem) 0 0;
    font: 620 clamp(3.5rem, 8.4vw, 9rem)/0.84 var(--font-display);
    letter-spacing: -0.075em;
    text-wrap: balance;
  }

  .lab-index__intro {
    padding: clamp(1.5rem, 3vw, 3rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--pop-yellow);
    color: var(--pop-ink);
  }

  .lab-index__intro :is(p, span) {
    color: inherit;
  }

  .lab-index__intro p {
    margin: 0;
    font: 480 clamp(1.45rem, 2.4vw, 2.7rem)/1.05 var(--font-display);
    letter-spacing: -0.035em;
    text-wrap: pretty;
  }

  @media (max-width: 980px) {
    .lab-index__hero {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .lab-index__title-block {
      min-height: 520px;
    }

    .lab-index__intro {
      min-height: 300px;
    }
  }

  @media (max-width: 720px) {
    .lab-index__hero {
      padding-inline: 1rem;
    }

    .lab-index__title-block {
      min-height: 440px;
    }

    .lab-index h1 {
      font-size: clamp(3rem, 15vw, 5rem);
      line-height: 0.88;
    }
  }
</style>

---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import OpportunityLanding from '../components/opportunities/OpportunityLanding';
import '../styles/opportunities-editorial.css';
---

<BaseLayout
    title="Opportunity Tracker — No spreadsheets, no lost tabs"
    description="No spreadsheets, no lost tabs, just your next move. Save open calls, grants, residencies, fellowships and creative jobs in one place. Keep track of deadlines and apply on time."
    image="/api/opportunities/social-preview.png"
    imageAlt="Opportunity Tracker — No spreadsheets, no lost tabs, just your next move. Preview of the opportunities dashboard and Chrome extension."
    useDynamicOgImage={false}
    noindex={false}
    fullWidth={true}
    showGlobalGrid={false}
    bodyClass="opportunities-editorial-page otl-page"
    hideHeader={true}
    hideSideMenuRail={true}
    hideFooter={true}
    showNewsletterPopup={false}
>
    <OpportunityLanding client:load />
</BaseLayout>

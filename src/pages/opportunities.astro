---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import OpportunityDashboard from '../components/opportunities/OpportunityDashboard';
import { isRequestAuthenticated } from '../lib/opportunities/auth';
import '../styles/portfolio-pop-editorial.css';
import '../styles/opportunities-editorial.css';

const title = 'Opportunity Desk · Field Radar';
const description = 'Personal field radar, grant tracker, and deadline chronicles.';
const isAuth = isRequestAuthenticated(Astro.request, Astro.cookies);
---

<BaseLayout
    title={title}
    description={description}
    noindex={true}
    fullWidth={true}
    showGlobalGrid={false}
    bodyClass="opportunities-editorial-page"
    navigationVariant="next"
>
    <div id="main-content" style="background: var(--opp-blue); min-height: calc(100svh - 72px);">
        <OpportunityDashboard client:load initialIsAuthenticated={isAuth} />
    </div>
</BaseLayout>

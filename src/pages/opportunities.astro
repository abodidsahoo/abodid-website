---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import OpportunityLanding from '../components/opportunities/OpportunityLanding';
import '../styles/portfolio-pop-editorial.css';
import '../styles/opportunities-editorial.css';
---

<BaseLayout
    title="NextUp by Abodid · Never miss an application deadline"
    description="Save it. Forget it. NextUp makes sure you do not miss the application deadline."
    noindex={false}
    fullWidth={true}
    showGlobalGrid={false}
    bodyClass="opportunities-editorial-page"
    hideHeader={true}
    hideSideMenuRail={true}
    hideFooter={true}
    showNewsletterPopup={false}
>
    <OpportunityLanding client:load />
</BaseLayout>

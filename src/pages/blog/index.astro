---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogFilter from "../../components/BlogFilter.jsx";
import { getAllPosts } from "../../lib/api";
import { breadcrumbJsonLd, personJsonLd } from "../../lib/seoData";
import "../../styles/blog-editorial.css";

const recentPosts = await getAllPosts();
const initialTag = Astro.url.searchParams.get("tag") || Astro.url.searchParams.get("category") || "All";
const pageTitle = "Blog";
const description =
  "Writing by Abodid Sahoo on creative technology, photography, filmmaking, research workflows, Obsidian, AI, visual culture, and learning.";
const structuredData = [
  personJsonLd(),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Blog", path: "/blog" },
  ]),
];
---

<BaseLayout
  title={pageTitle}
  description={description}
  structuredData={structuredData}
  fullWidth
  navigationVariant="next"
  showGlobalGrid={false}
  bodyClass="blog-page"
>
  <div class="blog-editorial">
    <div class="blog-file">
      <header class="blog-masthead">
        <p class="blog-file-tag">blog.js — notes & reflections</p>
        <div class="blog-masthead__hero">
          <h1>Blog</h1>
          <p>
            Notes on creative technology, photography, filmmaking, research workflows,
            Obsidian, AI, visual culture, and learning.
          </p>
        </div>
      </header>
      <div class="blog-board">
        <BlogFilter posts={recentPosts} initialTag={initialTag} client:load />
      </div>
    </div>
  </div>
</BaseLayout>

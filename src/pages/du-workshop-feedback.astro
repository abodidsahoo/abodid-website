---
import FeedbackForm from '../components/feedback/FeedbackForm.astro';
import { getFeedbackForm } from '../lib/feedback/server';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
const form = await getFeedbackForm('delhi-university-ethnographic-filmmaking');
if (!form) return new Response('Feedback form not found.', { status: 404 });
---

<FeedbackForm form={form} />

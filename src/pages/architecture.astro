---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import { personJsonLd, breadcrumbJsonLd } from "../lib/seoData";

const pageTitle = "Website Architecture — Abodid Sahoo";
const pageDescription =
  "A public architecture note for abodid.com, covering the Astro 5.0 SSR, React 19, Supabase, Web Audio API, AI consensus, and performance systems behind the site.";

const structuredData = [
  personJsonLd(),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Architecture", path: "/architecture" },
  ]),
];

const techStack = [
  {
    component: "Framework",
    tech: "Astro 5.0 (SSR) + React 19",
    purpose: "Hybrid rendering for instant loads & island interactivity",
  },
  {
    component: "Design System",
    tech: "Abodid Pop Editorial Tokens",
    purpose: "High-chroma Swiss color-blocking, 8px rhythm & Satoshi typography",
  },
  {
    component: "Animations",
    tech: "GSAP 3 + Framer Motion",
    purpose: "Fluid interactions, tactile hover states & physics gestures",
  },
  {
    component: "Database & Auth",
    tech: "Supabase (PostgreSQL 15)",
    purpose: "Real-time subscriptions, storage & Row-Level Security (RLS)",
  },
  {
    component: "Edge Deployment",
    tech: "Vercel Serverless Edge",
    purpose: "Global CDN distribution, edge functions & sub-50ms TTFB",
  },
  {
    component: "Broadcast & Email",
    tech: "Resend Batch API",
    purpose: "Transactional alerts & audience-segmented newsletters",
  },
  {
    component: "Sound Design",
    tech: "Native Web Audio API",
    purpose: "Real-time FFT audio visualizer & scroll-ducking without bloat",
  },
  {
    component: "AI Perception",
    tech: "OpenRouter Multi-Model Ensemble",
    purpose: "Neuro-symbolic consensus engine measuring human memory vs vision",
  },
];

const consultationHref =
  "/contact?from=%2Farchitecture&source_name=website-architecture&cta=book-consultation";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
  fullWidth={true}
  hideWhatsAppButton={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="pop-arch-page"
>
  <main class="arch-shell">
    <!-- 1. Clean Hero Header -->
    <section class="arch-hero" aria-labelledby="arch-heading">
      <div class="arch-hero__inner">
        <h1 id="arch-heading" class="arch-hero__title">Website Architecture</h1>

        <p class="arch-hero__lede">
          This digital space is a living, breathing extension of my mind — engineered as a high-performance, accessible, and tactile Dark Room for research, cinema, and creative technology.
        </p>
      </div>
    </section>

    <!-- 2. The Core Tech Stack Table -->
    <section class="arch-stack-section" aria-labelledby="stack-heading">
      <div class="arch-stack-card">
        <header class="arch-section-header">
          <div class="arch-section-header__title-block">
            <h2 id="stack-heading" class="arch-section-heading">01 // The Technology Stack</h2>
          </div>
          <p class="arch-section-desc">
            A hybrid edge architecture combining static speed with dynamic real-time capabilities.
          </p>
        </header>

        <div class="arch-table-wrap">
          <table class="arch-tech-table">
            <thead>
              <tr>
                <th scope="col">Layer</th>
                <th scope="col">Technology</th>
                <th scope="col">Purpose &amp; Implementation</th>
              </tr>
            </thead>
            <tbody>
              {techStack.map((item) => (
                <tr>
                  <td data-label="Layer" class="arch-table-layer">
                    <span>{item.component}</span>
                  </td>
                  <td data-label="Technology" class="arch-table-tech">
                    <strong>{item.tech}</strong>
                  </td>
                  <td data-label="Purpose" class="arch-table-purpose">
                    {item.purpose}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 3. Engineering Deep Dives Grid (All 9 Cards Inline) -->
    <section class="arch-deep-dives" aria-label="Architecture deep dives">
      <div class="arch-deep-dives__grid">
        <!-- 02: Typography & Design System -->
        <article class="arch-card arch-card--yellow">
          <div class="arch-card__top">
            <span class="arch-card__num">02</span>
          </div>
          <h3 class="arch-card__title">Typography &amp; Visual Geometry</h3>
          <ul class="arch-feature-list">
            <li>
              <strong>Primary: Satoshi Variable</strong>
              <p>Neo-grotesk display &amp; body hierarchy with tight negative tracking (-0.03em to -0.06em) on display headlines.</p>
            </li>
            <li>
              <strong>8px Structural Seams</strong>
              <p>Precise 8px gaps between color-blocked panels create a tactile, printed publication feel.</p>
            </li>
            <li>
              <strong>Accessible Color Pairings</strong>
              <p>Strict WCAG AA/AAA contrast adherence (Ink on Cream 17.5:1, Ink on Yellow 14.5:1, Cream on Cobalt 7.2:1).</p>
            </li>
          </ul>
        </article>

        <!-- 03: Logic & Edge Pipelines -->
        <article class="arch-card arch-card--cream">
          <div class="arch-card__top">
            <span class="arch-card__num">03</span>
          </div>
          <h3 class="arch-card__title">Logic &amp; Optimization</h3>
          <ul class="arch-feature-list">
            <li>
              <strong>Obsidian Bridge</strong>
              <p>Edge functions parse raw Markdown wikilinks into HTML, bridging private second-brain notes to the public site.</p>
            </li>
            <li>
              <strong>Atomic Research Engine</strong>
              <p>Client-side algorithm builds weighted frequency clouds instantly from JSON tag arrays.</p>
            </li>
            <li>
              <strong>Lazy-Performance</strong>
              <p><code>IntersectionObserver</code> keeps the DOM light, loading 3D and video assets only when scrolled into view.</p>
            </li>
          </ul>
        </article>

        <!-- 04: Native Audio Engine -->
        <article class="arch-card arch-card--lime">
          <div class="arch-card__top">
            <span class="arch-card__num">04</span>
          </div>
          <h3 class="arch-card__title">Native Audio Engine</h3>
          <ul class="arch-feature-list">
            <li>
              <strong>Pure Web Audio API</strong>
              <p>Zero external runtime libraries. Pure browser-native audio processing for lightweight execution.</p>
            </li>
            <li>
              <strong>Real-time FFT Spectrum</strong>
              <p>Visualizes audio frequencies using Fast Fourier Transform data directly on interactive canvas layers.</p>
            </li>
            <li>
              <strong>Scroll-Based Ducking</strong>
              <p>Audio volume smoothly ducks down as you scroll down to read long-form research notes.</p>
            </li>
          </ul>
        </article>

        <!-- 05: Interactive Experiments & Physics -->
        <article class="arch-card arch-card--pink">
          <div class="arch-card__top">
            <span class="arch-card__num">05</span>
          </div>
          <h3 class="arch-card__title">Interactive Experiments</h3>
          <ul class="arch-feature-list">
            <li>
              <strong>Invisible Punctum</strong>
              <p>Live AI model connection analyzes visual composition to generate poetic, sensory interpretations.</p>
            </li>
            <li>
              <strong>Polaroid Physics</strong>
              <p>Card stacking uses natural plane curves and physics-based drag gestures for tactile photo exploration.</p>
            </li>
            <li>
              <strong>Algorithmic Color Clustering</strong>
              <p>Adaptive palette generator clusters pixel data to sense the emotional mood of artwork.</p>
            </li>
          </ul>
        </article>

        <!-- 06: Custom Studio CMS -->
        <article class="arch-card arch-card--cream">
          <div class="arch-card__top">
            <span class="arch-card__num">06</span>
          </div>
          <h3 class="arch-card__title">Custom Studio CMS</h3>
          <ul class="arch-feature-list">
            <li>
              <strong>Content Dashboard</strong>
              <p>Bespoke administrative suite to manage research papers, films, and journals with zero code friction.</p>
            </li>
            <li>
              <strong>Drag &amp; Drop Sequencing</strong>
              <p>Intuitively re-order exhibitions and curated lists using <code>dnd-kit</code> sortable interfaces.</p>
            </li>
            <li>
              <strong>Secure Supabase RLS</strong>
              <p>Database queries secured with Postgres Row Level Security and role-based token authentication.</p>
            </li>
          </ul>
        </article>

        <!-- 07: Broadcast & Newsletter Engine -->
        <article class="arch-card arch-card--yellow">
          <div class="arch-card__top">
            <span class="arch-card__num">07</span>
          </div>
          <h3 class="arch-card__title">Broadcast Engine</h3>
          <ul class="arch-feature-list">
            <li>
              <strong>Resend Batch API</strong>
              <p>Integrated broadcast delivery emailing thousands of subscribers with zero delay or throttling.</p>
            </li>
            <li>
              <strong>Audience Segmentation</strong>
              <p>Dispatches tailored across research collaborators, art patrons, and workshop students.</p>
            </li>
            <li>
              <strong>1-Click Direct Unsubscribe</strong>
              <p>RFC 8058 compliant headers for transparent, instant subscription control.</p>
            </li>
          </ul>
        </article>

        <!-- 08: Ethics & Performance -->
        <article class="arch-card arch-card--lime">
          <div class="arch-card__top">
            <span class="arch-card__num">08</span>
          </div>
          <h3 class="arch-card__title">Ethics &amp; Optimization</h3>
          <ul class="arch-feature-list">
            <li>
              <strong>Inclusive Design</strong>
              <p>ARIA-labeled visualizers, semantic HTML5 elements, and keyboard-first navigation paths.</p>
            </li>
            <li>
              <strong>Zero-Tracking Policy</strong>
              <p>No advertising pixels, no behavioral profiling, and no surveillance cookies.</p>
            </li>
            <li>
              <strong>Reduced Motion</strong>
              <p>Honors <code>prefers-reduced-motion</code> by disabling complex physics and spatial transforms.</p>
            </li>
          </ul>
        </article>

        <!-- 09: Award Protocols & Targets -->
        <article class="arch-card arch-card--cream">
          <div class="arch-card__top">
            <span class="arch-card__num">09</span>
          </div>
          <h3 class="arch-card__title">Award Protocols</h3>
          <ul class="arch-feature-list">
            <li>
              <strong>4x100 Target Lighthouse</strong>
              <p>Static generation + edge caching engineered for Performance, Accessibility, Best Practices &amp; SEO.</p>
            </li>
            <li>
              <strong>Progressive Enhancement</strong>
              <p>Core content renders without JavaScript. Rich client interactive layers enhance the experience.</p>
            </li>
            <li>
              <strong>Automated JSON-LD</strong>
              <p>Rich schema.org Person, CreativeWork, and Breadcrumb structured data on every route.</p>
            </li>
          </ul>
        </article>

        <!-- 10: Punctum AI Architecture (Inline Card 10) -->
        <article class="arch-card arch-card--pink">
          <div class="arch-card__top">
            <span class="arch-card__num">10</span>
          </div>
          <h3 class="arch-card__title">Punctum AI Architecture</h3>
          <ul class="arch-feature-list">
            <li>
              <strong>Neuro-Symbolic Pipeline</strong>
              <p>Combines NVIDIA Vision for raw visual perception with Gemini Pro for poetic contextual synthesis.</p>
            </li>
            <li>
              <strong>Consensus Engine</strong>
              <p>Calculates the mathematical distance between Machine Interpretation and Human Memory to produce a Consensus Score.</p>
            </li>
            <li>
              <a href="/architecture/punctum" class="arch-card-link">
                <span>View full schematic</span>
                <span class="link-destination-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          </ul>
        </article>
      </div>
    </section>

    <!-- 4. Closing Consultation Card (High Contrast Dark Text on Yellow) -->
    <section class="arch-cta-section" aria-labelledby="cta-heading">
      <div class="arch-cta-card">
        <div class="arch-cta-card__copy">
          <h2 id="cta-heading" class="arch-cta-card__title">Build a website or resource system like this.</h2>
          <p class="arch-cta-card__text">
            I can help you design and build a bespoke content architecture, high-performance website, or interactive research platform in seven days.
          </p>
        </div>
        <a href={consultationHref} class="arch-cta-btn">
          <span>Book a Consultation</span>
          <span class="link-destination-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>

  <!-- Floating Consultation Drawer Widget -->
  <aside id="floating-consult-cta" class="floating-consult-cta" aria-hidden="true">
    <p class="floating-consult-copy">Build a site like this in 7 days</p>
    <a href={consultationHref} class="floating-consult-button">
      <span>Book Consultation</span>
      <span class="link-destination-arrow" aria-hidden="true">↗</span>
    </a>
  </aside>

  <script>
    const floatingConsultCta = document.getElementById("floating-consult-cta");

    if (floatingConsultCta) {
      let scrollEvents = 0;
      const minScrollDistance = 120;
      const minScrollEvents = 2;

      const syncFloatingCta = () => {
        const shouldShow =
          scrollEvents >= minScrollEvents && window.scrollY >= minScrollDistance;
        floatingConsultCta.classList.toggle("is-visible", shouldShow);
        floatingConsultCta.setAttribute(
          "aria-hidden",
          shouldShow ? "false" : "true"
        );
      };

      let framePending = false;
      window.addEventListener(
        "scroll",
        () => {
          scrollEvents += 1;
          if (framePending) return;
          framePending = true;
          window.requestAnimationFrame(() => {
            syncFloatingCta();
            framePending = false;
          });
        },
        { passive: true }
      );

      syncFloatingCta();
    }
  </script>
</BaseLayout>

<style is:global>
  body.pop-arch-page {
    --pop-blue: #2444ca;
    --pop-pink: #ff7eb5;
    --pop-yellow: #ffe44f;
    --pop-lime: #caff48;
    --pop-orange: #ff875c;
    --pop-purple: #5524c7;
    --pop-cyan: #62e6ff;
    --pop-cream: #fff8e8;
    --pop-ink: #15130f;
    --pop-border: rgba(21, 19, 15, 0.78);
    --pop-line: rgba(21, 19, 15, 0.24);
    --pop-gap: 8px;
    --pop-radius-panel: clamp(18px, 2vw, 28px);
    --pop-radius-card: clamp(14px, 1.5vw, 22px);
    --pop-radius-control: 14px;
    --pop-motion: 180ms ease;

    background: var(--pop-blue);
    color: var(--pop-ink);
  }

  html:has(body.pop-arch-page) {
    background: var(--pop-blue);
  }

  /* Robust contrast enforcement for headings and body copy */
  body.pop-arch-page h1,
  body.pop-arch-page h2,
  body.pop-arch-page h3,
  body.pop-arch-page p,
  body.pop-arch-page span,
  body.pop-arch-page li,
  body.pop-arch-page strong,
  body.pop-arch-page th,
  body.pop-arch-page td,
  body.pop-arch-page a {
    color: var(--pop-ink);
  }
</style>

<style>
  .arch-shell {
    display: flex;
    flex-direction: column;
    gap: var(--pop-gap);
    padding: var(--pop-gap);
    max-width: 1480px;
    margin: 0 auto;
  }

  /* Hero Section */
  .arch-hero {
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-panel);
    background: var(--pop-pink);
    color: var(--pop-ink) !important;
    padding: clamp(2.5rem, 5.5vw, 4.5rem) clamp(1.5rem, 4vw, 4rem);
  }

  .arch-hero__inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 900px;
  }

  .arch-hero__title {
    font: 720 clamp(2.8rem, 6.5vw, 5.5rem)/0.92 var(--font-display, sans-serif);
    letter-spacing: -0.05em;
    margin: 0;
    color: var(--pop-ink) !important;
    text-wrap: balance;
  }

  .arch-hero__lede {
    font: 480 clamp(1.15rem, 1.8vw, 1.5rem)/1.35 var(--font-display, sans-serif);
    letter-spacing: -0.02em;
    color: var(--pop-ink) !important;
    margin: 0;
    max-width: 50rem;
    text-wrap: pretty;
  }

  /* Tech Stack Table Card */
  .arch-stack-section {
    width: 100%;
  }

  .arch-stack-card {
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-panel);
    background: var(--pop-cream);
    color: var(--pop-ink) !important;
    padding: clamp(2rem, 4.5vw, 3.5rem) clamp(1.5rem, 3.5vw, 3.5rem);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .arch-section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--pop-line);
  }

  .arch-section-header__title-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .arch-section-heading {
    font: 650 clamp(2rem, 4vw, 3.2rem)/0.96 var(--font-display, sans-serif);
    letter-spacing: -0.045em;
    margin: 0;
    color: var(--pop-ink) !important;
  }

  .arch-section-desc {
    font: 450 clamp(0.95rem, 1.1vw, 1.05rem)/1.5 var(--font-body, sans-serif);
    margin: 0;
    color: rgba(21, 19, 15, 0.8) !important;
    max-width: 480px;
  }

  .arch-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-card);
    background: #ffffff;
  }

  .arch-tech-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.95rem;
  }

  .arch-tech-table th {
    background: var(--pop-yellow);
    border-bottom: 1px solid var(--pop-border);
    padding: 1rem 1.25rem;
    color: var(--pop-ink) !important;
    font: 750 0.78rem/1 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .arch-tech-table td {
    padding: 1.15rem 1.25rem;
    border-bottom: 1px solid var(--pop-line);
    color: var(--pop-ink) !important;
    vertical-align: middle;
  }

  .arch-tech-table tbody tr:last-child td {
    border-bottom: none;
  }

  .arch-table-layer span {
    font: 700 0.85rem/1.2 var(--font-mono, monospace);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--pop-ink) !important;
  }

  .arch-table-tech {
    font: 600 1rem/1.3 var(--font-display, sans-serif);
  }

  .arch-table-tech strong {
    color: var(--pop-ink) !important;
  }

  .arch-table-purpose {
    font: 450 0.94rem/1.5 var(--font-body, sans-serif);
    color: rgba(21, 19, 15, 0.85) !important;
  }

  /* Deep Dives Grid */
  .arch-deep-dives {
    display: flex;
    flex-direction: column;
    gap: var(--pop-gap);
  }

  .arch-deep-dives__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--pop-gap);
  }

  .arch-card {
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-panel);
    padding: clamp(1.5rem, 2.5vw, 2.2rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--pop-ink) !important;
    transition: transform var(--pop-motion), box-shadow var(--pop-motion);
  }

  .arch-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(21, 19, 15, 0.08);
  }

  .arch-card--yellow { background: var(--pop-yellow); }
  .arch-card--cream { background: var(--pop-cream); }
  .arch-card--lime { background: var(--pop-lime); }
  .arch-card--pink { background: var(--pop-pink); }

  .arch-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--pop-line);
  }

  .arch-card__num {
    font: 750 0.85rem/1 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    color: var(--pop-ink) !important;
  }

  .arch-card__title {
    font: 650 clamp(1.3rem, 1.8vw, 1.7rem)/1.1 var(--font-display, sans-serif);
    letter-spacing: -0.03em;
    margin: 0;
    color: var(--pop-ink) !important;
  }

  .arch-feature-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .arch-feature-list li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .arch-feature-list strong {
    font: 650 0.95rem/1.3 var(--font-display, sans-serif);
    color: var(--pop-ink) !important;
  }

  .arch-feature-list p {
    font: 450 0.88rem/1.5 var(--font-body, sans-serif);
    margin: 0;
    color: rgba(21, 19, 15, 0.85) !important;
  }

  .arch-feature-list code {
    font: 700 0.85em var(--font-mono, monospace);
    background: rgba(21, 19, 15, 0.08);
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    color: var(--pop-ink) !important;
  }

  .arch-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    font: 750 0.84rem/1 var(--font-mono, monospace);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 3px;
    color: var(--pop-ink) !important;
  }

  .arch-card-link:hover {
    color: var(--pop-blue) !important;
  }

  /* Closing Consultation Card */
  .arch-cta-section {
    width: 100%;
  }

  .arch-cta-card {
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-panel);
    background: var(--pop-yellow);
    color: var(--pop-ink) !important;
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 3.5vw, 3.5rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .arch-cta-card__copy {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 720px;
  }

  .arch-cta-card__title {
    font: 650 clamp(1.8rem, 3.2vw, 2.6rem)/1.05 var(--font-display, sans-serif);
    letter-spacing: -0.04em;
    margin: 0;
    color: var(--pop-ink) !important;
  }

  .arch-cta-card__text {
    font: 450 clamp(0.95rem, 1.1vw, 1.08rem)/1.55 var(--font-body, sans-serif);
    margin: 0;
    color: var(--pop-ink) !important;
  }

  .arch-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 54px;
    padding: 0 1.75rem;
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-control);
    background: var(--pop-cream);
    color: var(--pop-ink) !important;
    font: 750 0.88rem/1 var(--font-mono, monospace);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;

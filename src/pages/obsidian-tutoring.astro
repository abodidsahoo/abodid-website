---
import ObsidianLandingPage from "../components/obsidian/ObsidianLandingPage.astro";

const accordions = [
  { title: "Start", body: "Obsidian from zero, without the confusing internet rabbit hole." },
  { title: "Connect", body: "Notes, tags, backlinks and metadata that connect related thoughts." },
  { title: "Recall", body: "Find the right idea when you need to write, speak, create or make a decision." },
];

const hubLinks = [
  {
    title: "Academic Researchers",
    body: "Zotero, citations, synthesis and academic writing.",
    href: "/obsidian-for-researchers",
  },
  {
    title: "Creative Artists & Filmmakers",
    body: "Ideas, locations, people, references and projects.",
    href: "/obsidian-for-filmmakers",
  },
  {
    title: "Bloggers & Writers",
    body: "Bookmarks, research, thoughts and growing long-form writing.",
    href: "/obsidian-for-writers",
  },
];
---

<ObsidianLandingPage
  pageTitle="Obsidian Tutoring"
  description="One-to-one Obsidian tutoring with Abodid Sahoo. Build a simple note system that helps you capture, connect and recall ideas when you need them."
  path="/obsidian-tutoring"
  eyebrow="1:1 Obsidian Tutoring"
  headingLines={["Stop watching Obsidian tutorials.", "Start using it."]}
  bodyBeforeStrong="I'll show you my real vault, understand how you currently take notes, and help you build a simple system that works for the way "
  bodyStrong="you"
  bodyAfterStrong=" think."
  bodyEmphasis="Capture ideas. Connect them. Recall them efficiently when you actually need them."
  priceLines={[
    { text: "£90/hour", strike: true },
    { text: "£60/hour until 31 December 2026", strong: true },
  ]}
  showPayment={true}
  secondaryCta="Book 1:1 tutoring →"
  secondHeading="Your notes should find their way back to you."
  visualHeading="[[an-idea]] ↔ [[another-idea]]"
  visualCta="Move your cursor to reveal the live vault tags ↗"
  visualDetails={["backlinks: 2", "type: thought", "status: connected"]}
  accordions={accordions}
  hubHeading="Looking for something more specific?"
  hubLinks={hubLinks}
  endPrompt="Not sure where you fit?"
  sourceName="obsidian-tutoring"
  contactInterest="General Obsidian tutoring"
/>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="OG Image Preview & Testing">
    <div class="og-preview-container">
        <header class="og-preview-header">
            <span class="pop-brand-tag">⚡ ABODID POP ENGINE</span>
            <h1>Open Graph Social Share Studio</h1>
            <p class="subtitle">
                Real-time preview and debug studio for social share cards (WhatsApp, Twitter/X, iMessage, LinkedIn, Facebook).
            </p>
        </header>

        <!-- Dynamic OG Image Preview -->
        <section class="preview-section">
            <h2>🎨 Dynamic Card Controls</h2>
            
            <div class="controls-grid">
                <div class="input-group">
                    <label for="titleInput">Card Title</label>
                    <input
                        type="text"
                        id="titleInput"
                        placeholder="Enter page title (e.g. Curated Opportunities)"
                        value="Curated Opportunities"
                    />
                </div>

                <div class="input-group">
                    <label for="descInput">Subtitle / Description</label>
                    <input
                        type="text"
                        id="descInput"
                        placeholder="Enter short description"
                        value="Curated artist residencies, grants, fellowships, and creative tech open calls."
                    />
                </div>

                <div class="controls-row">
                    <div class="input-group">
                        <label for="themeSelect">Color Theme</label>
                        <select id="themeSelect">
                            <option value="">Auto (Category / Cycling)</option>
                            <option value="yellow">Pop Yellow (#ffe44f)</option>
                            <option value="blue">Cobalt Blue (#2444ca)</option>
                            <option value="purple">Vibrant Purple (#5524c7)</option>
                            <option value="lime">Pop Lime (#caff48)</option>
                            <option value="pink">Electric Pink (#ff7eb5)</option>
                            <option value="cyan">Neon Cyan (#62e6ff)</option>
                            <option value="orange">Bright Orange (#ff875c)</option>
                            <option value="cream">Swiss Cream (#fff8e8)</option>
                            <option value="dark">Dark Ink (#15130f)</option>
                        </select>
                    </div>

                    <div class="input-group">
                        <label for="categoryInput">Category Tag</label>
                        <input
                            type="text"
                            id="categoryInput"
                            placeholder="e.g. OPPORTUNITIES, PHOTOGRAPHY"
                            value="OPPORTUNITIES"
                        />
                    </div>
                </div>

                <div class="btn-actions">
                    <button id="previewBtn" class="primary-btn">⚡ Render Social Card</button>
                    <button id="copyUrlBtn" class="secondary-btn">📋 Copy Image URL</button>
                </div>
            </div>

            <div class="image-preview-wrapper">
                <div class="image-preview">
                    <img
                        id="ogImage"
                        src="/api/og?title=Curated%20Opportunities&description=Curated%20artist%20residencies%2C%20grants%2C%20fellowships%2C%20and%20creative%20tech%20open%20calls.&category=OPPORTUNITIES"
                        alt="OG Image Preview"
                    />
                </div>
                <div class="preview-meta">
                    <span class="badge">1200 × 630 px</span>
                    <span class="badge">Satoshi Typography</span>
                    <span class="badge">Safe WhatsApp Margins</span>
                </div>
            </div>
        </section>

        <!-- Major Pages Quick Links -->
        <section class="quick-links-section">
            <h2>📄 Preset Page Archetypes</h2>
            <div class="page-grid">
                <button class="page-btn" data-title="Curated Opportunities" data-desc="Curated artist residencies, grants, fellowships, and creative tech open calls." data-cat="OPPORTUNITIES" data-theme="yellow">
                    ⚡ Opportunities Radar
                </button>
                <button class="page-btn" data-title="Photography Studio" data-desc="Selected visual works, fine art, and human portraiture." data-cat="PHOTOGRAPHY" data-theme="yellow">
                    📷 Photography Studio
                </button>
                <button class="page-btn" data-title="Cinematography & Films" data-desc="Narrative shorts, documentaries, and audiovisual storytelling." data-cat="CINEMA & FILM" data-theme="purple">
                    🎬 Cinema & Films
                </button>
                <button class="page-btn" data-title="Punctum AI Perception" data-desc="Neuro-symbolic consensus engine measuring memory vs machine vision." data-cat="LAB & RESEARCH" data-theme="lime">
                    🔬 Punctum AI Lab
                </button>
                <button class="page-btn" data-title="Website Architecture" data-desc="A public architecture note covering Astro SSR, React 19, Supabase & Web Audio." data-cat="ARCHITECTURE" data-theme="blue">
                    📐 Architecture
                </button>
                <button class="page-btn" data-title="Obsidian Vault" data-desc="Connected atomic notes, research syntheses, and technical explorations." data-cat="OBSIDIAN VAULT" data-theme="cream">
                    📚 Obsidian Vault
                </button>
                <button class="page-btn" data-title="Creative Tech Toolkit" data-desc="Open-source instruments, audio synthesis, and interactive shader toys." data-cat="LAB & TECH" data-theme="cyan">
                    🛠️ Creative Tech
                </button>
                <button class="page-btn" data-title="Visual Storytelling Workshop" data-desc="Hands-on masterclass in non-linear editing, pacing, and color grading." data-cat="WORKSHOPS" data-theme="orange">
                    🎓 Workshops
                </button>
            </div>
        </section>

        <!-- WhatsApp Testing Instructions -->
        <section class="whatsapp-section">
            <h2>💬 Testing on WhatsApp & Social Media</h2>
            <div class="instructions">
                <ol>
                    <li>
                        <strong>Deploy your site</strong> to production or staging (WhatsApp requires public HTTPS access).
                    </li>
                    <li>
                        <strong>Copy any URL</strong> you want to test (e.g. <code>https://abodid.com/opportunities</code>).
                    </li>
                    <li><strong>Open WhatsApp</strong> and paste the URL in any chat.</li>
                    <li>
                        <strong>Inspect the preview</strong> — WhatsApp automatically pulls the high-contrast Satoshi Pop card with safe padding.
                    </li>
                </ol>
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    .og-preview-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 48px 24px 80px;
        font-family: var(--font-sans, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    }

    .og-preview-header {
        margin-bottom: 40px;
    }

    .pop-brand-tag {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 999px;
        background: var(--pop-yellow);
        color: var(--pop-ink);
        font-weight: 900;
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        margin-bottom: 12px;
        border: 2px solid var(--pop-ink);
    }

    h1 {
        font-size: 2.4rem;
        font-weight: 850;
        letter-spacing: -0.03em;
        margin: 0 0 10px 0;
        color: var(--text-primary, #111827);
    }

    .subtitle {
        font-size: 1.1rem;
        color: var(--text-secondary, #6b7280);
        margin: 0;
        max-width: 680px;
        line-height: 1.5;
    }

    .preview-section,
    .quick-links-section,
    .whatsapp-section {
        background: var(--bg-card, #ffffff);
        border: 2px solid var(--pop-ink);
        border-radius: 16px;
        padding: 28px;
        margin-bottom: 32px;
        box-shadow: 4px 4px 0px var(--pop-ink);
    }

    h2 {
        font-size: 1.35rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin: 0 0 18px 0;
        color: var(--text-primary, #111827);
    }

    .controls-grid {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-bottom: 24px;
    }

    .controls-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .input-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .input-group label {
        font-size: 0.8rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #374151;
    }

    .input-group input,
    .input-group select {
        padding: 12px 14px;
        font-size: 0.95rem;
        font-weight: 600;
        border: 2px solid var(--pop-ink);
        border-radius: 8px;
        outline: none;
        background: #fafafa;
    }

    .input-group input:focus,
    .input-group select:focus {
        border-color: var(--pop-purple);
        background: #ffffff;
    }

    .btn-actions {
        display: flex;
        gap: 12px;
        margin-top: 6px;
    }

    .primary-btn {
        padding: 12px 22px;
        background: var(--pop-yellow);
        color: var(--pop-ink);
        border: 2px solid var(--pop-ink);
        border-radius: 8px;
        font-weight: 850;
        font-size: 0.92rem;
        cursor: pointer;
        box-shadow: 2px 2px 0px var(--pop-ink);
        transition: transform 0.1s ease;
    }

    .primary-btn:hover {
        transform: translateY(-1px);
        box-shadow: 3px 3px 0px var(--pop-ink);
    }

    .secondary-btn {
        padding: 12px 20px;
        background: #ffffff;
        color: var(--pop-ink);
        border: 2px solid var(--pop-ink);
        border-radius: 8px;
        font-weight: 750;
        font-size: 0.92rem;
        cursor: pointer;
        box-shadow: 2px 2px 0px var(--pop-ink);
    }

    .image-preview-wrapper {
        margin-top: 24px;
    }

    .image-preview {
        border: 2px solid var(--pop-ink);
        border-radius: 12px;
        overflow: hidden;
        background: var(--pop-ink);
        aspect-ratio: 1200 / 630;
    }

    .image-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .preview-meta {
        display: flex;
        gap: 8px;
        margin-top: 12px;
    }

    .badge {
        font-size: 0.75rem;
        font-weight: 750;
        padding: 4px 10px;
        background: #f3f4f6;
        border: 1.5px solid #d1d5db;
        border-radius: 6px;
        color: #374151;
    }

    .page-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 12px;
    }

    .page-btn {
        padding: 12px 14px;
        background: #ffffff;
        border: 2px solid var(--pop-ink);
        border-radius: 8px;
        font-size: 0.88rem;
        font-weight: 750;
        text-align: left;
        cursor: pointer;
        box-shadow: 2px 2px 0px var(--pop-ink);
        transition: all 0.12s ease;
    }

    .page-btn:hover {
        background: var(--pop-yellow);
        transform: translateY(-1px);
        box-shadow: 3px 3px 0px var(--pop-ink);
    }

    .instructions ol {
        margin: 0;
        padding-left: 20px;
        line-height: 1.8;
        color: #374151;
    }
</style>

<script>
    const titleInput = document.getElementById("titleInput") as HTMLInputElement;
    const descInput = document.getElementById("descInput") as HTMLInputElement;
    const themeSelect = document.getElementById("themeSelect") as HTMLSelectElement;
    const categoryInput = document.getElementById("categoryInput") as HTMLInputElement;
    const previewBtn = document.getElementById("previewBtn") as HTMLButtonElement;
    const copyUrlBtn = document.getElementById("copyUrlBtn") as HTMLButtonElement;
    const ogImage = document.getElementById("ogImage") as HTMLImageElement;

    function buildOgUrl() {
        const title = titleInput?.value || "Abodid Sahoo";
        const desc = descInput?.value || "";
        const theme = themeSelect?.value || "";
        const cat = categoryInput?.value || "";

        const params = new URLSearchParams();
        params.set("title", title);
        if (desc) params.set("description", desc);
        if (theme) params.set("theme", theme);
        if (cat) params.set("category", cat);

        return `/api/og?${params.toString()}`;
    }

    function updatePreview() {
        ogImage.src = buildOgUrl();
    }

    previewBtn?.addEventListener("click", updatePreview);
    [titleInput, descInput, categoryInput].forEach((el) => {
        el?.addEventListener("keypress", (e) => {
            if (e.key === "Enter") updatePreview();
        });
    });
    themeSelect?.addEventListener("change", updatePreview);

    // Presets
    const pageButtons = document.querySelectorAll(".page-btn");
    pageButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
            const title = btn.getAttribute("data-title") || "";
            const desc = btn.getAttribute("data-desc") || "";
            const cat = btn.getAttribute("data-cat") || "";
            const theme = btn.getAttribute("data-theme") || "";

            if (titleInput) titleInput.value = title;
            if (descInput) descInput.value = desc;
            if (categoryInput) categoryInput.value = cat;
            if (themeSelect) themeSelect.value = theme;

            updatePreview();
        });
    });

    // Copy URL
    copyUrlBtn?.addEventListener("click", async () => {
        const fullUrl = new URL(buildOgUrl(), window.location.origin).toString();
        try {
            await navigator.clipboard.writeText(fullUrl);
            copyUrlBtn.textContent = "✓ Copied Link!";
            setTimeout(() => {
                copyUrlBtn.textContent = "📋 Copy Image URL";
            }, 2000);
        } catch (err) {
            console.error("Copy failed:", err);
        }
    });
</script>

---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import { personJsonLd, breadcrumbJsonLd } from "../../lib/seoData";

const pageTitle = "Punctum Architecture — Neuro-Symbolic Logic";
const pageDescription =
  "Architecture notes for the Invisible Punctums analysis system, including image perception, human memory input, consensus scoring, and poetic synthesis.";

const structuredData = [
  personJsonLd(),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Architecture", path: "/architecture" },
    { name: "Punctum Schematic", path: "/architecture/punctum" },
  ]),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
  fullWidth={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="pop-arch-page"
>
  <main class="arch-shell">
    <!-- 1. Clean Hero Header -->
    <section class="arch-hero" aria-labelledby="punctum-arch-heading">
      <div class="arch-hero__inner">
        <div class="arch-hero__top-row">
          <a href="/architecture" class="arch-back-btn">
            <span aria-hidden="true">←</span>
            <span>Back to Architecture</span>
          </a>
        </div>

        <h1 id="punctum-arch-heading" class="arch-hero__title">Punctum // Neuro-Symbolic Logic</h1>

        <p class="arch-hero__lede">
          An automated system for aesthetic judgment. How we taught a machine to "feel" images by measuring the mathematical distance between human memory and computer vision.
        </p>
      </div>
    </section>

    <!-- 2. The Core Pipeline Flowchart -->
    <section class="arch-pipeline-section" aria-labelledby="loop-heading">
      <div class="arch-pipeline-card">
        <header class="arch-section-header">
          <div class="arch-section-header__title-block">
            <h2 id="loop-heading" class="arch-section-heading">01 // The Feedback Loop</h2>
          </div>
          <p class="arch-section-desc">
            The multi-stage sensory pipeline translating visual perception into consensus scoring.
          </p>
        </header>

        <div class="arch-flow-grid">
          <div class="arch-flow-node arch-flow-node--yellow">
            <span class="arch-flow-node__step">STEP 01 // INPUT</span>
            <h3 class="arch-flow-node__title">Image + Audio</h3>
            <p class="arch-flow-node__desc">High-resolution frame input combined with user-submitted memory prompts.</p>
          </div>

          <div class="arch-flow-arrow" aria-hidden="true">→</div>

          <div class="arch-flow-node arch-flow-node--lime">
            <span class="arch-flow-node__step">STEP 02 // PERCEPTION</span>
            <h3 class="arch-flow-node__title">Vision Models</h3>
            <p class="arch-flow-node__desc">Nvidia Nemotron 12B + Llama 3.2 edge detection and scene composition.</p>
          </div>

          <div class="arch-flow-arrow" aria-hidden="true">→</div>

          <div class="arch-flow-node arch-flow-node--pink">
            <span class="arch-flow-node__step">STEP 03 // SYNTHESIS</span>
            <h3 class="arch-flow-node__title">Consensus Engine</h3>
            <p class="arch-flow-node__desc">Mathematical vector calculation comparing AI analysis vs Human feeling.</p>
          </div>

          <div class="arch-flow-arrow" aria-hidden="true">→</div>

          <div class="arch-flow-node arch-flow-node--cream">
            <span class="arch-flow-node__step">STEP 04 // OUTPUT</span>
            <h3 class="arch-flow-node__title">Poetic Analysis</h3>
            <p class="arch-flow-node__desc">Structured JSON gap report, consensus rating (0-100), and emotional narrative.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Technical Modules Deep Dive Grid -->
    <section class="arch-deep-dives" aria-label="Detailed technical modules">
      <div class="arch-deep-dives__grid">
        <!-- 02: Vision Stack -->
        <article class="arch-card arch-card--yellow">
          <div class="arch-card__top">
            <span class="arch-card__num">02</span>
          </div>
          <h3 class="arch-card__title">The Eye (Vision Stack)</h3>
          <ul class="arch-feature-list">
            <li>
              <strong>Primary: Nvidia Nemotron 12B</strong>
              <p>Specialized quantized vision model optimized for edge detection, framing composition, and raw physical presence.</p>
            </li>
            <li>
              <strong>Fallback: Llama 3.2 11B</strong>
              <p>Multimodal redundancy providing secondary verification if primary vision bounds fail.</p>
            </li>
            <li>
              <strong>Barthesian Constraints</strong>
              <p>Strictly structured JSON separating "Studium" (cultural context) from "Punctum" (emotional prick).</p>
            </li>
          </ul>
        </article>

        <!-- 03: The Voice -->
        <article class="arch-card arch-card--cream">
          <div class="arch-card__top">
            <span class="arch-card__num">03</span>
          </div>
          <h3 class="arch-card__title">The Voice (Synthesis)</h3>
          <ul class="arch-feature-list">
            <li>
              <strong>Mistral Small 24B Engine</strong>
              <p>Distinct literary personality tuned for poetic synthesis, avoiding corporate sterility.</p>
            </li>
            <li>
              <strong>Keyword Extraction</strong>
              <p>Maps stream tokens into curated emotional triads (e.g. <code>["Nostalgia", "Decay", "Warmth"]</code>).</p>
            </li>
            <li>
              <strong>Strict JSON Schemas</strong>
              <p>Guarantees clean client serialization and deterministic UI component binding.</p>
            </li>
          </ul>
        </article>

        <!-- 04: The Consensus Engine -->
        <article class="arch-card arch-card--lime">
          <div class="arch-card__top">
            <span class="arch-card__num">04</span>
          </div>
          <h3 class="arch-card__title">The Consensus Engine</h3>
          <ul class="arch-feature-list">
            <li>
              <strong>Mathematical Distance</strong>
              <p>Calculates: <code>SCORE = 100 - (|Vector(Human_Emotion) - Vector(AI_Analysis)|)</code>.</p>
            </li>
            <li>
              <strong>High Score (&gt;80)</strong>
              <p>Universal Alignment — the visual meaning translates cleanly across silicon and biological substrates.</p>
            </li>
            <li>
              <strong>Low Score (&lt;40)</strong>
              <p>Human Singularity — subjective emotional memory that the machine cannot replicate or compute.</p>
            </li>
          </ul>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  body.pop-arch-page {
    --pop-blue: #2444ca;
    --pop-pink: #ff7eb5;
    --pop-yellow: #ffe44f;
    --pop-lime: #caff48;
    --pop-orange: #ff875c;
    --pop-purple: #5524c7;
    --pop-cyan: #62e6ff;
    --pop-cream: #fff8e8;
    --pop-ink: #15130f;
    --pop-border: rgba(21, 19, 15, 0.78);
    --pop-line: rgba(21, 19, 15, 0.24);
    --pop-gap: 8px;
    --pop-radius-panel: clamp(18px, 2vw, 28px);
    --pop-radius-card: clamp(14px, 1.5vw, 22px);
    --pop-radius-control: 14px;
    --pop-motion: 180ms ease;

    background: var(--pop-blue);
    color: var(--pop-ink);
  }

  html:has(body.pop-arch-page) {
    background: var(--pop-blue);
  }

  /* Universal deep ink contrast override for all text elements */
  body.pop-arch-page,
  body.pop-arch-page h1,
  body.pop-arch-page h2,
  body.pop-arch-page h3,
  body.pop-arch-page h4,
  body.pop-arch-page h5,
  body.pop-arch-page h6,
  body.pop-arch-page p,
  body.pop-arch-page span,
  body.pop-arch-page small,
  body.pop-arch-page li,
  body.pop-arch-page strong,
  body.pop-arch-page em,
  body.pop-arch-page b,
  body.pop-arch-page th,
  body.pop-arch-page td,
  body.pop-arch-page a,
  body.pop-arch-page div {
    color: var(--pop-ink);
  }
</style>

<style>
  .arch-shell {
    display: flex;
    flex-direction: column;
    gap: var(--pop-gap);
    padding: var(--pop-gap);
    max-width: 1480px;
    margin: 0 auto;
  }

  .arch-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1rem;
    border: 1.5px solid var(--pop-border);
    border-radius: var(--pop-radius-control);
    background: var(--pop-cream);
    color: var(--pop-ink) !important;
    font: 750 clamp(0.74rem, 0.9vw, 0.82rem)/1 var(--font-mono, monospace);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    width: fit-content;
    transition: transform var(--pop-motion), box-shadow var(--pop-motion);
  }

  .arch-back-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(21, 19, 15, 0.12);
  }

  .arch-hero {
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-panel);
    background: var(--pop-pink);
    color: var(--pop-ink) !important;
    padding: clamp(2.5rem, 5.5vw, 4.5rem) clamp(1.5rem, 4vw, 4rem);
  }

  .arch-hero__inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 900px;
  }

  .arch-hero__top-row {
    margin-bottom: 0.25rem;
  }

  .arch-hero__title {
    font: 720 clamp(2.6rem, 6vw, 5rem)/0.92 var(--font-display, sans-serif);
    letter-spacing: -0.05em;
    margin: 0;
    color: var(--pop-ink) !important;
    text-wrap: balance;
  }

  .arch-hero__lede {
    font: 480 clamp(1.15rem, 1.8vw, 1.5rem)/1.35 var(--font-display, sans-serif);
    letter-spacing: -0.02em;
    color: var(--pop-ink) !important;
    margin: 0;
    max-width: 50rem;
    text-wrap: pretty;
  }

  /* Pipeline Section */
  .arch-pipeline-section {
    width: 100%;
  }

  .arch-pipeline-card {
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-panel);
    background: var(--pop-cream);
    color: var(--pop-ink) !important;
    padding: clamp(2rem, 4.5vw, 3.5rem) clamp(1.5rem, 3.5vw, 3.5rem);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .arch-section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--pop-line);
  }

  .arch-section-header__title-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .arch-section-heading {
    font: 650 clamp(2rem, 4vw, 3.2rem)/0.96 var(--font-display, sans-serif);
    letter-spacing: -0.045em;
    margin: 0;
    color: var(--pop-ink) !important;
  }

  .arch-section-desc {
    font: 550 clamp(0.98rem, 1.15vw, 1.1rem)/1.55 var(--font-body, sans-serif);
    margin: 0;
    color: var(--pop-ink) !important;
    max-width: 520px;
  }

  .arch-flow-grid {
    display: flex;
    align-items: stretch;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .arch-flow-node {
    flex: 1 1 220px;
    border: 1.5px solid var(--pop-border);
    border-radius: var(--pop-radius-card);
    padding: 1.6rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: 0 4px 12px rgba(21, 19, 15, 0.06);
    color: var(--pop-ink) !important;
  }

  .arch-flow-node--yellow { background: var(--pop-yellow); }
  .arch-flow-node--lime { background: var(--pop-lime); }
  .arch-flow-node--pink { background: var(--pop-pink); }
  .arch-flow-node--cream { background: var(--pop-cream); }

  .arch-flow-node__step {
    font: 800 0.78rem/1 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    color: var(--pop-ink) !important;
    text-transform: uppercase;
  }

  .arch-flow-node__title {
    font: 750 clamp(1.25rem, 1.7vw, 1.5rem)/1.15 var(--font-display, sans-serif);
    letter-spacing: -0.025em;
    margin: 0;
    color: var(--pop-ink) !important;
  }

  .arch-flow-node__desc {
    font: 550 0.98rem/1.55 var(--font-body, sans-serif);
    margin: 0;
    color: var(--pop-ink) !important;
  }

  .arch-flow-arrow {
    font: 800 1.6rem/1 var(--font-mono, monospace);
    color: var(--pop-ink) !important;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.65;
  }

  /* Deep Dives Grid */
  .arch-deep-dives {
    display: flex;
    flex-direction: column;
    gap: var(--pop-gap);
  }

  .arch-deep-dives__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--pop-gap);
  }

  .arch-card {
    border: 1.5px solid var(--pop-border);
    border-radius: var(--pop-radius-panel);
    padding: clamp(1.6rem, 2.6vw, 2.4rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--pop-ink) !important;
    transition: transform var(--pop-motion), box-shadow var(--pop-motion);
  }

  .arch-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(21, 19, 15, 0.08);
  }

  .arch-card--yellow { background: var(--pop-yellow); }
  .arch-card--cream { background: var(--pop-cream); }
  .arch-card--lime { background: var(--pop-lime); }

  .arch-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--pop-line);
  }

  .arch-card__num {
    font: 800 0.85rem/1 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    color: var(--pop-ink) !important;
  }

  .arch-card__title {
    font: 750 clamp(1.4rem, 2vw, 1.85rem)/1.1 var(--font-display, sans-serif);
    letter-spacing: -0.03em;
    margin: 0;
    color: var(--pop-ink) !important;
  }

  .arch-feature-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .arch-feature-list li {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .arch-feature-list strong {
    font: 750 1.05rem/1.3 var(--font-display, sans-serif);
    color: var(--pop-ink) !important;
  }

  .arch-feature-list p {
    font: 550 0.96rem/1.55 var(--font-body, sans-serif);
    margin: 0;
    color: var(--pop-ink) !important;
  }

  .arch-feature-list code {
    font: 750 0.9em var(--font-mono, monospace);
    background: rgba(21, 19, 15, 0.12);
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    color: var(--pop-ink) !important;
  }

  @media (max-width: 980px) {
    .arch-deep-dives__grid {
      grid-template-columns: 1fr;
    }

    .arch-flow-arrow {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .arch-shell {
      padding: var(--pop-gap);
    }

    .arch-hero {
      padding: 2rem 1.25rem;
    }

    .arch-pipeline-card {
      padding: 1.75rem 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arch-card,
    .arch-back-btn {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

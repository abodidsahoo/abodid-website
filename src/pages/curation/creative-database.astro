---
import BaseLayout from "../../layouts/BaseLayout.astro";
import creativeCompanies from "../../data/creativeCompanies.json";

export const prerender = true;

type Company = {
  company_name: string;
  overview: string;
  website?: string;
};

type CreativeDatabase = Record<string, Record<string, Company[]>>;

const title = "Creative Companies Database | Abodid Sahoo";
const description = "A curated directory of advertising agencies, production companies, studios, creative platforms, and design organisations.";
const canonicalUrl = "https://www.abodid.com/curation/creative-database";

const database = creativeCompanies as CreativeDatabase;
const companies = Object.entries(database).flatMap(([country, categories]) =>
  Object.entries(categories).flatMap(([category, entries]) =>
    entries.map((company) => ({ ...company, country, category }))
  )
);

const countries = Object.keys(database).map((country) => ({
  country,
  count: companies.filter((company) => company.country === country).length,
}));

const categories = [...new Set(companies.map((company) => company.category))].map((category) => ({
  category,
  count: companies.filter((company) => company.category === category).length,
}));

const websiteUrl = (website?: string) => {
  if (!website) return undefined;
  return /^https?:\/\//i.test(website) ? website : `https://${website}`;
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  fullWidth={true}
  showGlobalGrid={false}
  showNewsletterPopup={false}
  showCursorFollower={false}
  bodyClass="creative-database-page"
  navigationVariant="next"
  initialBackgroundColor="#2444ca"
>
  <main class="creative-page">
    <div class="creative-shell">
      <article class="creative-file">
        <header class="creative-heading">
          <p class="creative-file-tag">curation.02 — creative directory</p>
          <div class="creative-heading__hero">
            <h1>Creative companies</h1>
            <div class="creative-heading__summary">
              <p>A growing directory of studios, agencies, production companies, platforms and organisations worth knowing.</p>
            </div>
          </div>
        </header>

        <section class="creative-board" aria-labelledby="directory-heading">
          <div class="creative-browser">
            <div class="creative-controls">
              <div class="creative-control-row creative-control-row--primary">
                <div class="creative-filter-block">
                  <p class="creative-label">Filter by country</p>
                  <div class="creative-pills" role="group" aria-label="Filter by country">
                    <button class="creative-pill is-active" type="button" data-country-filter="all" aria-pressed="true">
                      <span>All</span>
                    </button>
                    {countries.map(({ country }) => (
                      <button class="creative-pill" type="button" data-country-filter={country} aria-pressed="false">
                        <span>{country}</span>
                      </button>
                    ))}
                  </div>
                </div>

                <div class="creative-search-wrap">
                  <label class="creative-label" for="company-search">Search the directory</label>
                  <div class="creative-search-field">
                    <svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19">
                      <circle cx="11" cy="11" r="7"></circle>
                      <path d="m16.2 16.2 4.3 4.3"></path>
                    </svg>
                    <input id="company-search" type="search" placeholder="Company, category or keyword" autocomplete="off" data-company-search />
                  </div>
                </div>
              </div>

              <div class="creative-filter-block creative-filter-block--categories">
                <p class="creative-label">Filter by category</p>
                <div class="creative-pills creative-pills--categories" role="group" aria-label="Filter by category">
                  <button class="creative-pill creative-pill--category is-active" type="button" data-category-filter="all" aria-pressed="true">
                    <span>All</span>
                  </button>
                  {categories.map(({ category }) => (
                    <button class="creative-pill creative-pill--category" type="button" data-category-filter={category} aria-pressed="false">
                      <span>{category}</span>
                    </button>
                  ))}
                </div>
              </div>
            </div>

            <div class="creative-results-heading">
              <div>
                <p class="creative-label">Browse the collection</p>
                <h2 id="directory-heading">Creative directory</h2>
              </div>
              <div class="creative-results-meta">
                <span aria-live="polite"><b data-result-count>{companies.length}</b> companies</span>
                <button type="button" data-reset-filters hidden>Reset filters <span aria-hidden="true">×</span></button>
              </div>
            </div>

            <section class="creative-catalogue" aria-label="Creative companies">
              <div class="creative-grid" data-company-grid>
                {companies.map((company, index) => {
                  const url = websiteUrl(company.website);
                  const searchable = [company.company_name, company.overview, company.category, company.country].join(" ").toLowerCase();

                  return (
                    <article
                      class={`creative-card creative-card--tone-${(index % 4) + 1}`}
                      data-company-card
                      data-country={company.country}
                      data-category={company.category}
                      data-search={searchable}
                    >
                      <div class="creative-card__topline">
                        <span>{company.category}</span>
                        <b>{String(index + 1).padStart(2, "0")}</b>
                      </div>

                      <div class="creative-card__body">
                        <div class="creative-card__title-row">
                          <h3>{company.company_name}</h3>
                          {url && (
                            <a href={url} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${company.company_name} website`}>
                              <span aria-hidden="true">↗</span>
                            </a>
                          )}
                        </div>
                        <p>{company.overview}</p>
                      </div>

                      <div class="creative-card__footer">
                        <span>{company.country}</span>
                        {url ? (
                          <a class="creative-card__website" href={url} target="_blank" rel="noopener noreferrer">
                            <span class="creative-card__link-label">Visit website</span>
                            <span class="creative-card__arrow" aria-hidden="true">↗</span>
                          </a>
                        ) : (
                          <span class="creative-card__pending">Website pending</span>
                        )}
                      </div>
                    </article>
                  );
                })}
              </div>

              <div class="creative-empty" data-empty-state hidden>
                <p class="creative-label">No match</p>
                <h2>Try another company, country or category.</h2>
                <button type="button" data-clear-filters>Show all companies</button>
              </div>
            </section>
          </div>
        </section>
      </article>
    </div>
  </main>
</BaseLayout>

<script>
  function initialiseCreativeDirectory() {
    const page = document.querySelector<HTMLElement>(".creative-page");
    if (!page || page.dataset.ready === "true") return;
    page.dataset.ready = "true";

    const search = page.querySelector<HTMLInputElement>("[data-company-search]");
    const cards = [...page.querySelectorAll<HTMLElement>("[data-company-card]")];
    const countryButtons = [...page.querySelectorAll<HTMLButtonElement>("[data-country-filter]")];
    const categoryButtons = [...page.querySelectorAll<HTMLButtonElement>("[data-category-filter]")];
    const resultCount = page.querySelector<HTMLElement>("[data-result-count]");
    const emptyState = page.querySelector<HTMLElement>("[data-empty-state]");
    const resetButton = page.querySelector<HTMLButtonElement>("[data-reset-filters]");
    const clearButton = page.querySelector<HTMLButtonElement>("[data-clear-filters]");
    let selectedCountry = "all";
    let selectedCategory = "all";

    const updateButtonGroup = (buttons: HTMLButtonElement[], activeButton: HTMLButtonElement) => {
      buttons.forEach((button) => {
        const active = button === activeButton;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
    };

    const applyFilters = () => {
      const query = search?.value.trim().toLowerCase() || "";
      let visible = 0;

      cards.forEach((card) => {
        const matchesCountry = selectedCountry === "all" || card.dataset.country === selectedCountry;
        const matchesCategory = selectedCategory === "all" || card.dataset.category === selectedCategory;
        const matchesSearch = !query || card.dataset.search?.includes(query);
        const isVisible = Boolean(matchesCountry && matchesCategory && matchesSearch);
        card.hidden = !isVisible;
        if (isVisible) visible += 1;
      });

      if (resultCount) resultCount.textContent = String(visible);
      if (emptyState) emptyState.hidden = visible !== 0;
      if (resetButton) resetButton.hidden = selectedCountry === "all" && selectedCategory === "all" && query.length === 0;
    };

    const clearFilters = () => {
      selectedCountry = "all";
      selectedCategory = "all";
      if (search) search.value = "";

      countryButtons.forEach((button) => {
        const active = button.dataset.countryFilter === "all";
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });

      categoryButtons.forEach((button) => {
        const active = button.dataset.categoryFilter === "all";
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });

      applyFilters();
      search?.focus();
    };

    countryButtons.forEach((button) => {
      button.addEventListener("click", () => {
        selectedCountry = button.dataset.countryFilter || "all";
        updateButtonGroup(countryButtons, button);
        applyFilters();
      });
    });

    categoryButtons.forEach((button) => {
      button.addEventListener("click", () => {
        selectedCategory = button.dataset.categoryFilter || "all";
        updateButtonGroup(categoryButtons, button);
        applyFilters();
      });
    });

    search?.addEventListener("input", applyFilters);
    resetButton?.addEventListener("click", clearFilters);
    clearButton?.addEventListener("click", clearFilters);
  }

  initialiseCreativeDirectory();
  document.addEventListener("astro:page-load", initialiseCreativeDirectory);
</script>

<style>
  :global(html:has(body.creative-database-page)),
  :global(body.creative-database-page) {
    margin: 0;
    max-width: none;
    overflow-x: clip;
    background: #2444ca;
    color: #15130f;
  }

  :global(body.creative-database-page) {
    --pop-blue: #2444ca;
    --pop-pink: #ff7eb5;
    --pop-yellow: #ffe44f;
    --pop-lime: #caff48;
    --pop-purple: #5524c7;
    --pop-cream: #fff8e8;
    --pop-ink: #15130f;
    --pop-border: rgba(21, 19, 15, 0.78);
    --pop-line: rgba(21, 19, 15, 0.24);
    --pop-motion: 180ms ease;
  }

  .creative-page {
    font-family: "Satoshi-Variable", "Satoshi-Regular", "Poppins", sans-serif;
    background: var(--pop-blue);
    padding: 8px;
  }

  .creative-shell {
    width: min(100%, 1580px);
    margin: 0 auto;
  }

  .creative-file {
    overflow: hidden;
    border: 1px solid var(--pop-border);
    border-radius: clamp(18px, 2vw, 28px);
    background: var(--pop-cream);
  }

  .creative-heading {
    min-width: 0;
    padding: clamp(2.5rem, 5vw, 5rem) clamp(1.5rem, 4vw, 4rem) clamp(2.6rem, 4.5vw, 4.5rem);
    border-bottom: 1px solid var(--pop-border);
    background: var(--pop-pink);
  }

  .creative-file-tag,
  .creative-label {
    margin: 0;
    color: var(--pop-ink);
    font: 750 clamp(0.68rem, 0.9vw, 0.78rem)/1.35 "Satoshi-Variable", "Satoshi-Regular", "Space Mono", monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .creative-heading__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(320px, 0.85fr);
    align-items: end;
    gap: clamp(2rem, 5vw, 6rem);
    margin-top: clamp(2.5rem, 6vw, 6.5rem);
  }

  .creative-heading h1 {
    max-width: 8ch;
    margin: 0;
    font-size: clamp(4.4rem, 8vw, 8.6rem);
    font-weight: 720;
    line-height: 0.82;
    letter-spacing: -0.075em;
    text-wrap: balance;
  }

  .creative-heading__summary {
    min-width: 0;
  }

  .creative-heading__summary > p {
    max-width: 31rem;
    margin: 0;
    font-size: clamp(1.18rem, 1.72vw, 1.75rem);
    font-weight: 480;
    line-height: 1.16;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }

  .creative-board {
    padding: clamp(1.5rem, 3.4vw, 3rem);
    background: var(--pop-cream);
  }

  .creative-browser { min-width: 0; }

  .creative-controls {
    display: grid;
    gap: 1.25rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--pop-border);
  }

  .creative-control-row--primary {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(300px, 0.7fr);
    align-items: end;
    gap: clamp(1.5rem, 4vw, 5rem);
  }

  .creative-filter-block,
  .creative-search-wrap { min-width: 0; }

  .creative-label { display: block; margin-bottom: 0.6rem; }

  .creative-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    max-width: 100%;
    overflow: visible;
    padding: 0;
  }

  .creative-pills--categories { padding-bottom: 0; }

  .creative-pill {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.68rem 1rem;
    border: 1px solid var(--pop-border);
    border-radius: 14px;
    background: var(--pop-cream);
    color: var(--pop-ink);
    font: 760 0.75rem/1 "Satoshi-Variable", "Satoshi-Regular", sans-serif;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform var(--pop-motion), background var(--pop-motion), box-shadow var(--pop-motion);
  }

  .creative-pill:hover {
    background: var(--pop-pink);
    transform: translateY(-2px);
    box-shadow: 0 3px 0 var(--pop-ink);
  }

  .creative-pill.is-active {
    background: var(--pop-yellow);
    color: var(--pop-ink);
    font-weight: 800;
    box-shadow: inset 0 -3px 0 var(--pop-ink);
  }

  .creative-search-field {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 48px;
    padding: 0 0.95rem;
    border: 1px solid var(--pop-border);
    border-radius: 14px;
    background: #fff;
  }

  .creative-search-field svg { flex: 0 0 auto; fill: none; stroke: currentColor; stroke-width: 1.8; }

  .creative-search-field input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--pop-ink);
    font: 500 0.98rem/1.2 inherit;
  }

  .creative-search-field:focus-within { outline: 3px solid var(--pop-purple); outline-offset: 2px; }

  .creative-results-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.4rem, 2.5vw, 2.2rem) 0 1.35rem;
  }

  .creative-results-heading .creative-label { margin-bottom: 0.35rem; }

  .creative-results-heading h2,
  .creative-empty h2 {
    margin: 0;
    color: var(--pop-ink);
    font-size: clamp(2rem, 3.2vw, 3.4rem);
    font-weight: 650;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .creative-results-meta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    font-size: 0.75rem;
    font-weight: 760;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .creative-results-meta button,
  .creative-empty button {
    min-height: 44px;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--pop-border);
    border-radius: 14px;
    background: var(--pop-pink);
    color: var(--pop-ink);
    font: 760 0.72rem/1 "Satoshi-Variable", "Satoshi-Regular", sans-serif;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .creative-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .creative-card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-width: 0;
    min-height: 250px;
    overflow: hidden;
    border: 1px solid var(--pop-border);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 6px 0 var(--pop-ink);
    transition: transform var(--pop-motion), box-shadow var(--pop-motion);
  }

  .creative-card:hover { transform: translateY(-2px); box-shadow: 0 8px 0 var(--pop-ink); }
  .creative-card[hidden] { display: none; }

  .creative-card__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 50px;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--pop-border);
    font-size: 0.72rem;
    font-weight: 780;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .creative-card__topline span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .creative-card--tone-1 .creative-card__topline { background: var(--pop-yellow); }
  .creative-card--tone-2 .creative-card__topline { background: var(--pop-pink); }
  .creative-card--tone-3 .creative-card__topline { background: var(--pop-lime); }
  .creative-card--tone-4 .creative-card__topline { background: var(--pop-blue); color: var(--pop-cream); }

  .creative-card__body {
    display: grid;
    align-content: start;
    gap: 1rem;
    min-width: 0;
    padding: 1.2rem;
  }

  .creative-card__title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .creative-card h3 {
    min-width: 0;
    margin: 0;
    color: var(--pop-ink);
    font-size: clamp(1.65rem, 2.15vw, 2.25rem);
    font-weight: 720;
    line-height: 1.07;
    letter-spacing: -0.035em;
    overflow-wrap: break-word;
    word-break: normal;
    text-wrap: balance;
  }

  .creative-card__title-row > a {
    display: grid;
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    margin: -0.55rem -0.55rem 0 0;
    place-items: center;
    color: inherit;
    font-size: 1.35rem;
    text-decoration: none;
  }

  .creative-card__title-row > a span { display: inline-block; transition: transform var(--pop-motion); }
  .creative-card:hover .creative-card__title-row > a span { transform: translate(3px, -3px); }

  .creative-card__body > p {
    margin: 0;
    color: rgba(21, 19, 15, 0.88);
    font-size: 1rem;
    font-weight: 450;
    line-height: 1.52;
    text-wrap: pretty;
  }

  .creative-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 1.1rem;
    padding: 0.85rem 0 1rem;
    border-top: 1px solid var(--pop-line);
    font-size: 0.72rem;
    font-weight: 760;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .creative-card__website {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
  }

  .creative-card__website:hover .creative-card__link-label,
  .creative-card__website:focus-visible .creative-card__link-label {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }

  .creative-card__arrow { display: inline-block; text-decoration: none; transition: transform var(--pop-motion); }
  .creative-card__website:hover .creative-card__arrow { transform: translate(2px, -2px); }
  .creative-card__pending { opacity: 0.56; }

  .creative-empty {
    padding: clamp(3rem, 7vw, 7rem) 1rem;
    border: 1px solid var(--pop-border);
    border-radius: 18px;
    background: var(--pop-yellow);
    text-align: center;
  }

  .creative-empty h2 { max-width: 18ch; margin: 0 auto 1.25rem; }
  .creative-empty .creative-label { margin-bottom: 0.65rem; }

  .creative-pill:focus-visible,
  .creative-results-meta button:focus-visible,
  .creative-empty button:focus-visible,
  .creative-card a:focus-visible {
    outline: 3px solid var(--pop-purple);
    outline-offset: 3px;
  }

  @media (max-width: 1100px) {
    .creative-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 980px) {
    .creative-heading__hero { grid-template-columns: minmax(0, 1fr); gap: 1.6rem; }
    .creative-heading h1 { max-width: 9ch; }
    .creative-heading__summary > p { max-width: 40rem; }
    .creative-control-row--primary { grid-template-columns: minmax(0, 1fr); gap: 1.15rem; }
  }

  @media (max-width: 720px) {
    .creative-page { padding: 4px; }
    .creative-heading,
    .creative-board { padding: 1rem; }
    .creative-heading { padding-block: 1.7rem 2.2rem; }
    .creative-heading__hero { margin-top: 2.2rem; }
    .creative-heading h1 { font-size: clamp(3rem, 14vw, 4.4rem); line-height: 0.86; letter-spacing: -0.065em; }
    .creative-heading__summary > p { font-size: 1.08rem; line-height: 1.36; }
    .creative-control-row--primary { display: flex; flex-direction: column-reverse; align-items: stretch; }
    .creative-controls { gap: 1rem; }
    .creative-pills { margin-inline: 0; padding-inline: 0; }
    .creative-results-heading { align-items: flex-end; }
    .creative-results-heading .creative-label { display: none; }
    .creative-results-meta { flex-direction: column; align-items: flex-end; gap: 0.5rem; }
    .creative-grid { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .creative-card { min-height: 0; }
  }

  @media (max-width: 390px) {
    .creative-heading,
    .creative-board { padding: 0.9rem; }
    .creative-heading h1 { font-size: clamp(2.85rem, 14.5vw, 3.6rem); }
    .creative-results-heading h2 { font-size: 1.85rem; }
    .creative-card__footer { align-items: flex-end; }
  }

  @media (prefers-reduced-motion: reduce) {
    .creative-pill,
    .creative-card,
    .creative-card__title-row > a span,
    .creative-card__arrow {
      transition-duration: 0.01ms !important;
      transform: none !important;
    }
  }
</style>

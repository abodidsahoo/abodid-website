---
import OpportunityAiBenchmark from "../../../components/opportunities/OpportunityAiBenchmark";
import ExperimentLayout from "../../../layouts/ExperimentLayout.astro";
import "../../../styles/opportunity-ai-benchmark.css";

export const prerender = false;

Astro.response.headers.set(
  "Cache-Control",
  "private, no-store, max-age=0, must-revalidate",
);
Astro.response.headers.set("Pragma", "no-cache");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("Permissions-Policy", "language-model=(self)");
---

<ExperimentLayout
  title="Opportunity AI Benchmark — Abodid Lab"
  description="An isolated comparison of Chrome's on-device AI and OpenRouter for opportunity extraction."
  canonicalUrl="https://abodid.com/lab/opportunity-ai-benchmark"
  bodyClass="opportunity-ai-benchmark-page"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#2442e3" />
  </Fragment>

  <OpportunityAiBenchmark client:load />
</ExperimentLayout>

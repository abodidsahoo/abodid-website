---
export const prerender = false;

Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=60, s-maxage=31536000, stale-while-revalidate=31536000"
);
Astro.response.headers.set(
    "Vercel-CDN-Cache-Control",
    "s-maxage=31536000, stale-while-revalidate=31536000"
);

import BaseLayout from "../../../layouts/BaseLayout.astro";
import SequenceRoomWorkspace from "../../../components/sequence-room/SequenceRoomWorkspace.jsx";
import { sequenceRoomDemoItems } from "../../../data/sequenceRoomDemo";
import { labUrl } from "../../../lib/labRoutes.js";

const pageTitle = "Sequence Room — Interactive Polaroid scatter";
const pageDescription =
    "Browse Abodid Sahoo's photography archive as an immersive, draggable scatter of Polaroid-style image cards.";
---

<BaseLayout
    canonicalUrl={labUrl("/sequence-room")}
    title={pageTitle}
    description={pageDescription}
    hideHeader={true}
    fullWidth={true}
>
    <main class="polaroid-hub-immersive">
        <h1 class="sr-only">Sequence Room</h1>
        <SequenceRoomWorkspace demoItems={sequenceRoomDemoItems} client:only="react" />
    </main>
</BaseLayout>

<style>
    /* 
       Polaroid Hub specific styles to ensure full immersion.
    */
    @import url("https://fonts.googleapis.com/css2?family=Reenie+Beanie&display=swap");

    .polaroid-hub-immersive {
        position: relative;
        width: 100vw;
        min-height: 100vh;
        /* Allow scroll */
        overflow-x: hidden;
        overflow-y: auto;

        /* BACKGROUND STYLES (Migrated from React for instant load) */

        /* --- OPTION B: POP EDITORIAL STUDIO BACKDROP (INFINITE SCROLL) --- */
        background-color: var(--polaroid-hub-bg, #fff8e8);
        transition: background-color 0.3s ease;

        /* PERF NOTE: Layered subtle grid + texture for editorial pop vibe */
        background-image: 
            /* LAYER 1: THE GRID */
            linear-gradient(
                to right,
                var(--polaroid-hub-grid-line, rgba(21, 19, 15, 0.09)) 2px,
                transparent 2px
            ),
            linear-gradient(
                to bottom,
                var(--polaroid-hub-grid-line, rgba(21, 19, 15, 0.09)) 2px,
                transparent 2px
            ),
            /* LAYER 2: VIGNETTE & SEAM BLENDING */
            linear-gradient(
                    to bottom,
                    var(--polaroid-hub-bg, #fff8e8) 0%,
                    var(--polaroid-hub-bg, #fff8e8) 15%,
                    transparent 30%,
                    transparent 70%,
                    var(--polaroid-hub-bg, #fff8e8) 85%,
                    var(--polaroid-hub-bg, #fff8e8) 100%
                ),
            /* LAYER 3: NOISE TEXTURE */
            url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.06'/%3E%3C/svg%3E"),
            /* LAYER 4: CONICAL WINDOW LIGHT (Left - Bright Beige) */
            radial-gradient(
                    ellipse at -10% 40%,
                    rgba(245, 240, 220, 0.08) 0%,
                    transparent 60%
                ),
            /* LAYER 5: SIDE FILL LIGHT (Right - Warm Beige) */
            radial-gradient(
                    ellipse at 110% 60%,
                    rgba(245, 235, 210, 0.05) 0%,
                    transparent 50%
                ),
            /* LAYER 6: TEXTURE CLOUDS */
            radial-gradient(
                    circle at 40% 50%,
                    rgba(255, 255, 255, 0.015) 0%,
                    transparent 30%
                ),
            radial-gradient(
                circle at 65% 30%,
                rgba(255, 255, 255, 0.01) 0%,
                transparent 20%
            );

        background-attachment: local;
        background-blend-mode:
            normal, normal, normal, overlay, screen, screen, screen, screen;

        background-size:
            50px 50px,
            50px 50px,
            /* Grid X, Grid Y */ 100% 2500px,
            /* Vignette */ 150px 150px,
            /* Noise */ 100% 2500px,
            /* Beam Left */ 100% 2500px,
            /* Beam Right */ 100% 2500px,
            /* Clouds 1 */ 100% 2500px; /* Clouds 2 */

        background-repeat:
            repeat,
            repeat,
            /* Grid repeats everywhere */ repeat-y,
            repeat,
            repeat-y,
            repeat-y,
            repeat-y,
            repeat-y;
    }

    .polaroid-hub-immersive::before {
        display: none;
    }
</style>

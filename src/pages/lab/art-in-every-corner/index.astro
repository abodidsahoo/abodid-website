---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArtistGlobe from '../../../components/artist-globe/ArtistGlobe';
import '../../../components/artist-globe/globe.css';
---

<BaseLayout
  title="Art in Every Corner — Abodid’s Lab"
  description="A playful globe for discovering artists, places and practices beyond the familiar art-world routes."
  canonicalUrl="https://abodid.com/lab/art-in-every-corner"
  image="/images/lab/art-in-every-corner/globe-quito.webp"
  fullWidth={true}
  hideFooter={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  bodyClass="artist-globe-page"
>
  <Fragment slot="head">
    <link rel="preload" href="/fonts/satoshi/Satoshi-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#fff8e8" />
  </Fragment>
  <div id="atlas" tabindex="-1"><ArtistGlobe client:load /></div>
</BaseLayout>

---
import HeroVaultTagsCard from "../../../components/HeroVaultTagsCard.jsx";
import ExperimentLayout from "../../../layouts/ExperimentLayout.astro";
import { labUrl } from "../../../lib/labRoutes.js";

const title = "Obsidian Tags Interactive Explorer — Abodid Sahoo";
const description =
  "A full-screen, physics-based exploration of the tags in Abodid Sahoo's Obsidian vault.";
---

<ExperimentLayout
  title={title}
  description={description}
  canonicalUrl={labUrl("/obsidian-tags-interactive-explorer")}
  bodyClass="obsidian-tags-explorer-page"
  lockViewport={true}
>
  <Fragment slot="head">
    <meta name="theme-color" content="#2442e3" />
  </Fragment>

  <h1 class="sr-only">Obsidian Tags Interactive Explorer</h1>
  <div class="obsidian-tags-explorer">
    <HeroVaultTagsCard
      client:load
      standalone={true}
      heading="Second Brain"
      helperText="Move your cursor or drag a finger to explore all the tags."
      cta="Explore Vault ↗"
      href="/obsidian-vault"
      ariaLabel="Interactive explorer of tags from Abodid Sahoo's Obsidian vault"
    />

    <a class="obsidian-tags-explorer__back" href="/lab">
      <span aria-hidden="true">←</span>
      <span>Back to Lab</span>
    </a>
  </div>
</ExperimentLayout>

<style is:global>
  html:has(body.obsidian-tags-explorer-page),
  body.obsidian-tags-explorer-page {
    margin: 0;
    overflow: hidden;
    background: #2442e3 !important;
  }

  body.obsidian-tags-explorer-page .skip-link,
  body.obsidian-tags-explorer-page astro-dev-toolbar {
    display: none !important;
  }

  body.obsidian-tags-explorer-page #main-content,
  body.obsidian-tags-explorer-page .experiment-shell,
  .obsidian-tags-explorer {
    width: 100%;
    height: 100svh;
    min-height: 100svh;
  }

  .obsidian-tags-explorer {
    position: relative;
  }

  body.obsidian-tags-explorer-page .hero-vault-tags-card--standalone {
    height: 100%;
    padding: clamp(1.4rem, 4vw, 4rem);
  }

  .obsidian-tags-explorer__back {
    position: absolute;
    top: max(1rem, env(safe-area-inset-top));
    right: max(1rem, env(safe-area-inset-right));
    z-index: 30;
    min-height: 44px;
    padding: 0 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid var(--pop-ink);
    border-radius: 999px;
    background: var(--pop-yellow);
    color: var(--pop-ink) !important;
    font: 700 0.72rem/1 var(--font-mono, monospace);
    letter-spacing: 0.06em;
    text-decoration: none !important;
    text-transform: uppercase;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .obsidian-tags-explorer__back:hover,
  .obsidian-tags-explorer__back:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 4px 0 var(--pop-ink);
  }

  @media (max-width: 640px) {
    body.obsidian-tags-explorer-page .hero-vault-tags-card--standalone {
      padding: max(5.25rem, env(safe-area-inset-top)) 1.1rem
        max(1.2rem, env(safe-area-inset-bottom));
    }

    body.obsidian-tags-explorer-page
      .hero-vault-tags-card--standalone
      .hero-vault-tags-card__heading {
      max-width: 9ch;
      font-size: clamp(3rem, 15vw, 5.4rem);
    }

    body.obsidian-tags-explorer-page
      .hero-vault-tags-card--standalone
      .hero-vault-tags-card__bottom {
      align-items: flex-start;
      align-self: flex-start;
      text-align: left;
    }
  }
</style>

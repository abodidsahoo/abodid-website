---
export const prerender = false;

import LabSubdomainHome from "../../components/lab/LabSubdomainHome.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Abodid Lab — Experiments in images, attention, and interaction"
  description="Abodid Sahoo's experimental practice across photography, visual attention, gesture-led interfaces, and participatory technology."
  canonicalUrl="https://abodid.com/lab"
  fullWidth={true}
  showGlobalGrid={false}
  bodyClass="lab-subdomain-page"
>
  <LabSubdomainHome />
</BaseLayout>

<style is:global>
  html:has(body.lab-subdomain-page) {
    background: #2444ca !important;
  }

  body.lab-subdomain-page {
    margin: 0;
    padding: 0 !important;
    background: #2444ca !important;
    background-color: #2444ca !important;
  }
</style>

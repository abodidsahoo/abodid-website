---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LabExperimentCards from "../../components/lab/LabExperimentCards.astro";

export const prerender = false;

// Lab cards are managed independently in the admin, so keep the edge cache short.
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=60, stale-while-revalidate=300",
);
Astro.response.headers.set(
  "Vercel-CDN-Cache-Control",
  "s-maxage=60, stale-while-revalidate=300",
);
---

<BaseLayout
  title="Media Lab — Abodid Sahoo"
  description="Inspired by the MIT Media Lab and Google Creative Lab, this is my playground for all the things I build at the crossover of technology and art."
  canonicalUrl="https://abodid.com/lab"
  fullWidth={true}
  showGlobalGrid={false}
  bodyClass="lab-page"
>
  <div class="media-lab">
    <div id="experiments">
      <LabExperimentCards
        title="Selected Experiments"
        introduction="This is where I play with images, code, and culture to build interactive storytelling experiences."
        absoluteLinks={false}
      />
    </div>

    <section
      class="media-lab__bottom-section"
      aria-label="About the Lab and Collaboration"
    >
      <div class="media-lab__bottom-container">
        <!-- Footnote Note Block -->
        <article class="media-lab__card media-lab__card--yellow">
          <div class="media-lab__card-meta">
            <span class="media-lab__card-index">Inspiration</span>
          </div>
          <p class="media-lab__note-body">
            Inspired by the MIT Media Lab and Google Creative Lab, this is my
            playground for all the things I build at the crossover of technology
            and art.
          </p>
        </article>

        <!-- Collaboration Call to Action Block -->
        <article class="media-lab__card media-lab__card--pink" id="collaborate">
          <div class="media-lab__card-meta">
            <span class="media-lab__card-index">Collaborate</span>
            <span class="media-lab__card-discipline"
              >Commissions & Projects</span
            >
          </div>

          <div class="media-lab__cta-layout">
            <div class="media-lab__cta-intro">
              <h2 id="media-lab-cta-title" class="media-lab__cta-title">
                Let’s build something together.
              </h2>
              <p class="media-lab__cta-description">
                Want to collaborate on a creative tech project, design an
                immersive physical + digital storytelling experience, or build a
                web experience powered by data, AI, and stories? Send a message
                below.
              </p>
              <div class="media-lab__cta-direct">
                <span class="media-lab__cta-direct-label">Direct email</span>
                <a
                  class="media-lab__cta-direct-link"
                  href="mailto:hello@abodid.com"
                >
                  <span>hello@abodid.com</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>

            <form
              class="media-lab__form"
              id="lab-contact-form"
              data-lab-form
              novalidate
            >
              <div class="media-lab__form-row">
                <div class="media-lab__field">
                  <label for="lab-form-name">Name</label>
                  <input
                    id="lab-form-name"
                    name="name"
                    type="text"
                    autocomplete="name"
                    required
                    maxlength="120"
                    placeholder="Your name"
                  />
                </div>
                <div class="media-lab__field">
                  <label for="lab-form-email">Email</label>
                  <input
                    id="lab-form-email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    required
                    maxlength="254"
                    placeholder="you@example.com"
                  />
                </div>
              </div>

              <div class="media-lab__field">
                <label for="lab-form-message">Project or Idea</label>
                <textarea
                  id="lab-form-message"
                  name="message"
                  rows="4"
                  required
                  maxlength="5000"
                  placeholder="Tell me what you'd like to build, explore, or celebrate..."
                ></textarea>
              </div>

              <div class="media-lab__form-footer">
                <button type="submit" class="media-lab__submit-btn">
                  <span>Send message</span>
                  <span class="media-lab__btn-arrow" aria-hidden="true">↗</span>
                </button>
                <p
                  id="lab-form-status"
                  class="media-lab__form-status"
                  role="status"
                  aria-live="polite"
                >
                </p>
              </div>
            </form>
          </div>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const initLabForm = () => {
    const form = document.querySelector<HTMLFormElement>("[data-lab-form]");
    if (!form || form.dataset.ready === "true") return;
    form.dataset.ready = "true";

    const statusNode = document.getElementById("lab-form-status");
    const submitBtn = form.querySelector<HTMLButtonElement>(
      "button[type='submit']",
    );
    const defaultBtnText =
      submitBtn?.innerHTML ||
      "<span>Send message</span><span class='media-lab__btn-arrow' aria-hidden='true'>↗</span>";

    const getJourneyTracking = () => ({
      sessionId:
        typeof (window as any).__abodidAnalytics?.getSessionId === "function"
          ? (window as any).__abodidAnalytics.getSessionId()
          : "",
      enquiryPath: window.location.pathname,
      sourceName: "lab-collaboration",
      cta: "lab-cta-form",
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!statusNode || !submitBtn) return;

      const formData = new FormData(form);
      const name = String(formData.get("name") || "").trim();
      const email = String(formData.get("email") || "").trim();
      const message = String(formData.get("message") || "").trim();

      if (!name || !email || !message) {
        statusNode.textContent = "Please fill in all fields.";
        statusNode.className = "media-lab__form-status is-error";
        return;
      }

      statusNode.textContent = "";
      statusNode.className = "media-lab__form-status";
      submitBtn.disabled = true;
      submitBtn.innerHTML = "<span>Sending…</span>";

      try {
        if (
          typeof (window as any).__abodidAnalytics?.prepareSubmission ===
          "function"
        ) {
          await (window as any).__abodidAnalytics.prepareSubmission();
        }

        const payload = {
          name,
          email,
          message,
          tracking: getJourneyTracking(),
        };

        const response = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const result = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(
            result.error || "Unable to send your message right now.",
          );
        }

        form.reset();
        statusNode.textContent =
          "Message sent successfully! I will get back to you soon.";
        statusNode.className = "media-lab__form-status is-success";

        try {
          if (typeof (window as any).gtag === "function") {
            (window as any).gtag("event", "generate_lead", {
              event_category: "lab",
              event_label: "lab-cta-submit",
              source_page: window.location.pathname,
            });
          }
        } catch {}
      } catch (err: any) {
        statusNode.textContent =
          err?.message ||
          "Unable to send message. Please email hello@abodid.com";
        statusNode.className = "media-lab__form-status is-error";
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = defaultBtnText;
      }
    });
  };

  initLabForm();
  document.addEventListener("astro:page-load", initLabForm);
</script>

<style>
  .media-lab {
    --pop-blue: #2444ca;
    --pop-pink: #ff7eb5;
    --pop-yellow: #ffe44f;
    --pop-lime: #caff48;
    --pop-cream: #fff8e8;
    --pop-ink: #15130f;
    --pop-border: rgba(21, 19, 15, 0.78);
    background: var(--pop-blue);
    color: var(--pop-ink);
  }

  .media-lab__bottom-section {
    padding: 0 clamp(1rem, 6vw, 6rem) clamp(5rem, 8vw, 8rem);
    background: var(--pop-blue);
  }

  .media-lab__bottom-container {
    width: min(100%, 1480px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Unified Card Base */
  .media-lab__card {
    border: 1px solid var(--pop-border);
    border-radius: clamp(18px, 2vw, 28px);
    padding: clamp(1.8rem, 3.2vw, 3rem) clamp(1.4rem, 2.8vw, 2.8rem);
    box-sizing: border-box;
    overflow: hidden;
  }

  .media-lab__card--yellow {
    background: var(--pop-yellow);
    color: var(--pop-ink);
  }

  .media-lab__card--pink {
    background: var(--pop-pink);
    color: var(--pop-ink);
  }

  /* Top Meta Line (matches .lab-card__meta throughout the page) */
  .media-lab__card-meta {
    padding-bottom: 0.9rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    border-bottom: 1px solid currentColor;
    font: 750 clamp(0.68rem, 0.9vw, 0.78rem)/1.35 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: inherit;
  }

  .media-lab__card-discipline {
    text-align: right;
  }

  /* Note Card Typography */
  .media-lab__note-body {
    margin: clamp(1.5rem, 2.5vw, 2.4rem) 0 0.5rem;
    font: 450 clamp(1.35rem, 2.2vw, 2.35rem)/1.3 var(--font-display);
    letter-spacing: -0.025em;
    color: inherit;
    text-wrap: balance;
    max-width: 68rem;
  }

  /* Collaboration CTA Section */
  .media-lab__cta-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, 1fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    margin-top: clamp(1.5rem, 2.8vw, 2.4rem);
    align-items: start;
  }

  .media-lab__cta-intro {
    display: flex;
    flex-direction: column;
  }

  .media-lab__cta-title {
    margin: 0;
    font: 620 clamp(2.2rem, 4.2vw, 4rem)/0.92 var(--font-display);
    letter-spacing: -0.055em;
    color: inherit;
    text-wrap: balance;
  }

  .media-lab__cta-description {
    margin: 1.25rem 0 0;
    font: 450 clamp(1.02rem, 1.25vw, 1.22rem)/1.45 var(--font-display);
    letter-spacing: -0.015em;
    color: rgba(21, 19, 15, 0.9);
    max-width: 36rem;
    text-wrap: pretty;
  }

  .media-lab__cta-direct {
    margin-top: clamp(1.5rem, 2.5vw, 2.2rem);
    padding-top: 1.2rem;
    border-top: 1px solid rgba(21, 19, 15, 0.25);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .media-lab__cta-direct-label {
    font: 750 0.72rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(21, 19, 15, 0.75);
  }

  .media-lab__cta-direct-link {
    font: 750 clamp(0.95rem, 1.1vw, 1.15rem)/1.35 var(--font-mono);
    color: var(--pop-ink);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
  }

  .media-lab__cta-direct-link > span:first-child {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
  }

  .media-lab__cta-direct-link > span:last-child {
    transition: transform 0.18s ease;
  }

  .media-lab__cta-direct-link:hover > span:last-child {
    transform: translate(2px, -2px);
  }

  /* Form Architecture */
  .media-lab__form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    background: rgba(255, 255, 255, 0.28);
    border: 1px solid var(--pop-border);
    border-radius: clamp(12px, 1.4vw, 18px);
    padding: clamp(1.4rem, 2.2vw, 2rem);
  }

  .media-lab__form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }

  .media-lab__field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .media-lab__field label {
    font: 750 0.72rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pop-ink);
  }

  .media-lab__field input,
  .media-lab__field textarea {
    width: 100%;
    box-sizing: border-box;
    background: #ffffff;
    border: 1px solid var(--pop-border);
    border-radius: 8px;
    padding: 0.8rem 0.95rem;
    font: 450 0.98rem/1.45 var(--font-body);
    color: var(--pop-ink);
    transition:
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .media-lab__field input::placeholder,
  .media-lab__field textarea::placeholder {
    color: rgba(21, 19, 15, 0.45);
  }

  .media-lab__field input:focus,
  .media-lab__field textarea:focus {
    outline: none;
    border-color: var(--pop-blue);
    box-shadow: 0 0 0 3px rgba(36, 68, 202, 0.2);
  }

  .media-lab__field textarea {
    resize: vertical;
    min-height: 95px;
  }

  .media-lab__form-footer {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-top: 0.35rem;
  }

  .media-lab__submit-btn {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: #15130f !important;
    color: #fff8e8 !important;
    border: 1px solid #15130f;
    border-radius: 999px;
    padding: 0.85rem 1.9rem;
    font: 750 0.8rem/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      transform 0.18s ease,
      background-color 0.18s ease,
      border-color 0.18s ease;
  }

  .media-lab__submit-btn * {
    color: #fff8e8 !important;
  }

  .media-lab__submit-btn:hover:not(:disabled) {
    background: var(--pop-blue) !important;
    border-color: var(--pop-blue) !important;
    transform: translateY(-2px);
  }

  .media-lab__btn-arrow {
    display: inline-block;
    color: #fff8e8 !important;
    transition: transform 0.18s ease;
  }

  .media-lab__submit-btn:hover:not(:disabled) .media-lab__btn-arrow {
    transform: translate(2px, -2px);
  }

  .media-lab__submit-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .media-lab__form-status {
    margin: 0;
    font: 600 0.85rem/1.4 var(--font-body);
    min-height: 1.2rem;
  }

  .media-lab__form-status.is-success {
    color: #0b6b2a;
  }

  .media-lab__form-status.is-error {
    color: #bd1c1c;
  }

  @media (max-width: 980px) {
    .media-lab__cta-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .media-lab__cta-title {
      font-size: clamp(2rem, 7vw, 3rem);
    }

    .media-lab__form-row {
      grid-template-columns: 1fr;
    }

    .media-lab__submit-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<style is:global>
  html:has(body.lab-page) {
    background: #2444ca !important;
  }

  body.lab-page {
    margin: 0;
    padding: 0 !important;
    background: #2444ca !important;
    background-color: #2444ca !important;
  }
</style>

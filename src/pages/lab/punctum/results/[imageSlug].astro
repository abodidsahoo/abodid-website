---
export const prerender = false;

import PunctumResultDetail from "../../../../components/punctum/PunctumResultDetail";
import { getPunctumImageBySlug } from "../../../../data/punctumImages";
import PunctumLayout from "../../../../layouts/PunctumLayout.astro";

const requestedSlug = Astro.params.imageSlug || "";
const image = getPunctumImageBySlug(requestedSlug);
if (!image) return Astro.redirect("/lab/punctum/results", 302);
if (requestedSlug !== image.slug) {
  return Astro.redirect(`/lab/punctum/results/${image.slug}`, 301);
}

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, s-maxage=31536000, stale-while-revalidate=31536000"
);
Astro.response.headers.set(
  "Vercel-CDN-Cache-Control",
  "s-maxage=31536000, stale-while-revalidate=31536000"
);
---

<PunctumLayout
  title={`${image.title} — Punctum Results`}
  description="Explore anonymous marks as a collective constellation or as individual punctums."
>
  <PunctumResultDetail client:load image={image} />
</PunctumLayout>

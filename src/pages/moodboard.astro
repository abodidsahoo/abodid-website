---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedMoodboardItems } from "../lib/services/moodboard";

const title = "Mood Board — Abodid Sahoo";
const description =
  "A living, randomly arranged collection of visual references, impulses and instincts.";

const moodboardItems = await getPublishedMoodboardItems();
const shuffledItems = [...moodboardItems];

for (let index = shuffledItems.length - 1; index > 0; index -= 1) {
  const randomIndex = Math.floor(Math.random() * (index + 1));
  [shuffledItems[index], shuffledItems[randomIndex]] = [
    shuffledItems[randomIndex],
    shuffledItems[index],
  ];
}

Astro.response.headers.set("Cache-Control", "no-store");
---

<BaseLayout
  title={title}
  description={description}
  fullWidth={true}
  hideHeader={true}
  hideFooter={false}
  hideWhatsAppButton={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="story-moodboard-page"
>
  <header class="story-nav">
    <a class="story-nav__brand" href="/" aria-label="Abodid Sahoo homepage"
      >abodid.com</a
    >
    <nav class="story-nav__links" aria-label="Primary navigation">
      <a href="/work">Work</a>
      <a href="/research">Research</a>
      <a href="/services">Services</a>
      <a href="/experience">Experience</a>
      <a href="/about">About</a>
    </nav>
    <a class="story-nav__contact" href="/#enquiry"
      >Hire me <span class="link-destination-arrow" aria-hidden="true">↗</span></a
    >
    <details class="story-nav__mobile">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        <a href="/work">Work</a>
        <a href="/research">Research</a>
        <a href="/services">Services</a>
        <a href="/experience">Experience</a>
        <a href="/about">About</a>
        <a href="/#enquiry">Hire me <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
      </nav>
    </details>
  </header>

  <main class="moodboard-shell">
    <article class="moodboard-file">
      <header class="moodboard-heading">
        <div class="moodboard-heading__hero">
          <h1>Mood Board</h1>
          <p>An archive of impulses and instincts.</p>
        </div>
      </header>

      <section
        class="moodboard-board"
        aria-label="Randomised visual references"
      >
        {
          shuffledItems.length > 0 ? (
            <div class="moodboard-grid">
              {shuffledItems.map((item, index) => (
                <figure class="moodboard-card">
                  <img
                    src={item.imageUrl}
                    alt={item.title || "Visual moodboard reference"}
                    width={item.imageWidth || undefined}
                    height={item.imageHeight || undefined}
                    loading={index < 10 ? "eager" : "lazy"}
                    fetchpriority={index < 5 ? "high" : "low"}
                    decoding="async"
                  />
                  <figcaption class="sr-only">
                    {item.title}
                    {item.tags.length ? ` — ${item.tags.join(", ")}` : ""}
                  </figcaption>
                </figure>
              ))}
            </div>
          ) : (
            <div class="moodboard-empty">
              <p>
                The visual archive is being rearranged. Please return shortly.
              </p>
            </div>
          )
        }

        <footer class="moodboard-footer">
          <div class="moodboard-footer__top">
            <h2 class="moodboard-footer__headline">
              Your vibe attracts your tribe
            </h2>
            <div class="moodboard-footer__ctas">
              <a class="moodboard-cta moodboard-cta--primary" href="/#enquiry">
                Get in touch <span class="link-destination-arrow" aria-hidden="true">↗</span>
              </a>
              <a class="moodboard-cta moodboard-cta--secondary" href="/photo-gallery">
                Check out my Work <span class="link-destination-arrow" aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <div class="moodboard-footer__divider" aria-hidden="true"></div>

          <div class="moodboard-footer__bottom">
            <blockquote class="moodboard-footer__quote">
              <h3 class="moodboard-footer__byline">
                &ldquo;Taste&rdquo; by <a
                  href="https://x.com/saranormous"
                  target="_blank"
                  rel="noopener noreferrer"
                  >Sarah Guo <span class="link-destination-arrow" aria-hidden="true">↗</span></a
                >
              </h3>
              <p>
                Taste begins as loneliness and ends as leadership. It starts
                with one person who can't unsee that the button is two pixels
                off. Then they find another who winces at the error message.
                Another who loses sleep over the loading animation.
              </p>
              <p>
                Suddenly you're not alone. You're a conspiracy of people who
                give a shit. The designer who fights for one more iteration. The
                engineer who refactors the hacky solution. The PM who kills the
                feature that would triple revenue but break the product's soul.
                The support rep who rewrites the docs because they're tired of
                explaining unclear things. Each person raising the bar simply by
                refusing to lower theirs.
              </p>
              <p>
                This is how taste compounds—not through manifestos or design
                systems, but through finding your people. The ones who see what
                you see. Who hurt where you hurt. Who can't help but care.
              </p>
            </blockquote>
          </div>
        </footer>
      </section>
    </article>
  </main>
</BaseLayout>

<style is:global>
  body.story-moodboard-page {
    --pop-blue: #2444ca;
    --pop-purple: #6657d8;
    --pop-pink: #ff7eb5;
    --pop-yellow: #ffe44f;
    --pop-cream: #fff8e8;
    --pop-ink: #15130f;
    --story-gutter: clamp(1rem, 3vw, 3.5rem);
    --pop-border: 1px solid var(--pop-ink);
    /* Exact same resets as landing page */
    margin: 0;
    padding: 0 !important;
    background: var(--pop-blue) !important;
    color: var(--pop-ink);
    min-height: 100vh;
  }

  html:has(body.story-moodboard-page) {
    background: var(--pop-blue);
    margin: 0;
    padding: 0;
  }

  /* Mirror landing page: zero out main, keep overflow visible for sticky header */
  body.story-moodboard-page main.page-content-full {
    margin: 0;
    padding: 0 !important;
    overflow: visible;
  }

  body.story-moodboard-page :is(h1, h2, h3, p, figure, dl, dd, ul) {
    margin-top: 0;
  }
  body.story-moodboard-page :is(a, button, summary) {
    -webkit-tap-highlight-color: transparent;
  }

  /* ── Force header to exactly match landing page — full specificity via body class ── */
  body.story-moodboard-page .story-nav {
    position: sticky !important;
    top: 0 !important;
    z-index: 50 !important;
    min-height: 72px !important;
    padding: 0 var(--story-gutter) !important;
    display: grid !important;
    grid-template-columns: minmax(140px, 1fr) auto minmax(
        220px,
        1fr
      ) !important;
    align-items: center !important;
    gap: 1.5rem !important;
    border-bottom: 0 !important;
    background: var(--pop-blue) !important;
    color: var(--pop-ink) !important;
  }
  body.story-moodboard-page .story-nav a,
  body.story-moodboard-page .story-nav summary {
    color: inherit !important;
    font: 700 0.72rem/1 var(--font-mono, monospace) !important;
    letter-spacing: 0.08em !important;
    text-decoration: none !important;
    text-transform: uppercase !important;
  }
  body.story-moodboard-page .story-nav__brand {
    width: fit-content !important;
    min-height: 42px !important;
    padding: 0 0.9rem !important;
    display: inline-flex !important;
    align-items: center !important;
    border: 1px solid var(--pop-ink) !important;
    border-radius: 14px !important;
    background: var(--pop-yellow) !important;
    color: var(--pop-ink) !important;
  }
  body.story-moodboard-page .story-nav__links {
    display: flex !important;
    align-items: center !important;
    justify-self: center !important;
    gap: clamp(1.2rem, 2.5vw, 2.5rem) !important;
  }
  body.story-moodboard-page .story-nav__links a {
    color: var(--pop-cream) !important;
    opacity: 1;
    transition: text-decoration-color 160ms ease;
  }
  body.story-moodboard-page .story-nav__links a:hover,
  body.story-moodboard-page .story-nav__links a:focus-visible {
    text-decoration: underline !important;
    text-underline-offset: 4px !important;
    text-decoration-thickness: 2px !important;
  }
  body.story-moodboard-page .story-nav__contact {
    justify-self: end !important;
    min-height: 44px !important;
    padding: 0 1rem !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.5rem !important;
    border: 1px solid var(--pop-ink) !important;
    border-radius: 14px !important;
    background: var(--pop-pink) !important;
    color: var(--pop-ink) !important;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }
  body.story-moodboard-page .story-nav__contact:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 0 var(--pop-ink);
  }
  body.story-moodboard-page .story-nav__mobile {
    display: none !important;
  }

  @media (max-width: 980px) {
    body.story-moodboard-page .story-nav {
      grid-template-columns: 1fr auto !important;
    }
    body.story-moodboard-page .story-nav__links,
    body.story-moodboard-page .story-nav__contact {
      display: none !important;
    }
    body.story-moodboard-page .story-nav__mobile {
      position: relative !important;
      display: block !important;
      justify-self: end !important;
    }
    body.story-moodboard-page .story-nav__mobile summary {
      min-height: 44px;
      padding: 0 0.9rem;
      display: flex;
      align-items: center;
      border: 1px solid var(--pop-ink);
      border-radius: 14px;
      background: var(--pop-yellow);
      color: var(--pop-ink);
      cursor: pointer;
      list-style: none;
    }
    body.story-moodboard-page
      .story-nav__mobile
      summary::-webkit-details-marker {
      display: none;
    }
    body.story-moodboard-page .story-nav__mobile nav {
      position: fixed;
      inset: 72px 0 auto;
      padding: 1.5rem var(--story-gutter) 2rem;
      display: grid;
      gap: 0;
      background: var(--pop-yellow);
      border-bottom: 1px solid var(--pop-ink);
    }
    body.story-moodboard-page .story-nav__mobile nav a {
      padding: 1rem 0;
      border-bottom: 1px solid rgba(23, 21, 15, 0.2);
      font-size: 0.85rem;
    }
  }
</style>

<style>
  /* ── Moodboard Layout ───────────────────── */
  .moodboard-shell {
    width: 100%;
    padding: 8px;
    box-sizing: border-box;
    background: var(--pop-blue);
  }

  .moodboard-file {
    width: 100%;
    max-width: none;
    margin-inline: 0;
    box-sizing: border-box;
    overflow: hidden;
    border: 1px solid var(--pop-ink);
    border-radius: clamp(20px, 3vw, 34px);
    background: var(--pop-cream);
    box-shadow: 0 10px 0 rgba(21, 19, 15, 0.2);
  }

  .moodboard-heading {
    padding: clamp(1.4rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--pop-ink);
    background: var(--pop-pink);
  }

  .moodboard-heading__tag {
    margin-bottom: clamp(2.5rem, 7vw, 5.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.55rem;
    color: var(--pop-ink);
    font: 700 0.72rem/1 var(--font-mono, monospace);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .moodboard-legacy-link {
    font-size: 0.72rem;
    color: var(--pop-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 700;
  }

  .moodboard-heading__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(260px, 0.7fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: end;
  }

  .moodboard-heading h1 {
    max-width: 9ch;
    margin: 0;
    color: var(--pop-ink);
    font: 720 clamp(3.7rem, 9vw, 8.5rem)/0.84 var(--font-display, sans-serif);
    letter-spacing: -0.075em;
  }

  .moodboard-heading__hero p {
    max-width: 34rem;
    margin: 0;
    color: var(--pop-ink);
    font: 500 clamp(1.15rem, 2vw, 1.65rem)/1.32 var(--font-display, sans-serif);
    letter-spacing: -0.025em;
  }

  .moodboard-board {
    --grid-gap: 25px;
    background: #f5ede0;
    padding: var(--grid-gap);
  }

  .moodboard-grid {
    columns: 4;
    column-gap: var(--grid-gap);
    orphans: 1;
    widows: 1;
  }

  .moodboard-card {
    break-inside: avoid;
    margin: 0 0 var(--grid-gap) 0;
    padding: 0;
    display: block;
    overflow: hidden;
    border-radius: 14px;
    transition: transform 200ms ease;
  }

  .moodboard-card:hover {
    transform: translateY(-2px);
  }

  .moodboard-card img {
    width: 100%;
    height: auto;
    display: block;
    /* Kill the 3-4px inline gap browsers add under images */
    vertical-align: bottom;
    line-height: 0;
  }

  .moodboard-empty {
    padding: 6rem 2rem;
    text-align: center;
    color: var(--pop-ink);
    font: 600 1.2rem/1.4 var(--font-display, sans-serif);
  }

  /* ── Moodboard Footer ────────────────────── */
  .moodboard-footer {
    margin-top: clamp(2.5rem, 6vw, 5rem);
    padding: clamp(2rem, 4.5vw, 4rem);
    border: 1px solid var(--pop-ink);
    border-radius: clamp(16px, 2.5vw, 28px);
    background: var(--pop-pink);
    color: var(--pop-ink);
  }

  .moodboard-footer__top {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
  }

  .moodboard-footer__headline {
    margin: 0;
    font: 700 clamp(2rem, 4.5vw, 3.8rem)/0.95 var(--font-display, sans-serif);
    letter-spacing: -0.05em;
    max-width: 30ch;
  }

  .moodboard-footer__subline {
    margin: 0;
    max-width: 38rem;
    font: 700 clamp(1.25rem, 2.2vw, 1.75rem)/1.3 var(--font-display, sans-serif);
    opacity: 0.95;
  }

  .moodboard-footer__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .moodboard-cta {
    min-height: 48px;
    padding: 0 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--pop-ink);
    border-radius: 14px;
    font: 700 0.76rem/1 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      transform 160ms ease,
      background 160ms ease;
  }

  .moodboard-cta--primary {
    background: var(--pop-yellow);
    color: var(--pop-ink);
  }

  .moodboard-cta--primary:hover {
    transform: translateY(-2px);
    background: #ffe96e;
  }

  .moodboard-cta--secondary {
    background: var(--pop-cream);
    color: var(--pop-ink);
  }

  .moodboard-cta--secondary:hover {
    transform: translateY(-2px);
  }

  .moodboard-footer__divider {
    height: 1px;
    background: var(--pop-ink);
    margin: clamp(2rem, 4vw, 3rem) 0;
    opacity: 0.25;
  }

  .moodboard-footer__bottom {
    max-width: 48rem;
    margin: 0 auto;
    text-align: center;
  }

  .moodboard-footer__quote {
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    color: #000000 !important;
    text-align: left;
    background: #ffe44f !important;
    border: 2.5px solid #000000 !important;
    border-radius: 24px;
    padding: clamp(2rem, 5vw, 3rem);
    box-shadow: 0 8px 0 #000000 !important;
  }

  .moodboard-footer__byline {
    margin: 0;
    font: 850 clamp(2rem, 4.5vw, 3.2rem)/1.05 var(--font-display, sans-serif) !important;
    letter-spacing: -0.04em;
    color: #000000 !important;
    padding-bottom: 1.25rem;
    border-bottom: 3px solid #000000;
  }

  .moodboard-footer__byline a {
    color: #000000 !important;
    text-decoration: underline !important;
    text-decoration-thickness: 3px !important;
    text-underline-offset: 4px;
  }

  .moodboard-footer__quote p {
    margin: 0;
    font: 600 clamp(1.15rem, 2vw, 1.55rem)/1.45 var(--font-display, sans-serif) !important;
    color: #000000 !important;
    letter-spacing: -0.015em;
  }

  @media (max-width: 1100px) {
    .moodboard-grid {
      columns: 3;
    }
  }

  @media (max-width: 760px) {
    .moodboard-heading__hero {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .moodboard-grid {
      columns: 2;
    }
    .moodboard-shell {
      padding: 6px;
    }
  }

  @media (max-width: 480px) {
    .moodboard-grid {
      columns: 1;
    }
  }
</style>

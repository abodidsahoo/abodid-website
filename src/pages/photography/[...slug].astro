---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPhotographyBySlug } from "../../lib/api";
import { marked } from "marked";
import ShareButtons from "../../components/ShareButtons.jsx";
import photographyImageDimensions from "../../data/photographyImageDimensions.generated.json";
import {
  getOptimizedImageSrcSet,
  getOptimizedImageUrl,
} from "../../lib/imageOptimization.js";
import {
  breadcrumbJsonLd,
  creativeWorkJsonLd,
  personJsonLd,
  seoIdentity,
} from "../../lib/seoData";

export const prerender = false;

const { slug } = Astro.params;

type PhotographyPageProject = {
  title: string;
  content?: string;
  intro?: string;
  description?: string;
  cover_image?: string;
  image?: string;
  images: string[];
  date?: string;
};

if (slug === "my-life") {
  return Astro.redirect("/bts", 301);
}
if (slug === "uk-2026") {
  return Astro.redirect("/uk-2026", 301);
}

const project = (await getPhotographyBySlug(
  slug ?? "",
)) as PhotographyPageProject | null;

if (!project) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const contentHtml = marked.parse(project.content || "");
const PRIORITY_IMAGE_COUNT = 2;
const imageDimensionsByPath = photographyImageDimensions as Record<
  string,
  { width: number; height: number }
>;
const storagePathFromUrl = (url: string) => {
  try {
    const pathname = new URL(url).pathname;
    const match = pathname.match(/\/object\/(?:public\/)?photography\/(.+)$/);
    return match?.[1] ? decodeURIComponent(match[1]) : "";
  } catch {
    return "";
  }
};

const canonicalUrl = `${seoIdentity.siteUrl}/photography/${slug}`;
const description = project.intro || project.description || `Photography project ${project.title} by Abodid Sahoo.`;
const coverImage = project.cover_image || project.image || project.images?.[0];

const structuredData = [
  personJsonLd(),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Photography", path: "/photography" },
    { name: project.title, path: `/photography/${slug}` },
  ]),
  creativeWorkJsonLd({
    title: project.title,
    description,
    url: canonicalUrl,
    image: coverImage || undefined,
    dateCreated: project.date || undefined,
  }),
];

const processedImages = (project.images || []).map((img, index) => {
  const dimensions = imageDimensionsByPath[storagePathFromUrl(img)];
  const isPriority = index < PRIORITY_IMAGE_COUNT;
  return {
    src: img,
    optimizedSrc: getOptimizedImageUrl(img, {
      width: isPriority ? 1400 : 1000,
      quality: 82,
    }),
    optimizedSrcSet: getOptimizedImageSrcSet(img, {
      widths: [480, 800, 1200, 1600],
      quality: 82,
    }),
    dimensions,
    isPriority,
  };
});

const SERIES_PDF_MAP: Record<string, string> = {
  "into-the-flux": "abodid-into-the-flux.pdf",
  "outernet-london-2025": "abodid-outernet-london-2025.pdf",
  "yu-ting-blinded-in-london-overground": "abodid-yu-ting-blinded-in-london-overground.pdf",
  "digital-direction-rca-gradshow-in-white-city": "abodid-digital-direction-rca-gradshow-in-white-city.pdf",
  "vaneesha-birthday-in-kent": "abodid-vaneesha-birthday-in-kent.pdf",
  "england-women-football-team-wins": "abodid-england-women-football-team-wins.pdf",
  "navratti-sharma-in-london": "abodid-navratti-sharma-in-london.pdf",
  "outernet-london-2024": "abodid-outernet-london-2024.pdf",
  "portobello-art-fair-london": "abodid-portobello-art-fair-london.pdf",
  "suheda-in-primrose-hill-london": "abodid-suheda-in-primrose-hill-london.pdf",
  "mary-and-her-daughter-in-london-exhibitions": "abodid-mary-and-her-daughter-in-london-exhibitions.pdf",
  "frameless-london-rca-exhibition": "abodid-frameless-london-rca-exhibition.pdf",
  "british-film-institute-london": "abodid-british-film-institute-london.pdf",
  "prakruti-mishra-in-london": "abodid-prakruti-mishra-in-london.pdf",
  "outernet-london-rca-2023": "abodid-outernet-london-rca-2023.pdf",
  "rca-gradshow-in-london": "abodid-rca-gradshow-in-london.pdf",
  "uncanny-comforts-with-emma": "abodid-uncanny-comforts-with-emma.pdf",
  "breathe-variations-london-exhibition": "abodid-breathe-variations-london-exhibition.pdf",
  "rca-gradshow-in-white-city-london": "abodid-rca-gradshow-in-white-city-london.pdf",
  "rca-battersea-exhibiton-arts-and-humanities": "abodid-rca-battersea-exhibiton-arts-and-humanities.pdf",
  "cries-of-an-unmarried-widow": "abodid-cries-of-an-unmarried-widow.pdf",
  "portobello-market-london": "abodid-portobello-market-london.pdf",
  "bus-ride-in-london": "abodid-bus-ride-in-london.pdf",
  "navratti-in-london-underground": "abodid-navratti-in-london-underground.pdf",
};

const pdfFilename = slug ? (SERIES_PDF_MAP[slug] || `abodid-${slug}.pdf`) : "";
const pdfDownloadUrl = pdfFilename
  ? `https://assets.abodid.com/documents/photography-series-pdfs/${pdfFilename}`
  : null;
---

<BaseLayout
  title={`${project.title} — Photography Series | Abodid Sahoo`}
  description={description}
  image={coverImage}
  type="article"
  structuredData={structuredData}
  fullWidth={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="story-moodboard-page"
>
  {/* Floating Bottom-Right Controls: PDF Download + View Switcher (Pop Editorial) */}
  <aside class="floating-actions-container" aria-label="Series quick actions">
    {pdfDownloadUrl && (
      <a
        href={pdfDownloadUrl}
        download={pdfFilename}
        target="_blank"
        rel="noopener noreferrer"
        class="floating-pdf-btn pop-editorial-control"
        title={`Download ${project.title} PDF`}
        aria-label={`Download ${project.title} PDF`}
      >
        <span class="floating-pdf-icon" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
        </span>
        <span class="floating-pdf-text">Download PDF</span>
        <span class="floating-pdf-badge" aria-hidden="true">↓</span>
      </a>
    )}

    <div class="view-mode-floating-control pop-editorial-control" role="toolbar" aria-label="Select photo display layout">
      <button
        type="button"
        class="view-mode-btn is-active"
        data-view-btn="board"
        title="Board view (moodboard masonry grid)"
        aria-label="Board view"
        aria-pressed="true"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <rect x="3" y="3" width="7.5" height="7.5" rx="1.5" />
          <rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5" />
          <rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5" />
          <rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5" />
        </svg>
        <span>Board</span>
      </button>
      <button
        type="button"
        class="view-mode-btn"
        data-view-btn="postcard"
        title="Postcard view (framed story layout)"
        aria-label="Postcard view"
        aria-pressed="false"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <rect x="3" y="4" width="18" height="4.5" rx="1.5" />
          <rect x="3" y="9.75" width="18" height="4.5" rx="1.5" />
          <rect x="3" y="15.5" width="18" height="4.5" rx="1.5" />
        </svg>
        <span>Postcard</span>
      </button>
    </div>
  </aside>

  <main class="moodboard-shell">
    <article class="moodboard-file" data-view-container="board">
      {/* 1. Authentic Pop Editorial Moodboard Heading */}
      <header class="moodboard-heading">
        <div class="moodboard-heading__tag">
          <a href="/photography" class="moodboard-back-link">
            <span>← All Photo Series</span>
          </a>
        </div>

        <div class="moodboard-heading__hero">
          <h1>{project.title}</h1>
          {project.intro ? (
            <p>{project.intro}</p>
          ) : project.description ? (
            <p>{project.description}</p>
          ) : null}
        </div>

        {project.content && (
          <div class="moodboard-prose" set:html={contentHtml} />
        )}
      </header>

      {/* 2. Moodboard Board Canvas */}
      <section class="moodboard-board" aria-label={`${project.title} photography series`}>
        <div class="moodboard-gallery-container" data-view-content="board">
          {processedImages.map((item, index) => (
            <figure class="moodboard-card" key={index}>
              <img
                src={item.optimizedSrc}
                srcset={item.optimizedSrcSet}
                sizes="(max-width: 600px) calc(100vw - 32px), (max-width: 1200px) 50vw, 800px"
                alt={`${project.title} frame ${index + 1}`}
                width={item.dimensions?.width}
                height={item.dimensions?.height}
                loading={item.isPriority ? "eager" : "lazy"}
                decoding={index < 2 ? "sync" : "async"}
              />
            </figure>
          ))}
        </div>

        {/* 3. Moodboard Footer Section */}
        <footer class="moodboard-footer">
          <div class="moodboard-footer__top">
            <h2 class="moodboard-footer__headline">
              Commission or license this photo series
            </h2>
            <div class="moodboard-footer__ctas">
              <a class="moodboard-cta moodboard-cta--primary" href="/photography#enquiry">
                <span>Commission work</span>
                <span class="link-destination-arrow" aria-hidden="true">↗</span>
              </a>
              <a class="moodboard-cta moodboard-cta--secondary" href="/photography">
                <span>Explore all series</span>
                <span class="link-destination-arrow" aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <div class="moodboard-footer__share">
            <ShareButtons
              client:idle
              title={project.title}
              url={Astro.url.href}
            />
          </div>
        </footer>
      </section>
    </article>
  </main>

  <script is:inline>
    (() => {
      const STORAGE_KEY = "photography_project_view_mode";

      const initViewMode = () => {
        const container = document.querySelector("[data-view-container]");
        const content = document.querySelector("[data-view-content]");
        const buttons = document.querySelectorAll("[data-view-btn]");
        if (!container || !content) return;

        // Retrieve initial mode from URL or localStorage (default to 'board')
        const urlParams = new URLSearchParams(window.location.search);
        const urlMode = urlParams.get("view");
        let activeMode = urlMode === "board" || urlMode === "postcard"
          ? urlMode
          : localStorage.getItem(STORAGE_KEY) || "board";

        const applyViewMode = (mode) => {
          container.setAttribute("data-view-container", mode);
          content.setAttribute("data-view-content", mode);

          buttons.forEach((btn) => {
            const isMatch = btn.getAttribute("data-view-btn") === mode;
            btn.classList.toggle("is-active", isMatch);
            btn.setAttribute("aria-pressed", String(isMatch));
          });

          try {
            localStorage.setItem(STORAGE_KEY, mode);
          } catch (e) {}
        };

        buttons.forEach((btn) => {
          btn.addEventListener("click", () => {
            const mode = btn.getAttribute("data-view-btn");
            if (mode) {
              applyViewMode(mode);
              const nextUrl = new URL(window.location.href);
              nextUrl.searchParams.set("view", mode);
              window.history.replaceState({}, "", nextUrl.toString());
            }
          });
        });

        applyViewMode(activeMode);
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initViewMode);
      } else {
        initViewMode();
      }
      document.addEventListener("astro:page-load", initViewMode);
      document.addEventListener("astro:after-swap", initViewMode);
    })();
  </script>
</BaseLayout>

<style is:global>
  body.story-moodboard-page {
    --pop-border: 1px solid var(--pop-ink);
    margin: 0;
    padding: 0 !important;
    min-height: 100vh;
    background: var(--pop-blue) !important;
    color: var(--pop-ink);
  }

  html:has(body.story-moodboard-page) {
    background: var(--pop-blue) !important;
    margin: 0;
    padding: 0;
  }

  body.story-moodboard-page main.page-content-full {
    margin: 0;
    padding: 0 !important;
    overflow: visible;
    max-width: 100% !important;
  }

  body.story-moodboard-page :is(h1, h2, h3, p, figure, dl, dd, ul) {
    margin-top: 0;
  }

  body.story-moodboard-page :is(a, button, summary) {
    -webkit-tap-highlight-color: transparent;
  }
</style>

<style>
  /* --- POP EDITORIAL FLOATING CONTROLS (BOTTOM-RIGHT) --- */
  .floating-actions-container {
    position: fixed;
    bottom: clamp(1.2rem, 3vw, 2.5rem);
    right: clamp(1rem, 3vw, 2.5rem);
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
    pointer-events: none;
  }

  .floating-actions-container > * {
    pointer-events: auto;
  }

  /* Shared Pop Editorial Pill styling */
  .pop-editorial-control {
    border: 1.5px solid var(--pop-ink, var(--pop-ink));
    border-radius: 999px;
    box-shadow: 3px 3px 0 var(--pop-ink, var(--pop-ink));
    transition: transform 160ms ease, box-shadow 160ms ease, background-color 160ms ease, border-color 160ms ease;
  }

  /* 1. Download PDF Button */
  .floating-pdf-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 38px;
    padding: 0.4rem 0.95rem 0.4rem 0.85rem;
    background: var(--pop-yellow, #ffe44f);
    color: var(--pop-ink, #15130f);
    font: 750 0.72rem/1 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    user-select: none;
  }

  .floating-pdf-btn:hover {
    background: #ffffff;
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--pop-ink, var(--pop-ink));
  }

  .floating-pdf-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 2px 2px 0 var(--pop-ink, var(--pop-ink));
  }

  .floating-pdf-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .floating-pdf-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1;
    margin-left: 2px;
    transition: transform 160ms ease;
  }

  .floating-pdf-btn:hover .floating-pdf-badge {
    transform: translateY(2px);
  }

  /* 2. View Mode Switcher */
  .view-mode-floating-control {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 3.5px;
    background: var(--pop-cream, #fff8e8);
    user-select: none;
  }

  .view-mode-floating-control:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--pop-ink, var(--pop-ink));
  }

  .view-mode-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    min-height: 31px;
    padding: 0.35rem 0.72rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--pop-ink, #15130f);
    font: 750 0.68rem/1 var(--font-mono, monospace);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 140ms ease, color 140ms ease, transform 140ms ease, border-color 140ms ease;
  }

  .view-mode-btn svg {
    flex-shrink: 0;
  }

  .view-mode-btn:hover:not(.is-active) {
    background: rgba(21, 19, 15, 0.07);
    transform: translateY(-1px);
  }

  .view-mode-btn.is-active {
    background: var(--pop-blue, #2444ca);
    color: #ffffff;
    border-color: var(--pop-ink, var(--pop-ink));
    box-shadow: 1.5px 1.5px 0 var(--pop-ink, var(--pop-ink));
  }

  .view-mode-btn.is-active:hover {
    background: #3355e0;
  }

  /* ── 1. MOODBOARD SHELL & ENVELOPE ───────────────────── */
  .moodboard-shell {
    width: 100%;
    padding: 8px;
    box-sizing: border-box;
    background: var(--pop-blue, #2444ca);
  }

  .moodboard-file {
    width: 100%;
    max-width: none;
    margin-inline: 0;
    box-sizing: border-box;
    overflow: hidden;
    border: 1px solid var(--pop-ink, var(--pop-ink));
    border-radius: clamp(20px, 3vw, 34px);
    background: var(--pop-cream, #fff8e8);
    box-shadow: 0 10px 0 rgba(21, 19, 15, 0.2);
  }

  /* ── 2. MOODBOARD HEADING (HOT-PINK PANEL) ────────────── */
  .moodboard-heading {
    padding: clamp(1.4rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--pop-ink, var(--pop-ink));
    background: var(--pop-pink, #ff7eb5);
    color: var(--pop-ink, #15130f);
  }

  .moodboard-heading__tag {
    margin-bottom: clamp(1.8rem, 4vw, 3.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .moodboard-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--pop-ink, #15130f);
    font: 750 0.72rem/1 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--pop-ink, var(--pop-ink));
    border-radius: 999px;
    background: var(--pop-cream, #fff8e8);
    transition: transform 160ms ease, background-color 160ms ease;
  }

  .moodboard-back-link:hover {
    transform: translateY(-2px);
    background: #ffffff;
  }



  .moodboard-heading__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(260px, 0.7fr);
    gap: clamp(2rem, 5vw, 6rem);
    align-items: end;
  }

  .moodboard-heading h1 {
    margin: 0;
    color: var(--pop-ink, #15130f);
    font: 720 clamp(3.2rem, 7.5vw, 7.5rem)/0.86 var(--font-display, sans-serif);
    letter-spacing: -0.07em;
    text-wrap: balance;
  }

  .moodboard-heading__hero p {
    max-width: 38rem;
    margin: 0;
    color: var(--pop-ink, #15130f);
    font: 500 clamp(1.15rem, 1.8vw, 1.6rem)/1.35 var(--font-display, sans-serif);
    letter-spacing: -0.025em;
  }

  .moodboard-prose {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: clamp(1.2rem, 2.5vw, 2rem);
    border-top: 1px solid rgba(21, 19, 15, 0.35);
    max-width: 820px;
    font: 450 clamp(1rem, 1.2vw, 1.15rem)/1.65 var(--font-body, sans-serif);
    color: rgba(21, 19, 15, 0.9);
  }

  /* ── 3. MOODBOARD BOARD SECTION ──────────────────────── */
  .moodboard-board {
    background: #f5ede0;
    padding: clamp(1.2rem, 2.5vw, 25px);
    box-sizing: border-box;
    width: 100%;
  }

  /* --- BOARD VIEW: Masonry Columns --- */
  .moodboard-gallery-container[data-view-content="board"] {
    display: block;
    columns: 4;
    column-gap: 24px;
    orphans: 1;
    widows: 1;
    width: 100%;
    box-sizing: border-box;
  }

  .moodboard-gallery-container[data-view-content="board"] .moodboard-card {
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    page-break-inside: avoid;
    margin: 0 0 24px 0;
    padding: 0;
    display: block;
    overflow: hidden;
    border-radius: 14px;
    box-sizing: border-box;
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .moodboard-gallery-container[data-view-content="board"] .moodboard-card:hover {
    transform: translateY(-3px);
  }

  .moodboard-gallery-container[data-view-content="board"] .moodboard-card img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 14px;
    vertical-align: bottom;
    line-height: 0;
  }

  /* --- POSTCARD VIEW: Centered Sequence --- */
  .moodboard-file[data-view-container="postcard"] {
    --postcard-gallery-gap: clamp(2rem, 4vw, 3.5rem);
  }

  .moodboard-file[data-view-container="postcard"] .moodboard-board {
    padding-top: var(--postcard-gallery-gap);
  }

  .moodboard-gallery-container[data-view-content="postcard"] {
    display: flex;
    flex-direction: column;
    gap: var(--postcard-gallery-gap);
    max-width: 1080px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .moodboard-gallery-container[data-view-content="postcard"] .moodboard-card {
    break-inside: auto;
    margin: 0;
    width: 100%;
    padding: 0;
    box-sizing: border-box;
    display: block;
    overflow: hidden;
    border-radius: 14px;
    transition: transform 200ms ease;
  }

  .moodboard-gallery-container[data-view-content="postcard"] .moodboard-card:hover {
    transform: translateY(-2px);
  }

  .moodboard-gallery-container[data-view-content="postcard"] .moodboard-card img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
    vertical-align: bottom;
  }

  /* ── 4. MOODBOARD FOOTER ─────────────────────────────── */
  .moodboard-footer {
    margin-top: clamp(2.5rem, 6vw, 5rem);
    padding: clamp(2rem, 4.5vw, 4rem);
    border: 1px solid var(--pop-ink, var(--pop-ink));
    border-radius: clamp(16px, 2.5vw, 28px);
    background: var(--pop-pink, #ff7eb5);
    color: var(--pop-ink, #15130f);
  }

  .moodboard-footer__top {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;

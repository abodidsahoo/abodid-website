---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PortfolioFilter from "../../components/PortfolioFilter.jsx";
import InlineInquiryForm from "../../components/InlineInquiryForm.astro";
import { getAllPhotography } from "../../lib/api";
import { featuredPhotography as mockPhotography } from "../../utils/mockData";
import photographyPortfolios from "../../data/photographyPortfolios.generated.json";
import { breadcrumbJsonLd, personJsonLd } from "../../lib/seoData";

// Safe Fetch Helper
const safeFetch = async (fn: () => Promise<any>, fallback: any) => {
  try {
    return await fn();
  } catch (e) {
    console.error("Data fetch failed:", e);
    return fallback;
  }
};

const rawPortfolioItems = await safeFetch(getAllPhotography, mockPhotography);

// Enrich items with metadata from photographyPortfolios generated data if matching
const storyMetadataBySlug = new Map(
  (photographyPortfolios.stories || []).map((s) => [s.slug, s])
);

const portfolioItems = rawPortfolioItems.map((item: any, index: number) => {
  const storyMeta = item.slug ? storyMetadataBySlug.get(item.slug) : undefined;
  return {
    ...item,
    imageCount: storyMeta?.imageCount || item.images?.length || 0,
    downloadUrl: storyMeta?.downloadUrl || null,
    labels: storyMeta?.labels || (Array.isArray(item.category) ? item.category : [item.category]),
    sortIndex: index,
  };
});

const collections = photographyPortfolios.collections || [
  {
    id: "art",
    title: "Art Portfolio",
    description: "Art-tagged photographs drawn from the wider portfolio, centered on experimentation, exhibitions, and image-making.",
    imageCount: 22,
    downloadUrl: "https://assets.abodid.com/documents/curated-photography-archives/abodid-art-portfolio.pdf",
  },
  {
    id: "commercial",
    title: "Commercial Portfolio",
    description: "Commercial-tagged photographs spanning fashion, events, commissioned portraiture, and cultural documentation.",
    imageCount: 25,
    downloadUrl: "https://assets.abodid.com/documents/curated-photography-archives/abodid-commercial-portfolio.pdf",
  },
  {
    id: "complete",
    title: "Complete Portfolio",
    description: "The full 404-image photography archive across experimental work, fashion-led frames, exhibitions, portraits, and street observation.",
    imageCount: 404,
    downloadUrl: "https://drive.google.com/file/d/1bU6WqxZvVAakmhWrQwXGhVNtiUdm9DMO/view?usp=sharing",
  },
];

// Curated Hero Featured Slides
const heroSlideSlugs = [
  "into-the-flux",
  "cries-of-an-unmarried-widow",
  "british-film-institute-london",
  "outernet-london-2025",
  "uncanny-comforts-with-emma",
  "rca-gradshow-in-london",
];

const heroSlides = heroSlideSlugs
  .map((slug) => portfolioItems.find((item: any) => item.slug === slug))
  .filter(Boolean)
  .concat(portfolioItems.slice(0, 4))
  .slice(0, 6);

const pageTitle = "Photography & Visual Essays — Abodid Sahoo";
const pageDescription =
  "Documentary, exhibition, and experimental photography archive by Abodid Sahoo in London. Capturing moments of silence, chaos, and human depth across 24 photo series.";

const structuredData = [
  personJsonLd(),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Photography", path: "/photography" },
  ]),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
  fullWidth={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="story-photography-page"
>
  <main class="pe-photography-main">
    {/* 1. Hero Section */}
    <section class="pe-photo-hero" aria-labelledby="photo-hero-heading">
      <div class="pe-photo-hero__copy" data-auto-contrast>
        <div class="pe-photo-hero__masthead">
          <p class="pe-photo-hero__name">Abodid Sahoo</p>
        </div>

        <h1 id="photo-hero-heading">
          Photography & Visual Essays
        </h1>

        <p class="pe-photo-hero__statement">
          A documentary, exhibition, and experimental archive capturing moments of silence, chaos, and human depth.
        </p>

        <p class="pe-photo-hero__lede">
          From large-scale spatial installations at Outernet &amp; RCA to intimate portraits, fashion editorials, and sociological observations across London and India.
        </p>

        <div class="pe-photo-actions">
          <a class="pe-button pe-button--primary" href="#portfolio-archive">
            <span>Explore photo essays</span>
            <b aria-hidden="true">↓</b>
          </a>
          <a class="pe-button pe-button--secondary" href="#curated-portfolios">
            <span>Curated Portfolios (PDF)</span>
            <b aria-hidden="true">↓</b>
          </a>
          <a class="pe-button pe-button--ghost" href="#enquiry">
            <span>Commission work</span>
            <span class="link-destination-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <aside class="pe-photo-hero__rail" aria-label="Featured photography preview">
        {/* Featured Visual Slide Carousel */}
        <div class="pe-hero-visual" aria-label="Featured photo series showcase" data-hero-slider>
          <div class="pe-hero-visual__track" role="region" aria-label="Featured photo series carousel" aria-live="polite">
            {heroSlides.map((item: any, index: number) => (
              <a
                class={`pe-hero-visual__slide ${index === 0 ? "is-active" : ""}`}
                href={item.href || `/photography/${item.slug}`}
                data-hero-slide={index}
                aria-hidden={index === 0 ? "false" : "true"}
                tabindex={index === 0 ? "0" : "-1"}
              >
                <img
                  src={item.image}
                  alt={item.title}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding={index === 0 ? "sync" : "async"}
                />
                <span class="pe-hero-visual__caption">
                  <b>{item.title}</b>
                  <small>
                    {Array.isArray(item.category) ? item.category[0] : item.category || "Series"} · {item.imageCount || "20+"} frames
                  </small>
                </span>
              </a>
            ))}
          </div>
        </div>
      </aside>
    </section>

    {/* 2. Curated Portfolios Feature Band */}
    <section class="pe-curated-section" id="curated-portfolios" aria-labelledby="curated-portfolios-heading">
      <header class="pe-section-heading">
        <p class="pe-eyebrow">Curated Portfolios &amp; PDF Archives</p>
        <h2 id="curated-portfolios-heading">Curated Selections</h2>
      </header>

      <div class="pe-curated-grid">
        {/* Card 1: Art Portfolio */}
        <article class="pe-curated-card pe-curated-card--art">
          <div class="pe-curated-card__top">
            <span class="pe-curated-card__num">01 / ART</span>
            <h3>Art Portfolio</h3>
            <p class="pe-curated-card__count">22 Selected Works · Exhibitions &amp; Experimental</p>
          </div>
          <p class="pe-curated-card__desc">
            Art-tagged photographs drawn from the wider portfolio, centered on experimentation, spatial exhibitions, and image-making as a sensory visual language.
          </p>
          <div class="pe-curated-card__actions">
            <a href="https://assets.abodid.com/documents/curated-photography-archives/abodid-art-portfolio.pdf" download="abodid-art-portfolio.pdf" target="_blank" rel="noopener noreferrer" class="pe-curated-btn">
              <span>Download PDF (22 Images)</span>
              <b aria-hidden="true">↓</b>
            </a>
          </div>
        </article>

        {/* Card 2: Commercial Portfolio */}
        <article class="pe-curated-card pe-curated-card--commercial">
          <div class="pe-curated-card__top">
            <span class="pe-curated-card__num">02 / COMMERCIAL</span>
            <h3>Commercial Portfolio</h3>
            <p class="pe-curated-card__count">25 Selected Works · Fashion, Events &amp; Commissioned</p>
          </div>
          <p class="pe-curated-card__desc">
            Commercial-tagged photographs spanning fashion editorials, cultural events, commissioned portraiture, and work shaped for collaborators and institutional clients.
          </p>
          <div class="pe-curated-card__actions">
            <a href="https://assets.abodid.com/documents/curated-photography-archives/abodid-commercial-portfolio.pdf" download="abodid-commercial-portfolio.pdf" target="_blank" rel="noopener noreferrer" class="pe-curated-btn">
              <span>Download PDF (25 Images)</span>
              <b aria-hidden="true">↓</b>
            </a>
          </div>
        </article>

        {/* Card 3: Complete Portfolio Archive */}
        <article class="pe-curated-card pe-curated-card--complete">
          <div class="pe-curated-card__top">
            <span class="pe-curated-card__num">03 / ARCHIVE</span>
            <h3>Complete Archive</h3>
            <p class="pe-curated-card__count">404 Images · Full Comprehensive Portfolio</p>
          </div>
          <p class="pe-curated-card__desc">
            The full 404-image photography archive across experimental work, fashion-led frames, exhibitions at RCA and Outernet, portraits, and street observation.
          </p>
          <div class="pe-curated-card__actions">
            <a href="https://drive.google.com/file/d/1bU6WqxZvVAakmhWrQwXGhVNtiUdm9DMO/view?usp=sharing" target="_blank" rel="noopener noreferrer" class="pe-curated-btn">
              <span>View Full Archive (PDF)</span>
              <span class="link-destination-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      </div>
    </section>

    {/* 3. Complete Photography Archive Grid with Category Filter */}
    <section class="pe-archive-section" id="portfolio-archive" aria-labelledby="archive-heading">
      <header class="pe-section-heading">
        <p class="pe-eyebrow">Documentary &amp; Experimental Series</p>
        <h2 id="archive-heading">All Photo Series</h2>
      </header>

      <PortfolioFilter items={portfolioItems} client:load />
    </section>

    {/* 4. Project Enquiry & Commission Section */}
    <section class="story-enquiry" aria-label="Project enquiry">
      <InlineInquiryForm
        id="enquiry"
        heading="Commission or license photography."
        intro="Open for commissioned editorial assignments, exhibition documentation, creative direction, and fine art print licensing."
        sourceName="photography-page"
        variant="pop"
        interestOptions={[
          "Exhibition & spatial documentation",
          "Editorial & fashion photography",
          "Cultural documentation & film stills",
          "Fine art print licensing",
          "Creative direction & photo essay",
          "Something else",
        ]}
      />
    </section>
  </main>

  {/* Client-Side Hero Slider and Surface Interactions */}
  <script is:inline>
    (() => {
      const initialiseHeroSlider = () => {
        const slider = document.querySelector("[data-hero-slider]");
        if (!slider) return;

        const slides = Array.from(slider.querySelectorAll("[data-hero-slide]"));
        if (slides.length <= 1) return;

        let currentIndex = 0;
        let timer = null;
        const INTERVAL_MS = 3800;

        const goToSlide = (nextIndex) => {
          const targetIndex = (nextIndex + slides.length) % slides.length;
          if (targetIndex === currentIndex) return;

          slides[currentIndex]?.classList.remove("is-active");
          slides[currentIndex]?.setAttribute("aria-hidden", "true");
          slides[currentIndex]?.setAttribute("tabindex", "-1");

          currentIndex = targetIndex;

          slides[currentIndex]?.classList.add("is-active");
          slides[currentIndex]?.setAttribute("aria-hidden", "false");
          slides[currentIndex]?.setAttribute("tabindex", "0");
        };

        const startTimer = () => {
          stopTimer();
          timer = setInterval(() => {
            goToSlide(currentIndex + 1);
          }, INTERVAL_MS);
        };

        const stopTimer = () => {
          if (timer) {
            clearInterval(timer);
            timer = null;
          }
        };

        // Touch gestures
        let touchStartX = 0;
        slider.addEventListener(
          "touchstart",
          (e) => {
            touchStartX = e.changedTouches && e.changedTouches[0] ? e.changedTouches[0].screenX : 0;
          },
          { passive: true }
        );

        slider.addEventListener(
          "touchend",
          (e) => {
            const touchEndX = e.changedTouches && e.changedTouches[0] ? e.changedTouches[0].screenX : 0;
            const diff = touchStartX - touchEndX;
            if (Math.abs(diff) > 40) {
              if (diff > 0) {
                goToSlide(currentIndex + 1);
              } else {
                goToSlide(currentIndex - 1);
              }
              startTimer();
            }
          },
          { passive: true }
        );

        slider.addEventListener("mouseenter", stopTimer);
        slider.addEventListener("mouseleave", startTimer);

        slider.addEventListener("keydown", (e) => {
          if (e.key === "ArrowLeft") {
            goToSlide(currentIndex - 1);
            startTimer();
          } else if (e.key === "ArrowRight") {
            goToSlide(currentIndex + 1);
            startTimer();
          }
        });

        startTimer();
      };

      const initialisePage = () => {
        initialiseHeroSlider();
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initialisePage);
      } else {
        requestAnimationFrame(initialisePage);
      }
      document.addEventListener("astro:page-load", initialisePage);
      document.addEventListener("astro:after-swap", initialisePage);
    })();
  </script>
</BaseLayout>

<style is:global>
  :root {
    --pop-blue: #2444ca;
    --pop-pink: #ff7eb5;
    --pop-yellow: #ffe44f;
    --pop-lime: #caff48;
    --pop-orange: #ff875c;
    --pop-purple: #5524c7;
    --pop-cyan: #62e6ff;
    --pop-cream: #fff8e8;
    --pop-ink: #15130f;
    --pop-border: rgba(21, 19, 15, 0.78);
    --pop-gap: 8px;
    --pop-radius-panel: clamp(18px, 2vw, 28px);
    --pop-radius-card: clamp(14px, 1.5vw, 22px);
    --pop-radius-control: 14px;
    --pop-radius-media: clamp(10px, 1.2vw, 16px);
    --pop-card-inset: 10px;
    --pop-motion: 180ms ease;
  }

  html:has(body.story-photography-page) {
    background: var(--pop-blue) !important;
  }

  body.story-photography-page {
    margin: 0;
    padding: 0 !important;
    background: var(--pop-blue) !important;
    color: var(--pop-ink);
  }

  body.story-photography-page main.page-content-full {
    overflow: visible;
    padding: 0 !important;
    max-width: 100% !important;
  }

  body.story-photography-page :is(h1, h2, h3, h4, p, figure, dl, dd, ul, ol) {
    margin-top: 0;
  }

  body.story-photography-page :is(a, button, summary) {
    -webkit-tap-highlight-color: transparent;
  }

  /* Main Shell Container */
  .pe-photography-main {
    padding: var(--pop-gap);
    display: flex;
    flex-direction: column;
    gap: var(--pop-gap);
    background: var(--pop-blue);
  }

  /* Eyebrow / Meta Labels */
  .pe-eyebrow {
    margin: 0 0 0.85rem;
    font: 750 clamp(0.68rem, 0.9vw, 0.78rem)/1.35 var(--font-mono, monospace);
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: inherit;
  }

  /* Section Headings */
  .pe-section-heading {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--pop-cream, #fff8e8);
  }

  .pe-section-heading h2 {
    margin: 0;
    font: 620 clamp(2.4rem, 5.2vw, 4.8rem)/0.92 var(--font-display, sans-serif);
    letter-spacing: -0.055em;
    color: var(--pop-cream, #fff8e8) !important;
  }

  /* 1. Hero Section */
  .pe-photo-hero {
    min-height: auto;
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(360px, 1fr);
    gap: var(--pop-gap);
    align-items: stretch;
  }

  .pe-photo-hero__copy {
    padding: clamp(1.75rem, 3.5vw, 3.8rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-panel);
    background: var(--pop-pink);
    color: var(--pop-ink);
  }

  .pe-photo-hero__masthead {
    margin-bottom: clamp(1.15rem, 2vw, 1.8rem);
    padding-bottom: clamp(0.85rem, 1.4vw, 1.2rem);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--pop-ink);
  }

  .pe-photo-hero__name {
    margin: 0;
    color: inherit;
    font: 720 clamp(2.2rem, 3.8vw, 4.2rem)/0.85 var(--font-display, sans-serif);
    letter-spacing: -0.06em;
  }



  .pe-photo-hero h1 {
    max-width: 36ch;
    margin: 0 0 clamp(0.85rem, 1.4vw, 1.25rem);
    color: inherit;
    font: 620 clamp(2.6rem, 4.8vw, 4.6rem)/0.92 var(--font-display, sans-serif);
    letter-spacing: -0.06em;
    text-wrap: balance;
  }

  .pe-photo-hero__statement {
    max-width: 32ch;
    margin: 0 0 clamp(1.1rem, 1.8vw, 1.5rem);
    color: inherit;
    font: 300 clamp(1.75rem, 2.7vw, 2.9rem)/1.02 var(--font-display, sans-serif);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .pe-photo-hero__lede {
    max-width: 820px;
    margin-bottom: clamp(1.5rem, 2.5vw, 2.2rem);
    color: rgba(21, 19, 15, 0.82);
    font: 450 clamp(0.95rem, 1.15vw, 1.12rem)/1.5 var(--font-body, sans-serif);
  }

  .pe-photo-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
  }

  .pe-button {
    min-height: 50px;
    padding: 0 1.2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    border: 1px solid var(--pop-ink);
    border-radius: var(--pop-radius-control);
    color: var(--pop-ink);
    font: 750 0.72rem/1 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform var(--pop-motion), box-shadow var(--pop-motion);
    box-sizing: border-box;
  }

  .pe-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 0 var(--pop-ink);
  }

  .pe-button--primary {
    background: var(--pop-cream);
  }

  .pe-button--secondary {
    background: var(--pop-yellow);
  }

  .pe-button--ghost {
    background: transparent;
    border: 1px solid currentColor;
  }

  /* Right Rail Showcase */
  .pe-photo-hero__rail {
    min-width: 0;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* Hero Visual Slider */
  .pe-hero-visual {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: clamp(340px, 35vw, 540px);
    padding: var(--pop-card-inset);
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-panel);
    background: var(--pop-blue);
    overflow: hidden;
    display: flex;
    box-sizing: border-box;
  }

  .pe-hero-visual__track {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--pop-ink);
    border-radius: var(--pop-radius-media);
    background: var(--pop-pink);
  }

  .pe-hero-visual__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 550ms cubic-bezier(0.2, 0.8, 0.2, 1), transform 550ms cubic-bezier(0.2, 0.8, 0.2, 1);
    transform: scale(1.02);
    overflow: hidden;
    text-decoration: none;
  }

  .pe-hero-visual__slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: scale(1);
    z-index: 2;
  }

  .pe-hero-visual__slide img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 600ms ease;
  }

  .pe-hero-visual__slide:hover img {
    transform: scale(1.025);
  }

  .pe-hero-visual__caption {
    position: absolute;
    inset: auto 0 0;
    padding: 0.85rem 1.1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    background: var(--pop-yellow);
    color: var(--pop-ink);
    border-top: 1px solid var(--pop-ink);
    z-index: 3;
  }

  .pe-hero-visual__caption b {
    font: 700 0.95rem/1.1 var(--font-display, sans-serif);
  }

  .pe-hero-visual__caption small {
    font: 750 0.62rem/1.3 var(--font-mono, monospace);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* 2. Curated Portfolios Section */
  .pe-curated-section {
    padding: clamp(1.75rem, 3.5vw, 3.5rem);
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-panel);
    background: var(--pop-blue);
    color: var(--pop-cream);
  }

  .pe-curated-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--pop-gap);
  }

  .pe-curated-card {
    padding: clamp(1.4rem, 2.5vw, 2.2rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 340px;
    border: 1px solid var(--pop-ink);
    border-radius: var(--pop-radius-card);
    transition: transform var(--pop-motion), box-shadow var(--pop-motion);
    box-sizing: border-box;
  }

  .pe-curated-card:hover,
  .pe-curated-card:focus-visible {
    color: var(--pop-ink) !important;
    text-decoration: none;
    transform: translateY(-3px);
    box-shadow: 0 6px 0 var(--pop-ink);
  }

  .pe-curated-card--art {
    background: var(--pop-yellow);
    color: var(--pop-ink);
  }

  .pe-curated-card--commercial {
    background: var(--pop-pink);
    color: var(--pop-ink);
  }

  .pe-curated-card--complete {
    background: var(--pop-lime);
    color: var(--pop-ink);
  }

  .pe-curated-card__top {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .pe-curated-card__num {
    font: 750 0.72rem/1 var(--font-mono, monospace);
    letter-spacing: 0.1em;
    opacity: 0.85;
    text-transform: uppercase;
  }

  .pe-curated-card h3 {
    margin: 0;
    color: inherit !important;
    font: 640 clamp(1.6rem, 2.4vw, 2.2rem)/1.02 var(--font-display, sans-serif) !important;
    letter-spacing: -0.04em !important;
  }

  .pe-curated-card__count {
    margin: 0;
    font: 750 0.72rem/1.3 var(--font-mono, monospace);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .pe-curated-card__desc {
    margin: 0;
    color: inherit !important;
    font: 450 clamp(0.92rem, 1.1vw, 1.02rem)/1.5 var(--font-body, sans-serif) !important;
    opacity: 0.92;
  }

  .pe-curated-card__actions {
    padding-top: 1rem;
    border-top: 1px solid currentColor;
  }

  .pe-curated-btn {
    min-height: 46px;
    padding: 0 1.15rem;
    display: inline-flex;

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PortfolioFilter from "../../components/PortfolioFilter.jsx";
import InlineInquiryForm from "../../components/InlineInquiryForm.astro";
import { getAllPhotography } from "../../lib/api";
import { featuredPhotography as mockPhotography } from "../../utils/mockData";
import photographyPortfolios from "../../data/photographyPortfolios.generated.json";
import { breadcrumbJsonLd, personJsonLd } from "../../lib/seoData";
import "../../styles/press-editorial.css";

const safeFetch = async (fn: () => Promise<any>, fallback: any) => {
  try {
    return await fn();
  } catch (error) {
    console.error("Data fetch failed:", error);
    return fallback;
  }
};

const rawPortfolioItems = await safeFetch(getAllPhotography, mockPhotography);
const storyMetadataBySlug = new Map(
  (photographyPortfolios.stories || []).map((story) => [story.slug, story]),
);

const portfolioItems = rawPortfolioItems.map((item: any, index: number) => {
  const storyMeta = item.slug ? storyMetadataBySlug.get(item.slug) : undefined;

  return {
    ...item,
    imageCount: storyMeta?.imageCount || item.images?.length || 0,
    downloadUrl: storyMeta?.downloadUrl || null,
    labels:
      storyMeta?.labels ||
      (Array.isArray(item.category) ? item.category : [item.category]),
    sortIndex: index,
  };
});

const fallbackCollections = [
  {
    id: "art",
    title: "Art Portfolio",
    description:
      "Art-tagged photographs drawn from the wider portfolio, centered on experimentation, exhibitions, and image-making.",
    imageCount: 22,
    downloadName: "abodid-art-portfolio.pdf",
    downloadUrl:
      "https://assets.abodid.com/documents/curated-photography-archives/abodid-art-portfolio.pdf",
  },
  {
    id: "commercial",
    title: "Commercial Portfolio",
    description:
      "Commercial-tagged photographs spanning fashion, events, commissioned portraiture, and cultural documentation.",
    imageCount: 25,
    downloadName: "abodid-commercial-portfolio.pdf",
    downloadUrl:
      "https://assets.abodid.com/documents/curated-photography-archives/abodid-commercial-portfolio.pdf",
  },
  {
    id: "complete",
    title: "Complete Archive",
    description:
      "The full 404-image photography archive across experimental work, fashion-led frames, exhibitions, portraits, and street observation.",
    imageCount: 404,
    downloadName: null,
    downloadUrl:
      "https://drive.google.com/file/d/1bU6WqxZvVAakmhWrQwXGhVNtiUdm9DMO/view?usp=sharing",
  },
];

const collections = (
  photographyPortfolios.collections?.length
    ? photographyPortfolios.collections
    : fallbackCollections
).map((collection) => {
  const fallback = fallbackCollections.find((c) => c.id === collection.id);
  return {
    ...collection,
    title: collection.id === "complete" ? "Complete Archive" : collection.title,
    description: collection.description || fallback?.description || "",
    downloadName: collection.downloadName || fallback?.downloadName || null,
  };
});

const pageTitle = "Photography & Visual Essays — Abodid Sahoo";
const pageDescription =
  "Documentary, exhibition, and experimental photography archive by Abodid Sahoo in London.";

const structuredData = [
  personJsonLd(),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Photography", path: "/photography" },
  ]),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
  fullWidth={true}
  navigationVariant="next"
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="press-page photography-page"
>
  <div class="press-editorial">
    <div class="press-file">
      <header class="press-masthead">
        <p class="press-file-tag">photography.index — visual archive</p>
        <div class="press-masthead__hero">
          <h1>Photography</h1>
          <div class="press-masthead__summary">
            <p>
              Documentary, exhibition, and experimental photo series shot across
              London and India.
            </p>
            <div class="press-masthead__actions">
              <button
                type="button"
                class="press-topic press-topic--action press-topic--yellow"
                id="open-pdf-dialog-btn"
                aria-haspopup="dialog"
                aria-controls="agency-pdf-dialog"
              >
                <span>PDF portfolio for agencies</span>
                <b aria-hidden="true">↓</b>
              </button>
            </div>
          </div>
        </div>
      </header>

      <div class="press-board" id="photo-series">
        <PortfolioFilter items={portfolioItems} client:load />
      </div>
    </div>

    <section class="photography-enquiry" aria-label="Project enquiry">
      <InlineInquiryForm
        id="enquiry"
        heading="Let's work together — license photography."
        intro="Open for commissioned editorial assignments, exhibition documentation, creative direction, and fine art print licensing."
        sourceName="photography-page"
        variant="pop"
        interestOptions={[
          "Exhibition & spatial documentation",
          "Editorial & fashion photography",
          "Cultural documentation & film stills",
          "Fine art print licensing",
          "Creative direction & photo essay",
          "Something else",
        ]}
      />
    </section>

    <!-- Agency PDF Portfolios Modal Dialog -->
    <dialog
      id="agency-pdf-dialog"
      class="agency-pdf-dialog"
      closedby="any"
      aria-labelledby="agency-pdf-title"
    >
      <div class="agency-pdf-modal">
        <header class="agency-pdf-modal__header">
          <div class="agency-pdf-modal__intro">
            <p class="agency-pdf-modal__tag">Documents // Agency Access</p>
            <h2 id="agency-pdf-title">PDF Files for Agencies</h2>
            <p class="agency-pdf-modal__desc">
              Direct downloads and complete visual archives for art directors,
              producers, and commissioning agencies.
            </p>
          </div>
          <button
            type="button"
            class="agency-pdf-modal__close"
            id="close-pdf-dialog-btn"
            aria-label="Close dialog"
          >
            <span aria-hidden="true">✕</span>
          </button>
        </header>

        <div class="agency-pdf-modal__body">
          <div class="agency-pdf-cards">
            {
              collections.map((collection, index) => {
                const isExternal =
                  collection.id === "complete" || !collection.downloadName;
                return (
                  <article
                    class={`agency-pdf-card agency-pdf-card--${collection.id}`}
                  >
                    <div class="agency-pdf-card__top">
                      <span class="agency-pdf-card__badge">
                        0{index + 1} / {collection.id.toUpperCase()}
                      </span>
                      <h3>{collection.title}</h3>
                      <p class="agency-pdf-card__count">
                        {collection.imageCount} Selected Images
                      </p>
                    </div>

                    <p class="agency-pdf-card__desc">
                      {collection.description}
                    </p>

                    <div class="agency-pdf-card__footer">
                      <a
                        class="agency-pdf-card__btn"
                        href={collection.downloadUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        download={
                          collection.id === "complete"
                            ? undefined
                            : collection.downloadName || undefined
                        }
                      >
                        <span>
                          {collection.id === "complete"
                            ? "View Full Archive (PDF)"
                            : `Download PDF (${collection.imageCount} Images)`}
                        </span>
                        <b class="link-destination-arrow" aria-hidden="true">
                          {isExternal ? "↗" : "↓"}
                        </b>
                      </a>
                    </div>
                  </article>
                );
              })
            }
          </div>
        </div>
      </div>
    </dialog>
  </div>

  <script>
    function setupAgencyPdfModal() {
      const dialog = document.getElementById(
        "agency-pdf-dialog",
      ) as HTMLDialogElement | null;
      const openBtn = document.getElementById("open-pdf-dialog-btn");
      const closeBtn = document.getElementById("close-pdf-dialog-btn");

      if (!dialog || !openBtn) return;

      openBtn.addEventListener("click", () => {
        dialog.showModal();
      });

      if (closeBtn) {
        closeBtn.addEventListener("click", () => {
          dialog.close();
        });
      }

      // Fallback light-dismiss for browsers without closedby support
      if (!("closedBy" in HTMLDialogElement.prototype)) {
        dialog.addEventListener("click", (event) => {
          if (event.target !== dialog) return;
          const rect = dialog.getBoundingClientRect();
          const isInside =
            rect.top <= event.clientY &&
            event.clientY <= rect.top + rect.height &&
            rect.left <= event.clientX &&
            event.clientX <= rect.left + rect.width;
          if (!isInside) {
            dialog.close();
          }
        });
      }
    }

    setupAgencyPdfModal();
    document.addEventListener("astro:page-load", setupAgencyPdfModal);
  </script>
</BaseLayout>

<style is:global>
  /* Actions inside masthead summary */
  .press-page .press-masthead__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 0.75rem;
  }

  .press-page .press-topic--action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .press-page .press-topic--yellow {
    background: var(--pop-yellow);
  }

  .press-page .press-topic--yellow:hover {
    background: var(--pop-pink);
  }

  .press-page .photography-enquiry {
    margin-top: 8px;
    padding: clamp(1.25rem, 3.5vw, 3rem);
    overflow: hidden;
    border: 1px solid var(--pop-ink);
    border-radius: clamp(20px, 3vw, 34px);
    background: var(--pop-purple);
    color: var(--pop-cream);
    box-shadow: 0 10px 0 rgba(21, 19, 15, 0.2);
  }

  .press-page .photography-enquiry .inline-inquiry-form {
    border: 0;
  }

  /* Agency PDF Portfolios Modal Dialog */
  dialog.agency-pdf-dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    padding: 0;
    width: min(94vw, 1100px);
    max-height: 90vh;
    border: 2px solid var(--pop-ink, #15130f);
    border-radius: clamp(20px, 3vw, 32px);
    background: var(--pop-cream, #fff8e8);
    box-shadow:
      0 20px 0 var(--pop-ink, #15130f),
      0 30px 60px rgba(0, 0, 0, 0.4);
    overflow: hidden;
    color: var(--pop-ink, #15130f);
    outline: none;
    z-index: 1000;
  }

  dialog.agency-pdf-dialog::backdrop {
    background: rgba(21, 19, 15, 0.65);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  dialog.agency-pdf-dialog[open] {
    animation: agencyPdfPopIn 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes agencyPdfPopIn {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(12px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .agency-pdf-modal {
    display: flex;
    flex-direction: column;
    max-height: 90vh;
    overflow-y: auto;
  }

  .agency-pdf-modal__header {
    padding: clamp(1.4rem, 3vw, 2.4rem);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 2px solid var(--pop-ink, #15130f);
    background: var(--pop-pink, #ff7eb5);
  }

  .agency-pdf-modal__intro {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .agency-pdf-modal__tag {
    margin: 0;
    font: 700 0.72rem/1 var(--press-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pop-ink, #15130f);
  }

  .agency-pdf-modal__header h2 {
    margin: 0;
    font: 720 clamp(1.8rem, 3.5vw, 3rem)/0.96 var(--press-font, sans-serif);
    letter-spacing: -0.05em;
    color: var(--pop-ink, #15130f);
  }

  .agency-pdf-modal__desc {
    margin: 0.25rem 0 0;
    max-width: 620px;
    font: 500 clamp(0.92rem, 1.2vw, 1.05rem)/1.4 var(--press-font, sans-serif);
    color: var(--pop-ink, #15130f);
  }

  .agency-pdf-modal__close {
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 2px solid var(--pop-ink, #15130f);
    border-radius: 50%;
    background: var(--pop-cream, #fff8e8);
    color: var(--pop-ink, #15130f);
    font: 700 1.2rem/1 var(--press-mono, monospace);
    cursor: pointer;
    box-shadow: 0 3px 0 var(--pop-ink, #15130f);
    transition:
      transform 160ms ease,
      background 160ms ease,
      box-shadow 160ms ease;
  }

  .agency-pdf-modal__close:hover {
    background: var(--pop-yellow, #ffe44f);
    transform: rotate(90deg) scale(1.05);
    box-shadow: 0 4px 0 var(--pop-ink, #15130f);
  }

  .agency-pdf-modal__body {
    padding: clamp(1.2rem, 3vw, 2.5rem);
    background: var(--pop-blue, #2444ca);
  }

  .agency-pdf-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 1.8vw, 1.5rem);
  }

  .agency-pdf-card {
    min-width: 0;
    padding: clamp(1.25rem, 2.2vw, 1.85rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    border: 2px solid var(--pop-ink, #15130f);
    border-radius: 20px;
    color: var(--pop-ink, #15130f);
    box-shadow: 0 6px 0 var(--pop-ink, #15130f);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .agency-pdf-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 9px 0 var(--pop-ink, #15130f);
  }

  .agency-pdf-card--art {
    background: var(--pop-yellow, #ffe44f);
  }

  .agency-pdf-card--commercial {
    background: var(--pop-pink, #ff7eb5);
  }

  .agency-pdf-card--complete {
    background: var(--pop-lime, #caff48);
  }

  .agency-pdf-card__top {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .agency-pdf-card__badge {
    font: 750 0.68rem/1 var(--press-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pop-ink, #15130f);
    opacity: 0.85;
  }

  .agency-pdf-card h3 {
    margin: 0;
    font: 720 clamp(1.4rem, 2vw, 1.85rem)/1.05 var(--press-font, sans-serif);
    letter-spacing: -0.04em;
    color: var(--pop-ink, #15130f);
  }

  .agency-pdf-card__count {
    margin: 0;
    font: 700 0.72rem/1.2 var(--press-mono, monospace);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pop-ink, #15130f);
  }

  .agency-pdf-card__desc {
    margin: 0;
    font: 480 0.95rem/1.45 var(--press-font, sans-serif);
    color: var(--pop-ink, #15130f);
    opacity: 0.92;
  }

  .agency-pdf-card__footer {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(21, 19, 15, 0.25);
  }

  .agency-pdf-card__btn {
    min-height: 46px;
    padding: 0 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    box-sizing: border-box;
    border: 2px solid var(--pop-ink, #15130f);
    border-radius: 12px;
    background: var(--pop-cream, #fff8e8);
    color: var(--pop-ink, #15130f);
    font: 750 0.72rem/1 var(--press-mono, monospace);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 3px 0 var(--pop-ink, #15130f);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      background 160ms ease;
  }

  .agency-pdf-card__btn:hover {
    background: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 5px 0 var(--pop-ink, #15130f);
  }

  .agency-pdf-card__btn .link-destination-arrow {
    display: inline-block;
    transition: transform 160ms ease;
  }

  .agency-pdf-card__btn:hover .link-destination-arrow {
    transform: translate(2px, -2px);
  }

  @media (max-width: 900px) {
    .agency-pdf-cards {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    dialog.agency-pdf-dialog {
      width: 96vw;
      border-radius: 20px;
    }

    .agency-pdf-modal__header {
      padding: 1.25rem;
    }

    .agency-pdf-modal__body {
      padding: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .agency-pdf-card,
    .agency-pdf-card__btn,
    .agency-pdf-modal__close {
      transition-duration: 0.01ms !important;
      transform: none !important;
    }
  }
</style>

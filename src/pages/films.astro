---
import BaseLayout from "../layouts/BaseLayout.astro";
import FilmsFilter from "../components/FilmsFilter.jsx";
import { getFilms } from "../lib/api";

const pageTitle = "Films";
const pageDescription =
  "Films by Abodid Sahoo spanning visual storytelling, brand films, documentary work, and experimental cinematography.";

const films = await getFilms();
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  fullWidth={true}
  navigationVariant="next"
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="films-moodboard-page"
>
  <!-- Plyr CSS -->
  <link rel="stylesheet" href="https://cdn.plyr.io/3.7.8/plyr.css" />

  <main class="films-shell">
    <article class="films-file">
      <header class="films-heading">
        <p class="films-file-tag">films.js — video curation</p>
        <div class="films-heading__hero">
          <h1>Films</h1>
          <div class="films-heading__summary">
            <p>
              A selection of films I made for brands, organisations, artists and
              NGOs.
            </p>
            <div class="films-heading__actions">
              <a
                class="films-action-btn"
                href="/premiere-pro-masterclass"
              >
                <span>Join my video editing workshop</span>
                <b class="link-destination-arrow" aria-hidden="true">↗</b>
              </a>
            </div>
          </div>
        </div>
      </header>

      <section class="films-board">
        <FilmsFilter items={films} client:load />
      </section>
    </article>
  </main>

  <div id="video-modal" class="video-modal">
    <div class="video-container">
      <button
        class="close-btn"
        onclick="closeVideo()"
        aria-label="Close video player"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
      <div class="plyr__video-embed" id="player">
        <iframe src="" allowfullscreen allowtransparency allow="autoplay"
        ></iframe>
      </div>
    </div>
  </div>

  <!-- Plyr JS -->
  <script src="https://cdn.plyr.io/3.7.8/plyr.polyfilled.js" is:inline></script>

  <script is:inline>
    let player = null;

    window.openVideo = function openVideo(url, provider) {
      if (!url) return;

      const modal = document.getElementById("video-modal");
      const container = document.getElementById("player");

      // Extract ID
      let videoId = "";
      if (provider === "vimeo") {
        videoId = url.split("/").pop().split("?")[0];
      } else {
        if (url.includes("youtu.be")) videoId = url.split("/").pop();
        else videoId = new URLSearchParams(new URL(url).search).get("v");
      }

      // 1. Set source for Plyr
      let embedSrc = "";
      if (provider === "vimeo") {
        embedSrc = `https://player.vimeo.com/video/${videoId}?loop=false&byline=false&portrait=false&title=false&speed=true&transparent=0&gesture=media`;
      } else {
        embedSrc = `https://www.youtube.com/embed/${videoId}?origin=${location.origin}&iv_load_policy=3&modestbranding=1&playsinline=1&showinfo=0&rel=0&enablejsapi=1`;
      }

      // 2. Strict Tear Down
      if (player) {
        player.destroy();
        player = null;
      }

      // Explicitly clear and update iframe
      const iframe = container.querySelector("iframe");
      iframe.src = embedSrc;

      // 3. Initialize Plyr (fresh instance)
      player = new Plyr("#player", {
        controls: [
          "play-large",
          "play",
          "progress",
          "current-time",
          "mute",
          "volume",
          "fullscreen",
        ],
        hideControls: true,
        resetOnEnd: true,
        youtube: {
          noCookie: true,
          rel: 0,
          showinfo: 0,
          iv_load_policy: 3,
          modestbranding: 1,
        },
        vimeo: {
          byline: false,
          portrait: false,
          title: false,
          speed: true,
          transparent: false,
        },
      });

      // Show modal
      modal.classList.add("active");
      document.body.style.overflow = "hidden";

      // Auto-play when ready
      player.on("ready", () => {
        player.play();
      });
    };

    window.closeVideo = function () {
      const modal = document.getElementById("video-modal");
      modal.classList.remove("active");

      if (player) {
        player.stop();
        player.destroy();
        player = null;
      }

      document.body.style.overflow = "";

      const iframe = document.querySelector("#player iframe");
      if (iframe) iframe.src = "";
    };

    // Close on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeVideo();
    });
  </script>
</BaseLayout>

<style is:global>
  html:has(body.films-moodboard-page) {
    background: var(--pop-blue) !important;
  }

  body.films-moodboard-page {
    --films-font: "Satoshi-Variable", "Satoshi-Regular", "Poppins", sans-serif;
    --films-mono:
      "Satoshi-Variable", "Satoshi-Regular", "Space Mono", "Inconsolata",
      monospace;
    --resources-font: var(--films-font);
    --resources-mono: var(--films-mono);
    --pop-border: rgba(21, 19, 15, 0.78);
    --pop-line: rgba(21, 19, 15, 0.24);
    margin: 0;
    padding: 0 !important;
    min-height: 100vh;
    background: var(--pop-blue) !important;
    color: var(--pop-ink);
    color-scheme: light;
  }

  body.films-moodboard-page main.page-content-full {
    max-width: 100% !important;
    padding: 0 !important;
    overflow: visible;
  }

  body.films-moodboard-page :is(h1, h2, h3, p, figure) {
    margin-top: 0;
  }

  body.films-moodboard-page :is(a, button, summary):focus-visible {
    outline: 3px solid var(--pop-purple);
    outline-offset: 3px;
  }
</style>

<style>
  .films-shell {
    width: 100%;
    padding: 8px;
    box-sizing: border-box;
    background: var(--pop-blue);
    min-height: 100vh;
  }

  .films-file {
    width: 100%;
    max-width: none;
    margin-inline: 0;
    box-sizing: border-box;
    overflow: hidden;
    border: 1px solid var(--pop-ink);
    border-radius: clamp(20px, 3vw, 34px);
    background: var(--pop-cream);
    box-shadow: 0 10px 0 rgba(21, 19, 15, 0.2);
  }

  .films-heading {
    padding: clamp(1.6rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--pop-ink);
    background: var(--pop-pink);
  }

  .films-file-tag {
    margin: 0 0 clamp(1.5rem, 4vw, 3.5rem);
    color: var(--pop-ink);
    font: 700 0.72rem/1 var(--films-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .films-heading__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(260px, 0.7fr);
    gap: clamp(1.5rem, 4vw, 5rem);
    align-items: end;
  }

  .films-heading h1 {
    max-width: 12ch;
    margin: 0;
    color: var(--pop-ink);
    font: 720 clamp(3.5rem, 8.5vw, 7.5rem)/0.86 var(--films-font, sans-serif);
    letter-spacing: -0.075em;
    overflow-wrap: anywhere;
  }

  .films-heading__summary {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .films-heading__summary > p,
  .films-heading__hero p {
    max-width: 38rem;
    margin: 0;
    color: var(--pop-ink);
    font: 500 clamp(1.35rem, 1.8vw, 1.55rem)/1.32 var(--films-font, sans-serif);
    letter-spacing: -0.025em;
    text-wrap: balance;
    text-wrap: pretty;
  }

  .films-heading__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 0.75rem;
  }

  .films-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 18px;
    border: 1px solid var(--pop-ink);
    border-radius: 14px;
    background: var(--pop-cream);
    color: var(--pop-ink);
    font: 700 0.76rem/1 var(--films-mono, monospace);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    box-shadow: none;
    transition: transform 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }

  .films-action-btn:hover {
    background: var(--pop-pink);
    transform: translateY(-2px);
    box-shadow: 0 3px 0 var(--pop-ink);
    text-decoration: none;
  }

  .films-action-btn:active {
    transform: translateY(0);
    box-shadow: none;
  }

  .films-action-btn .link-destination-arrow {
    display: inline-block;
    font-size: 0.95em;
    transition: transform 180ms ease;
  }

  .films-action-btn:hover .link-destination-arrow {
    transform: translate(2px, -2px);
  }

  .films-break {
    display: inline;
  }

  .films-board {
    padding: clamp(1.2rem, 3.5vw, 3rem);
    background: var(--pop-cream);
  }

  /* Modal */
  .video-modal {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: var(--app-rail-width, 0px);
    background: rgba(21, 19, 15, 0.92);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
    backdrop-filter: blur(8px);
  }

  .video-modal.active {
    opacity: 1;
    pointer-events: auto;
  }

  .video-container {
    width: 92%;
    max-width: 1200px;
    position: relative;
    border-radius: 20px;
    border: 1px solid var(--pop-ink);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
    background: var(--pop-ink);
    overflow: hidden;
  }

  .close-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 44px;
    height: 44px;
    background: var(--pop-yellow);
    border: 1px solid var(--pop-ink);
    border-radius: 50%;
    color: var(--pop-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 3px 0 var(--pop-ink);
    transition:
      transform 180ms ease,
      background 180ms ease;
    z-index: 30;
  }

  .close-btn:hover {
    transform: scale(1.08);
    background: var(--pop-pink);
  }

  @media (max-width: 980px) {
    .films-heading__hero {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .films-heading__summary > p,
    .films-heading__hero p {
      max-width: 36rem;
      font-size: clamp(1.35rem, 2.5vw, 1.55rem);
      line-height: 1.34;
    }
  }

  @media (max-width: 720px) {
    .films-shell {
      padding: 4px;
    }

    .films-heading__hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .films-heading h1 {
      font-size: clamp(2.8rem, 14.5vw, 4.4rem);
      line-height: 0.9;
      letter-spacing: -0.065em;
    }

    .films-heading__summary > p,
    .films-heading__hero p {
      max-width: 100%;
      font-size: 1.1rem;
      line-height: 1.36;
    }

    .films-break {
      display: none;
    }

    .films-board {
      padding: 1rem;
    }
  }

  @media (max-width: 380px) {
    .films-heading,
    .films-board {
      padding: 0.9rem;
    }
  }
</style>

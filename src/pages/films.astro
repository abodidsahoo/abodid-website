---
import BaseLayout from "../layouts/BaseLayout.astro";
import FilmsIsland from "../components/FilmsIsland.astro";
import ProgressiveContentSkeleton from "../components/ProgressiveContentSkeleton.astro";

const pageTitle = "Films";
const pageDescription =
  "Films by Abodid Sahoo spanning visual storytelling, brand films, documentary work, and experimental cinematography.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  fullWidth={true}
  navigationVariant="next"
  bodyClass="films-moodboard-page"
>
  <!-- Plyr CSS -->
  <link rel="stylesheet" href="https://cdn.plyr.io/3.7.8/plyr.css" />

  <main class="films-shell">
    <article class="films-file">
      <header class="films-heading">
        <p class="films-file-tag">films.js — video curation</p>
        <div class="films-heading__hero">
          <h1>Films</h1>
          <p>
            A curation of visual stories, brand films, and experimental
            cinematography.
          </p>
        </div>
      </header>

      <section class="films-board">
        <FilmsIsland server:defer>
          <ProgressiveContentSkeleton
            slot="fallback"
            variant="films"
            count={4}
            label="Loading films"
          />
        </FilmsIsland>
      </section>
    </article>
  </main>

  <div id="video-modal" class="video-modal">
    <div class="video-container">
      <button class="close-btn" onclick="closeVideo()" aria-label="Close video player">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
      <div class="plyr__video-embed" id="player">
        <iframe src="" allowfullscreen allowtransparency allow="autoplay"
        ></iframe>
      </div>
    </div>
  </div>

  <!-- Plyr JS -->
  <script src="https://cdn.plyr.io/3.7.8/plyr.polyfilled.js" is:inline></script>

  <script is:inline>
    let player = null;

    function openVideo(url, provider) {
      if (!url) return;

      const modal = document.getElementById("video-modal");
      const container = document.getElementById("player");

      // Extract ID
      let videoId = "";
      if (provider === "vimeo") {
        videoId = url.split("/").pop().split("?")[0];
      } else {
        if (url.includes("youtu.be")) videoId = url.split("/").pop();
        else videoId = new URLSearchParams(new URL(url).search).get("v");
      }

      // 1. Set source for Plyr
      let embedSrc = "";
      if (provider === "vimeo") {
        embedSrc = `https://player.vimeo.com/video/${videoId}?loop=false&byline=false&portrait=false&title=false&speed=true&transparent=0&gesture=media`;
      } else {
        embedSrc = `https://www.youtube.com/embed/${videoId}?origin=${location.origin}&iv_load_policy=3&modestbranding=1&playsinline=1&showinfo=0&rel=0&enablejsapi=1`;
      }

      // 2. Strict Tear Down
      if (player) {
        player.destroy();
        player = null;
      }

      // Explicitly clear and update iframe
      const iframe = container.querySelector("iframe");
      iframe.src = embedSrc;

      // 3. Initialize Plyr (fresh instance)
      player = new Plyr("#player", {
        controls: [
          "play-large",
          "play",
          "progress",
          "current-time",
          "mute",
          "volume",
          "fullscreen",
        ],
        hideControls: true,
        resetOnEnd: true,
        youtube: {
          noCookie: true,
          rel: 0,
          showinfo: 0,
          iv_load_policy: 3,
          modestbranding: 1,
        },
        vimeo: {
          byline: false,
          portrait: false,
          title: false,
          speed: true,
          transparent: false,
        },
      });

      // Show modal
      modal.classList.add("active");
      document.body.style.overflow = "hidden";

      // Auto-play when ready
      player.on("ready", () => {
        player.play();
      });
    }

    window.closeVideo = function () {
      const modal = document.getElementById("video-modal");
      modal.classList.remove("active");

      if (player) {
        player.stop();
        player.destroy();
        player = null;
      }

      document.body.style.overflow = "";

      const iframe = document.querySelector("#player iframe");
      if (iframe) iframe.src = "";
    };

    // Close on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeVideo();
    });
  </script>
</BaseLayout>

<style is:global>
  body.films-moodboard-page {
    --pop-blue: #2444ca;
    --pop-purple: #6657d8;
    --pop-pink: #ff7eb5;
    --pop-yellow: #ffe44f;
    --pop-cream: #fff8e8;
    --pop-ink: #15130f;
    --pop-border: rgba(21, 19, 15, 0.78);
    --pop-line: rgba(21, 19, 15, 0.24);
    --resources-font: "Satoshi-Variable", "Satoshi-Regular", "Poppins", sans-serif;
    --resources-mono: "Satoshi-Variable", "Satoshi-Regular", "Space Mono", "Inconsolata", monospace;
    margin: 0;
    padding: 0 !important;
    background: var(--pop-blue) !important;
    color: var(--pop-ink);
    min-height: 100vh;
    color-scheme: light;
  }
</style>

<style>
  .films-shell {
    width: 100%;
    padding: 8px;
    box-sizing: border-box;
    background: var(--pop-blue);
    min-height: 100vh;
  }

  .films-file {
    width: 100%;
    max-width: none;
    margin-inline: 0;
    box-sizing: border-box;
    overflow: hidden;
    border: 1px solid var(--pop-ink);
    border-radius: clamp(20px, 3vw, 34px);
    background: var(--pop-cream);
    box-shadow: 0 10px 0 rgba(21, 19, 15, 0.2);
  }

  .films-heading {
    padding: clamp(1.6rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--pop-ink);
    background: var(--pop-pink);
  }

  .films-file-tag {
    margin-bottom: clamp(1.5rem, 4vw, 3.5rem);
    color: var(--pop-ink);
    font: 700 0.72rem/1 var(--resources-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .films-heading__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(260px, 0.7fr);
    gap: clamp(1.5rem, 4vw, 5rem);
    align-items: end;
  }

  .films-heading h1 {
    margin: 0;
    color: var(--pop-ink);
    font: 720 clamp(3.5rem, 8.5vw, 7.5rem)/0.86 var(--resources-font, sans-serif);
    letter-spacing: -0.075em;
  }

  .films-heading__hero p {
    max-width: 36rem;
    margin: 0;
    color: var(--pop-ink);
    font: 500 clamp(1.1rem, 1.8vw, 1.55rem)/1.32 var(--resources-font, sans-serif);
    letter-spacing: -0.025em;
  }

  .films-board {
    padding: clamp(1.2rem, 3.5vw, 3rem);
    background: var(--pop-cream);
  }

  /* Modal */
  .video-modal {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: var(--app-rail-width, 0px);
    background: rgba(21, 19, 15, 0.92);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
    backdrop-filter: blur(8px);
  }

  .video-modal.active {
    opacity: 1;
    pointer-events: auto;
  }

  .video-container {
    width: 92%;
    max-width: 1200px;
    position: relative;
    border-radius: 20px;
    border: 1px solid var(--pop-ink);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
    background: var(--pop-ink);
    overflow: hidden;
  }

  .close-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 44px;
    height: 44px;
    background: var(--pop-yellow);
    border: 1px solid var(--pop-ink);
    border-radius: 50%;
    color: var(--pop-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 3px 0 var(--pop-ink);
    transition: transform 180ms ease, background 180ms ease;
    z-index: 30;
  }

  .close-btn:hover {
    transform: scale(1.08);
    background: var(--pop-pink);
  }

  @media (max-width: 760px) {
    .films-heading__hero {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .films-shell {
      padding: 4px;
    }
  }
</style>

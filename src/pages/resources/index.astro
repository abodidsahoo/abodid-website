---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResourceFeed from "../../components/resources/ResourceFeed";
import AuthHeader from "../../components/resources/AuthHeader";
import { getApprovedResources } from "../../lib/resources/db";
import { curationUrl } from "../../lib/curationRoutes.js";
import "../../styles/resources.css";
import "../../styles/resources-editorial.css";

// 1. Get Search Params
const query = Astro.url.searchParams.get("q") || "";
const audience = Astro.url.searchParams.get("audience") || "";

// 2. Fetch Data
// Keep the complete library available when a visitor clears a linked filter.
const resources = await getApprovedResources();

const title = "Curation by Abodid";
const description =
    "Remarkable tools, ideas, references, and creative work—selected with intent by Abodid Sahoo.";
---

<BaseLayout title={title} description={description} canonicalUrl={curationUrl("/")} fullWidth={true} showGlobalGrid={false} bodyClass="resources-editorial-page" navigationVariant="next">
  <div class="resources-editorial">
    <header
        class="resources-hero"
    >
        <div class="resources-hero__copy">
            <h1>Curation by Abodid</h1>
            <p class="section-intro">
                Remarkable tools, ideas, references, and creative work—selected
                with intent for designers, artists, and creative technologists.
            </p>
        </div>

        <div class="resources-hero__account">
            <AuthHeader client:only="react" theme="default" />
        </div>
    </header>

    <div class="resources-browser">
        <!--
          Resource Feed (React Island)
          - Handles client-side filtering and visual "snapping" updates.
        -->
        <ResourceFeed
            client:load
            initialResources={resources}
            variant="editorial"
            initialQuery={query}
            initialAudience={audience}
        />
    </div>
  </div>
</BaseLayout>

---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { curationPath, curationUrl } from '../../../lib/curationRoutes.js';
---
<BaseLayout title='Verifying User...' canonicalUrl={curationUrl(curationPath.authCallback)} noindex={true}>
  <div style='display:flex; justify-content:center; align-items:center; height:60vh; color:white;'>
    Completing login...
  </div>
  <script>
    import { supabase } from '../../../lib/supabaseClient';
    // Handle hash fragment
    supabase.auth.onAuthStateChange((event, session) => {
      if (session) {
        window.location.href = '/dashboard';
      }
    });
  </script>
</BaseLayout>

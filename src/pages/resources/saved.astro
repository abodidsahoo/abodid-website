---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import SavedResourceList from "../../components/resources/SavedResourceList";
import { curationPath, curationUrl } from "../../lib/curationRoutes.js";
import "../../styles/resources.css";
import "../../styles/resources-editorial.css";

const title = "My Saved Resources";
const description =
    "Your personal collection of bookmarked tools and articles.";
---

<BaseLayout title={title} description={description} canonicalUrl={curationUrl(curationPath.saved)} noindex={true} fullWidth={true} showGlobalGrid={false} bodyClass="resources-editorial-page" navigationVariant="next">
    <div class="resources-editorial">
        <header class="resources-hero">
            <div class="resources-hero__copy">
                <h1>My Collection</h1>
                <p class="section-intro">Resources you've bookmarked for later.</p>
            </div>
            <div class="resources-hero__account">
                <a href="/" class="btn-refresh-text" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none; font-weight: 700;">
                    &larr; Back to Explore
                </a>
            </div>
        </header>

        <div class="resources-browser">
            <SavedResourceList client:only="react" />
        </div>
    </div>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import PressFilter from "../components/PressFilter.jsx";
import { getMediaMentions } from "../lib/api";
import "../styles/press-editorial.css";

export const prerender = false;

Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=60, s-maxage=300, stale-while-revalidate=86400"
);

const mentions = await getMediaMentions();
const pageTitle = "Digital Footprint";
const pageDescription = "Press releases, media mentions, films, interviews, and articles featuring Abodid Sahoo's work.";
const requestedTag = Astro.url.searchParams.get("tag") || Astro.url.searchParams.get("category") || "All";
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    fullWidth
    navigationVariant="next"
    showGlobalGrid={false}
    bodyClass="press-page"
>
    <div class="press-editorial">
        <div class="press-file">
            <header class="press-masthead">
                <p class="press-file-tag">press.js — public archive</p>
                <div class="press-masthead__hero">
                    <h1>{pageTitle}</h1>
                    <div class="press-masthead__summary">
                        <p>
                            A living archive of press, interviews, films, features,
                            and collaborations from across the web.
                        </p>
                        <div class="press-masthead__actions">
                            <a
                                class="press-topic press-topic--action"
                                href="/media-kit"
                            >
                                <span>Download Media Kit</span>
                                <b class="link-destination-arrow" aria-hidden="true">↗</b>
                            </a>
                        </div>
                    </div>
                </div>
            </header>

            <div class="press-board">
                <PressFilter items={mentions} initialTag={requestedTag} client:load />
            </div>
        </div>
    </div>
</BaseLayout>

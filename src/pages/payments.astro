---
import BaseLayout from "../layouts/BaseLayout.astro";
import StripePayment from "../components/payments/StripePayment.astro";
import PayPalPayment from "../components/payments/PayPalPayment.astro";
import RazorpayPayment from "../components/payments/RazorpayPayment.astro";

const pageTitle = "Payments";
const pageDescription =
  "Pay Abodid Sahoo with PayPal or Stripe, or use Razorpay for payments from India.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  noindex={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  fullWidth={true}
  showFooterNavigation={false}
  bodyClass="payments-page"
>
  <section class="payments-shell" aria-labelledby="payments-heading">
    <header class="payments-header">
      <div>
        <p class="payments-kicker">Abodid Sahoo / Payments</p>
        <h1 id="payments-heading">Choose a<br />payment method<span>.</span></h1>
      </div>
      <div class="payments-intro">
        <p>Good work.<br /><em>Easy payments.</em></p>
        <p>Use PayPal or Stripe for international payments, or Razorpay for payments from India.</p>
      </div>
    </header>

    <div id="payment-options" class="payment-panels" aria-label="Payment options">
      <article class="payment-panel payment-panel--paypal" aria-labelledby="paypal-heading">
        <div class="payment-details">
          <p class="payment-region">01 / International · GBP</p>
          <div class="payment-heading-row">
            <div>
              <h2 id="paypal-heading">PayPal</h2>
              <p class="payment-summary">For payments from outside India.<br /> Enter the agreed amount in GBP.</p>
            </div>
          </div>
          <div class="payment-action">
            <p class="payment-action-label">International payment</p>
            <div class="gateway-checkout-surface"><PayPalPayment appearance="light" /></div>
          </div>
        </div>
      </article>

      <article class="payment-panel payment-panel--stripe" aria-labelledby="stripe-heading">
        <div class="payment-details">
          <p class="payment-region">02 / International</p>
          <div class="payment-heading-row">
            <div>
              <h2 id="stripe-heading">Stripe</h2>
              <p class="payment-summary">Pay securely through Stripe.<br /> Review your payment at checkout.</p>
            </div>
          </div>
          <div class="payment-action">
            <p class="payment-action-label">Stripe checkout</p>
            <div class="gateway-checkout-surface"><StripePayment /></div>
          </div>
        </div>
      </article>

      <article class="payment-panel payment-panel--india" aria-labelledby="razorpay-heading">
        <div class="payment-details">
          <p class="payment-region">03 / India</p>
          <div class="payment-heading-row">
            <div>
              <h2 id="razorpay-heading">Razorpay</h2>
              <p class="payment-summary">For payments from India.<br /> UPI, Indian cards &amp; net banking.</p>
            </div>
          </div>
          <div class="payment-action">
            <p class="payment-action-label">India payment</p>
            <div class="gateway-checkout-surface razorpay-checkout-box">
              <p>Click the button to initiate payment.</p>
              <RazorpayPayment />
            </div>
          </div>
        </div>
      </article>
    </div>

    <footer class="payments-note">
      <p>Payments go directly through your chosen provider.</p>
      <a href="/">Back to abodid.com <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
    </footer>
  </section>
</BaseLayout>

<style>
  :global(body.payments-page) {
    background: #2444ca;
  }

  .payments-shell {
    --pop-blue: #2444ca;
    --pop-pink: #ff7eb5;
    --pop-yellow: #ffe44f;
    --pop-purple: #5524c7;
    --pop-cream: #fff8e8;
    --pop-ink: #15130f;
    --pop-border: rgba(21, 19, 15, 0.78);
    --pop-line: rgba(21, 19, 15, 0.24);
    --payments-gutter: clamp(16px, 3vw, 40px);
    color: var(--pop-cream);
    background: var(--pop-blue);
    padding: 0 8px;
    width: 100%;
  }

  .payment-panels,
  .payments-note {
    max-width: 1400px;
    width: calc(100% - 2 * var(--payments-gutter));
    margin-inline: auto;
  }

  .payments-header {
    max-width: 1480px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(240px, 0.65fr);
    gap: 32px;
    align-items: end;
    padding: clamp(32px, 4vw, 56px) var(--payments-gutter) 64px;
  }

  .payments-kicker,
  .payment-region,
  .payment-action-label {
    margin: 0;
    font: 750 0.72rem/1.35 var(--font-mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: inherit;
  }

  .payments-header h1 {
    margin: 24px 0 0;
    font: 620 clamp(3rem, 6.5vw, 6rem)/0.94 var(--font-display);
    letter-spacing: -0.065em;
    color: inherit;
  }

  .payments-header h1 span { color: var(--pop-yellow); }
  .payments-intro p { color: inherit; margin: 0; }
  .payments-intro p:first-child {
    font: 480 clamp(1.35rem, 2vw, 1.8rem)/1.12 var(--font-display);
    letter-spacing: -0.03em;
  }
  .payments-intro em { font-style: normal; color: var(--pop-yellow); }
  .payments-intro p + p {
    max-width: 34ch;
    margin-top: 12px;
    font: 450 0.96rem/1.45 var(--font-body);
  }
  .payment-panels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    align-items: start;
    scroll-margin-top: 88px;
  }
  .payment-panel {
    width: 100%;
    min-width: 0;
    border: 1px solid var(--pop-border);
    border-radius: 22px;
    color: var(--pop-ink);
  }
  .payment-panel--stripe { background: var(--pop-pink); }
  .payment-panel--paypal { background: var(--pop-cream); }
  .payment-panel--india { background: var(--pop-yellow); }
  .payment-details { padding: 28px 24px; }
  .payment-heading-row { margin-top: 16px; }
  .payment-panel h2 {
    margin: 0;
    color: inherit;
    font: 620 clamp(2rem, 3.4vw, 3.2rem)/1 var(--font-display);
    letter-spacing: -0.045em;
  }
  .payment-summary {
    margin: 12px 0 0;
    color: inherit;
    font: 450 0.96rem/1.45 var(--font-body);
    text-wrap: pretty;
  }
  .payment-action {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--pop-line);
  }
  .payment-action-label { margin-bottom: 12px; }
  .gateway-checkout-surface {
    width: 100%;
    max-width: 400px;
    min-width: 0;
    margin-inline: auto;
    color-scheme: light;
  }
  .payment-panel--stripe .gateway-checkout-surface {
    /* Center Stripe's native frame while the surrounding card stays fluid. */
    max-width: 288px;
  }
  .razorpay-checkout-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 224px;
    padding: 32px 20px;
    border: 1px solid var(--pop-line);
    border-radius: 6px;
    background: var(--pop-cream);
    text-align: center;
  }
  .razorpay-checkout-box p {
    margin: 0 0 16px;
    color: var(--pop-ink);
    font: 450 0.96rem/1.45 var(--font-body);
    text-wrap: balance;
  }
  .payments-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0 24px;
    font: 450 0.8rem/1.4 var(--font-body);
  }
  .payments-note p { margin: 0; color: inherit; }
  .payments-note a {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: inherit;
    text-underline-offset: 4px;
    white-space: nowrap;
  }
  .payments-shell a:focus-visible {
    outline: 3px solid var(--pop-yellow);
    outline-offset: 4px;
    border-radius: 4px;
  }
  .payments-shell a:hover { text-decoration: underline; }

  /* Keep room for each checkout and 24px side padding before stacking. */
  @media (max-width: 1130px) {
    .payment-panels { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 980px) {
    .payments-header { grid-template-columns: 1fr; gap: 24px; }
    .payments-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start; }
    .payments-intro p + p { margin-top: 0; }
    .payment-summary br { display: none; }
  }
  @media (max-width: 780px) {
    .payments-shell { --payments-gutter: 16px; }
    .payments-header { padding: 32px var(--payments-gutter) 40px; gap: 20px; }
    .payments-header h1 { margin-top: 16px; font-size: clamp(2.6rem, 10vw, 4.4rem); line-height: 0.98; letter-spacing: -0.055em; }
    .payments-intro { display: block; }
    .payments-intro p:first-child { display: none; }
    .payments-intro p + p { max-width: 40ch; }
    .payment-panel { border-radius: 18px; }
    .payments-note { flex-direction: column; align-items: start; gap: 4px; padding: 20px 0; }
  }
  @media (max-width: 370px) {
    /* Keep the native checkout wide enough on the smallest screens. */
    .payments-shell { --payments-gutter: 0px; }
  }
  @media (max-width: 480px) {
    .payment-details { padding: 24px 16px; }
  }
  @media (max-width: 337px) {
    /* Preserve Stripe's 288px frame by reducing only our card's side inset. */
    .payment-panel--stripe .payment-details { padding-inline: 7px; }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';

const description = 'Abodid & Co. is an independent creative collective bringing art, technology and research together through creative applications and bespoke immersive storytelling. Based in London. Working globally.';
const founderPortrait = 'https://assets.abodid.com/photos/variants/landing-page-01/800/35-img-0652-edited-comp-0200b8a693.webp';
---

<BaseLayout
  title="Abodid & Co. — Independent Creative-Tech Studio"
  description={description}
  canonicalUrl="https://abodid.com/studio"
  noindex={false}
  fullWidth={true}
  hideHeader={true}
  hideFooter={true}
  hideSideMenuRail={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="aco-page"
>
  <div class="aco-shell">
    <header class="aco-header">
      <div class="aco-identity">
        <a href="/studio" class="aco-brand" aria-label="Abodid and Co. studio home">Abodid <span>&amp; Co.</span></a>
        <p>Creative Production and Technology studio based in London.</p>
      </div>
      <nav aria-label="Studio navigation">
        <a class="aco-button" href="/manifesto">Our ethos</a>
        <a class="aco-button" href="#contact">Let’s talk</a>
      </nav>
    </header>

    <section class="aco-hero" aria-labelledby="aco-title">
      <h1 id="aco-title">For the ones with<br />bold ideas and<br /><span>an impeccable taste.</span></h1>
      <div class="aco-introduction">
        <p class="aco-statement">Abodid &amp; Co. is an independent creative collective bringing art, technology and research together.</p>
        <div class="aco-body-copy">
          <p>We build creative applications and produce bespoke immersive storytelling experiences through films, installations and digital media.</p>
          <p>We love working with forward-thinking brands, organisations and independent artists who dare to go beyond the expected. People who believe in making something meaningful, culturally rooted, thoughtfully crafted and a little offbeat.</p>
        </div>
      </div>
    </section>

    <section class="aco-practice aco-yellow" aria-label="Our practice">
      <div class="aco-directions">
        <article>
          <h2>Creative Production</h2>
          <p class="aco-service-tagline">Stories that become experiences.</p>
          <p class="aco-service-intro">Films, photography, installations, exhibitions and immersive digital media.</p>
          <p>From the first question to the final experience, we bring research, storytelling and creative direction together to make work that stays with people.</p>
          <a class="aco-button" href="/work">Explore selected work</a>
        </article>
        <article>
          <h2>Bespoke Creative Apps</h2>
          <p class="aco-service-tagline">Tools for curious minds.</p>
          <p class="aco-service-intro">Creative applications, interactive prototypes and research tools.</p>
          <p>We turn complex ideas into intuitive digital products that help people think, create and act. Technology with a purpose, not just for the sake of it.</p>
          <a class="aco-button" href="/opportunities">Explore Opportunity Tracker</a>
        </article>
      </div>
    </section>

    <section class="aco-ethos" aria-labelledby="aco-ethos-title">
      <h2 id="aco-ethos-title">It all starts <br />with a why.</h2>
      <div class="aco-body-copy">
        <p class="aco-lead">We believe great work begins with asking the right questions.</p>
        <p>Our approach is medium-agnostic. We don’t start with a format or a formula. We follow the idea, bringing together the right people, perspectives and technologies to give it form.</p>
        <p>With creative operations between London and India, and an international network of artists, researchers, designers, filmmakers and technologists, we build teams around ideas rather than disciplines.</p>
        <a class="aco-button" href="/manifesto">Read our ethos</a>
      </div>
    </section>

    <section class="aco-founder" aria-labelledby="aco-founder-title">
      <figure class="aco-founder-portrait aco-yellow">
        <img src={founderPortrait} alt="Abodid Sahoo, founder of Abodid & Co." width="640" height="800" loading="lazy" decoding="async" />
        <figcaption><span>Abodid Sahoo</span><span>Founder &amp; Creative Lead</span></figcaption>
      </figure>
      <div class="aco-body-copy">
        <h2 id="aco-founder-title">About the Founder.</h2>
        <p class="aco-lead">Abodid &amp; Co. is founded and led by <strong>Abodid Sahoo</strong>, a multidisciplinary artist, filmmaker and creative technologist.</p>
        <p>An alumnus of the Royal College of Art, London, and the National Institute of Design, Ahmedabad, his practice moves between visual storytelling, emerging technologies and research-led experimentation.</p>
        <p>Through the collective, he brings independent creative minds together to build meaningful work across disciplines, cultures and borders.</p>
        <a class="aco-button" href="/about">Meet Abodid</a>
      </div>
    </section>

    <section id="contact" class="aco-contact-panel aco-yellow" aria-labelledby="aco-contact-title">
      <div>
        <p class="aco-contact-intro">Have a big idea, or something that doesn’t quite fit into a brief?</p>
        <h2 id="aco-contact-title">Let’s make it happen.</h2>
      </div>
      <address aria-label="Studio contact details">
        <a class="aco-contact-link" href="mailto:studio@abodid.com"><span>Email</span><strong>studio@abodid.com</strong></a>
        <a class="aco-contact-link" href="tel:+447522258768"><span>London</span><strong>+44 7522 258768</strong></a>
        <a class="aco-contact-link" href="tel:+919439094370"><span>India</span><strong>+91 9439094370</strong></a>
      </address>
    </section>

    <footer class="aco-footer">
      <div><a class="aco-brand" href="/studio">Abodid <span>&amp; Co.</span></a><p>Art × Technology × Research</p></div>
      <p class="aco-footer-location">Based in London, working globally.</p>
    </footer>
  </div>
</BaseLayout>

<style is:global>
  html:has(body.aco-page),body.aco-page { background:#2949d4; }
  body.aco-page { --aco-blue:#2949d4;--aco-yellow:#ffe457;--aco-ink:#151515;--aco-white:#fff;--page-bg:var(--aco-blue);color:var(--aco-white);color-scheme:light; }
  .aco-page #main-content { padding:0; }
</style>
<style>
  .aco-shell { max-inline-size:1280px;margin-inline:auto;padding-inline:clamp(1.25rem,4vw,3.5rem);font-family:"Satoshi-Variable","Satoshi-Regular",sans-serif;color:var(--aco-white); }
  .aco-shell :where(h1,h2,h3,p,figure) { margin:0;color:inherit; }
  .aco-shell a { color:inherit;text-decoration:none; }
  .aco-shell a:focus-visible { outline:2px solid currentColor;outline-offset:5px;border-radius:2px; }
  .aco-yellow { background:var(--aco-yellow);color:var(--aco-ink);border-radius:20px; }
  .aco-header { display:flex;align-items:center;justify-content:space-between;gap:32px;min-block-size:116px;padding-block:12px;box-sizing:border-box;border-block-end:1px solid #ffffff70; }
  .aco-identity { min-inline-size:0; }
  .aco-identity p { max-inline-size:48ch;font-size:13px;line-height:1.45; }
  .aco-brand { display:inline-flex;align-items:center;gap:5px;font-size:24px;font-weight:750;letter-spacing:-.055em;white-space:nowrap;min-block-size:44px; }
  .aco-brand span { font-weight:450; }
  .aco-header nav { display:flex;flex-wrap:wrap;gap:10px;flex:none; }
  .aco-button { display:inline-flex;align-items:center;justify-content:center;min-block-size:46px;padding:11px 18px;box-sizing:border-box;max-inline-size:100%;border:1px solid currentColor;border-radius:8px;color:inherit;background:transparent;font-size:14px;font-weight:650;line-height:1.4;text-align:center; }
  .aco-shell .aco-button:is(:hover,:focus-visible),.aco-contact-link:is(:hover,:focus-visible) { background:var(--aco-white);color:var(--aco-ink);text-decoration:none; }
  .aco-shell .aco-button:focus-visible { outline-color:var(--aco-white); }
  .aco-yellow .aco-button:focus-visible { outline-color:var(--aco-ink); }
  .aco-hero { padding-block:48px 56px; }
  .aco-hero h1 { margin-block:0 40px;font-size:clamp(2.5rem,1rem + 5.7vw,6rem);line-height:1.02;letter-spacing:-.065em;font-weight:650; }
  .aco-hero h1 > span { font-weight:450; }
  .aco-introduction { display:grid;grid-template-columns:1fr 1fr;gap:64px; }
  .aco-introduction .aco-statement { max-inline-size:27ch;font-size:clamp(1.4rem,1rem + 1vw,1.9rem);line-height:1.3;letter-spacing:-.03em;font-weight:550; }
  .aco-body-copy p,.aco-directions p { font-size:17px;line-height:1.6;max-inline-size:54ch; }
  .aco-body-copy p + p { margin-block-start:16px; }
  .aco-practice { padding:32px; }
  .aco-directions { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:64px; }
  .aco-directions article { display:flex;flex-direction:column;align-items:flex-start; }
  .aco-directions h2 { font-size:clamp(1.6rem,1.2rem + .9vw,2rem);line-height:1.15;letter-spacing:-.035em;font-weight:650;margin-block-end:10px; }
  .aco-directions .aco-service-tagline { font-size:18px;font-weight:550;margin-block-end:20px; }
  .aco-directions .aco-service-intro { font-weight:650;margin-block-end:12px; }
  .aco-directions article > p:last-of-type { margin-block-end:24px; }
  .aco-directions .aco-button { margin-block-start:auto; }
  .aco-ethos { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:64px;padding-block:64px; }
  .aco-ethos h2 { font-size:clamp(2.25rem,1rem + 3vw,3.8rem);font-weight:550;letter-spacing:-.05em;line-height:1.05; }
  .aco-body-copy .aco-lead { font-size:21px;line-height:1.4;letter-spacing:-.015em; }
  .aco-body-copy > .aco-button { margin-block-start:24px; }
  .aco-founder { display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1fr);align-items:center;gap:clamp(32px,6vw,96px);padding-block:48px 64px;border-block-start:1px solid #ffffff70; }
  .aco-founder-portrait { max-inline-size:390px;padding:8px;overflow:hidden; }
  .aco-founder-portrait img { display:block;inline-size:100%;block-size:auto;aspect-ratio:4/5;object-fit:cover;object-position:center;border-radius:13px; }
  .aco-founder-portrait figcaption { display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 12px;padding:12px 8px 6px;font-size:11px;line-height:1.5;color:var(--aco-ink); }
  .aco-founder h2 { margin-block-end:24px;font-size:clamp(1.8rem,1rem + 1.8vw,2.8rem);font-weight:600;letter-spacing:-.04em;line-height:1.1; }
  .aco-contact-panel { display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);align-items:center;gap:48px;padding:32px;scroll-margin-block:24px; }
  .aco-contact-intro { max-inline-size:32ch;font-size:clamp(1.25rem,1rem + .7vw,1.65rem);line-height:1.35;letter-spacing:-.02em;margin-block-end:20px !important; }
  .aco-contact-panel h2 { font-size:clamp(2rem,1rem + 2.3vw,3rem);line-height:1.05;letter-spacing:-.045em;font-weight:650; }
  .aco-contact-panel address { display:grid;gap:8px;font-style:normal;min-inline-size:0; }
  .aco-contact-link { display:grid;grid-template-columns:56px minmax(0,1fr);align-items:center;gap:16px;min-block-size:52px;padding:10px 14px;border:1px solid var(--aco-ink);border-radius:8px;box-sizing:border-box; }
  .aco-contact-link > span { font-size:12px;line-height:1.4; }.aco-contact-link > strong { font-size:16px;font-weight:600;line-height:1.4;white-space:nowrap; }
  .aco-footer { display:flex;align-items:center;justify-content:space-between;gap:32px;padding-block:32px; }
  .aco-footer p { font-size:13px;line-height:1.5; }.aco-footer-location { white-space:nowrap; }
  @media(prefers-reduced-motion:no-preference) { .aco-button,.aco-contact-link { transition:background-color 150ms ease,color 150ms ease; } }
  @media(max-width:900px) { .aco-introduction,.aco-directions,.aco-ethos { gap:32px; }.aco-founder { gap:32px; }.aco-contact-panel { grid-template-columns:minmax(0,1fr);gap:28px; }.aco-contact-panel address { max-inline-size:480px;inline-size:100%; } }
  @media(max-width:720px) {
    .aco-header { flex-direction:column;align-items:flex-start;gap:16px;padding-block:16px; }.aco-brand { font-size:22px; }.aco-identity p { font-size:12px;max-inline-size:43ch; }.aco-header nav { gap:10px; }.aco-header .aco-button { font-size:13px;padding-inline:16px; }
    .aco-hero { padding-block:36px 40px; }.aco-hero h1 { margin-block-end:28px; }.aco-introduction,.aco-directions,.aco-ethos,.aco-founder { grid-template-columns:minmax(0,1fr);gap:28px; }
    .aco-body-copy p,.aco-directions p { font-size:16px; }.aco-practice,.aco-contact-panel { padding:24px; }.aco-directions { gap:36px; }.aco-directions article + article { padding-block-start:28px;border-block-start:1px solid #15151566; }
    .aco-ethos { padding-block:40px; }.aco-ethos h2 br { display:none; }.aco-founder { padding-block:32px 40px; }.aco-founder-portrait { inline-size:min(100%,350px);box-sizing:border-box;justify-self:center; }.aco-founder h2 { margin-block-end:20px; }
    .aco-footer { align-items:flex-start;flex-direction:column;gap:16px; }.aco-body-copy .aco-lead { font-size:20px; }
  }
  @media(max-width:380px) { .aco-practice,.aco-contact-panel { padding:20px; }.aco-contact-link { grid-template-columns:42px minmax(0,1fr);gap:8px;padding-inline:10px; }.aco-contact-link > strong { font-size:14px; }.aco-button { padding-inline:14px; } }
</style>

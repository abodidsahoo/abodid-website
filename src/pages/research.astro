---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getResearchProjects } from "../lib/api";
import { punctumImages } from "../data/punctumImages";
import { GESTURE_CONTROL_VIDEO_URL, GESTURE_CONTROL_HERO_GIF_URL } from "../lib/mediaAssets";
import { breadcrumbJsonLd, personJsonLd } from "../lib/seoData";

export const prerender = false;

const fetchedProjects = await getResearchProjects();
const bySlug = new Map(fetchedProjects.map((project) => [project.slug, project]));

const researchSelection = [
  {
    slug: "invisible-punctum",
    title: "Punctum",
    kind: "Participatory AI experiment",
    description: "A sociological experiment exploring visual perception, attention and the details that remain with us after an image has gone.",
    href: "/research/punctum",
    image: punctumImages[0]?.url,
    tags: ["Visual perception", "AI", "Sociology"],
  },
  {
    slug: "gesture-image-preview",
    title: "Hand Gesture Control",
    kind: "Interaction prototype",
    description: "A hand-controlled interface for browsing photographs as though they were physical cards, with an experimental voice layer.",
    href: "/research/gesture-image-preview",
    video: GESTURE_CONTROL_VIDEO_URL,
    image: GESTURE_CONTROL_HERO_GIF_URL,
    tags: ["Computer vision", "Photography", "Interaction"],
  },
  {
    slug: "obsidian-vault",
    title: "Obsidian Vault",
    kind: "Knowledge ecosystem",
    description: "A public-facing experiment in connected thinking, retrieval and the long-term development of creative taste.",
    href: "/research/obsidian-vault",
    image: punctumImages[3]?.url,
    tags: ["Knowledge systems", "Archives", "Retrieval"],
  },
  {
    slug: "polaroid-hub",
    title: "Polaroid Hub",
    kind: "Photographic microsite",
    description: "A tactile digital space for arranging, sequencing and encountering photographs outside a conventional gallery grid.",
    href: "/research/polaroid-hub",
    image: punctumImages[4]?.url,
    tags: ["Photography", "Archives", "Interface"],
  },
].map((fallback) => {
  const project = bySlug.get(fallback.slug);
  return {
    ...fallback,
    title: fallback.slug === "invisible-punctum" ? "Punctum" : project?.title || fallback.title,
    image: project?.image || fallback.image,
    video: project?.video || fallback.video,
  };
});

const title = "Research and Creative Technology — Abodid Sahoo";
const description = "Research-driven experiments by Abodid Sahoo across visual perception, participatory AI, archives, knowledge systems and cultural technology.";

const structuredData = [
  personJsonLd(),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Research", path: "/research" },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
  fullWidth={true}
  hideHeader={true}
  hideFooter={true}
  hideWhatsAppButton={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="research-next-page"
>
  <header class="story-nav">
    <a class="story-nav__brand" href="/" aria-label="Abodid Sahoo homepage">abodid.com</a>
    <nav class="story-nav__links" aria-label="Primary navigation">
      <a href="/#selected-work">Work</a>
      <a href="/research" class="is-active">Research</a>
      <a href="/services">Services</a>
      <a href="/experience">Experience</a>
      <a href="/about">About</a>
    </nav>
    <a class="story-nav__contact" href="/#enquiry">Hire me <span aria-hidden="true">↗</span></a>
    <details class="story-nav__mobile">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        <a href="/#selected-work">Work</a>
        <a href="/research" class="is-active">Research</a>
        <a href="/services">Services</a>
        <a href="/experience">Experience</a>
        <a href="/about">About</a>
        <a href="/#enquiry">Hire me ↗</a>
      </nav>
    </details>
  </header>

  <main class="research-next">
    <section class="research-next__hero" aria-labelledby="research-next-heading">
      <div class="research-next__hero-copy">
        <p class="next-eyebrow">Research · creative technology · culture</p>
        <h1 id="research-next-heading">Experiments for understanding how people see, remember and make meaning.</h1>
        <p class="research-next__lede">I combine cultural research, photography and emerging technology to turn difficult questions into participatory experiences people can see, touch and contribute to.</p>
        <div class="next-actions">
          <a href="/research/punctum">Enter Punctum <span aria-hidden="true">↗</span></a>
          <a href="/#enquiry">Discuss a role or collaboration <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="research-next__hero-images" aria-label="Images from the Punctum visual study">
        {punctumImages.slice(0, 3).map((image, index) => (
          <figure class={`research-next__hero-image research-next__hero-image--${index + 1}`}>
            <img src={image.url} alt={image.title} loading={index === 0 ? "eager" : "lazy"} />
            <figcaption>{String(index + 1).padStart(2, "0")} · Visual study</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="research-next__opportunity" aria-labelledby="opportunity-heading">
      <p class="next-eyebrow">The next environment</p>
      <h2 id="opportunity-heading">Open to joining a culture-shaping technology team in London.</h2>
      <div>
        <p>I am looking for a full-time role where research, prototyping, media and cultural insight belong in the same room—especially within a creative lab or a team building public-facing cultural products.</p>
        <p>My perspective is shaped by creative communities in London, Bangalore and Mumbai. I want my work to create more meaningful exchange between the UK and India.</p>
      </div>
      <ul aria-label="Areas of contribution">
        <li>Creative technology</li>
        <li>Design research</li>
        <li>Rapid prototyping</li>
        <li>Visual systems</li>
      </ul>
    </section>

    <section class="research-next__feature" aria-labelledby="feature-heading">
      <div class="research-next__feature-image">
        <img src={punctumImages[5]?.url} alt="Exhibition photograph used as part of the Punctum study" loading="lazy" />
      </div>
      <div class="research-next__feature-copy">
        <p class="next-eyebrow">Flagship experiment · 2026</p>
        <h2 id="feature-heading">Punctum</h2>
        <p class="research-next__feature-intro">What makes one detail in an image pierce a person—and why does another person remember something completely different?</p>
        <dl>
          <div><dt>Question</dt><dd>How do visual attention, memory and personal experience shape what stays with us?</dd></div>
          <div><dt>Method</dt><dd>Participatory image annotation, sociological inquiry and an AI-assisted ecosystem for comparing responses.</dd></div>
          <div><dt>Role</dt><dd>Research, photography, experience design, prototyping and system direction.</dd></div>
        </dl>
        <a class="next-text-link" href="/research/punctum">Explore the experiment →</a>
      </div>
    </section>

    <section class="research-next__projects" aria-labelledby="projects-heading">
      <header>
        <p class="next-eyebrow">Selected experiments</p>
        <h2 id="projects-heading">Research becomes more useful when people can enter it.</h2>
      </header>
      <div class="research-next__project-grid">
        {researchSelection.map((project, index) => (
          <a class="research-next__project" href={project.href}>
            <figure>
              {project.video ? (
                <video
                  src={project.video}
                  poster={project.image}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  aria-label={`${project.title} video preview`}
                />
              ) : (
                <img src={project.image} alt={project.title} loading="lazy" />
              )}
            </figure>
            <div>
              <span class="next-eyebrow">{String(index + 1).padStart(2, "0")} · {project.kind}</span>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <ul aria-label={`${project.title} themes`}>{project.tags.map((tag) => <li>{tag}</li>)}</ul>
              <strong>Open experiment ↗</strong>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="research-next__method" aria-labelledby="method-heading">
      <div class="research-next__method-header">
        <p class="next-eyebrow">Working method</p>
        <h2 id="method-heading">Research, prototype, observe, rebuild.</h2>
      </div>
      <div class="research-next__method-track-wrapper">
        <ol class="research-next__method-grid" role="region" aria-label="Working method steps">
          <li class="research-next__method-card">
            <div class="research-next__card-top">
              <span class="research-next__card-index">01</span>
            </div>
            <div class="research-next__card-body">
              <strong>Find the human question</strong>
              <p>Begin with a cultural tension or behaviour worth understanding.</p>
            </div>
          </li>
          <li class="research-next__method-card">
            <div class="research-next__card-top">
              <span class="research-next__card-index">02</span>
            </div>
            <div class="research-next__card-body">
              <strong>Make it tangible</strong>
              <p>Translate the question into an image, interface, system or participatory encounter.</p>
            </div>
          </li>
          <li class="research-next__method-card">
            <div class="research-next__card-top">
              <span class="research-next__card-index">03</span>
            </div>
            <div class="research-next__card-body">
              <strong>Learn from use</strong>
              <p>Observe what people notice, misunderstand, remember and contribute.</p>
            </div>
          </li>
          <li class="research-next__method-card">
            <div class="research-next__card-top">
              <span class="research-next__card-index">04</span>
            </div>
            <div class="research-next__card-body">
              <strong>Build the ecosystem</strong>
              <p>Turn those insights into a richer product, archive or research direction.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="research-next__closing">
      <p class="next-eyebrow">London · India · worldwide</p>
      <h2>Building a cultural or media-driven product?</h2>
      <p>I am open to full-time creative technology roles, research collaborations, talks and selected consulting engagements.</p>
      <div class="next-actions">
        <a href="/#enquiry">Start a conversation <span aria-hidden="true">↗</span></a>
        <a href="/experience">View experience <span aria-hidden="true">↗</span></a>
        <a href="/">Back to Home <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  body.research-next-page {
    --pop-blue: #2444ca;
    --pop-pink: #ff7eb5;
    --pop-yellow: #ffe44f;
    --pop-lime: #caff48;
    --pop-orange: #ff875c;
    --pop-purple: #5524c7;
    --pop-cyan: #62e6ff;
    --pop-cream: #fff8e8;
    --pop-ink: #15130f;
    --pop-border: rgba(21, 19, 15, 0.78);
    --story-ink: var(--pop-ink);
    --story-cream: var(--pop-cream);
    --story-gutter: clamp(1rem, 3vw, 3.5rem);

    --next-ink: var(--pop-ink);
    --next-cream: var(--pop-cream);
    --next-lime: var(--pop-lime);
    --next-pink: var(--pop-pink);
    --next-yellow: var(--pop-yellow);
    --next-blue: var(--pop-blue);
    --next-purple: var(--pop-purple);
    --next-cyan: var(--pop-cyan);
    --next-orange: var(--pop-orange);
    --color-brand-red: var(--pop-purple);
    --link-hover-color: var(--pop-purple);
    --theme-color-primary: var(--pop-blue);
    --theme-color-accent: var(--pop-purple);

    /* Layout Tokens */
    --research-gap: 8px;
    --research-page-padding: 8px;
    --research-panel-radius: 28px;
    --research-card-radius: 22px;
    --research-panel-padding: clamp(1.5rem, 4vw, 4rem);

    /* Typography Tokens - Desktop */
    --research-hero-h1-family: var(--font-display, sans-serif);
    --research-hero-h1-size: clamp(2.4rem, 4.4vw, 5.2rem);
    --research-hero-h1-weight: 700;
    --research-hero-h1-line-height: 0.92;
    --research-hero-h1-spacing: -0.055em;
    --research-hero-h1-max-width: 14ch;

    --research-section-h2-family: var(--font-display, sans-serif);
    --research-section-h2-size: clamp(2rem, 3.5vw, 4.2rem);
    --research-section-h2-weight: 700;
    --research-section-h2-line-height: 0.94;
    --research-section-h2-spacing: -0.045em;

    --research-feature-h2-family: var(--font-display, sans-serif);
    --research-feature-h2-size: clamp(2.5rem, 4.2vw, 5.2rem);
    --research-feature-h2-weight: 700;
    --research-feature-h2-line-height: 0.9;
    --research-feature-h2-spacing: -0.055em;

    --research-feature-intro-family: var(--font-display, sans-serif);
    --research-feature-intro-size: clamp(1.15rem, 1.6vw, 1.7rem);
    --research-feature-intro-weight: 500;
    --research-feature-intro-line-height: 1.25;

    --research-card-h3-family: var(--font-display, sans-serif);
    --research-card-h3-size: clamp(1.5rem, 2.2vw, 2.8rem);
    --research-card-h3-weight: 700;
    --research-card-h3-line-height: 0.98;
    --research-card-h3-spacing: -0.04em;

    --research-closing-h2-family: var(--font-display, sans-serif);
    --research-closing-h2-size: clamp(2.6rem, 4.8vw, 5.8rem);
    --research-closing-h2-weight: 700;
    --research-closing-h2-line-height: 0.9;
    --research-closing-h2-spacing: -0.055em;

    --research-font-lede-family: var(--font-sans, sans-serif);
    --research-font-lede-size: clamp(1rem, 1.2vw, 1.25rem);
    --research-font-lede-weight: 450;
    --research-font-lede-line-height: 1.45;

    --research-font-body-family: var(--font-sans, sans-serif);
    --research-font-body-size: clamp(0.92rem, 1.05vw, 1.15rem);
    --research-font-body-weight: 450;
    --research-font-body-line-height: 1.5;

    --research-font-eyebrow-family: var(--font-ui, sans-serif);
    --research-font-eyebrow-size: 0.72rem;
    --research-font-eyebrow-weight: 700;
    --research-font-eyebrow-line-height: 1.2;
    --research-font-eyebrow-spacing: 0.06em;

    --research-font-action-family: var(--font-ui, sans-serif);
    --research-font-action-size: 0.82rem;
    --research-font-action-weight: 700;
    --research-font-action-line-height: 1;

    background: var(--pop-blue);
    color: var(--pop-ink);
  }

  /* Keep text contrast intentional inside every colour panel. Global theme
     colours can otherwise leak into headings and body copy on this page. */
  body.research-next-page .research-next {
    color: var(--pop-ink);
  }

  body.research-next-page .research-next :is(h1, h2, h3, p, li, dt, dd, strong, span) {
    color: inherit;
  }

  body.research-next-page .page-content-full { padding: 0; }

  /* Top Navigation */
  .story-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    min-height: 72px;
    padding: 0 var(--story-gutter);
    display: grid;
    grid-template-columns: minmax(140px, 1fr) auto minmax(220px, 1fr);
    align-items: center;
    gap: 1.5rem;
    border-bottom: 0;
    background: var(--pop-blue);
    color: var(--pop-cream);
  }

  .story-nav a,
  .story-nav summary {
    color: inherit;
    font: 700 .72rem/1 var(--font-mono, monospace);
    letter-spacing: .08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .story-nav__brand {
    width: fit-content;
    min-height: 42px;
    padding: 0 .9rem;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--pop-ink);
    border-radius: 14px;
    background: var(--pop-yellow);
    color: var(--pop-ink) !important;
  }

  .story-nav__links {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 2.5vw, 2.5rem);
  }

  .story-nav__links a {
    opacity: 1;
    transition: text-decoration-color 160ms ease;
  }

  .story-nav__links a.is-active,
  .story-nav__mobile nav a.is-active {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  .story-nav__links a:hover,
  .story-nav__links a:focus-visible {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  .story-nav__contact {
    justify-self: end;
    min-height: 44px;
    padding: 0 1rem;
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    border: 1px solid var(--pop-ink);
    border-radius: 14px;
    background: var(--pop-pink);
    color: var(--pop-ink) !important;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .story-nav__contact:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 0 var(--pop-ink);
  }

  .story-nav__mobile {
    display: none;
  }

  .research-next { padding: var(--research-page-padding); background: var(--pop-blue); }
  .research-next :is(h1, h2, h3, p) { margin-top: 0; }
  .next-eyebrow {
    margin: 0;
    font-family: var(--research-font-eyebrow-family);
    font-size: var(--research-font-eyebrow-size);
    font-weight: var(--research-font-eyebrow-weight);
    line-height: var(--research-font-eyebrow-line-height);
    letter-spacing: var(--research-font-eyebrow-spacing);
    text-transform: uppercase;
  }
  .next-actions { display: flex; flex-wrap: wrap; gap: .55rem; }
  .next-actions a {
    min-height: 54px;
    padding: 0 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid currentColor;
    border-radius: 14px;
    color: inherit;
    text-decoration: none;
    font-family: var(--research-font-action-family);
    font-size: var(--research-font-action-size);
    font-weight: var(--research-font-action-weight);
    line-height: var(--research-font-action-line-height);
  }
  .next-actions a:first-child { background: var(--next-cream); }

  .research-next__hero { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(420px, .95fr); gap: var(--research-gap); }
  .research-next__hero-copy, .research-next__hero-images { min-height: calc(100svh - 88px); border: 1px solid rgba(21,19,15,.3); border-radius: var(--research-panel-radius); overflow: hidden; }
  .research-next__hero-copy { padding: var(--research-panel-padding); display: flex; flex-direction: column; background: var(--next-lime); }
  .research-next__hero-copy h1 {
    max-width: var(--research-hero-h1-max-width);
    margin: auto 0 1.5rem;
    font-family: var(--research-hero-h1-family);
    font-size: var(--research-hero-h1-size);
    font-weight: var(--research-hero-h1-weight);
    line-height: var(--research-hero-h1-line-height);
    letter-spacing: var(--research-hero-h1-spacing);
    overflow-wrap: break-word;
    word-break: normal;
    text-wrap: balance;
  }
  .research-next__lede {
    max-width: 62ch;
    margin-bottom: 1.5rem;
    font-family: var(--research-font-lede-family);
    font-size: var(--research-font-lede-size);
    font-weight: var(--research-font-lede-weight);
    line-height: var(--research-font-lede-line-height);
  }
  .research-next__hero-images { position: relative; background: var(--next-yellow); }
  .research-next__hero-image { position: absolute; overflow: hidden; border: 1px solid var(--next-ink); border-radius: 18px; background: var(--next-cream); box-shadow: 0 14px 35px rgba(21,19,15,.2); }
  .research-next__hero-image img { width: 100%; height: 100%; display: block; object-fit: cover; }
  .research-next__hero-image figcaption { position: absolute; left: 10px; bottom: 10px; padding: .45rem .6rem; border-radius: 999px; background: rgba(21,19,15,.78); color: var(--next-cream); font: 700 .65rem/1 var(--font-ui, sans-serif); }
  .research-next__hero-image--1 { inset: 5% 7% 34% 7%; transform: rotate(-2deg); }
  .research-next__hero-image--2 { inset: 38% 28% 7% 4%; transform: rotate(2.5deg); }
  .research-next__hero-image--3 { inset: 46% 4% 5% 52%; transform: rotate(-1deg); }

  .research-next__opportunity { margin-top: var(--research-gap); padding: var(--research-panel-padding); display: grid; grid-template-columns: .55fr 1.4fr 1fr; gap: clamp(2rem, 5vw, 6rem); border: 1px solid rgba(21,19,15,.3); border-radius: var(--research-panel-radius); background: var(--next-pink); }
  .research-next__opportunity h2 {
    font-family: var(--research-section-h2-family);
    font-size: var(--research-section-h2-size);
    font-weight: var(--research-section-h2-weight);
    line-height: var(--research-section-h2-line-height);
    letter-spacing: var(--research-section-h2-spacing);
    overflow-wrap: break-word;
  }
  .research-next__opportunity > div p {
    font-family: var(--research-font-body-family);
    font-size: var(--research-font-body-size);
    font-weight: var(--research-font-body-weight);
    line-height: var(--research-font-body-line-height);
  }
  .research-next__opportunity ul, .research-next__project ul { margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-content: flex-start; gap: .4rem; list-style: none; }
  .research-next__opportunity li, .research-next__project li { padding: .45rem .6rem; border: 1px solid currentColor; border-radius: 999px; font: 700 .68rem/1 var(--font-ui, sans-serif); }

  .research-next__feature { margin-top: var(--research-gap); display: grid; grid-template-columns: 1.1fr .9fr; gap: var(--research-gap); }
  .research-next__feature-image, .research-next__feature-copy { min-height: 720px; border: 1px solid rgba(21,19,15,.3); border-radius: var(--research-panel-radius); overflow: hidden; }
  .research-next__feature-image img { width: 100%; height: 100%; display: block; object-fit: cover; }
  .research-next__feature-copy { padding: var(--research-panel-padding); display: flex; flex-direction: column; background: var(--next-cyan); }
  .research-next__feature-copy h2 {
    margin: auto 0 1rem;
    font-family: var(--research-feature-h2-family);
    font-size: var(--research-feature-h2-size);
    font-weight: var(--research-feature-h2-weight);
    line-height: var(--research-feature-h2-line-height);
    letter-spacing: var(--research-feature-h2-spacing);
    overflow-wrap: break-word;
  }
  .research-next__feature-intro {
    font-family: var(--research-feature-intro-family);
    font-size: var(--research-feature-intro-size);
    font-weight: var(--research-feature-intro-weight);
    line-height: var(--research-feature-intro-line-height);
    overflow-wrap: break-word;
  }
  .research-next__feature-copy dl { display: grid; gap: .8rem; }
  .research-next__feature-copy dl div { padding-top: .8rem; display: grid; grid-template-columns: 90px 1fr; gap: 1rem; border-top: 1px solid rgba(21,19,15,.3); }
  .research-next__feature-copy dt { font: 700 .7rem/1.2 var(--font-ui, sans-serif); text-transform: uppercase; }
  .research-next__feature-copy dd { margin: 0; line-height: 1.45; }

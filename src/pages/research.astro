---
import BaseLayout from "../layouts/BaseLayout.astro";
import { researchProjects } from "../data/researchPortfolio";
import { breadcrumbJsonLd, personJsonLd } from "../lib/seoData";
import "../styles/research-portfolio.css";

const title = "Research — Abodid Sahoo";
const description =
  "Autoethnographic research by Abodid Sahoo across personal archives, grief, photography and cultural memory.";
const structuredData = [
  personJsonLd(),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Research", path: "/research" },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  useDynamicOgImage={true}
  structuredData={structuredData}
  canonicalUrl="https://abodid.com/research"
  fullWidth={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="research-portfolio-page"
>
  <main class="rp-shell">
    <section
      class="rp-projects"
      id="projects"
      aria-labelledby="projects-heading"
    >
      <header class="rp-projects__header">
        <p class="rp-eyebrow">Current collection · 2026</p>
        <h1 id="projects-heading">
          <span>Selected</span>
          <span>Research Projects</span>
        </h1>
        <p>
          Selected projects, papers and ongoing inquiries developed across
          academic and creative contexts.
        </p>
      </header>

      <div class="rp-grid">
        {
          researchProjects.map((project, index) => (
            <article
              class="rp-card"
              data-accent={project.accent}
              data-pop-surface={project.accent}
            >
              <a class="rp-card__shell" href={`/research/${project.slug}`}>
                <figure class="rp-card__media">
                  <img
                    src={project.images[0].src}
                    alt={project.images[0].alt}
                    loading={index < 2 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </figure>
                <div class="rp-card__copy">
                  <div class="rp-card__meta">
                    <span class="rp-card__index">{String(index + 1).padStart(2, "0")}</span>
                    <span class="rp-card__role">{project.role}</span>
                  </div>
                  <h2>{project.title}</h2>
                  <p class="rp-card__premise">{project.premise}</p>
                  <ul
                    class="rp-card__themes"
                    aria-label={`${project.title} themes`}
                  >
                    {project.themes.map((theme) => (
                      <li>{theme}</li>
                    ))}
                  </ul>
                  <span class="rp-card__destination">
                    <span>Open case study</span>
                    <span aria-hidden="true">↗</span>
                  </span>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="rp-panel rp-proof-strip" data-pop-surface="pink" aria-labelledby="proof-heading">
      <div>
        <h2 id="proof-heading">Recognition</h2>
      </div>
      <div class="rp-proof-strip__items">
        <article>
          <h3>British Sociological Association</h3>
          <p>
            Two accepted research projects at the 2026 Annual Conference: a
            poster in Science, Technology & Digital Studies and a roundtable in
            Families & Relationships.
          </p>
        </article>
        <article>
          <h3>Cambridge Digital Humanities</h3>
          <p>
            Full bursary for the 2026 Cultural Heritage Data School, working
            across co-design, photogrammetry, critical visualisation and
            participatory preservation.
          </p>
        </article>
        <article>
          <h3>Royal College of Art</h3>
          <p>
            I received a full scholarship from Apple to pursue my postgraduate
            studies in London, where I completed an MA in Digital Direction,
            working across photography, performance, writing, archival material
            and technology-driven participatory projects.
          </p>
        </article>
      </div>
    </section>

    <section
      class="rp-panel rp-practice rp-practice--method"
      data-pop-surface="yellow"
      id="method"
      aria-labelledby="method-heading"
    >
      <div>
        <h2 id="method-heading">My Research Method</h2>
      </div>
      <div class="rp-practice__items">
        <article>
          <h3>Autoethnography</h3>
          <p class="rp-practice__lead">
            Autoethnography is the throughline of my research: I work with my
            own personal archives and lived experience as both evidence and
            material.
          </p>
        </article>
        <article>
          <h3>Archives as Method</h3>
          <p>
            Photographs, handwritten texts, voice notes, screenshots,
            conversations and everyday performances become ways of studying
            memory, relationships, grief, migration and technology from inside
            the experience itself.
          </p>
        </article>
        <article>
          <h3>From Personal to Sociological</h3>
          <p>
            The research becomes sociological when those private experiences are
            examined in relation to collective structures: family rituals,
            cultural expectations, platforms, consent, ideas of widowhood, the
            social recognition of grief, and the technologies that decide what
            is remembered or resurfaced.
          </p>
        </article>
      </div>
    </section>

    <section class="rp-panel rp-closing" data-pop-surface="purple">
      <p class="rp-eyebrow">
        Research collaboration · London · India · Worldwide
      </p>
      <h2>Questions worth staying with.</h2>
      <p>
        I am open to research collaborations, talks and roles connecting
        culture, visual practice and technology.
      </p>
      <div class="rp-hero__actions">
        <a class="rp-button" data-pop-surface="lime" href="/#enquiry">Start a conversation ↗</a>
        <a class="rp-button" data-pop-surface="lime" href="/lab">Visit the Lab →</a>
      </div>
    </section>
  </main>
</BaseLayout>

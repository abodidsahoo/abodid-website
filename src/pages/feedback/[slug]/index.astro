---
import FeedbackForm from '../../../components/feedback/FeedbackForm.astro';
import { getFeedbackForm } from '../../../lib/feedback/server';
import { formPath } from '../../../lib/feedback/schema';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
const form = await getFeedbackForm(Astro.params.slug || '');
if (!form) return new Response('Feedback form not found.', { status: 404 });
const canonicalPath = formPath(form.slug);
if (canonicalPath !== Astro.url.pathname) return Astro.redirect(canonicalPath + Astro.url.search, 308);
---

<FeedbackForm form={form} />

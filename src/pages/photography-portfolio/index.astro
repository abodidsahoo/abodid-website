---
import { getPortfolioPhotos, groupPortfolio } from '../../lib/photography/server';
import { extractPaletteFromServerImage } from '../../lib/photography/serverPalette';
import '../../styles/photography/portfolio.css';
export const prerender = false;
const photos = await getPortfolioPhotos();
const groups = groupPortfolio(photos);
const groupsWithPalette = await Promise.all(groups.map(async (group) => {
  const coverUrl = group.cover.small || group.cover.large;
  const palette = await extractPaletteFromServerImage(coverUrl);
  return { ...group, palette };
}));
// Fisher-Yates shuffle so project positions randomize on every refresh
const shuffledGroups = [...groupsWithPalette];
for (let i = shuffledGroups.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [shuffledGroups[i], shuffledGroups[j]] = [shuffledGroups[j], shuffledGroups[i]];
}
const INITIAL_SSR_COUNT = 8;
const initialGroups = shuffledGroups.slice(0, INITIAL_SSR_COUNT);
const canonical = 'https://photos.abodid.com/';
const description = 'Photography by Abodid Sahoo. Exhibitions, people and places, observed with feeling. Available worldwide for editorial, commercial, fine art and documentary commissions and image licensing.';
const person = { '@type': 'Person', '@id': `${canonical}#photographer`, name: 'Abodid Sahoo', jobTitle: 'Photographer', url: canonical, email: 'hello@abodid.com', sameAs: ['https://abodid.com', 'https://www.instagram.com/abodid.sahoo'], knowsAbout: ['Exhibition photography', 'Editorial photography', 'Commercial photography', 'Fine art photography', 'Documentary photography'], alumniOf: { '@type': 'CollegeOrUniversity', name: 'Royal College of Art', url: 'https://www.rca.ac.uk/' } };
const structuredData = { '@context': 'https://schema.org', '@graph': [person, { '@type': 'ImageGallery', '@id': `${canonical}#gallery`, name: 'Abodid Sahoo — Selected Photography', description, url: canonical, author: { '@id': person['@id'] }, mainEntity: photos.map(photo => ({ '@type': 'ImageObject', '@id': `${canonical}#${photo.id}`, name: photo.title, caption: photo.alt, description: photo.story || photo.alt, contentUrl: photo.large, thumbnailUrl: photo.small, creator: { '@id': person['@id'] }, creditText: 'Abodid Sahoo', copyrightNotice: '© Abodid Sahoo. All rights reserved.', acquireLicensePage: `${canonical}#inquiry`, ...(photo.location ? { contentLocation: { '@type': 'Place', name: photo.location } } : {}) })) }, { '@type': 'Service', name: 'Worldwide photography commissions and image licensing', provider: { '@id': person['@id'] }, areaServed: 'Worldwide', serviceType: ['Editorial photography', 'Commercial photography', 'Fine art photography', 'Documentary photography', 'Image licensing'], url: `${canonical}#inquiry` }] };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Abodid Sahoo — Photographer · Worldwide Commissions</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#fbfbf9" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 80 80'%3E%3Crect width='80' height='80' fill='white'/%3E%3Ctext x='10' y='59' font-size='56' font-family='Georgia' font-style='italic'%3Ea.%3C/text%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://assets.abodid.com" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content="Abodid Sahoo — Photographer" />
    <meta property="og:description" content={description} />
    {shuffledGroups[0] && <meta property="og:image" content={shuffledGroups[0].cover.large} />}
    <meta property="og:image:alt" content={shuffledGroups[0]?.cover.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll('<', '\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#gallery">Skip to photographs</a>
    <header class="site-header">
      <a href="#about" class="nav-link" data-open-about>About</a>
      <a class="wordmark" href={Astro.url.hostname === 'photos.abodid.com' ? '/' : '/photography-portfolio'} aria-label="Abodid Sahoo, photography home"><span>ABODID SAHOO</span></a>
      <nav aria-label="Main navigation"><button class="nav-link" id="view-toggle" aria-controls="gallery" aria-pressed="false">Index</button><span aria-hidden="true">/</span><a class="nav-link" href="#inquiry" data-open-inquiry>Inquire</a></nav>
    </header>
    <main>
      <h1 class="sr-only">Abodid Sahoo — Photographer. Selected work.</h1>
      <div id="index-floating-preview" class="index-floating-preview" aria-hidden="true">
        <img id="index-floating-img" alt="" />
      </div>
      <section id="gallery" class="gallery" aria-label="Selected photography series">
        {initialGroups.map((group, i) => (
          <article
            class="project"
            data-category={group.category}
            data-index={i}
            data-palette-bg={group.palette.bg}
            data-palette-dark={group.palette.isDark ? 'true' : 'false'}
            data-palette-text={group.palette.textColor}
            data-palette-subtext={group.palette.subtextColor}
            data-size={i % 5 === 0 ? 'wide' : i % 5 === 3 ? 'tall' : i % 7 === 0 ? 'small' : 'normal'}
            style={`--order:${i}`}
          >
            <a
              href={group.cover.large}
              class="project-link"
              data-group={i}
              data-cover={group.cover.small || group.cover.large}
              data-title={group.title}
              data-category-name={group.category || 'Editorial'}
              data-count={group.images.length}
              aria-label={`View ${group.title}, ${group.images.length} photographs`}
            >
              <div class="image-wrap">
                <img
                  src={group.cover.large}
                  srcset={`${group.cover.small} 800w, ${group.cover.large} 1600w`}
                  sizes="(max-width: 600px) 90vw, 42vw"
                  width={group.cover.width || undefined}
                  height={group.cover.height || undefined}
                  loading={i < 2 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  decoding="async"
                  alt={group.cover.alt}
                />
                <div class="project-hover-overlay" aria-hidden="true">
                  <div class="hover-content">
                    <h2 class="hover-title">
                      {group.title}
                      <span class="hover-count">({group.images.length})</span>
                    </h2>
                    <span class="hover-category">{group.category || 'Editorial'}</span>
                  </div>
                </div>
              </div>
              <div class="index-row">
                <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
                <div class="index-info">
                  <h2 class="index-title">{group.title}</h2>
                  <span class="index-category-mobile">{group.category || 'Editorial'} · {group.images.length} photos</span>
                </div>
                <span class="index-category">{group.category || 'Editorial'}</span>
                <span class="index-count">{group.images.length} photos</span>
                <span class="index-arrow" aria-hidden="true">↗</span>
              </div>
            </a>
          </article>
        ))}
        {!shuffledGroups.length && (
          <p class="empty-state">New photographs are on their way. <a href="#inquiry" data-open-inquiry>Request a portfolio →</a></p>
        )}
        <div id="scroll-sentinel" aria-hidden="true" style="grid-column: 1 / -1; height: 1px; width: 100%;"></div>
      </section>
      <p id="gallery-status" class="sr-only" aria-live="polite"></p>
      <section class="closing" id="about">
        <span class="eyebrow">Abodid Sahoo / Photography</span>
        <h2>People. Places. Memories.</h2>
        <div class="closing-copy"><p>I’m Abodid, a photographer and Royal College of Art alumnus. I photograph exhibitions, people and cultural spaces, drawn to the small gestures that give a place its life.</p><p>For editorial, commercial, fine art and documentary commissions. From the first conversation to the final frame, wherever your story takes us.</p><a class="text-link" href="#inquiry" data-open-inquiry>Worldwide commissions & licensing <span aria-hidden="true">↗</span></a></div>
      </section>
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Abodid Sahoo</span>
      <a href="https://www.instagram.com/abodid.sahoo" target="_blank" rel="noopener noreferrer">Instagram ↗</a>
    </footer>
    <span class="cursor-label" aria-hidden="true">View series ↗</span>
    <dialog id="lightbox" aria-labelledby="lightbox-title">
      <div class="lightbox-top"><span id="lightbox-count" aria-live="polite"></span><button data-close aria-label="Close photo viewer">Close ×</button></div>
      <div class="lightbox-stage"><button id="previous-photo" class="photo-arrow" aria-label="Previous photograph">←</button><img id="lightbox-image" alt="" sizes="(max-width: 600px) 94vw, 85vw" /><button id="next-photo" class="photo-arrow" aria-label="Next photograph">→</button></div>
      <div class="lightbox-bottom"><div><h2 id="lightbox-title"></h2><p id="lightbox-location"></p></div><button id="details-toggle" aria-expanded="false" aria-controls="photo-details">Details +</button><button id="license-photo">License this image ↗</button></div>
      <div id="photo-details" hidden><p id="photo-story"></p><p id="photo-camera"></p><p>Photograph © Abodid Sahoo. Licensing by arrangement.</p></div>
      <p class="sr-only" id="image-load-status" aria-live="polite"></p>
    </dialog>
    <dialog id="inquiry" class="inquiry" aria-labelledby="inquiry-title">
      <div class="drawer-top"><span class="eyebrow">Let’s make something matter.</span><button data-close aria-label="Close inquiry">Close ×</button></div>
      <p class="drawer-availability"><i aria-hidden="true"></i> Available for global travel / Q4 2026</p>
      <h2 id="inquiry-title">A new story<br /><em>starts here.</em></h2>
      <p class="drawer-intro">Worldwide commissions & image licensing.<br />Tell me what you have in mind.</p>
      <form id="inquiry-form">
        <label>Your name<input name="name" autocomplete="name" required maxlength="100" placeholder="Name / studio" /></label>
        <label>Email<input name="email" type="email" autocomplete="email" required maxlength="200" placeholder="you@studio.com" /></label>
        <div class="form-row"><label>Interested in<select name="type"><option>Editorial commission</option><option>Commercial commission</option><option>Fine art commission</option><option>Documentary commission</option><option>Image licensing</option></select></label><label>Location / dates<input name="location" maxlength="150" placeholder="Anywhere in the world" /></label></div>
        <label>Your brief<textarea name="brief" rows="3" maxlength="3000" required placeholder="The idea, timing and approximate budget…"></textarea></label>
        <button class="send-inquiry" type="submit">Compose inquiry <span aria-hidden="true">↗</span></button>
        <p class="form-note" id="inquiry-note" role="status">Opens your email app with your brief ready to send.</p>
      </form>
      <a class="direct-email" href="mailto:hello@abodid.com">hello@abodid.com ↗</a>
    </dialog>
    <noscript><style>.project-caption{opacity:1!important;transform:none!important}#view-toggle{display:none}</style><p class="noscript-message">For commissions and licensing, email <a href="mailto:hello@abodid.com">hello@abodid.com</a>. Select a photograph to view it.</p></noscript>
    <script id="portfolio-data" type="application/json" set:html={JSON.stringify(shuffledGroups).replaceAll('<', '\u003c')} />
    <script src="../../scripts/photography/portfolio.ts"></script>
  </body>
</html>

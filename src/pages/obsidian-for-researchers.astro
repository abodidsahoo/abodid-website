const pillars = [
  {
    title: "Zotero & Better BibTeX Sync",
    body: "Bring papers, monographs, and PDF annotations directly from Zotero into markdown notes with automated citation keys and metadata.",
  },
  {
    title: "Atomic Literature Synthesis",
    body: "Deconstruct dense academic sources into atomic conceptual notes, arguments, methodology comparisons, and thematic webs.",
  },
  {
    title: "Pandoc & Thesis Compilation",

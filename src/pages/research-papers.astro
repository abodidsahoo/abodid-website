---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchFilter from "../components/ResearchFilter.jsx";
import { getResearchPapers } from "../lib/api";

const pageTitle = "Research Papers I Have Curated";
const papers = await getResearchPapers();
const initialTag = Astro.url.searchParams.get('tag') || Astro.url.searchParams.get('category') || 'All';
---

<BaseLayout title={pageTitle} fullWidth={true} showGlobalGrid={false} bodyClass="research-papers-page" navigationVariant="next">
    <div class="research-papers-index">
        <header class="research-papers-hero">
            <div>
                <p class="research-papers-hero__eyebrow">Curated by Abodid Sahoo</p>
                <h1>Research papers<span>I keep coming back to.</span></h1>
            </div>
            <p class="research-papers-hero__intro">
                Written by their respective authors, not by me. Collected here
                for their connections to autoethnography, photography, grief,
                memory and human emotions.
            </p>
        </header>
        <ResearchFilter client:load papers={papers} initialTag={initialTag} />
    </div>
</BaseLayout>

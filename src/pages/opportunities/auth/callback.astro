---
export const prerender = false;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/portfolio-pop-editorial.css';
import '../../../styles/opportunities-editorial.css';
---

<BaseLayout
    title="Completing sign in · Opportunity Tracker"
    description="Completing Google sign in."
    noindex={true}
    fullWidth={true}
    showGlobalGrid={false}
    bodyClass="opportunities-editorial-page"
    navigationVariant="next"
>
    <main class="opp-auth-callback" id="main-content">
        <div>
            <span>GOOGLE AUTHENTICATION</span>
            <div id="opportunity-auth-wave"><span class="opp-wave-dots" aria-hidden="true"><i></i><i></i><i></i></span></div>
            <h1 id="opportunity-auth-title">Your next chapter is loading.</h1>
            <p id="opportunity-auth-status" role="status" aria-live="polite">A quick sign-in check. Then back to the good stuff.</p>
            <a id="opportunity-auth-retry" href="/opportunities" hidden>Return to sign in →</a>
        </div>
    </main>
    <script>
        import { opportunitySupabase as supabase } from '../../../lib/opportunitySupabase';

        const status = document.getElementById('opportunity-auth-status');
        const retry = document.getElementById('opportunity-auth-retry') as HTMLAnchorElement | null;
        const params = new URLSearchParams(window.location.search);
        const requestedNext = params.get('next');
        const safeNext = requestedNext?.startsWith('/opportunities/') && !requestedNext.startsWith('//')
            ? requestedNext
            : null;

        if (retry && safeNext) retry.href = safeNext;

        const showFailure = (message: string) => {
            document.getElementById('opportunity-auth-wave')?.setAttribute('hidden', '');
            const title = document.getElementById('opportunity-auth-title');
            if (title) title.textContent = 'Let’s try that again.';
            if (status) status.textContent = message;
            if (retry) retry.hidden = false;
        };

        const getProfile = async (accessToken: string) => {
            // Profile creation happens in the same database transaction as a
            // first login, but a short retry also covers API/cache propagation.
            for (const delay of [0, 250, 750]) {
                if (delay) await new Promise((resolve) => window.setTimeout(resolve, delay));
                const response = await fetch('/api/opportunities/session', {
                    headers: { Authorization: `Bearer ${accessToken}` },
                    cache: 'no-store',
                });
                if (response.ok) return response;
                if (response.status !== 409) return response;
            }
            return null;
        };

        const complete = async () => {
            const oauthError = params.get('error_description') || params.get('error');
            if (oauthError) {
                showFailure('Google sign in was cancelled or rejected. Please try again.');
                return;
            }

            const { data: { session }, error } = await supabase.auth.getSession();
            if (error || !session?.access_token) {
                showFailure('Sign in could not be completed. Please return and try again.');
                return;
            }

            const response = await getProfile(session.access_token);
            if (!response) {
                showFailure('Your profile could not be prepared. Please try again in a moment.');
                return;
            }
            if (!response.ok) {
                const payload = await response.json().catch(() => ({}));
                showFailure(
                    payload?.code === 'OPPORTUNITIES_NOT_CONFIGURED'
                        ? 'Opportunities account storage is not configured yet.'
                        : 'Your profile could not be opened. Please return and try again.',
                );
                return;
            }

            const payload = await response.json();
            window.location.replace(safeNext || `/opportunities/${payload.profile.username}`);
        };

        void complete().catch(() => showFailure('We could not finish signing you in. Check your connection and try again.'));
    </script>
</BaseLayout>

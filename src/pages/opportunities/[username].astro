---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import OpportunityCollectionApp from '../../components/opportunities/OpportunityCollectionApp';
import { OPPORTUNITY_RESERVED_USERNAMES } from '../../lib/opportunities/username';
import '../../styles/portfolio-pop-editorial.css';
import '../../styles/opportunities-editorial.css';

const username = String(Astro.params.username || '').trim().toLowerCase();
if (!/^[a-z0-9_]{3,24}$/.test(username) || OPPORTUNITY_RESERVED_USERNAMES.has(username)) {
    return Astro.redirect('/opportunities', 302);
}
---

<BaseLayout
    title={`@${username} · Opportunity Tracker`}
    description={`View @${username}'s organized open calls, residencies, fellowships, grants and jobs.`}
    noindex={false}
    fullWidth={true}
    showGlobalGrid={false}
    bodyClass="opportunities-editorial-page opp-app-page"
    hideHeader={true}
    hideFooter={true}
    hideSideMenuRail={true}
    showNewsletterPopup={false}
>
    <div class="opp-route-canvas">
        <OpportunityCollectionApp client:load username={username} />
    </div>
</BaseLayout>

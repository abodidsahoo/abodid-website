---
export const prerender = false;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/portfolio-pop-editorial.css';
import '../../../styles/opportunities-editorial.css';
---

<BaseLayout
    title="Completing Safari sign in · Opportunity Tracker"
    description="Completing Safari extension sign in."
    noindex={true}
    fullWidth={true}
    showGlobalGrid={false}
    bodyClass="opportunities-editorial-page"
    navigationVariant="next"
>
    <main class="opp-auth-callback" id="main-content">
        <div>
            <span>SAFARI EXTENSION</span>
            <div id="safari-extension-auth-wave"><span class="opp-wave-dots" aria-hidden="true"><i></i><i></i><i></i></span></div>
            <h1>Getting your extension a seat at the table.</h1>
            <p id="safari-extension-auth-status" role="status" aria-live="polite">Keep this tab open for a moment. If Safari asks, allow Opportunity Tracker access to abodid.com so the extension can complete sign-in.</p>
            <a href="/opportunities">Open Opportunity Tracker →</a>
        </div>
    </main>
</BaseLayout>

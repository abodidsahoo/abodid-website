---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import BoudoirMoodboard from "../components/BoudoirMoodboard.jsx";
import { listR2Folder, buildR2PublicUrl } from "../lib/media/r2.ts";

const pageTitle = "Boudoir Board — Abodid Sahoo";
const pageDescription =
  "A visual mood board and photographic study of boudoir portraiture, lighting, shadow, and intimate human form.";

const { files: files1600, config } = await listR2Folder("photos/variants/boudoir/1600/", "assets");
const { files: files800 } = await listR2Folder("photos/variants/boudoir/800/", "assets");
const publicAssetConfig = { ...config, publicBaseUrl: "https://assets.abodid.com" };
const fileMap = new Map<string, { key1600?: string; key800?: string; etag?: string }>();

(files1600 || []).forEach((file) => {
  const filename = file.objectKey.split("/").pop() || "";
  fileMap.set(filename, { key1600: file.objectKey, etag: file.etag || undefined });
});

(files800 || []).forEach((file) => {
  const filename = file.objectKey.split("/").pop() || "";
  const existing = fileMap.get(filename) || { etag: file.etag || undefined };
  existing.key800 = file.objectKey;
  fileMap.set(filename, existing);
});

const sortedFilenames = Array.from(fileMap.keys()).sort((a, b) =>
  a.localeCompare(b, undefined, { numeric: true, sensitivity: "base" })
);

const photos = sortedFilenames.map((filename, index) => {
  const data = fileMap.get(filename)!;
  const gridKey = data.key800 || data.key1600 || "";
  const highResKey = data.key1600 || data.key800 || "";
  return {
    id: `boudoir-${index + 1}`,
    title: `Boudoir photograph ${index + 1}`,
    imageUrl: buildR2PublicUrl(publicAssetConfig, highResKey),
    thumbnailUrl: buildR2PublicUrl(publicAssetConfig, gridKey),
    paletteImageUrl: `/api/image-palette-proxy?url=${encodeURIComponent(
      buildR2PublicUrl(publicAssetConfig, gridKey)
    )}`,
  };
});

Astro.response.headers.set("Cache-Control", "public, max-age=0, must-revalidate");
Astro.response.headers.set("Vercel-CDN-Cache-Control", "s-maxage=300, stale-while-revalidate=86400");
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  fullWidth={true}
  hideHeader={false}
  hideFooter={false}
  hideWhatsAppButton={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="story-moodboard-page"
>
  <main class="moodboard-shell">
    <article class="moodboard-file">
      <header class="moodboard-heading">
        <div class="moodboard-heading__hero">
          <h1>Boudoir Board</h1>
          <p>An intimate archive of light, shadow and human form.</p>
        </div>
      </header>

      <section class="moodboard-board" aria-label="Boudoir photographic studies">
        <BoudoirMoodboard items={photos} deepLinkParam="photo" showTitles={false} client:load />

        <footer class="moodboard-footer">
          <h2>Every photograph carries its own atmosphere.</h2>
          <p>Open any image to see its extracted colour palette.</p>
        </footer>
      </section>
    </article>
  </main>
</BaseLayout>

<style is:global>
  body.story-moodboard-page {
    --pop-blue: #2444ca;
    --pop-pink: #ff7eb5;
    --pop-yellow: #ffe44f;
    --pop-cream: #fff8e8;
    --pop-ink: #15130f;
    --story-gutter: clamp(1rem, 3vw, 3.5rem);
    margin: 0;
    padding: 0 !important;
    min-height: 100vh;
    background: var(--pop-blue) !important;
    color: var(--pop-ink);
  }
  html:has(body.story-moodboard-page) { background: var(--pop-blue); }
  body.story-moodboard-page #main-content { padding: 0 !important; }
  body.story-moodboard-page .skip-link { z-index: 11000; }

  .moodboard-shell { width: 100%; padding: 8px; box-sizing: border-box; background: var(--pop-blue); }
  .moodboard-file {
    width: 100%; overflow: hidden; box-sizing: border-box;
    border: 1px solid var(--pop-ink); border-radius: clamp(20px, 3vw, 34px);
    background: var(--pop-cream); box-shadow: 0 10px 0 rgba(21, 19, 15, 0.2);
  }
  .moodboard-heading {
    padding: clamp(1.4rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--pop-ink); background: var(--pop-pink);
  }
  .moodboard-heading__hero {
    display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(260px, 0.7fr);
    gap: clamp(2rem, 6vw, 7rem); align-items: end;
  }
  .moodboard-heading h1 {
    max-width: 10ch; margin: 0; color: var(--pop-ink);
    font: 720 clamp(3.7rem, 9vw, 8.5rem)/0.84 var(--font-display, sans-serif);
    letter-spacing: -0.075em;
  }
  .moodboard-heading p {
    max-width: 34rem; margin: 0; color: var(--pop-ink);
    font: 500 clamp(1.15rem, 2vw, 1.65rem)/1.32 var(--font-display, sans-serif);
    letter-spacing: -0.025em;
  }
  .moodboard-board { background: #f5ede0; padding: 25px; }
  .moodboard-footer {
    margin-top: clamp(2.5rem, 6vw, 5rem); padding: clamp(2rem, 4.5vw, 4rem);
    border: 1px solid var(--pop-ink); border-radius: clamp(16px, 2.5vw, 28px);
    background: var(--pop-pink); color: var(--pop-ink); text-align: center;
  }
  .moodboard-footer h2 {
    margin: 0; font: 700 clamp(2rem, 4.5vw, 3.8rem)/0.95 var(--font-display, sans-serif);
    letter-spacing: -0.05em;
  }
  .moodboard-footer p { margin: 1rem 0 0; font: 600 1rem/1.4 var(--font-mono, monospace); }

  @media (max-width: 760px) {
    .moodboard-heading__hero { grid-template-columns: 1fr; gap: 1rem; }
    .moodboard-shell { padding: 6px; }
  }
</style>

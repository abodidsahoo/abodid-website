---
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbJsonLd, personJsonLd, serviceJsonLd } from "../lib/seoData";
import { CV_DOWNLOAD_URL } from "../lib/cv";
import { getHomeStorytellingContent } from "../lib/homeStorytellingContent";

export const prerender = false;

const content = await getHomeStorytellingContent();
const heroSlideCopy: Record<string, { category: string; outcome: string }> = {
  "into-the-flux": {
    category: "Exhibition experience design",
    outcome: "10,000+ visitors",
  },
  punctum: {
    category: "Sociological research",
    outcome: "180,000+ images",
  },
  "gesture-control": {
    category: "Interaction prototype",
    outcome: "Interactive playful app",
  },
  "obsidian-vault": {
    category: "Knowledge ecosystem",
    outcome: "1,000+ interconnected notes",
  },
  "show-me-the-way": {
    category: "Music video",
    outcome: "Broadcast on VH1 & Rolling Stone",
  },
};
const punctumProject = content.projects.find((project: any) => project.id === "punctum");
const punctumWalkthroughSlide = punctumProject
  ? {
      ...punctumProject,
      id: "punctum-walkthrough",
      category: "Human attention analysis",
      outcome: "Interactive web application",
      heroImage: "https://jwipqbjxpmgyevfzpjjx.supabase.co/storage/v1/object/public/misc/gif/punctum-walkthrough-abodid-shorter-duration.gif",
      image: "https://jwipqbjxpmgyevfzpjjx.supabase.co/storage/v1/object/public/misc/gif/punctum-walkthrough-abodid-shorter-duration.gif",
      alt: "Animated walkthrough of the Punctum human-attention research prototype",
    }
  : undefined;
const availableHeroSlides = [
  ...(punctumWalkthroughSlide ? [punctumWalkthroughSlide] : []),
  ...content.projects.map((project: any) => ({
    ...project,
    ...(heroSlideCopy[project.id] || {}),
  })),
];
const heroSlideOrder = [
  "into-the-flux",
  "punctum",
  "punctum-walkthrough",
  "gesture-control",
  "obsidian-vault",
  "show-me-the-way",
];
const heroSlides = heroSlideOrder
  .map((id) => availableHeroSlides.find((slide: any) => slide.id === id))
  .filter(Boolean);
const letterboxedHeroSlideIds = new Set(["gesture-control", "punctum-walkthrough"]);

const title = "Creative Direction, Technology & Experience Design";
const description =
  "Work with Abodid Sahoo across creative direction, interactive prototyping, visual documentation, and creative leadership for cultural experiences, institutions, and ambitious teams.";
const contactHref = "/#enquiry";

const engagements = [
  {
    number: "01",
    title: "Creative Direction",
    summary:
      "Shaping research, narrative, space and interaction into one coherent public experience.",
    areas: ["Exhibitions and installations", "Early-stage concepts", "Participatory experiences"],
    proof: "Into the Flux · 10,000+ visitors",
    href: "/blog/from-an-abandoned-garage-into-the-hottest-exhibition-spot-in-london-in-just-two-days",
    tone: "yellow",
  },
  {
    number: "02",
    title: "Digital Prototyping",
    summary:
      "Turning complex ideas into intuitive digital experiences people can explore, question and contribute to.",
    areas: ["Interactive storytelling", "Creative technology", "Research and knowledge systems"],
    proof: "Punctum · Live participatory experiment",
    href: "/research/punctum",
    tone: "pink",
  },
  {
    number: "03",
    title: "Visual Documentation",
    summary:
      "Creating photography and film that preserves atmosphere while helping organisations communicate with clarity.",
    areas: ["Cultural documentation", "Films and campaigns", "Editorial storytelling"],
    proof: "BFI London · 20,000+ visitors across four days",
    href: "/photography/british-film-institute-london",
    tone: "lime",
  },
  {
    number: "04",
    title: "Creative Leadership",
    summary:
      "Building the teams, production workflows and reusable systems that help ambitious creative work scale.",
    areas: ["Creative team direction", "Cross-disciplinary workflows", "Scalable production systems"],
    proof: "RCA exhibitions · 10+ spaces / 700+ students",
    href: "/experience",
    tone: "orange",
  },
];

const evidence = [
  { figure: "6+", label: "Years directing film and exhibition work" },
  { figure: "10+", label: "Exhibition spaces delivered at the RCA" },
  { figure: "700+", label: "Students supported through show production" },
  { figure: "India ↔ UK", label: "Cross-cultural creative practice" },
];

const heroTestimonials = [
  {
    quote:
      "Abodid has not only created stellar videos but has always elevated the brand voice, visual storytelling and overall look and feel!",
    name: "Saunak Shah",
    role: "Creative Director · Pursuit of Portraits, NYC",
  },
  {
    quote:
      "Abodid made sure the visual storytelling of the film was aptly aligned to the brand's voice.",
    name: "Pranjal Agrawal",
    role: "Founder & CEO · Hermosa Design Studio",
  },
  {
    quote: "Abodid and his team have literally been a breath of fresh air to work with.",
    name: "Alonzo",
    role: "Singer-Songwriter · Los Angeles",
  },
  {
    quote:
      "He helped me think differently about how to actually build a story — how shots work together, where to make cuts, and how to use pacing.",
    name: "Mitch Longe",
    role: "Travel Filmmaker · Australia",
  },
  {
    quote:
      "Each session is carefully prepared and adapted to suit my learning needs, making the lessons both focused and effective.",
    name: "Michael",
    role: "Filmmaker · London",
  },
];

const structuredData = [
  personJsonLd(),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Work together", path: "/services" },
  ]),
  serviceJsonLd({
    path: "/services",
    name: "Creative Direction, Interactive Prototyping, and Experience Design",
    description,
    serviceType:
      "Creative direction, interactive prototyping, visual documentation, and creative leadership systems",
  }),
];
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
  fullWidth={true}
  hideHeader={true}
  hideFooter={true}
  hideWhatsAppButton={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="story-services-page"
>
  <header class="services-nav">
    <a class="services-nav__brand" href="/" aria-label="Abodid Sahoo homepage">abodid.com</a>
    <nav class="services-nav__links" aria-label="Primary navigation">
      <a href="/#selected-work">Work</a>
      <a href="/research">Research</a>
      <a href="/services" class="is-active">Services</a>
      <a href="/experience">Experience</a>
      <a href="/about">About</a>
    </nav>
    <a class="services-nav__contact" href={contactHref}>
      Hire me <span aria-hidden="true">↗</span>
    </a>
    <details class="services-nav__mobile">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        <a href="/#selected-work">Work</a>
        <a href="/research">Research</a>
        <a href="/services" class="is-active">Services</a>
        <a href="/experience">Experience</a>
        <a href="/about">About</a>
        <a href={contactHref}>Hire me ↗</a>
      </nav>
    </details>
  </header>

  <main class="services-main">
    <section class="services-hero" aria-labelledby="services-heading">
      <div class="services-hero__copy">
        <div class="services-hero__topline">
          <p class="services-eyebrow">Ways to work together</p>
          <p class="services-availability">London · Bengaluru</p>
        </div>
        <h1 id="services-heading">
          Available for creative leadership and media production roles.
        </h1>
        <p class="services-hero__lede">
          I partner with institutions, brands, artists and creative teams.
        </p>
        <p class="services-hero__fit">
          Together, we shape exhibitions, interactive experiences, films and cultural documentation
          from early concept to public delivery.
        </p>
        <a class="services-button" href={contactHref}>
          Start a conversation <span aria-hidden="true">↗</span>
        </a>
      </div>

      <aside class="services-hero__showcase" aria-label="Selected work and client feedback">
        <div class="services-hero__visual" aria-label="Selected projects showcase" data-hero-slider>
          <div class="services-hero__slider-track" role="region" aria-label="Featured projects carousel" aria-live="polite">
            {heroSlides.map((project, index) => (
              <a
                class={`services-hero__slide ${letterboxedHeroSlideIds.has(project.id) ? "services-hero__slide--letterboxed" : ""} ${index === 0 ? "is-active" : ""}`}
                href={project.href}
                data-hero-slide={index}
                aria-hidden={index === 0 ? "false" : "true"}
                tabindex={index === 0 ? "0" : "-1"}
              >
                {project.heroImage ? (
                  <img
                    src={project.heroImage}
                    alt={project.alt}
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                    decoding={index === 0 ? "sync" : "async"}
                  />
                ) : project.video ? (
                  <video
                    src={project.video}
                    poster={project.image}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    aria-label={project.alt}
                  />
                ) : (
                  <img
                    src={project.image}
                    alt={project.alt}
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                    decoding={index === 0 ? "sync" : "async"}
                  />
                )}
                <span>
                  <b>{project.title}</b>
                  <small>{project.category} · {project.outcome}</small>
                </span>
              </a>
            ))}
          </div>
        </div>

        <div class="services-hero__testimonial" data-services-testimonials>
          <p class="services-eyebrow">What collaborators say</p>
          <div class="services-testimonial__slides" aria-live="polite">
            {heroTestimonials.map((testimonial, index) => (
              <blockquote data-testimonial-slide hidden={index !== 0}>
                <p>“{testimonial.quote}”</p>
                <footer>
                  <strong>{testimonial.name}</strong>
                  <span>{testimonial.role}</span>
                </footer>
              </blockquote>
            ))}
          </div>
          <div class="services-testimonial__controls">
            <span data-testimonial-count>01 / {String(heroTestimonials.length).padStart(2, "0")}</span>
            <div>
              <button type="button" data-testimonial-previous aria-label="Previous testimonial">←</button>
              <button type="button" data-testimonial-next aria-label="Next testimonial">→</button>
            </div>
          </div>
        </div>
      </aside>
    </section>

    <section class="services-engagements" aria-labelledby="engagements-heading">
      <header class="services-section-heading">
        <h2 id="engagements-heading">Hire me for</h2>
      </header>

      <div class="services-engagements__grid">
        {engagements.map((engagement) => (
          <article class={`services-engagement services-engagement--${engagement.tone}`}>
            <div class="services-engagement__title">
              <span>{engagement.number}</span>
              <h3>{engagement.title}</h3>
            </div>
            <p class="services-engagement__summary">{engagement.summary}</p>
            <ul>
              {engagement.areas.map((area) => <li>{area}</li>)}
            </ul>
            <a href={engagement.href}>
              <span>{engagement.proof}</span>
              <b aria-hidden="true">↗</b>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="services-evidence" aria-labelledby="evidence-heading">
      <div class="services-evidence__statement">
        <p class="services-eyebrow">The thread through the work</p>
        <h2 id="evidence-heading">From research and team alignment to the final public encounter.</h2>
        <p>
          I connect the creative, technical and operational parts of a project so that teams can
          move with confidence and the audience experiences one coherent idea.
        </p>
      </div>
      <dl class="services-evidence__stats">
        {evidence.map((item) => (
          <div>
            <dt>{item.figure}</dt>
            <dd>{item.label}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="services-cta" aria-labelledby="cta-heading">
      <p class="services-eyebrow">Role, team or early idea</p>
      <h2 id="cta-heading">Let’s work it out.</h2>
      <p>
        Bring the brief, the unresolved question or the ambitious half-formed idea. We can start there.
      </p>
      <a class="services-button services-button--cream" href={contactHref}>
        Start a conversation <span aria-hidden="true">↗</span>
      </a>
    </section>
  </main>

  <!-- Global Story Footer -->
  <footer class="story-footer" aria-label="Site directory and footer">
    <div class="story-footer__grid">
      <div class="story-footer__card story-footer__card--work">
        <div class="story-footer__card-header">
          <h3 class="story-footer__title">Work</h3>
          <span class="story-footer__index">01</span>
        </div>
        <nav aria-label="Work links">
          <a href="/work">All Projects <span aria-hidden="true">↗</span></a>
          <a href="/research">Research <span aria-hidden="true">↗</span></a>
          <a href="/photography">Photography <span aria-hidden="true">↗</span></a>
          <a href="/films">Filmmaking <span aria-hidden="true">↗</span></a>
          <a href="/blog">Writing <span aria-hidden="true">↗</span></a>
        </nav>
      </div>

      <div class="story-footer__card story-footer__card--curation">
        <div class="story-footer__card-header">
          <h3 class="story-footer__title">Curation</h3>
          <span class="story-footer__index">02</span>
        </div>
        <nav aria-label="Curation links">
          <a href="/resources">Resource Hub <span aria-hidden="true">↗</span></a>
          <a href="/moodboard">Visual Moodboard <span aria-hidden="true">↗</span></a>
          <a href="/xr-showcase">XR Showcase <span aria-hidden="true">↗</span></a>
          <a href="/curated-videos">Must Watch Videos <span aria-hidden="true">↗</span></a>
          <a href="/research/obsidian-vault">Obsidian Vault <span aria-hidden="true">↗</span></a>
        </nav>
      </div>

      <div class="story-footer__card story-footer__card--workshops">
        <div class="story-footer__card-header">
          <h3 class="story-footer__title">Workshops</h3>
          <span class="story-footer__index">03</span>
        </div>
        <nav aria-label="Workshops links">
          <a href="/obsidian-tutoring">Obsidian Tutoring <span aria-hidden="true">↗</span></a>
          <a href="/premiere-pro-masterclass">Video Editing Masterclass <span aria-hidden="true">↗</span></a>
          <a href="/workshops">Photography <span aria-hidden="true">↗</span></a>
          <a href="/workshops/video-editing-storytelling-class-1">Filmmaking <span aria-hidden="true">↗</span></a>
          <a href="/workshops">Autoethnography <span aria-hidden="true">↗</span></a>
        </nav>
      </div>

      <div class="story-footer__card story-footer__card--about">
        <div class="story-footer__card-header">
          <h3 class="story-footer__title">About</h3>
          <span class="story-footer__index">04</span>
        </div>
        <nav aria-label="About links">
          <a href="/about">About <span aria-hidden="true">↗</span></a>
          <a href="/awards">Awards <span aria-hidden="true">↗</span></a>
          <a href="/press">Press Mentions <span aria-hidden="true">↗</span></a>
          <a href="/manifesto">Manifesto <span aria-hidden="true">↗</span></a>
          <a href={CV_DOWNLOAD_URL} target="_blank" rel="noopener noreferrer">Resume <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </div>

    <div class="story-footer__bottom-card">
      <div class="story-footer__brand-group">
        <a class="story-footer__brand" href="/" aria-label="Abodid Sahoo homepage">abodid.com</a>
        <span class="story-footer__copyright">© {new Date().getFullYear()} Abodid Sahoo. All rights reserved.</span>
      </div>

      <div class="story-footer__social">
        <a href="https://www.instagram.com/abodid.sahoo" target="_blank" rel="noopener noreferrer">Instagram ↗</a>
        <a href="https://uk.linkedin.com/in/abodidsahoo" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a href="https://vimeo.com/abodidsahoo" target="_blank" rel="noopener noreferrer">Vimeo ↗</a>
        <a href="https://github.com/abodidsahoo" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>

      <div class="story-footer__legal">
        <a href="/privacy">Privacy Policy</a>
        <span aria-hidden="true">·</span>
        <a href="/sitemap">Sitemap</a>
        <span aria-hidden="true">·</span>
        <a href="/architecture">Architecture</a>
      </div>
    </div>
  </footer>

  <script>
    const initialiseServicesTestimonials = () => {
      document.querySelectorAll("[data-services-testimonials]").forEach((root) => {
        if (!(root instanceof HTMLElement) || root.dataset.initialised === "true") return;

        const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-testimonial-slide]"));
        const count = root.querySelector<HTMLElement>("[data-testimonial-count]");
        const previous = root.querySelector<HTMLButtonElement>("[data-testimonial-previous]");
        const next = root.querySelector<HTMLButtonElement>("[data-testimonial-next]");
        if (slides.length < 2 || !count || !previous || !next) return;

        root.dataset.initialised = "true";
        let activeIndex = 0;
        let timer = 0;

        const show = (nextIndex: number) => {
          activeIndex = (nextIndex + slides.length) % slides.length;
          slides.forEach((slide, index) => {
            slide.hidden = index !== activeIndex;
          });
          count.textContent = `${String(activeIndex + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
        };

        const stop = () => window.clearInterval(timer);
        const start = () => {
          stop();
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          timer = window.setInterval(() => show(activeIndex + 1), 6000);
        };

        previous.addEventListener("click", () => {
          show(activeIndex - 1);
          start();
        });
        next.addEventListener("click", () => {
          show(activeIndex + 1);
          start();
        });
        root.addEventListener("mouseenter", stop);
        root.addEventListener("mouseleave", start);
        root.addEventListener("focusin", stop);
        root.addEventListener("focusout", start);
        start();
      });
    };

    const initialiseHeroSlider = () => {
      const slider = document.querySelector("[data-hero-slider]");
      if (!slider) return;

      const slides = Array.from(slider.querySelectorAll<HTMLElement>("[data-hero-slide]"));
      if (slides.length <= 1) return;

      let currentIndex = 0;
      let timer: number | null = null;
      const INTERVAL_MS = 3800;

      const goToSlide = (nextIndex: number) => {
        const targetIndex = (nextIndex + slides.length) % slides.length;
        if (targetIndex === currentIndex) return;

        slides[currentIndex]?.classList.remove("is-active");
        slides[currentIndex]?.setAttribute("aria-hidden", "true");
        slides[currentIndex]?.setAttribute("tabindex", "-1");

        currentIndex = targetIndex;

        slides[currentIndex]?.classList.add("is-active");
        slides[currentIndex]?.setAttribute("aria-hidden", "false");
        slides[currentIndex]?.setAttribute("tabindex", "0");
      };

      const startTimer = () => {
        stopTimer();
        timer = window.setInterval(() => {
          goToSlide(currentIndex + 1);
        }, INTERVAL_MS);
      };

      const stopTimer = () => {
        if (timer) {
          window.clearInterval(timer);
          timer = null;
        }
      };

      // Touch swipe gestures
      let touchStartX = 0;
      slider.addEventListener(
        "touchstart",
        (e: TouchEvent) => {
          touchStartX = e.changedTouches && e.changedTouches[0] ? e.changedTouches[0].screenX : 0;
        },
        { passive: true },
      );

      slider.addEventListener(
        "touchend",
        (e: TouchEvent) => {
          const touchEndX = e.changedTouches && e.changedTouches[0] ? e.changedTouches[0].screenX : 0;
          const diff = touchStartX - touchEndX;
          if (Math.abs(diff) > 40) {
            if (diff > 0) {
              goToSlide(currentIndex + 1);
            } else {
              goToSlide(currentIndex - 1);
            }
            startTimer();
          }
        },
        { passive: true },
      );

      slider.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "ArrowLeft") {
          goToSlide(currentIndex - 1);
          startTimer();
        } else if (e.key === "ArrowRight") {
          goToSlide(currentIndex + 1);
          startTimer();
        }
      });

      slider.addEventListener("mouseenter", stopTimer);
      slider.addEventListener("mouseleave", startTimer);

      startTimer();
    };

    const initialiseServicesPage = () => {
      initialiseServicesTestimonials();
      initialiseHeroSlider();
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initialiseServicesPage, { once: true });
    } else {
      initialiseServicesPage();
    }
    document.addEventListener("astro:page-load", initialiseServicesPage);
  </script>
</BaseLayout>

<style is:global>
  :root {
    --services-blue: #2444ca;
    --services-pink: #ff7eb5;
    --services-yellow: #ffe44f;
    --services-lime: #caff48;
    --services-orange: #ff875c;
    --services-purple: #5524c7;
    --services-cream: #fff8e8;
    --services-ink: #15130f;
    --services-border: rgba(21, 19, 15, 0.78);
    --services-gutter: clamp(1rem, 3vw, 3.5rem);
    --services-gap: 8px;
    --services-radius-panel: clamp(18px, 2vw, 28px);
    --services-radius-card: clamp(14px, 1.5vw, 22px);
    --services-radius-control: 14px;
  }

  body.story-services-page {
    margin: 0;
    padding: 0 !important;
    background: var(--services-blue) !important;
    color: var(--services-ink);
  }

  body.story-services-page main.page-content-full { overflow: visible; }
  body.story-services-page :is(h1, h2, h3, p, ul, dl, dd, figure) { margin-top: 0; }
  body.story-services-page :is(a, summary) { -webkit-tap-highlight-color: transparent; }
  body.story-services-page a:hover,
  body.story-services-page a:focus-visible { color: inherit; text-decoration: none; }
  body.story-services-page a:focus-visible,
  body.story-services-page summary:focus-visible {
    outline: 4px solid var(--services-purple);
    outline-offset: 3px;
  }

  .services-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    min-height: 72px;
    padding: 0 var(--services-gutter);
    display: grid;
    grid-template-columns: minmax(140px, 1fr) auto minmax(220px, 1fr);
    align-items: center;
    gap: 1.5rem;
    background: var(--services-blue);
    color: var(--services-cream);
  }

  .services-nav a,
  .services-nav summary {
    color: inherit;
    font: 700 .72rem/1 var(--font-mono, monospace);
    letter-spacing: .08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .services-nav__brand {
    width: fit-content;
    min-height: 42px;
    padding: 0 .9rem;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--services-ink);
    border-radius: var(--services-radius-control);
    background: var(--services-yellow);
    color: var(--services-ink) !important;
  }

  .services-nav__links { display: flex; align-items: center; gap: clamp(1.2rem, 2.5vw, 2.5rem); }
  .services-nav__links a { opacity: 1; transition: text-decoration-color 160ms ease; }
  .services-nav__links a.is-active,
  .services-nav__mobile nav a.is-active {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }
  .services-nav__links a:hover,
  .services-nav__links a:focus-visible {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  .services-nav__contact {
    justify-self: end;
    min-height: 44px;
    padding: 0 1rem;
    display: inline-flex;
    align-items: center;

---
import BaseLayout from "../layouts/BaseLayout.astro";
import InlineInquiryForm from "../components/InlineInquiryForm.astro";
import Newsletter from "../components/Newsletter.astro";
import LandingInteractiveHero from "../components/LandingInteractiveHero.jsx";
import { getRecentPosts } from "../lib/api";
import {
  cloudflareExhibitionFallbacks,
  getHomeStorytellingContent,
} from "../lib/homeStorytellingContent";
import {
  personJsonLd,
  websiteJsonLd,
  breadcrumbJsonLd,
  serviceJsonLd,
} from "../lib/seoData";

const content = await getHomeStorytellingContent();
const journalArticles = (await getRecentPosts()).slice(0, 3);
// Desktop rows always have two cards; omit a trailing project without a partner.
const selectedWorkProjects = content.projects.slice(
  0,
  content.projects.length - (content.projects.length % 2),
);
const curatedBrandOrder = [
  { match: "apple", name: "Apple", role: "Creative Technology" },
  { match: "outernet", name: "Outernet", role: "Immersive Venue" },
  {
    match: "rca",
    name: "Royal College of Art",
    role: "Spatial Media & Exhibitions",
  },
  { match: "iba", name: "IBA", role: "Spatial & Exhibition Design" },
  { match: "nid", name: "NID", role: "Design Research" },
  { match: "vh1", name: "VH1", role: "Broadcast Music Video" },
  { match: "bfi", name: "BFI", role: "Cultural Documentation" },
  { match: "wieden", name: "WK", role: "Creative Direction" },
  { match: "hermosa", name: "Hermosa Studio", role: "Brand Film" },
  {
    match: "furnmill",
    name: "Furnmill",
    role: "Executive Producer & Director",
  },
  {
    match: "pursuit",
    name: "Pursuit of Portraits",
    role: "Visual Storytelling",
  },
  { match: "uniqlo", name: "Uniqlo", role: "Brand Campaign" },
  { match: "frameless", name: "Frameless", role: "Immersive Venue" },
  { match: "budweiser", name: "Budweiser", role: "Film & Visual Direction" },
  { match: "rolling", name: "Rolling Stone", role: "Editorial Feature" },
  { match: "odisha", name: "Odisha Tourism", role: "Visual Storytelling" },
  { match: "unilever", name: "Unilever", role: "Creative Consultant" },
  {
    match: "grand hyatt",
    name: "Grand Hyatt",
    role: "Video Production & Editing",
  },
];

const featuredBrands = curatedBrandOrder.map((item, index) => {
  const existing = content.brands.find(
    (b: any) =>
      String(b.name || "")
        .toLowerCase()
        .includes(item.match) ||
      String(b.id || "")
        .toLowerCase()
        .includes(item.match),
  );
  const name = item.name;
  const role = existing?.role || item.role;
  const pillChars = Math.max(name.length, role.length);
  const pillSize = pillChars >= 18 ? "medium" : "small";

  return {
    id: existing?.id || `brand-${index}-${item.match}`,
    name,
    role,
    pillSize,
  };
});

const testimonialPriority = ["saunak", "pranjal", "alonzo", "michael", "mitch"];
const featuredTestimonials = testimonialPriority
  .map((token) =>
    content.testimonials.find((testimonial) =>
      String(testimonial.name || "")
        .toLowerCase()
        .includes(token),
    ),
  )
  .filter(Boolean);
const title = "Abodid Sahoo — Creative Director, Artist & Researcher in London";
const description = content.hero.lede;

const workWithMeCards = [
  {
    title: "Exhibitions & Interactive Experiences",
    description:
      "I build exhibitions and immersive storytelling spaces using photographs, film, performance, AI, AR, VR and XR. I’ve built more than 30 exhibition experiences (both digital and physical) in London in the last three years.",
    examples: [
      { label: "Into the Flux", href: "/work/into-the-flux" },
      { label: "Punctum", href: "/work/punctum" },
      { label: "Sequence Room", href: "/work/sequence-room" },
    ],
  },
  {
    title: "Photography & Visual Documentation",
    description:
      "With over 8 years of experience in documenting art exhibitions, galleries, and immersive spaces, I absolutely love capturing the details that bring the true essence of the experience to life through the photographs.",
    examples: [
      {
        label: "Outernet London 2025",
        href: "/photography/outernet-london-2025",
      },
      {
        label: "British Film Institute",
        href: "/photography/british-film-institute-london",
      },
    ],
  },
  {
    title: "Creative Direction & Production",
    description:
      "For over eight years, I’ve led the production of commercials, brand films, music videos, dance videos, short films and photo stories that are experimental, tasteful and made to have an impact.",
    examples: [
      {
        label: "Hermosa Design Studio film",
        href: "https://www.youtube.com/watch?v=EMsZT9PCFms",
        external: true,
      },
      {
        label: "Budweiser film",
        href: "https://www.weareanimal.co/budweiser-streetwear",
        external: true,
      },
    ],
  },
  {
    title: "Research & Knowledge Systems",
    description:
      "I love being a second brain for ambitious ideas, helping you think them through and articulate them clearly. I also teach Obsidian workshops that help you take better notes and put your knowledge to work.",
    examples: [{ label: "Obsidian Vault", href: "/obsidian-vault" }],
  },
];

const structuredData = [
  personJsonLd(),
  websiteJsonLd(),
  breadcrumbJsonLd([{ name: "Home", path: "/" }]),
  serviceJsonLd({
    path: "/",
    name: "Creative Direction, Spatial & Interactive Experiences",
    description,
    serviceType:
      "Creative Direction, Exhibition & Experience Design, Autoethnography, Cultural Storytelling",
  }),
];
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
  fullWidth={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="story-home-page"
>
  <main class="story-home">
    <LandingInteractiveHero
      client:load
      name="Abodid Sahoo"
      keyline="Creative Technologist, Immersive Experience Designer and Visual Artist working between London and India"
      ctaText="Explore selected work"
      ctaHref="#selected-work"
      secondaryCtaText="Work with me"
      secondaryCtaHref="#enquiry"
      vaultLabel="my obsidian vault"
    />

    <section
      class="story-work"
      id="selected-work"
      aria-labelledby="selected-work-heading"
    >
      <h2 class="story-work__heading" id="selected-work-heading">
        Selected work
      </h2>
      <div class="story-work__grid">
        {
          selectedWorkProjects.map((project) => (
            <a
              class={`story-project story-project--${project.id}`}
              href={project.href}
              data-accent={project.accent || "pink"}
            >
              <figure>
                {project.heroImage ? (
                  <img
                    src={project.heroImage}
                    alt={project.alt}
                    loading="lazy"
                    decoding="async"
                  />
                ) : project.video &&
                  /\.(mp4|webm)(?:[?#]|$)/i.test(project.video) ? (
                  <video
                    src={project.video}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="auto"
                    aria-label={project.alt}
                  />
                ) : (
                  <img
                    src={project.image || project.video}
                    alt={project.alt}
                    loading="lazy"
                    decoding="async"
                    data-cloudflare-fallback
                  />
                )}
              </figure>
              <div class="story-project__copy" data-auto-contrast>
                <p class="story-project__category">{project.category}</p>
                <h3>{project.title}</h3>
                <p class="story-project__summary">{project.summary}</p>
                {project.themes?.length ? (
                  <ul
                    class="story-project__themes"
                    aria-label={`${project.title} themes`}
                  >
                    {project.themes.map((theme) => (
                      <li>{theme}</li>
                    ))}
                  </ul>
                ) : null}
                <dl>
                  <div>
                    <>
                      <dt>Role</dt>
                      <dd>{project.role}</dd>
                    </>
                  </div>
                  <div>
                    <>
                      <dt>Outcome</dt>
                      <dd>{project.outcome}</dd>
                    </>
                  </div>
                </dl>
                <span class="story-project__link">
                  <span>View project</span>{" "}
                  <b class="link-destination-arrow" aria-hidden="true">
                    ↗
                  </b>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section
      class="story-evidence"
      aria-labelledby="story-evidence-heading"
      data-auto-contrast
    >
      <header>
        <p class="story-eyebrow">Selected organisations</p>
        <h2 id="story-evidence-heading">Trusted by</h2>
        <a href="/experience"
          ><span class="link-label">View professional experience</span>
          <span class="link-destination-arrow" aria-hidden="true">↗</span></a
        >
      </header>
      <ul class="story-brands" aria-label="Clients and collaborators">
        {
          featuredBrands.map((brand) => (
            <li
              class="story-brand-pill"
              data-pill-size={brand.pillSize}
              data-auto-contrast
            >
              <span class="story-brand-pill__mask">
                <span class="story-brand-pill__track">
                  <strong>{brand.name}</strong>
                  <span>{brand.role || "Client or collaborator"}</span>
                </span>
              </span>
            </li>
          ))
        }
      </ul>
      {
        featuredTestimonials.length > 0 && (
          <div class="story-quotes" aria-label="Testimonials">
            {featuredTestimonials.map((testimonial, index) => {
              const shortQuote =
                testimonial.highlightQuote || testimonial.content;
              const hasMore =
                String(shortQuote).trim() !==
                String(testimonial.content).trim();
              return (
                <blockquote
                  class={`story-quote story-quote--${index + 1}`}
                  data-testimonial-card
                  data-auto-contrast
                >
                  <div class="story-quote__content">
                    <div class="story-quote__short">
                      <p>“{shortQuote}”</p>
                    </div>
                    <div
                      class="story-quote__full"
                      aria-hidden="true"
                      data-at-top="true"
                    >
                      <p>“{testimonial.content}”</p>
                    </div>
                  </div>
                  <footer>
                    <strong>{testimonial.name}</strong>
                    <span>
                      {[testimonial.role, testimonial.company]
                        .filter(Boolean)
                        .join(" · ")}
                    </span>
                  </footer>
                  {hasMore && (
                    <button
                      type="button"
                      class="story-quote__toggle"
                      data-testimonial-toggle
                      aria-expanded="false"
                    >
                      <span data-toggle-label>Read the full testimonial</span>
                      <b aria-hidden="true">→</b>
                    </button>
                  )}
                </blockquote>
              );
            })}
          </div>
        )
      }
    </section>

    <section
      class="story-services"
      id="services"
      aria-labelledby="story-services-heading"
      data-auto-contrast
    >
      <header class="story-section-heading story-section-heading--dark-text">
        <p class="story-eyebrow">Ways to work together</p>
        <h2 id="story-services-heading">Work with me</h2>
      </header>
      <div class="story-services__intro" data-auto-contrast>
        <figure class="story-services__portrait">
          <img
            src="https://assets.abodid.com/photos/variants/landing-page-01/800/35-img-0652-edited-comp-0200b8a693.webp"
            alt="Abodid Sahoo"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="story-services__intro-copy">
          <p class="story-services__intro-lead">
            I turn ambitious ideas and stories into intuitive, accessible
            participatory experiences.
          </p>
          <p>
            Over the past eight years, I’ve worked on more than 300 exhibitions,
            installations, films, photo stories and digital experiences. My
            research-driven work is designed to spark conversations and help
            people connect.
          </p>
        </div>
      </div>

      <div class="story-services__cards">
        {
          workWithMeCards.map((card) => (
            <article class="story-services__card" data-auto-contrast>
              <h3>{card.title}</h3>
              <div class="story-services__card-body">
                <p>{card.description}</p>
                <div class="story-services__examples">
                  <p class="story-services__examples-label">Selected work</p>
                  <ul>
                    {card.examples.map((example) => (
                      <li>
                        <a
                          class="story-services__example-link"
                          href={example.href}
                          target={example.external ? "_blank" : undefined}
                          rel={example.external ? "noreferrer" : undefined}
                        >
                          <span>{example.label}</span>
                          <span
                            class="story-services__example-arrow link-destination-arrow"
                            aria-hidden="true"
                          >
                            ↗
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div class="story-services__cta">
        <a class="story-button story-button--primary" href="#enquiry">
          <span>Start a conversation</span>
          <b aria-hidden="true">→</b>
        </a>
      </div>
    </section>

    <section class="story-enquiry" aria-label="Project enquiry">
      <InlineInquiryForm
        id="enquiry"
        heading="Let’s connect."
        intro="Got an idea you badly want to execute or have a photoshoot in mind and you want to have someone you can trust?"
        sourceName="home-next-storytelling"
        variant="pop"
        interestOptions={[
          "Creative direction and experience design",
          "Exhibition or installation",
          "Storytelling product or prototype",
          "Photography, film or cultural documentation",
          "Ecosystem mapping or creative consulting",
          "Speaking, teaching or workshop",
          "Something else",
        ]}
      />
    </section>

    <section
      class="story-writing"
      id="writing"
      aria-labelledby="morning-digest-heading"
      data-auto-contrast
    >
      <div class="story-writing__inner">
        <article
          class="story-writing__panel story-writing__newsletter"
          data-auto-contrast
        >
          <p class="story-eyebrow">Weekly newsletter</p>
          <h2 class="story-writing__title" id="morning-digest-heading">
            Subscribe to my Morning Digest.
          </h2>
          <p class="story-writing__description">
            A curated set of 7 unmissable must-read articles and resources on
            creative technology, digital media and art exhibitions. Delivered in
            your mailbox every week.
          </p>
          <Newsletter
            showName={true}
            nameRequired={true}
            buttonLabel="Subscribe"
            source="footer-newsletter"
          />
        </article>

        <article
          class="story-writing__panel story-writing__blog"
          data-auto-contrast
        >
          <p class="story-eyebrow">From the journal</p>
          <h2 class="story-writing__title">
            Want to read articles written by me?
          </h2>
          <ul class="story-writing__articles" aria-label="Recent articles">
            {
              journalArticles.map((article, index) => (
                <li>
                  <a href={article.href} class="story-writing__article-link">
                    <span class="story-writing__article-index" aria-hidden="true">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <span class="story-writing__article-title">{article.title}</span>
                    <span class="story-writing__article-arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="story-writing__blog-link" href="/blog">
            <span>Go to my blog page</span>
            <span class="story-writing__blog-arrow" aria-hidden="true">→</span>
          </a>
        </article>
      </div>
    </section>
  </main>

  <script is:inline define:vars={{ cloudflareExhibitionFallbacks }}>
    (() => {
      const localSafetyImage = "/images/exhibition-image-fallback.svg";
      const fallbackPool = Array.isArray(cloudflareExhibitionFallbacks)
        ? cloudflareExhibitionFallbacks.filter(Boolean)
        : [];

      document
        .querySelectorAll("img[data-cloudflare-fallback]")
        .forEach((image) => {
          const startAt = fallbackPool.length
            ? Math.floor(Math.random() * fallbackPool.length)
            : 0;

          const useNextFallback = () => {
            const attempt = Number(image.dataset.fallbackAttempt || "0");
            const currentUrl = image.currentSrc || image.src;

            for (
              let offset = attempt;
              offset < fallbackPool.length;
              offset += 1
            ) {
              const candidate =
                fallbackPool[(startAt + offset) % fallbackPool.length];
              image.dataset.fallbackAttempt = String(offset + 1);
              if (candidate && candidate !== currentUrl) {
                image.src = candidate;
                return;
              }
            }

            if (!image.dataset.localSafetyApplied) {
              image.dataset.localSafetyApplied = "true";
              image.src = localSafetyImage;
            }
          };

          image.addEventListener("error", useNextFallback);
          image.addEventListener("load", () => {
            if (image.naturalWidth < 2 || image.naturalHeight < 2)
              useNextFallback();
          });

          if (
            image.complete &&
            (image.naturalWidth < 2 || image.naturalHeight < 2)
          ) {
            useNextFallback();
          }
        });

      const parseRgb = (value) => {
        const hex = String(value)
          .trim()
          .match(/^#([0-9a-f]{6})$/i)?.[1];
        if (hex) {
          return [0, 2, 4].map((offset) =>
            parseInt(hex.slice(offset, offset + 2), 16),
          );
        }
        const channels =
          String(value)
            .match(/[\d.]+/g)
            ?.map(Number) || [];
        if (channels.length < 3 || (channels.length > 3 && channels[3] === 0))
          return null;
        return channels.slice(0, 3);
      };

      const luminance = (channels) =>
        channels
          .map((channel) => channel / 255)
          .map((channel) =>
            channel <= 0.03928
              ? channel / 12.92
              : ((channel + 0.055) / 1.055) ** 2.4,
          )
          .reduce(
            (sum, channel, index) =>
              sum + channel * [0.2126, 0.7152, 0.0722][index],
            0,
          );

      const contrast = (first, second) => {
        const lighter = Math.max(first, second);
        const darker = Math.min(first, second);
        return (lighter + 0.05) / (darker + 0.05);
      };

      const resolveForegrounds = () => {
        const rootStyles = getComputedStyle(document.documentElement);
        const inkColour =
          rootStyles.getPropertyValue("--pop-ink").trim() || "#15130f";
        const creamColour =
          rootStyles.getPropertyValue("--pop-cream").trim() || "#fff8e8";
        return {
          ink: {
            colour: inkColour,
            luminance: luminance(parseRgb(inkColour) || [21, 19, 15]),
          },
          cream: {
            colour: creamColour,
            luminance: luminance(parseRgb(creamColour) || [255, 248, 232]),
          },
        };
      };

      const applySurfaceContrast = () => {
        const { ink, cream } = resolveForegrounds();
        document.querySelectorAll("[data-auto-contrast]").forEach((surface) => {
          const background = parseRgb(
            getComputedStyle(surface).backgroundColor,
          );
          if (!background) return;
          const surfaceLuminance = luminance(background);
          const inkRatio = contrast(surfaceLuminance, ink.luminance);
          const creamRatio = contrast(surfaceLuminance, cream.luminance);
          const foreground = inkRatio >= creamRatio ? ink : cream;
          surface.style.setProperty("--surface-foreground", foreground.colour);
          surface.style.color = foreground.colour;
          surface.dataset.contrastRatio = Math.max(
            inkRatio,
            creamRatio,
          ).toFixed(2);
        });
      };

      const initialiseTestimonials = () => {
        document.querySelectorAll(".story-quote__full").forEach((fullQuote) => {
          if (
            !(fullQuote instanceof HTMLElement) ||
            fullQuote.dataset.scrollReady === "true"
          )
            return;
          fullQuote.dataset.scrollReady = "true";

          const updateScrollFade = () => {
            const hasOverflow =
              fullQuote.scrollHeight > fullQuote.clientHeight + 4;
            const isAtTop = fullQuote.scrollTop <= 4;
            const isAtBottom =
              fullQuote.scrollHeight -
                fullQuote.scrollTop -
                fullQuote.clientHeight <=
              4;
            fullQuote.dataset.hasOverflow = String(hasOverflow);
            fullQuote.dataset.atTop = String(isAtTop);
            fullQuote.dataset.atBottom = String(isAtBottom);
          };

          fullQuote.addEventListener("scroll", updateScrollFade, {
            passive: true,
          });
          requestAnimationFrame(updateScrollFade);
        });

        document
          .querySelectorAll("[data-testimonial-toggle]")
          .forEach((button) => {
            if (
              !(button instanceof HTMLButtonElement) ||
              button.dataset.ready === "true"
            )
              return;
            button.dataset.ready = "true";

            button.addEventListener("click", () => {
              const card = button.closest("[data-testimonial-card]");
              const fullQuote = card?.querySelector(".story-quote__full");
              const label = button.querySelector("[data-toggle-label]");
              if (
                !(card instanceof HTMLElement) ||
                !(fullQuote instanceof HTMLElement)
              )
                return;

              const willExpand =
                button.getAttribute("aria-expanded") !== "true";
              button.setAttribute("aria-expanded", String(willExpand));
              card.classList.toggle("is-expanded", willExpand);
              fullQuote.setAttribute("aria-hidden", String(!willExpand));
              if (label)
                label.textContent = willExpand
                  ? "Show less"
                  : "Read the full testimonial";

              if (willExpand) {
                fullQuote.scrollTop = 0;
                requestAnimationFrame(() => {
                  const hasOverflow =
                    fullQuote.scrollHeight > fullQuote.clientHeight + 4;
                  fullQuote.dataset.hasOverflow = String(hasOverflow);
                  fullQuote.dataset.atTop = "true";
                  fullQuote.dataset.atBottom = String(!hasOverflow);
                });
              }
            });
          });
      };

      const ensureVideosPlay = () => {
        document.querySelectorAll("video[autoplay]").forEach((element) => {
          if (!(element instanceof HTMLVideoElement)) return;
          const video = element;
          const playVideo = () => {
            if (video.paused) video.play().catch(() => {});
          };

          if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
            playVideo();
          } else {
            video.addEventListener("canplay", playVideo, { once: true });
            // Videos inserted by Astro's client-side page swap can retain their
            // src attribute without selecting/loading the media resource.
            if (video.readyState === HTMLMediaElement.HAVE_NOTHING)
              video.load();
          }

          if (video.dataset.viewportPlaybackReady !== "true") {
            video.dataset.viewportPlaybackReady = "true";
            const observer = new IntersectionObserver(
              (entries) => {
                if (entries.some((entry) => entry.isIntersecting)) playVideo();
              },
              { threshold: 0.1 },
            );
            observer.observe(video);
          }
        });
      };

      const initialisePage = () => {
        applySurfaceContrast();
        window.addEventListener("design-tokens:loaded", applySurfaceContrast, {
          once: true,
        });
        initialiseTestimonials();
        ensureVideosPlay();
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initialisePage);
      } else {
        requestAnimationFrame(initialisePage);
      }
      document.addEventListener("astro:page-load", initialisePage);
      window.addEventListener("pageshow", ensureVideosPlay);
    })();
  </script>
</BaseLayout>

<style is:global>
  :root {
    --pop-border: rgba(21, 19, 15, 0.78);
    --story-ink: var(--pop-ink);
    --story-cream: var(--pop-cream);
    --story-paper: var(--pop-cream);
    --story-cobalt: var(--pop-blue);
    --story-coral: var(--pop-orange);
    --story-yellow: var(--pop-yellow);
    --story-green: var(--pop-lime);
    --story-line: rgba(21, 19, 15, 0.24);
    --story-gutter: clamp(1.35rem, 4vw, 4rem);
    --home-next-gap: clamp(1rem, 2vw, 1.5rem);
    --home-next-border: 1px solid var(--pop-border);
    --home-next-radius-panel: clamp(18px, 2vw, 28px);
    --home-next-radius-card: clamp(14px, 1.5vw, 22px);
    --home-next-radius-control: 14px;
    --home-next-radius-media: clamp(10px, 1.2vw, 16px);
    --home-next-card-inset: 10px;
    --home-next-control-height: 52px;
    --home-next-motion: 180ms ease;
    --home-next-hero-height: clamp(720px, calc(100svh - 112px), 1000px);

    /* Hero Typography Tokens */
    --home-next-hero-name-font: 720 clamp(2.8rem, 4.5vw, 5rem)/0.82
      var(--font-display, sans-serif);

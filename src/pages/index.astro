---
import BaseLayout from "../layouts/BaseLayout.astro";
import InlineInquiryForm from "../components/InlineInquiryForm.astro";
import Newsletter from "../components/Newsletter.astro";
import HeroVaultTagsCard from "../components/HeroVaultTagsCard";
import {
  cloudflareExhibitionFallbacks,
  getHomeStorytellingContent,
} from "../lib/homeStorytellingContent";
import {
  personJsonLd,
  websiteJsonLd,
  breadcrumbJsonLd,
  serviceJsonLd,
} from "../lib/seoData";

export const prerender = false;

const content = await getHomeStorytellingContent();
const heroSlideCopy: Record<string, { category: string; outcome: string }> = {
  "into-the-flux": {
    category: "Exhibition experience design",
    outcome: "10,000+ visitors",
  },
  punctum: {
    category: "Sociological research",
    outcome: "180,000+ images",
  },
  "gesture-control": {
    category: "Interaction prototype",
    outcome: "Interactive playful app",
  },
  "obsidian-vault": {
    category: "Knowledge ecosystem",
    outcome: "1,000+ interconnected notes",
  },
  "show-me-the-way": {
    category: "Music video",
    outcome: "Broadcast on VH1 & Rolling Stone",
  },
};
const punctumProject = content.projects.find((project) => project.id === "punctum");
const punctumWalkthroughSlide = punctumProject
  ? {
      ...punctumProject,
      id: "punctum-walkthrough",
      category: "Human attention analysis",
      outcome: "Interactive web application",
      heroImage: "https://jwipqbjxpmgyevfzpjjx.supabase.co/storage/v1/object/public/misc/gif/punctum-walkthrough-abodid-shorter-duration.gif",
      image: "https://jwipqbjxpmgyevfzpjjx.supabase.co/storage/v1/object/public/misc/gif/punctum-walkthrough-abodid-shorter-duration.gif",
      alt: "Animated walkthrough of the Punctum human-attention research prototype",
    }
  : undefined;
const availableHeroSlides = [
  ...(punctumWalkthroughSlide ? [punctumWalkthroughSlide] : []),
  ...content.projects.map((project) => ({
    ...project,
    ...heroSlideCopy[project.id],
  })),
];
const heroSlideOrder = [
  "into-the-flux",
  "punctum",
  "punctum-walkthrough",
  "gesture-control",
  "obsidian-vault",
  "show-me-the-way",
];
const heroSlides = heroSlideOrder
  .map((id) => availableHeroSlides.find((slide) => slide.id === id))
  .filter((slide): slide is (typeof availableHeroSlides)[number] => Boolean(slide));
const heroProject = heroSlides[0] || content.projects[0];
const letterboxedHeroSlideIds = new Set(["gesture-control", "punctum-walkthrough"]);

const curatedBrandOrder = [
  { match: "apple", name: "Apple", role: "Creative Technology" },
  { match: "outernet", name: "Outernet", role: "Immersive Venue" },
  { match: "rca", name: "Royal College of Art", role: "Spatial Media & Exhibitions" },
  { match: "iba", name: "IBA", role: "Spatial & Exhibition Design" },
  { match: "nid", name: "NID", role: "Design Research" },
  { match: "vh1", name: "VH1", role: "Broadcast Music Video" },
  { match: "bfi", name: "BFI", role: "Cultural Documentation" },
  { match: "wieden", name: "WK", role: "Creative Direction" },
  { match: "hermosa", name: "Hermosa Studio", role: "Brand Film" },
  { match: "furnmill", name: "Furnmill", role: "Executive Producer & Director" },
  { match: "pursuit", name: "Pursuit of Portraits", role: "Visual Storytelling" },
  { match: "uniqlo", name: "Uniqlo", role: "Brand Campaign" },
  { match: "frameless", name: "Frameless", role: "Immersive Venue" },
  { match: "budweiser", name: "Budweiser", role: "Film & Visual Direction" },
  { match: "rolling", name: "Rolling Stone", role: "Editorial Feature" },
  { match: "odisha", name: "Odisha Tourism", role: "Visual Storytelling" },
  { match: "unilever", name: "Unilever", role: "Creative Consultant" },
  { match: "grand hyatt", name: "Grand Hyatt", role: "Video Production & Editing" },
];

const featuredBrands = curatedBrandOrder.map((item, index) => {
  const existing = content.brands.find((b: any) =>
    String(b.name || "").toLowerCase().includes(item.match) ||
    String(b.id || "").toLowerCase().includes(item.match),
  );
  const name = item.name;
  const role = existing?.role || item.role;
  const pillChars = Math.max(name.length, role.length);
  const pillSize = pillChars >= 18 ? "medium" : "small";

  return {
    id: existing?.id || `brand-${index}-${item.match}`,
    name,
    role,
    pillSize,
  };
});

const testimonialPriority = ["saunak", "pranjal", "alonzo", "michael", "mitch"];
const featuredTestimonials = testimonialPriority
  .map((token) => content.testimonials.find((testimonial) =>
    String(testimonial.name || "").toLowerCase().includes(token),
  ))
  .filter(Boolean);
const title = "Abodid Sahoo — Creative Director, Artist & Researcher in London";
const description = content.hero.lede;

const structuredData = [
  personJsonLd(),
  websiteJsonLd(),
  breadcrumbJsonLd([{ name: "Home", path: "/" }]),
  serviceJsonLd({
    path: "/",
    name: "Creative Direction, Spatial & Interactive Experiences",
    description,
    serviceType: "Creative Direction, Exhibition & Experience Design, Autoethnography, Cultural Storytelling",
  }),
];
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
  fullWidth={true}
  hideWhatsAppButton={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="story-home-page"
>
  <link slot="head" rel="preload" as="image" href={heroProject.heroImage || heroProject.image} />

  <main class="story-home">
    <section class="story-hero" aria-labelledby="story-hero-heading">
      <div class="story-hero__copy" data-auto-contrast>
        <div class="story-hero__masthead">
          <p class="story-hero__name">{content.hero.name}</p>
          <p class="story-hero__availability">
            <img src="/images/map-pin.png" alt="" aria-hidden="true" />
            <span>{content.hero.location}</span>
          </p>
        </div>
        <h1 id="story-hero-heading" aria-label={`Abodid Sahoo — ${content.hero.heading}`}>
          <span class="sr-only">Abodid Sahoo — </span>{content.hero.heading}
        </h1>
        <p class="story-hero__statement">{content.hero.statement}</p>
        <p class="story-hero__lede">{content.hero.lede}</p>
        <div class="story-actions">
          <a class="story-button story-button--secondary" href="#enquiry">Let’s build together <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <aside class="story-hero__rail" aria-label="Featured work and future content">
        <div class="story-hero__visual" aria-label="Selected projects showcase" data-auto-contrast data-hero-slider>
          <div class="story-hero__slider-track" role="region" aria-label="Featured projects carousel" aria-live="polite">
            {heroSlides.map((project, index) => (
              <a
                class={`story-hero__slide ${letterboxedHeroSlideIds.has(project.id) ? "story-hero__slide--letterboxed" : ""} ${index === 0 ? "is-active" : ""}`}
                href={project.href}
                data-hero-slide={index}
                aria-hidden={index === 0 ? "false" : "true"}
                tabindex={index === 0 ? "0" : "-1"}
                data-auto-contrast
              >
                {project.heroImage ? (
                  <img
                    src={project.heroImage}
                    alt={project.alt}
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                    decoding={index === 0 ? "sync" : "async"}
                  />
                ) : project.video ? (
                  <video
                    src={project.video}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="auto"
                    aria-label={project.alt}
                  />
                ) : (
                  <img
                    src={project.image}
                    alt={project.alt}
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                    decoding={index === 0 ? "sync" : "async"}
                    data-cloudflare-fallback
                  />
                )}
                <span data-auto-contrast>
                  <b>{project.title}</b>
                  <small>{project.category} · {project.outcome}</small>
                </span>
              </a>
            ))}
          </div>
        </div>

        <HeroVaultTagsCard client:load />
      </aside>
    </section>

    <section class="story-work" id="selected-work" aria-label="Selected work">
      <div class="story-work__grid">
        {content.projects.map((project, index) => (
          <a class={`story-project story-project--${index + 1}`} href={project.href} data-auto-contrast>
            <figure>
              {project.heroImage ? (
                <img
                  src={project.heroImage}
                  alt={project.alt}
                  loading="lazy"
                  decoding="async"
                />
              ) : project.video ? (
                <video
                  src={project.video}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="auto"
                  aria-label={project.alt}
                />
              ) : (
                <img src={project.image} alt={project.alt} loading="lazy" decoding="async" data-cloudflare-fallback />
              )}
            </figure>
            <div class="story-project__copy">
              <p><span>{String(index + 1).padStart(2, "0")}</span>{project.category}</p>
              <h3>{project.title}</h3>
              <p class="story-project__summary">{project.summary}</p>
              <dl>
                <div><dt>Role</dt><dd>{project.role}</dd></div>
                <div><dt>Outcome</dt><dd>{project.outcome}</dd></div>
              </dl>
              <span class="story-project__link"><span>View project</span> <b aria-hidden="true">↗</b></span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="story-evidence" aria-labelledby="story-evidence-heading" data-auto-contrast>
      <header>
        <p class="story-eyebrow">Selected organisations</p>
        <h2 id="story-evidence-heading">Trusted by</h2>
        <a href="/experience">View professional experience <span aria-hidden="true">↗</span></a>
      </header>
      <ul class="story-brands" aria-label="Clients and collaborators">
        {featuredBrands.map((brand) => (
          <li
            class="story-brand-pill"
            data-pill-size={brand.pillSize}
            data-auto-contrast
          >
            <span class="story-brand-pill__mask">
              <span class="story-brand-pill__track">
                <strong>{brand.name}</strong>
                <span>{brand.role || "Client or collaborator"}</span>
              </span>
            </span>
          </li>
        ))}
      </ul>
      {featuredTestimonials.length > 0 && (
        <div class="story-quotes" aria-label="Testimonials">
          {featuredTestimonials.map((testimonial, index) => {
            const shortQuote = testimonial.highlightQuote || testimonial.content;
            const hasMore = String(shortQuote).trim() !== String(testimonial.content).trim();
            return (
            <blockquote class={`story-quote story-quote--${index + 1}`} data-testimonial-card data-auto-contrast>
              <div class="story-quote__content">
                <div class="story-quote__short">
                  <p>“{shortQuote}”</p>
                </div>
                <div class="story-quote__full" aria-hidden="true" data-at-top="true">
                  <p>“{testimonial.content}”</p>
                </div>
              </div>
              <footer>
                <strong>{testimonial.name}</strong>
                <span>{[testimonial.role, testimonial.company].filter(Boolean).join(" · ")}</span>
              </footer>
              {hasMore && (
                <button type="button" class="story-quote__toggle" data-testimonial-toggle aria-expanded="false">
                  <span data-toggle-label>Read the full testimonial</span>
                  <b aria-hidden="true">→</b>
                </button>
              )}
            </blockquote>
            );
          })}
        </div>
      )}
    </section>

    <section class="story-services" id="services" aria-labelledby="story-services-heading" data-auto-contrast>
      <header class="story-section-heading story-section-heading--dark-text">
        <p class="story-eyebrow">Ways to work together</p>
        <h2 id="story-services-heading">Work with me</h2>
        <a href="#enquiry">Discuss an engagement <span aria-hidden="true">↗</span></a>
      </header>
      <div class="story-capabilities">
        {content.capabilities.map((capability, index) => (
          <details class="story-capability" name="story-capabilities" open={index === 0}>
            <summary data-auto-contrast>
              <span>{capability.number}</span>
              <h3>{capability.title}</h3>
              <small>{String(capability.details.length).padStart(2, "0")} areas</small>
              <b aria-hidden="true"></b>
            </summary>
            <div class="story-capability__content">
              <div class="story-capability__main">
                <p>{capability.summary}</p>
                {capability.projects && capability.projects.length > 0 && (
                  <p class="story-capability__featured">
                    <span class="story-capability__featured-label">Relevant project{capability.projects.length > 1 ? "s" : ""}:</span>
                    <span class="story-capability__project-links">
                      {capability.projects.map((project, pIdx) => (
                        <Fragment key={project.name}>
                          <a class="story-capability__project-link" href={project.href}>
                            <span>{project.name}</span>
                            <b aria-hidden="true">↗</b>
                          </a>
                          {pIdx < capability.projects.length - 1 && <span class="story-capability__project-sep" aria-hidden="true">,</span>}
                        </Fragment>
                      ))}
                    </span>
                  </p>
                )}
              </div>
              <div class="story-capability__scope">
                <ul>
                  {capability.details.map((detail) => <li>{detail}</li>)}
                </ul>
              </div>
            </div>
          </details>
        ))}
      </div>
      <div class="story-services__conversation" data-auto-contrast>
        <div class="story-services__conversation-copy">
          <p class="story-eyebrow">Have a project or idea in mind?</p>
          <h3>Start a conversation</h3>
          <p class="story-services__conversation-text">Open for creative direction, spatial & interactive prototypes, and strategic advisory.</p>
          <a class="story-button story-button--primary" href="#enquiry">
            <span>Discuss an engagement</span>
            <b aria-hidden="true">→</b>
          </a>
        </div>
        <figure class="story-services__conversation-media">
          <img
            src="https://photos.abodid.com/variants/uk-2026/1600/162_UK-Trip-2026-280fe68684.webp"
            alt="Abodid Sahoo"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>


    <section class="story-enquiry" aria-label="Project enquiry">
      <InlineInquiryForm
        id="enquiry"
        heading="Write to me."
        intro=""
        sourceName="home-next-storytelling"
        variant="pop"
        interestOptions={[
          "Creative direction and experience design",
          "Exhibition or installation",
          "Storytelling product or prototype",
          "Photography, film or cultural documentation",
          "Ecosystem mapping or creative consulting",
          "Speaking, teaching or workshop",
          "Something else",
        ]}
      />
    </section>

    <section class="story-writing" id="writing" aria-labelledby="story-writing-heading" data-auto-contrast>
      <div class="story-writing__inner">
        <div class="story-writing__copy">
          <p class="story-eyebrow">Blog & newsletter</p>
          <h2 id="story-writing-heading">I love writing!</h2>
          <p class="story-writing__intro">Read my essays and memoirs on visual culture, art, and creative technology.</p>
          <a class="story-button story-button--primary" href="/blog">Go to the blog <span aria-hidden="true">↗</span></a>
        </div>
        <div class="story-writing__newsletter" data-auto-contrast>
          <p>Receive my writings and hand-picked curated resources to boost your creativity, productivity and research acumen.</p>
          <Newsletter />
        </div>
      </div>
    </section>
  </main>

  <script is:inline define:vars={{ cloudflareExhibitionFallbacks }}>
    (() => {
      const localSafetyImage = "/images/exhibition-image-fallback.svg";
      const fallbackPool = Array.isArray(cloudflareExhibitionFallbacks)
        ? cloudflareExhibitionFallbacks.filter(Boolean)
        : [];

      document.querySelectorAll("img[data-cloudflare-fallback]").forEach((image) => {
        const startAt = fallbackPool.length
          ? Math.floor(Math.random() * fallbackPool.length)
          : 0;

        const useNextFallback = () => {
          const attempt = Number(image.dataset.fallbackAttempt || "0");
          const currentUrl = image.currentSrc || image.src;

          for (let offset = attempt; offset < fallbackPool.length; offset += 1) {
            const candidate = fallbackPool[(startAt + offset) % fallbackPool.length];
            image.dataset.fallbackAttempt = String(offset + 1);
            if (candidate && candidate !== currentUrl) {
              image.src = candidate;
              return;
            }
          }

          if (!image.dataset.localSafetyApplied) {
            image.dataset.localSafetyApplied = "true";
            image.src = localSafetyImage;
          }
        };

        image.addEventListener("error", useNextFallback);
        image.addEventListener("load", () => {
          if (image.naturalWidth < 2 || image.naturalHeight < 2) useNextFallback();
        });

        if (image.complete && (image.naturalWidth < 2 || image.naturalHeight < 2)) {
          useNextFallback();
        }
      });

      const parseRgb = (value) => {
        const channels = String(value).match(/[\d.]+/g)?.map(Number) || [];
        if (channels.length < 3 || (channels.length > 3 && channels[3] === 0)) return null;
        return channels.slice(0, 3);
      };

      const luminance = (channels) => channels
        .map((channel) => channel / 255)
        .map((channel) => channel <= 0.03928 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4)
        .reduce((sum, channel, index) => sum + channel * [0.2126, 0.7152, 0.0722][index], 0);

      const contrast = (first, second) => {
        const lighter = Math.max(first, second);
        const darker = Math.min(first, second);
        return (lighter + 0.05) / (darker + 0.05);
      };

      const ink = { colour: "#15130f", luminance: luminance([21, 19, 15]) };
      const cream = { colour: "#fff8e8", luminance: luminance([255, 248, 232]) };

      const applySurfaceContrast = () => {
        document.querySelectorAll("[data-auto-contrast]").forEach((surface) => {
          const background = parseRgb(getComputedStyle(surface).backgroundColor);
          if (!background) return;
          const surfaceLuminance = luminance(background);
          const inkRatio = contrast(surfaceLuminance, ink.luminance);
          const creamRatio = contrast(surfaceLuminance, cream.luminance);
          const foreground = inkRatio >= creamRatio ? ink : cream;
          surface.style.setProperty("--surface-foreground", foreground.colour);
          surface.style.color = foreground.colour;
          surface.dataset.contrastRatio = Math.max(inkRatio, creamRatio).toFixed(2);
        });
      };

      const initialiseTestimonials = () => {
        document.querySelectorAll(".story-quote__full").forEach((fullQuote) => {
          if (!(fullQuote instanceof HTMLElement) || fullQuote.dataset.scrollReady === "true") return;
          fullQuote.dataset.scrollReady = "true";

          const updateScrollFade = () => {
            const hasOverflow = fullQuote.scrollHeight > fullQuote.clientHeight + 4;
            const isAtTop = fullQuote.scrollTop <= 4;
            const isAtBottom = fullQuote.scrollHeight - fullQuote.scrollTop - fullQuote.clientHeight <= 4;
            fullQuote.dataset.hasOverflow = String(hasOverflow);
            fullQuote.dataset.atTop = String(isAtTop);
            fullQuote.dataset.atBottom = String(isAtBottom);
          };

          fullQuote.addEventListener("scroll", updateScrollFade, { passive: true });
          requestAnimationFrame(updateScrollFade);
        });

        document.querySelectorAll("[data-testimonial-toggle]").forEach((button) => {
          if (!(button instanceof HTMLButtonElement) || button.dataset.ready === "true") return;
          button.dataset.ready = "true";

          button.addEventListener("click", () => {
            const card = button.closest("[data-testimonial-card]");
            const fullQuote = card?.querySelector(".story-quote__full");
            const label = button.querySelector("[data-toggle-label]");
            if (!(card instanceof HTMLElement) || !(fullQuote instanceof HTMLElement)) return;

            const willExpand = button.getAttribute("aria-expanded") !== "true";
            button.setAttribute("aria-expanded", String(willExpand));
            card.classList.toggle("is-expanded", willExpand);
            fullQuote.setAttribute("aria-hidden", String(!willExpand));
            if (label) label.textContent = willExpand ? "Show less" : "Read the full testimonial";

            if (willExpand) {
              fullQuote.scrollTop = 0;
              requestAnimationFrame(() => {
                const hasOverflow = fullQuote.scrollHeight > fullQuote.clientHeight + 4;
                fullQuote.dataset.hasOverflow = String(hasOverflow);
                fullQuote.dataset.atTop = "true";
                fullQuote.dataset.atBottom = String(!hasOverflow);
              });
            }
          });
        });
      };

      const initialiseHeroSlider = () => {
        const slider = document.querySelector("[data-hero-slider]");
        if (!slider) return;

        const slides = Array.from(slider.querySelectorAll("[data-hero-slide]"));
        if (slides.length <= 1) return;

        let currentIndex = 0;
        let timer = null;
        const INTERVAL_MS = 3800;

        const goToSlide = (nextIndex) => {
          const targetIndex = (nextIndex + slides.length) % slides.length;
          if (targetIndex === currentIndex) return;

          slides[currentIndex]?.classList.remove("is-active");
          slides[currentIndex]?.setAttribute("aria-hidden", "true");
          slides[currentIndex]?.setAttribute("tabindex", "-1");

          currentIndex = targetIndex;

          slides[currentIndex]?.classList.add("is-active");
          slides[currentIndex]?.setAttribute("aria-hidden", "false");
          slides[currentIndex]?.setAttribute("tabindex", "0");

          if (typeof applySurfaceContrast === "function") {
            applySurfaceContrast();
          }
        };

        const startTimer = () => {
          stopTimer();
          timer = setInterval(() => {
            goToSlide(currentIndex + 1);
          }, INTERVAL_MS);
        };

        const stopTimer = () => {
          if (timer) {
            clearInterval(timer);
            timer = null;
          }
        };

        // Touch swipe gestures
        let touchStartX = 0;
        let touchEndX = 0;

        slider.addEventListener("touchstart", (e) => {
          touchStartX = e.changedTouches && e.changedTouches[0] ? e.changedTouches[0].screenX : 0;
        }, { passive: true });

        slider.addEventListener("touchend", (e) => {
          touchEndX = e.changedTouches && e.changedTouches[0] ? e.changedTouches[0].screenX : 0;
          const diff = touchStartX - touchEndX;
          if (Math.abs(diff) > 40) {
            if (diff > 0) {
              goToSlide(currentIndex + 1);
            } else {
              goToSlide(currentIndex - 1);
            }
            startTimer();
          }
        }, { passive: true });

        // Keyboard navigation when focused
        slider.addEventListener("keydown", (e) => {
          if (e.key === "ArrowLeft") {
            goToSlide(currentIndex - 1);
            startTimer();
          } else if (e.key === "ArrowRight") {
            goToSlide(currentIndex + 1);
            startTimer();
          }
        });

        startTimer();
      };

      const ensureVideosPlay = () => {
        document.querySelectorAll<HTMLVideoElement>("video[autoplay]").forEach((video) => {
          const playVideo = () => {
            if (video.paused) video.play().catch(() => {});
          };

          if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
            playVideo();
          } else {
            video.addEventListener("canplay", playVideo, { once: true });
          }

          if (video.dataset.viewportPlaybackReady !== "true") {
            video.dataset.viewportPlaybackReady = "true";
            const observer = new IntersectionObserver((entries) => {
              if (entries.some((entry) => entry.isIntersecting)) playVideo();
            }, { threshold: 0.1 });
            observer.observe(video);
          }
        });
      };

      const initialisePage = () => {
        applySurfaceContrast();
        initialiseTestimonials();
        initialiseHeroSlider();
        ensureVideosPlay();
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initialisePage);
      } else {
        requestAnimationFrame(initialisePage);
      }
      document.addEventListener("astro:page-load", initialisePage);
      window.addEventListener("pageshow", ensureVideosPlay);
    })();
  </script>
</BaseLayout>

<style is:global>
  :root {
    --pop-blue: #2444ca;
    --pop-pink: #ff7eb5;
    --pop-yellow: #ffe44f;
    --pop-lime: #caff48;
    --pop-orange: #ff875c;
    --pop-purple: #5524c7;
    --pop-cyan: #62e6ff;
    --pop-cream: #fff8e8;

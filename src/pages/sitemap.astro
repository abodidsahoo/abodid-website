---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbJsonLd, personJsonLd, seoIdentity } from "../lib/seoData";
import { siteDirectory, knowledgeLinks, utilityLinks } from "../data/siteDirectory.js";
import { getSubscriptionEntries } from "../lib/subscriptions/sources";

// Reuse the published-content index, including its publication and noindex rules.
// A temporarily unavailable collection must not take down the permanent directory.
const collections = await Promise.allSettled(
  ['work', 'research', 'blog', 'lab'].map((section) => getSubscriptionEntries(section)),
);
const content = collections.flatMap((result, index) => {
  if (result.status === 'fulfilled') return result.value;
  console.error(`[sitemap-directory:${index}]`, result.reason?.message || 'Collection unavailable');
  return [];
});
const origin = new URL(seoIdentity.siteUrl).origin;
const directory = siteDirectory.map((group) => {
  const links = [...group.links];
  const seen = new Set(links.map((item) => new URL(item.href, origin).href));
  const belongsToGroup = (path: string) => {
    if (group.id === 'writing') return path.startsWith('/blog/');
    if (group.id === 'papers') return path.startsWith('/research-papers/');
    return ['work', 'research', 'photography', 'films', 'lab'].includes(group.id)
      && path.startsWith(`/${group.id}/`);
  };
  for (const entry of content) {
    const url = new URL(entry.url);
    if (url.origin !== origin || url.hash || !belongsToGroup(url.pathname) || seen.has(url.href)) continue;
    seen.add(url.href);
    links.push({ title: entry.title, href: url.pathname });
  }
  return { ...group, links };
});
const allLinks = [...directory.flatMap((group) => group.links), ...knowledgeLinks, ...utilityLinks];
const uniqueLinks = [...new Map(allLinks.map((item) => [new URL(item.href, origin).href, item])).values()];
const title = "Sitemap & Complete Site Directory — Abodid Sahoo";
const description = "Explore Abodid Sahoo’s projects, photography, films, artistic research, Media Lab experiments, writing, workshops, creative resources and public Obsidian notes.";
const structuredData = [
  personJsonLd(),
  breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Sitemap", path: "/sitemap" }]),
  {
    "@context": "https://schema.org", "@type": "CollectionPage",
    "@id": `${origin}/sitemap#webpage`, url: `${origin}/sitemap`, name: title, description,
    mainEntity: {
      "@type": "ItemList", numberOfItems: uniqueLinks.length,
      itemListElement: uniqueLinks.map((item, index) => ({
        "@type": "ListItem", position: index + 1, name: item.title, url: new URL(item.href, origin).href,
      })),
    },
  },
];
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=3600');
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={`${origin}/sitemap`}
  structuredData={structuredData}
  fullWidth={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="pop-sitemap-page"
>
  <main class="sitemap-shell">
    <section class="sitemap-hero" aria-labelledby="sitemap-heading">
      <div class="sitemap-hero__inner">
        <h1 id="sitemap-heading" class="sitemap-hero__title">Sitemap</h1>
        <p class="sitemap-hero__lede">
          Explore my work, research, photographs, films and writing, alongside
          experiments, workshops, creative resources and a growing public knowledge system.
        </p>
        <nav class="sitemap-quick-links" aria-label="Jump to a directory section">
          {directory.map((group) => <a href={`#group-${group.id}`}>{group.title}</a>)}
          <a href="#group-vault">Knowledge & documentation</a>
        </nav>
      </div>
    </section>

    <section class="sitemap-directory" aria-label="Complete site directory">
      <div class="sitemap-directory__grid">
        {directory.map((group) => (
          <article id={`group-${group.id}`} class="sitemap-group" aria-labelledby={`group-${group.id}-title`}>
            <header class="sitemap-group__header">
              <h2 id={`group-${group.id}-title`}><a href={group.href}>{group.title}</a></h2>
              <p class="sitemap-group__description">{group.description}</p>
            </header>
            <ul class="sitemap-links">
              {group.links.slice(0, 6).map((item) => (
                <li><a href={item.href}><span class="sitemap-link-text">{item.title}</span><span class="link-destination-arrow" aria-hidden="true">↗</span></a></li>
              ))}
            </ul>
            {group.links.length > 6 && (
              <details class="sitemap-more">
                <summary>Browse {group.links.length - 6} more pages</summary>
                <ul class="sitemap-links">
                  {group.links.slice(6).map((item) => (
                    <li><a href={item.href}><span class="sitemap-link-text">{item.title}</span><span class="link-destination-arrow" aria-hidden="true">↗</span></a></li>
                  ))}
                </ul>
              </details>
            )}
            <div class="sitemap-group__footer">
              <a href={group.href} class="sitemap-hub-link">Explore {group.title} <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
      <article id="group-vault" class="sitemap-vault-band" aria-labelledby="group-vault-title">
        <div class="sitemap-vault-band__header">
          <div class="sitemap-vault-band__title-block">
            <h2 id="group-vault-title">Knowledge & documentation</h2>
            <p class="sitemap-vault-band__sub">Explore public Obsidian notes, connected ideas and the documentation behind this creative ecosystem. The vault directory provides a dedicated index of individual notes.</p>
          </div>
          <a href="/obsidian-vault/directory" class="sitemap-vault-all-btn">Browse complete vault directory <span aria-hidden="true">↗</span></a>
        </div>
        <div class="sitemap-vault-pills-grid">
          {knowledgeLinks.map((item) => <a href={item.href} class="sitemap-vault-pill">{item.title}</a>)}
        </div>
      </article>
      <nav class="sitemap-utilities" aria-label="Site information and feeds">
        {utilityLinks.map((item) => <a href={item.href}>{item.title}</a>)}
        <a href="/sitemap-index.xml">XML sitemap index</a>
        <a href="/rss.xml">All updates RSS feed</a>
        <a href="/subscribe">Email & topic feeds</a>
      </nav>
    </section>
  </main>
</BaseLayout>

<style is:global>
  body.pop-sitemap-page {
    --pop-border: var(--ui-border-strong);
    --pop-line: var(--ui-border);
    --pop-gap: 8px;
    --pop-radius-panel: clamp(18px, 2vw, 28px);
    --pop-radius-card: clamp(14px, 1.5vw, 22px);
    --pop-radius-control: 14px;
    --pop-motion: 180ms ease;

    background: var(--color-primary);
    color: var(--color-text);
  }

  html:has(body.pop-sitemap-page) {
    background: var(--color-primary);
  }

  /* Robust contrast enforcement for headings and body copy */
  body.pop-sitemap-page h1,
  body.pop-sitemap-page h2,
  body.pop-sitemap-page h3,
  body.pop-sitemap-page p,
  body.pop-sitemap-page span,
  body.pop-sitemap-page li,
  body.pop-sitemap-page strong,
  body.pop-sitemap-page a {
    color: var(--color-text);
  }
</style>

<style>
  .sitemap-shell {
    display: flex;
    flex-direction: column;
    gap: var(--pop-gap);
    padding: var(--pop-gap);
    max-width: 1480px;
    margin: 0 auto;
  }

  /* Hero Section */
  .sitemap-hero {
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-panel);
    background: var(--color-secondary);
    color: var(--color-text) !important;
    padding: clamp(2.5rem, 5.5vw, 4.5rem) clamp(1.5rem, 4vw, 4rem);
  }

  .sitemap-hero__inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 900px;
  }

  .sitemap-hero__title {
    font: 720 clamp(2.8rem, 6.5vw, 5.5rem)/0.92 var(--font-display, sans-serif);
    letter-spacing: -0.05em;
    margin: 0;
    color: var(--color-text) !important;
    text-wrap: balance;
  }

  .sitemap-hero__lede {
    font: 480 clamp(1.15rem, 1.8vw, 1.5rem)/1.35 var(--font-display, sans-serif);
    letter-spacing: -0.02em;
    color: var(--color-text) !important;
    margin: 0;
    max-width: 48rem;
    text-wrap: pretty;
  }

  /* Complete Directory Section */
  .sitemap-directory {
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-panel);
    background: var(--color-background);
    color: var(--color-text) !important;
    padding: clamp(2rem, 4.5vw, 3.5rem) clamp(1.5rem, 3.5vw, 3.5rem);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sitemap-directory__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .sitemap-group {
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-card);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background: var(--color-surface);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--color-text) 4%, transparent);
    height: 100%;
    transition: transform var(--pop-motion), box-shadow var(--pop-motion);
  }

  .sitemap-group__header {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--pop-line);
  }

  .sitemap-group__header h2 {
    font: 700 1.35rem/1.2 var(--font-display, sans-serif);
    letter-spacing: -0.025em;
    margin: 0;
    color: var(--color-text) !important;
  }

  .sitemap-group__header h2 a {
    color: var(--color-text) !important;
    text-decoration: none;
  }

  .sitemap-group__header h2 a:hover {
    text-decoration: underline;
  }

  .sitemap-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1 1 auto;
  }

  .sitemap-links li:not(:last-child) {
    border-bottom: 1px solid var(--pop-line);
  }

  .sitemap-links li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.45rem 0.25rem;
    color: var(--color-text) !important;
    font: 500 0.92rem/1.4 var(--font-body, sans-serif);
    text-decoration: none;
    transition: transform var(--pop-motion), color var(--pop-motion);
  }

  .sitemap-links li a:hover {
    transform: translateX(4px);
    color: var(--color-text) !important;
  }

  .sitemap-links li a:hover .sitemap-link-text {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sitemap-link-text {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .sitemap-group__footer {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--pop-line);
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .sitemap-hub-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font: 750 0.8rem/1 var(--font-mono, monospace);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text) !important;
    text-decoration: none;
    transition: transform var(--pop-motion);
  }

  .sitemap-hub-link:hover {
    text-decoration: underline;
    transform: translateX(3px);
  }

  .sitemap-group__description {
    margin: 0.6rem 0 0;
    font: 450 1rem/1.5 var(--font-body, sans-serif);
  }

  .sitemap-quick-links, .sitemap-utilities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    margin-top: 1rem;
  }

  .sitemap-more {
    border-top: 1px solid var(--pop-line);
    padding-top: 0.75rem;
  }

  .sitemap-more summary {
    cursor: pointer;
    font: 650 1rem/1.4 var(--font-body, sans-serif);
    padding-block: 0.5rem;
  }

  .sitemap-group a:focus-visible,
  .sitemap-more summary:focus-visible,
  .sitemap-shell nav a:focus-visible {
    outline: 2px solid var(--ui-focus-ring);
    outline-offset: 4px;
  }

  .sitemap-group { scroll-margin-top: 7rem; min-width: 0; }
  .sitemap-links li a:hover { background: var(--ui-surface-hover-bg); }

  /* Vault Full-Width Band */
  .sitemap-vault-band {
    padding: 2rem;
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-panel);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sitemap-vault-band__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--pop-line);
  }

  .sitemap-vault-band__title-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 700px;
  }

  .sitemap-vault-band__title-block h2 {
    font: 650 clamp(1.4rem, 2.2vw, 2rem)/1.1 var(--font-display, sans-serif);
    letter-spacing: -0.035em;
    margin: 0;
    color: var(--color-text) !important;
  }

  .sitemap-vault-band__title-block h2 a {
    color: var(--color-text) !important;
    text-decoration: none;
  }

  .sitemap-vault-band__title-block h2 a:hover {
    text-decoration: underline;
  }

  .sitemap-vault-band__sub {
    font: 450 0.95rem/1.5 var(--font-body, sans-serif);
    margin: 0;
    color: var(--color-text) !important;
  }

  .sitemap-vault-band__sub code {
    font: 700 0.85em var(--font-mono, monospace);
    background: color-mix(in srgb, var(--color-text) 10%, transparent);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
  }

  .sitemap-vault-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 46px;
    padding: 0 1.25rem;
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-control);
    background: var(--color-background);
    color: var(--color-text) !important;
    font: 750 0.8rem/1 var(--font-mono, monospace);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform var(--pop-motion), box-shadow var(--pop-motion);
  }

  .sitemap-vault-all-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--color-text) 12%, transparent);
  }

  .sitemap-vault-pills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .sitemap-vault-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--pop-border);
    border-radius: 8px;
    background: var(--color-background);
    color: var(--color-text) !important;
    font: 500 0.86rem/1.2 var(--font-body, sans-serif);
    text-decoration: none;
    transition: transform var(--pop-motion), background var(--pop-motion);
  }

  .sitemap-vault-pill:hover {
    transform: translateY(-2px);
    background: var(--color-surface);
    color: var(--color-text) !important;
  }

  .sitemap-vault-more-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 1rem;
    border: 1px solid var(--pop-border);
    border-radius: 8px;
    background: var(--color-text);
    color: var(--color-primary-text) !important;
    font: 700 0.85rem/1.2 var(--font-mono, monospace);
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: transform var(--pop-motion), opacity var(--pop-motion);
  }

  .sitemap-vault-more-pill:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  .link-destination-arrow {
    display: inline-block;
    text-decoration: none !important;
    transition: transform var(--pop-motion);
  }

  /* Responsive Rules */
  @media (max-width: 1100px) {
    .sitemap-directory__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .sitemap-shell {
      padding: var(--pop-gap);
    }

    .sitemap-hero {
      padding: 2rem 1.25rem;
    }

    .sitemap-directory {
      padding: 1.5rem 1.25rem;
    }

    .sitemap-directory__grid {
      grid-template-columns: 1fr;
    }

    .sitemap-vault-band {
      padding: 1.25rem;
    }

    .sitemap-vault-all-btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sitemap-vault-pill,
    .sitemap-vault-all-btn,
    .sitemap-links li a,
    .link-destination-arrow {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

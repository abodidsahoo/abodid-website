---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPortfolioIndex } from "../lib/portfolio/services";
import {
  getAllPosts,
  getAllPhotography,
  getResearchProjects,
  getFilms,
  getResearchPapers,
} from "../lib/api";
import { getAllPublicVaultNotes } from "../lib/vault-note-index.js";
import { breadcrumbJsonLd, personJsonLd } from "../lib/seoData";

const [rawWork, photos, research, films, posts, papers, vaultNotes] =
  await Promise.all([
    getPublishedPortfolioIndex().catch(() => []),
    getAllPhotography().catch(() => []),
    getResearchProjects().catch(() => []),
    getFilms().catch(() => []),
    getAllPosts().catch(() => []),
    getResearchPapers().catch(() => []),
    getAllPublicVaultNotes().catch(() => []),
  ]);

const workProjects = rawWork.filter((p) => p.searchVisible !== false);
const publishedPhotos = photos.filter((p) => p.published !== false && p.slug);
const publishedResearch = research.filter(
  (r) => r.published !== false && (r as any).visible !== false && r.slug,
);
const publishedFilms = films.filter((f) => f.published !== false && f.slug);
const publishedPosts = posts.filter((b) => b.published !== false && b.slug);
const publishedPapers = papers.filter((rp) => rp.published !== false && rp.slug);

const title = "Sitemap & Complete Directory — Abodid Sahoo";
const description =
  "Complete directory of Abodid Sahoo’s work, research, films, photography, writing, and Obsidian notes.";

const structuredData = [
  personJsonLd(),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Sitemap", path: "/sitemap" },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
  fullWidth={true}
  hideWhatsAppButton={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="pop-sitemap-page"
>
  <main class="sitemap-shell">
    <!-- 1. Hero Header -->
    <section class="sitemap-hero" aria-labelledby="sitemap-heading">
      <div class="sitemap-hero__inner">
        <h1 id="sitemap-heading" class="sitemap-hero__title">Sitemap</h1>

        <p class="sitemap-hero__lede">
          A complete index of all projects, research experiments, films, photography series, essays, and public Obsidian notes.
        </p>
      </div>
    </section>

    <!-- 2. Complete Directory Modular Grid -->
    <section class="sitemap-directory" aria-label="Directory sections">
      <div class="sitemap-directory__grid">
        <!-- Work -->
        <article class="sitemap-group sitemap-group--yellow" aria-labelledby="group-work-title">
          <header class="sitemap-group__header">
            <h2 id="group-work-title">
              <a href="/work">Work</a>
            </h2>
          </header>
          <ul class="sitemap-links">
            {workProjects.map((item, index) => (
              <li class={index >= 7 ? "sitemap-link-item--collapsible" : ""}>
                <a href={`/work/${item.slug}`}>
                  <span class="sitemap-link-text">{item.title}</span>
                  <span class="link-destination-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
          {workProjects.length > 7 && (
            <button
              type="button"
              class="sitemap-toggle-btn"
              aria-expanded="false"
              data-more-text={`+ View ${workProjects.length - 7} more ↓`}
              data-less-text="Show less ↑"
            >
              + View {workProjects.length - 7} more ↓
            </button>
          )}
          <div class="sitemap-group__footer">
            <a href="/work" class="sitemap-hub-link">
              <span>Explore Work Hub</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>

        <!-- Research -->
        <article class="sitemap-group sitemap-group--cream" aria-labelledby="group-research-title">
          <header class="sitemap-group__header">
            <h2 id="group-research-title">
              <a href="/research">Research</a>
            </h2>
          </header>
          <ul class="sitemap-links">
            {publishedResearch.map((item, index) => (
              <li class={index >= 7 ? "sitemap-link-item--collapsible" : ""}>
                <a href={`/research/${item.slug}`}>
                  <span class="sitemap-link-text">{item.title}</span>
                  <span class="link-destination-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
          {publishedResearch.length > 7 && (
            <button
              type="button"
              class="sitemap-toggle-btn"
              aria-expanded="false"
              data-more-text={`+ View ${publishedResearch.length - 7} more ↓`}
              data-less-text="Show less ↑"
            >
              + View {publishedResearch.length - 7} more ↓
            </button>
          )}
          <div class="sitemap-group__footer">
            <a href="/research" class="sitemap-hub-link">
              <span>Explore Research Hub</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>

        <!-- Photography -->
        <article class="sitemap-group sitemap-group--lime" aria-labelledby="group-photography-title">
          <header class="sitemap-group__header">
            <h2 id="group-photography-title">
              <a href="/photography">Photography</a>
            </h2>
          </header>
          <ul class="sitemap-links">
            {publishedPhotos.map((item, index) => (
              <li class={index >= 7 ? "sitemap-link-item--collapsible" : ""}>
                <a href={`/photography/${item.slug}`}>
                  <span class="sitemap-link-text">{item.title}</span>
                  <span class="link-destination-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
          {publishedPhotos.length > 7 && (
            <button
              type="button"
              class="sitemap-toggle-btn"
              aria-expanded="false"
              data-more-text={`+ View ${publishedPhotos.length - 7} more ↓`}
              data-less-text="Show less ↑"
            >
              + View {publishedPhotos.length - 7} more ↓
            </button>
          )}
          <div class="sitemap-group__footer">
            <a href="/photography" class="sitemap-hub-link">
              <span>Explore Photography Hub</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>

        <!-- Films -->
        <article class="sitemap-group sitemap-group--pink" aria-labelledby="group-films-title">
          <header class="sitemap-group__header">
            <h2 id="group-films-title">
              <a href="/films">Films</a>
            </h2>
          </header>
          <ul class="sitemap-links">
            {publishedFilms.map((item, index) => (
              <li class={index >= 7 ? "sitemap-link-item--collapsible" : ""}>
                <a href={`/films/${item.slug}`}>
                  <span class="sitemap-link-text">{item.title}</span>
                  <span class="link-destination-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
          {publishedFilms.length > 7 && (
            <button
              type="button"
              class="sitemap-toggle-btn"
              aria-expanded="false"
              data-more-text={`+ View ${publishedFilms.length - 7} more ↓`}
              data-less-text="Show less ↑"
            >
              + View {publishedFilms.length - 7} more ↓
            </button>
          )}
          <div class="sitemap-group__footer">
            <a href="/films" class="sitemap-hub-link">
              <span>Explore Films Hub</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>

        <!-- Writing / Blog -->
        <article class="sitemap-group sitemap-group--cream" aria-labelledby="group-writing-title">
          <header class="sitemap-group__header">
            <h2 id="group-writing-title">
              <a href="/blog">Writing</a>
            </h2>
          </header>
          <ul class="sitemap-links">
            {publishedPosts.map((item, index) => (
              <li class={index >= 7 ? "sitemap-link-item--collapsible" : ""}>
                <a href={`/blog/${item.slug}`}>
                  <span class="sitemap-link-text">{item.title}</span>
                  <span class="link-destination-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
          {publishedPosts.length > 7 && (
            <button
              type="button"
              class="sitemap-toggle-btn"
              aria-expanded="false"
              data-more-text={`+ View ${publishedPosts.length - 7} more ↓`}
              data-less-text="Show less ↑"
            >
              + View {publishedPosts.length - 7} more ↓
            </button>
          )}
          <div class="sitemap-group__footer">
            <a href="/blog" class="sitemap-hub-link">
              <span>Explore Writing Hub</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>

        <!-- Curated Papers -->
        <article class="sitemap-group sitemap-group--cyan" aria-labelledby="group-papers-title">
          <header class="sitemap-group__header">
            <h2 id="group-papers-title">
              <a href="/research-papers">Curated Papers</a>
            </h2>
          </header>
          <ul class="sitemap-links">
            {publishedPapers.map((item, index) => (
              <li class={index >= 7 ? "sitemap-link-item--collapsible" : ""}>
                <a href={`/research-papers/${item.slug}`}>
                  <span class="sitemap-link-text">{item.title}</span>
                  <span class="link-destination-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
          {publishedPapers.length > 7 && (
            <button
              type="button"
              class="sitemap-toggle-btn"
              aria-expanded="false"
              data-more-text={`+ View ${publishedPapers.length - 7} more ↓`}
              data-less-text="Show less ↑"
            >
              + View {publishedPapers.length - 7} more ↓
            </button>
          )}
          <div class="sitemap-group__footer">
            <a href="/research-papers" class="sitemap-hub-link">
              <span>Explore Papers Hub</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      </div>

      <!-- Obsidian Vault Notes Full-Width Band -->
      <article id="section-vault" class="sitemap-vault-band" aria-labelledby="group-vault-title">
        <div class="sitemap-vault-band__header">
          <div class="sitemap-vault-band__title-block">
            <h2 id="group-vault-title">
              <a href="/obsidian-vault">Obsidian Vault Notes</a>
            </h2>
            <p class="sitemap-vault-band__sub">
              Public second brain notes from <code>6 - Main Notes</code> spanning autoethnography, cognitive maps, and creative technology.
            </p>
          </div>
          <a href="/obsidian-vault/directory" class="sitemap-vault-all-btn">
            <span>Browse Complete Vault Directory</span>
            <span class="link-destination-arrow" aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="sitemap-vault-pills-grid">
          {vaultNotes.slice(0, 48).map((note) => (
            <a href={note.href} class="sitemap-vault-pill">
              {note.title}
            </a>
          ))}
          {vaultNotes.length > 48 && (
            <a href="/obsidian-vault/directory" class="sitemap-vault-more-pill">
              +{vaultNotes.length - 48} more notes in full directory →
            </a>
          )}
        </div>
      </article>
    </section>
  </main>

  <script is:inline>
    document.querySelectorAll('.sitemap-toggle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const group = btn.closest('.sitemap-group');
        if (!group) return;
        const isExpanded = group.classList.toggle('is-expanded');
        btn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
        btn.textContent = isExpanded ? btn.getAttribute('data-less-text') : btn.getAttribute('data-more-text');
      });
    });
  </script>
</BaseLayout>

<style is:global>
  body.pop-sitemap-page {
    --pop-blue: #2444ca;
    --pop-pink: #ff7eb5;
    --pop-yellow: #ffe44f;
    --pop-lime: #caff48;
    --pop-orange: #ff875c;
    --pop-purple: #5524c7;
    --pop-cyan: #62e6ff;
    --pop-cream: #fff8e8;
    --pop-ink: #15130f;
    --pop-border: rgba(21, 19, 15, 0.78);
    --pop-line: rgba(21, 19, 15, 0.24);
    --pop-gap: 8px;
    --pop-radius-panel: clamp(18px, 2vw, 28px);
    --pop-radius-card: clamp(14px, 1.5vw, 22px);
    --pop-radius-control: 14px;
    --pop-motion: 180ms ease;

    background: var(--pop-blue);
    color: var(--pop-ink);
  }

  html:has(body.pop-sitemap-page) {
    background: var(--pop-blue);
  }

  /* Robust contrast enforcement for headings and body copy */
  body.pop-sitemap-page h1,
  body.pop-sitemap-page h2,
  body.pop-sitemap-page h3,
  body.pop-sitemap-page p,
  body.pop-sitemap-page span,
  body.pop-sitemap-page li,
  body.pop-sitemap-page strong,
  body.pop-sitemap-page a {
    color: var(--pop-ink);
  }
</style>

<style>
  .sitemap-shell {
    display: flex;
    flex-direction: column;
    gap: var(--pop-gap);
    padding: var(--pop-gap);
    max-width: 1480px;
    margin: 0 auto;
  }

  /* Hero Section */
  .sitemap-hero {
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-panel);
    background: var(--pop-pink);
    color: var(--pop-ink) !important;
    padding: clamp(2.5rem, 5.5vw, 4.5rem) clamp(1.5rem, 4vw, 4rem);
  }

  .sitemap-hero__inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 900px;
  }

  .sitemap-hero__title {
    font: 720 clamp(2.8rem, 6.5vw, 5.5rem)/0.92 var(--font-display, sans-serif);
    letter-spacing: -0.05em;
    margin: 0;
    color: var(--pop-ink) !important;
    text-wrap: balance;
  }

  .sitemap-hero__lede {
    font: 480 clamp(1.15rem, 1.8vw, 1.5rem)/1.35 var(--font-display, sans-serif);
    letter-spacing: -0.02em;
    color: var(--pop-ink) !important;
    margin: 0;
    max-width: 48rem;
    text-wrap: pretty;
  }

  /* Complete Directory Section */
  .sitemap-directory {
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-panel);
    background: var(--pop-cream);
    color: var(--pop-ink) !important;
    padding: clamp(2rem, 4.5vw, 3.5rem) clamp(1.5rem, 3.5vw, 3.5rem);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sitemap-directory__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .sitemap-group {
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-card);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background: #ffffff;
    box-shadow: 0 2px 8px rgba(21, 19, 15, 0.04);
    height: 100%;
    transition: transform var(--pop-motion), box-shadow var(--pop-motion);
  }

  .sitemap-group--yellow { border-top: 5px solid var(--pop-yellow); }
  .sitemap-group--cream { border-top: 5px solid var(--pop-pink); }
  .sitemap-group--lime { border-top: 5px solid var(--pop-lime); }
  .sitemap-group--pink { border-top: 5px solid var(--pop-blue); }
  .sitemap-group--cyan { border-top: 5px solid var(--pop-cyan); }

  .sitemap-group__header {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--pop-line);
  }

  .sitemap-group__header h2 {
    font: 700 1.35rem/1.2 var(--font-display, sans-serif);
    letter-spacing: -0.025em;
    margin: 0;
    color: var(--pop-ink) !important;
  }

  .sitemap-group__header h2 a {
    color: var(--pop-ink) !important;
    text-decoration: none;
  }

  .sitemap-group__header h2 a:hover {
    text-decoration: underline;
  }

  .sitemap-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1 1 auto;
  }

  .sitemap-group:not(.is-expanded) .sitemap-link-item--collapsible {
    display: none;
  }

  .sitemap-links li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.45rem 0.25rem;
    border-bottom: 1px solid rgba(21, 19, 15, 0.08);
    color: var(--pop-ink) !important;
    font: 500 0.92rem/1.4 var(--font-body, sans-serif);
    text-decoration: none;
    transition: transform var(--pop-motion), color var(--pop-motion);
  }

  .sitemap-links li a:hover {
    transform: translateX(4px);
    color: var(--pop-blue) !important;
  }

  .sitemap-links li a:hover .sitemap-link-text {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sitemap-links li:last-child a {
    border-bottom: none;
  }

  .sitemap-link-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sitemap-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.55rem 0.85rem;
    margin-top: 0.25rem;
    border: 1.5px dashed var(--pop-border);
    border-radius: 8px;
    background: rgba(21, 19, 15, 0.04);
    color: var(--pop-ink) !important;
    font: 750 0.78rem/1 var(--font-mono, monospace);
    letter-spacing: 0.04em;
    cursor: pointer;
    width: 100%;
    transition: background var(--pop-motion), border-color var(--pop-motion), transform var(--pop-motion);
  }

  .sitemap-toggle-btn:hover {
    background: rgba(21, 19, 15, 0.09);
    border-color: var(--pop-ink);
    transform: translateY(-1px);
  }

  .sitemap-group__footer {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--pop-line);
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .sitemap-hub-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font: 750 0.8rem/1 var(--font-mono, monospace);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--pop-blue) !important;
    text-decoration: none;
    transition: transform var(--pop-motion);
  }

  .sitemap-hub-link:hover {
    text-decoration: underline;
    transform: translateX(3px);
  }

  /* Vault Full-Width Band */
  .sitemap-vault-band {
    padding: 2rem;
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-panel);
    background: var(--pop-yellow);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sitemap-vault-band__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--pop-line);
  }

  .sitemap-vault-band__title-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 700px;
  }

  .sitemap-vault-band__title-block h2 {
    font: 650 clamp(1.4rem, 2.2vw, 2rem)/1.1 var(--font-display, sans-serif);
    letter-spacing: -0.035em;
    margin: 0;
    color: var(--pop-ink) !important;
  }

  .sitemap-vault-band__title-block h2 a {
    color: var(--pop-ink) !important;
    text-decoration: none;
  }

  .sitemap-vault-band__title-block h2 a:hover {
    text-decoration: underline;
  }

  .sitemap-vault-band__sub {
    font: 450 0.95rem/1.5 var(--font-body, sans-serif);
    margin: 0;
    color: var(--pop-ink) !important;
  }

  .sitemap-vault-band__sub code {
    font: 700 0.85em var(--font-mono, monospace);
    background: rgba(21, 19, 15, 0.1);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
  }

  .sitemap-vault-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 46px;
    padding: 0 1.25rem;
    border: 1px solid var(--pop-border);
    border-radius: var(--pop-radius-control);
    background: var(--pop-cream);
    color: var(--pop-ink) !important;
    font: 750 0.8rem/1 var(--font-mono, monospace);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform var(--pop-motion), box-shadow var(--pop-motion);
  }

  .sitemap-vault-all-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(21, 19, 15, 0.12);
  }

  .sitemap-vault-pills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .sitemap-vault-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--pop-border);
    border-radius: 8px;
    background: var(--pop-cream);
    color: var(--pop-ink) !important;
    font: 500 0.86rem/1.2 var(--font-body, sans-serif);
    text-decoration: none;
    transition: transform var(--pop-motion), background var(--pop-motion);
  }

  .sitemap-vault-pill:hover {
    transform: translateY(-2px);
    background: #ffffff;
    color: var(--pop-blue) !important;
  }

  .sitemap-vault-more-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 1rem;
    border: 1px solid var(--pop-border);
    border-radius: 8px;
    background: var(--pop-ink);
    color: var(--pop-cream) !important;
    font: 700 0.85rem/1.2 var(--font-mono, monospace);
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: transform var(--pop-motion), opacity var(--pop-motion);
  }

  .sitemap-vault-more-pill:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  .link-destination-arrow {
    display: inline-block;
    text-decoration: none !important;
    transition: transform var(--pop-motion);
  }

  /* Responsive Rules */
  @media (max-width: 1100px) {
    .sitemap-directory__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .sitemap-shell {
      padding: var(--pop-gap);
    }

    .sitemap-hero {
      padding: 2rem 1.25rem;
    }

    .sitemap-directory {
      padding: 1.5rem 1.25rem;

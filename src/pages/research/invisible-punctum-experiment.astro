---
import PunctumGame from "../../components/PunctumGame.jsx";
import ExperimentLayout from "../../layouts/ExperimentLayout.astro";
---

<ExperimentLayout
    title="Invisible Punctums | The Game"
    description="Playful interactive extension of the Invisible Punctums experiment."
    bodyClass="punctum-game-page"
>
    <main>
        <h1 class="sr-only">Invisible Punctums Game</h1>
        <PunctumGame client:only="react" />
    </main>
</ExperimentLayout>

<style>
    :global(body.punctum-game-page) {
        background: #0a0a0a;
        color: var(--color-primary-text);
        overflow-x: hidden;
        color-scheme: dark;
        --cursor-dot-bg: color-mix(in srgb, var(--color-surface) 98%, transparent);
        --cursor-dot-outline: color-mix(in srgb, var(--color-surface) 24%, transparent);
        --cursor-dot-glow: color-mix(in srgb, var(--color-surface) 48%, transparent);
        --cursor-ring-border: color-mix(in srgb, var(--color-surface) 76%, transparent);
        --cursor-shadow: color-mix(in srgb, var(--color-surface) 20%, transparent);
    }
</style>

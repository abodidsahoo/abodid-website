---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PortfolioProjectRenderer from "../../components/portfolio/PortfolioProjectRenderer.jsx";
import { researchProjects, researchProjectBySlug } from "../../data/researchPortfolio";
import { getProjectBySlug } from "../../lib/api";
import {
  breadcrumbJsonLd,
  creativeWorkJsonLd,
  personJsonLd,
  seoIdentity,
} from "../../lib/seoData";
import "../../styles/research-portfolio.css";
import "../../styles/portfolio-pop-editorial.css";

export const prerender = false;

const { slug } = Astro.params;
const portfolioProject = slug ? researchProjectBySlug[slug] : undefined;

let dbProject = null;
if (!portfolioProject && slug) {
  dbProject = await getProjectBySlug(slug);
  if (!dbProject || !dbProject.published || dbProject.visible === false) {
    Astro.response.status = 404;
    return Astro.rewrite("/404");
  }
}

// Compute next research project for footer navigation
const currentIndex = researchProjects.findIndex((p) => p.slug === slug);
const nextResearchProject = currentIndex >= 0
  ? {
      id: researchProjects[(currentIndex + 1) % researchProjects.length].slug,
      slug: researchProjects[(currentIndex + 1) % researchProjects.length].slug,
      title: researchProjects[(currentIndex + 1) % researchProjects.length].title,
      category: researchProjects[(currentIndex + 1) % researchProjects.length].metaValue,
      href: `/research/${researchProjects[(currentIndex + 1) % researchProjects.length].slug}`,
    }
  : researchProjects.length > 0
  ? {
      id: researchProjects[0].slug,
      slug: researchProjects[0].slug,
      title: researchProjects[0].title,
      category: researchProjects[0].metaValue,
      href: `/research/${researchProjects[0].slug}`,
    }
  : null;

const project = portfolioProject ? {
  id: portfolioProject.slug,
  slug: portfolioProject.slug,
  title: portfolioProject.title,
  oneLineDescription: portfolioProject.intro || portfolioProject.premise,
  context: portfolioProject.deeper || portfolioProject.premise,
  role: portfolioProject.role,
  outcomeHeading: portfolioProject.metaValue || portfolioProject.outcomeBadge || "Research Outcome",
  outcomeStatus: portfolioProject.outcomeBadge || (portfolioProject.metaValue && !/^\d{4}$/.test(portfolioProject.metaValue) ? portfolioProject.metaValue : null),
  outcomeText: portfolioProject.outcome,
  coverUrl: portfolioProject.images?.[0]?.src,
  coverAlt: portfolioProject.images?.[0]?.alt,
  taxonomies: (portfolioProject.themes || []).map((t: string) => ({ groupType: "theme", label: t })),
  images: portfolioProject.images,
  reading: portfolioProject.reading,
  related: portfolioProject.related,
  accent: portfolioProject.accent,
  backHref: "/research",
  backLabel: "← All Research",
  isResearch: true,
  blocks: (portfolioProject.process && portfolioProject.process.length > 0) ? [
    {
      id: "process-block",
      blockType: "text_prose",
      content: {
        heading: "Research Process",
        text: portfolioProject.process.map((step: string, i: number) => `${i + 1}. ${step}`).join("\n\n"),
      }
    }
  ] : [],
  searchVisible: true,
} : dbProject ? {
  id: dbProject.slug || String(dbProject.id),
  slug: dbProject.slug || String(dbProject.id),
  title: dbProject.title,
  oneLineDescription: dbProject.description,
  context: dbProject.content || dbProject.description,
  role: dbProject.role || "Lead Researcher",
  outcomeHeading: "Research Outcome",
  outcomeText: dbProject.outcome || "Published",
  outcome: dbProject.outcome || "Published",
  coverUrl: dbProject.cover_image || dbProject.image,
  coverAlt: `${dbProject.title} project cover`,
  experimentUrl: dbProject.experiment_url,
  taxonomies: (Array.isArray(dbProject.tags) ? dbProject.tags : []).map((t: string) => ({ groupType: "theme", label: t })),
  blocks: dbProject.blocks || [],
  backHref: "/research",
  backLabel: "← All Research",
  isResearch: true,
  searchVisible: true,
} : null;

if (!project) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const title = `${project.title} — Abodid Sahoo`;
const description = project.oneLineDescription || project.context;
const image = project.coverUrl;
const canonicalUrl = `${seoIdentity.siteUrl}/research/${project.slug}`;
const structuredData = [
  personJsonLd(),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Research", path: "/research" },
    { name: project.title, path: `/research/${project.slug}` },
  ]),
  creativeWorkJsonLd({
    title: project.title,
    description: description || project.title,
    url: canonicalUrl,
    image: image || undefined,
  }),
];
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={project.coverAlt}
  canonicalUrl={canonicalUrl}
  fullWidth={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="work-project-page"
  structuredData={structuredData}
>
  <PortfolioProjectRenderer project={project} nextProject={nextResearchProject} client:load />
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PortfolioProjectRenderer from "../../components/portfolio/PortfolioProjectRenderer.jsx";
import { getProjectBySlug, getResearchProjects } from "../../lib/api";
import {
  breadcrumbJsonLd,
  creativeWorkJsonLd,
  personJsonLd,
  seoIdentity,
} from "../../lib/seoData";
import "../../styles/research-portfolio.css";
import "../../styles/portfolio-pop-editorial.css";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "no-store");

const { slug } = Astro.params;
const [dbProject, researchProjects] = await Promise.all([
  slug ? getProjectBySlug(slug) : null,
  getResearchProjects({ featuredOnly: true }),
]);

if (!dbProject || !dbProject.published || dbProject.visible === false) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

// Compute next research project for footer navigation
const currentIndex = researchProjects.findIndex((p) => p.slug === slug);
const nextResearchProject = currentIndex >= 0
  ? {
      id: researchProjects[(currentIndex + 1) % researchProjects.length].slug,
      slug: researchProjects[(currentIndex + 1) % researchProjects.length].slug,
      title: researchProjects[(currentIndex + 1) % researchProjects.length].title,
      category: researchProjects[(currentIndex + 1) % researchProjects.length].role,
      href: `/research/${researchProjects[(currentIndex + 1) % researchProjects.length].slug}`,
    }
  : researchProjects.length > 0
  ? {
      id: researchProjects[0].slug,
      slug: researchProjects[0].slug,
      title: researchProjects[0].title,
      category: researchProjects[0].role,
      href: `/research/${researchProjects[0].slug}`,
    }
  : null;

const sourceBlocks = Array.isArray(dbProject.blocks) ? dbProject.blocks : [];
const outcomeHeadingIndex = sourceBlocks.findIndex((block: any) =>
  block?.blockType === "heading" && /^(outcome|status)$/i.test(String(block?.content?.text || "").trim())
);
const outcomeBlock = outcomeHeadingIndex >= 0 ? sourceBlocks[outcomeHeadingIndex + 1] : null;
const rawOutcome = String(outcomeBlock?.content?.text || "").trim();
const outcomeStatus = rawOutcome.match(/^\*\*([^*]+)\*\*/)?.[1] || null;
const outcomeText = rawOutcome.replace(/^\*\*[^*]+\*\*\s*/, "").trim();
const displayBlocks = outcomeHeadingIndex >= 0 && outcomeBlock
  ? sourceBlocks.filter((_: any, index: number) => index !== outcomeHeadingIndex && index !== outcomeHeadingIndex + 1)
  : sourceBlocks;

const project = {
  id: dbProject.slug || String(dbProject.id),
  slug: dbProject.slug || String(dbProject.id),
  title: dbProject.title,
  oneLineDescription: dbProject.description,
  context: dbProject.description,
  role: dbProject.role || "Lead Researcher",
  outcomeHeading: "Research Outcome",
  outcomeStatus,
  outcomeText: outcomeText || "Published research project.",
  coverUrl: dbProject.cover_image || dbProject.image,
  coverAlt: dbProject.gallery_images?.[0]?.alt || `${dbProject.title} project cover`,
  experimentUrl: dbProject.experiment_url,
  accent: dbProject.accent || "lime",
  taxonomies: (Array.isArray(dbProject.tags) ? dbProject.tags : []).map((t: string) => ({ groupType: "theme", label: t })),
  blocks: displayBlocks,
  backHref: "/research",
  backLabel: "← All Research",
  isResearch: true,
  searchVisible: true,
};

const title = `${project.title} — Abodid Sahoo`;
const description = project.oneLineDescription || project.context;
const image = project.coverUrl;
const canonicalUrl = `${seoIdentity.siteUrl}/research/${project.slug}`;
const structuredData = [
  personJsonLd(),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Research", path: "/research" },
    { name: project.title, path: `/research/${project.slug}` },
  ]),
  creativeWorkJsonLd({
    title: project.title,
    description: description || project.title,
    url: canonicalUrl,
    image: image || undefined,
  }),
];
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={project.coverAlt}
  canonicalUrl={canonicalUrl}
  fullWidth={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="work-project-page"
  structuredData={structuredData}
>
  <PortfolioProjectRenderer project={project} nextProject={nextResearchProject} client:load />
</BaseLayout>

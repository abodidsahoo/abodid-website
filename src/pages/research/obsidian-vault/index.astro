---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import InlineInquiryForm from "../../../components/InlineInquiryForm.astro";
import VaultAskSection from "../../../components/VaultAskSection.astro";
import { getVaultTags, getVaultNotes } from "../../../lib/github";

let error = "";
let allNotes = [];
let tags = [];

try {
    const [tagsData, notesData] = await Promise.all([
        getVaultTags(),
        getVaultNotes(),
    ]);

    tags = tagsData || [];
    allNotes = notesData || [];
} catch (e) {
    console.error("Error fetching vault data:", e);
    error = e instanceof Error
        ? e.message
        : "Failed to fetch vault data from GitHub. Check server logs.";
}

const pageTitle = "Obsidian Vault";
const pageDescription = "Ask questions across Abodid Sahoo's public Obsidian notes, or browse the live note and tag archive.";
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    fullWidth={true}
    showGlobalGrid={false}
    bodyClass="vault-pop-page"
>
    <div class="vault-page">
        <section class="vault-workspace" aria-labelledby="vault-title">
            <div class="vault-workspace__grid">
                <article class="vault-world-file">
                    <header class="vault-heading-panel">
                        <div class="vault-heading-panel__hero">
                            <h1 id="vault-title">Obsidian Vault</h1>
                            <p>Abodid’s Second Brain</p>
                        </div>
                        {error && <p class="vault-error" role="alert">{error}</p>}
                    </header>

                    <div class="vault-world-archive">
                        <section class="vault-panel vault-notes-panel" aria-labelledby="vault-notes-title">
                    <div class="vault-panel__topline vault-panel__topline--bordered">
                        <div>
                            <p class="vault-eyebrow">Browse the archive</p>
                            <h2 id="vault-notes-title">Notes</h2>
                        </div>
                        <div class="vault-topline-meta">
                            <a href="/research/obsidian-vault/directory" class="vault-browse-all-link">Browse all {allNotes.length} notes →</a>
                            <span class="vault-count">{allNotes.length} entries</span>
                        </div>
                    </div>

                    <div class="vault-notes-scroll-shell">
                        <div class="vault-notes-scroll" tabindex="0" aria-label="Scrollable list of vault notes">
                            <div class="vault-list" id="notes-grid">
                            {allNotes.length === 0 ? (
                                <div class="vault-empty-state">
                                    <p>No notes found. Check the GitHub connection.</p>
                                </div>
                            ) : (
                                allNotes.map((file, index) => (
                                    <a href={`/research/obsidian-vault/${file.name.replace(".md", "")}`} class="note-card">
                                        <span class="note-card__index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                                        <h3>{file.name.replace(".md", "").replace(/-/g, " ")}</h3>
                                        <span class="note-card__arrow" aria-hidden="true">→</span>
                                    </a>
                                ))
                            )}
                            </div>
                        </div>
                    </div>
                    <div class="vault-directory-link-banner">
                        <a href="/research/obsidian-vault/directory" class="vault-directory-cta">
                            <span>Browse complete directory of all {allNotes.length} notes</span>
                            <span aria-hidden="true">→</span>
                        </a>
                    </div>
                        </section>

                        <aside class="vault-panel vault-tags-panel" aria-labelledby="vault-tags-title">
                    <div class="vault-panel__topline vault-panel__topline--bordered">
                        <div>
                            <p class="vault-eyebrow">Follow a thread</p>
                            <h2 id="vault-tags-title">Tags</h2>
                        </div>
                        <span class="vault-count">{tags.length} topics</span>
                    </div>

                    <div class="vault-tags-scroll-shell">
                        <div class="tag-cloud-wrapper" tabindex="0" aria-label="Scrollable list of vault tags">
                            {tags.map((tag) => (
                                <a href={`/research/obsidian-vault/tag/${encodeURIComponent(tag.name.replace(".md", ""))}`} class="vault-tag">
                                    {tag.name.replace(".md", "").replace(/-/g, " ")}
                                </a>
                            ))}
                        </div>
                    </div>
                        </aside>
                    </div>
                </article>

                <section class="vault-panel vault-question-panel" aria-labelledby="vault-question-title">
                    <div class="vault-panel__topline">
                        <p class="vault-eyebrow">Semantic question</p>
                    </div>
                    <div class="vault-question-panel__intro">
                        <h2 id="vault-question-title">Ask my vault, anything.</h2>
                        <p>Describe an idea in your own words. The vault will find related notes and cite the sources it used.</p>
                    </div>
                    <VaultAskSection />
                </section>

                <header class="vault-panel vault-intro-panel">
                    <div class="vault-panel__topline">
                        <p class="vault-eyebrow">Build your own vault</p>
                    </div>
                    <div class="vault-intro-panel__copy">
                        <h2>Your notes should work for you.</h2>
                        <p>
                            I build simple Obsidian vaults for researchers, filmmakers
                            and anyone who wants their ideas easier to find—even if
                            you have never used Obsidian before.
                        </p>
                        <a class="vault-intro-panel__cta" href="#obsidian-interest">
                            Build your vault with me <span aria-hidden="true">→</span>
                        </a>
                    </div>
                </header>
            </div>
        </section>

        <section class="vault-interest-band" aria-label="Obsidian enquiry">
            <InlineInquiryForm
                id="obsidian-interest"
                eyebrow="Work with me"
                heading="Put the power of Obsidian to work."
                intro="Use Obsidian for a calmer note-taking experience, or work with me to shape a vault around the way you think."
                sourceName="obsidian-vault-interest"
                defaultInterest="Obsidian vault interest"
                variant="pop"
                compact={true}
                messageLabel="Optional message"
                messagePlaceholder="Tell me what you want your notes to help you do."
                messageRequired={false}
                submitLabel="Express interest →"
                showEmailLink={true}
            />
        </section>
    </div>
</BaseLayout>

<style is:global>
    :root {
        --pop-blue: #2444ca;
        --pop-pink: #ff7eb5;
        --pop-yellow: #ffe44f;
        --pop-lime: #caff48;
        --pop-purple: #5524c7;
        --pop-cream: #fff8e8;
        --pop-ink: #15130f;
        --pop-border: rgba(21, 19, 15, 0.78);
        --pop-line: rgba(21, 19, 15, 0.24);
        --vault-gap: 8px;
        --vault-panel-radius: clamp(18px, 2vw, 28px);
        --vault-card-radius: clamp(14px, 1.5vw, 22px);
        --vault-control-radius: 14px;
        --vault-motion: 180ms ease;
    }

    body.vault-pop-page { background: var(--pop-blue); color: var(--pop-ink); }

    .vault-pop-page .vault-page {
        width: 100%;
        overflow: clip;
        background: var(--pop-blue);
        font-family: "Satoshi-Variable", "Satoshi-Regular", "Poppins", sans-serif;
    }

    .vault-workspace { padding: var(--vault-gap); background: var(--pop-blue); }

    .vault-workspace__grid {
        width: min(100%, 1480px);
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--vault-gap);
        align-items: stretch;
    }

    .vault-panel {
        min-width: 0;
        padding: clamp(1.35rem, 2.8vw, 2.75rem);
        border: 1px solid var(--pop-border);
        border-radius: var(--vault-panel-radius);
    }

    .vault-world-file {
        grid-column: 1 / -1;
        overflow: hidden;
        border: 1px solid var(--pop-border);
        border-radius: var(--vault-panel-radius);
        background: var(--pop-cream);
    }

    .vault-heading-panel {
        padding: clamp(3rem, 6vw, 6rem) clamp(1.4rem, 4vw, 3.5rem);
        border-bottom: 1px solid var(--pop-ink);
        background: var(--pop-pink);
    }

    .vault-heading-panel__hero {
        display: grid;
        grid-template-columns: minmax(0, 1.3fr) minmax(260px, 0.7fr);
        align-items: end;
        gap: clamp(2rem, 6vw, 7rem);
    }

    .vault-heading-panel h1 {
        max-width: 9ch;
        margin: 0;
        color: var(--pop-ink);
        font: 720 clamp(3.7rem, 9vw, 8.5rem)/0.84 "Satoshi-Variable", "Satoshi-Regular", "Poppins", sans-serif;
        letter-spacing: -0.075em;
        text-wrap: balance;
    }

    .vault-heading-panel__hero > p {
        max-width: 34rem;
        margin: 0 0 0.5rem;
        color: var(--pop-ink);
        font: 500 clamp(1.15rem, 2vw, 1.65rem)/1.32 "Satoshi-Variable", "Satoshi-Regular", "Poppins", sans-serif;
        letter-spacing: -0.025em;
        text-wrap: pretty;
    }

    .vault-world-archive {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        background: var(--pop-cream);
    }

    .vault-world-archive .vault-panel {
        border: 0;
        border-radius: 0;
    }

    .vault-world-archive .vault-tags-panel {
        border-left: 1px solid var(--pop-ink);
    }

    .vault-intro-panel {
        grid-column: 1 / -1;
        min-height: 350px;
        align-self: start;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        background: var(--pop-pink);
    }

    .vault-question-panel {
        grid-column: 1 / -1;
        min-height: 480px;
        display: flex;
        flex-direction: column;
        background: var(--pop-yellow);
    }

    .vault-notes-panel { grid-column: span 7; background: var(--pop-cream); }

    .vault-tags-panel {
        grid-column: span 5;
        position: relative;
        display: flex;
        flex-direction: column;
        background: var(--pop-cream);
    }

    .vault-panel__topline {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .vault-panel__topline--bordered {
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        align-items: flex-end;
        border-bottom: 1px solid currentColor;
    }

    .vault-eyebrow,
    .vault-count {
        margin: 0;
        font: 750 clamp(0.68rem, 0.9vw, 0.78rem)/1.35 "Satoshi-Variable", "Satoshi-Regular", "Space Mono", "Inconsolata", monospace;
        letter-spacing: 0.09em;
        text-transform: uppercase;
    }

    .vault-intro-panel__copy { margin: clamp(2rem, 4vw, 3.75rem) 0 0; }

    .vault-intro-panel h2 {
        max-width: 10ch;
        margin: 0;
        color: var(--pop-ink);
        font: 620 clamp(2.65rem, 4.6vw, 4.8rem)/0.9 "Satoshi-Variable", "Satoshi-Regular", "Poppins", sans-serif;
        letter-spacing: -0.06em;
        text-wrap: balance;
    }

    .vault-intro-panel__copy > p {
        max-width: 34rem;
        margin: 1.8rem 0 0;
        color: rgba(21, 19, 15, 0.82);
        font-size: clamp(1rem, 1.35vw, 1.22rem);
        line-height: 1.48;
        text-wrap: pretty;
    }

    .vault-intro-panel__cta {
        width: fit-content;
        min-height: 50px;
        margin-top: 1.5rem;
        padding: 0 1rem;
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        border: 1px solid var(--pop-ink);
        border-radius: var(--vault-control-radius);
        background: var(--pop-yellow);
        color: var(--pop-ink);
        font-size: 0.82rem;
        font-weight: 720;
        letter-spacing: 0.045em;
        text-decoration: none;
        text-transform: uppercase;
        transition: transform var(--vault-motion), box-shadow var(--vault-motion);
    }

    .vault-intro-panel__cta:hover,
    .vault-intro-panel__cta:focus-visible {
        transform: translateY(-2px);
        box-shadow: 0 4px 0 var(--pop-ink);
        outline: 2px solid var(--pop-purple);
        outline-offset: 3px;
    }

    .vault-intro-panel__cta span { transition: transform var(--vault-motion); }
    .vault-intro-panel__cta:hover span,
    .vault-intro-panel__cta:focus-visible span { transform: translateX(4px); }

    .vault-error {
        margin: 1rem 0 0;
        padding: 0.8rem 1rem;
        border: 1px solid var(--pop-ink);
        border-radius: var(--vault-control-radius);
        background: var(--pop-cream);
        color: #7c0018;
    }

    .vault-question-panel__intro { margin-top: clamp(2.5rem, 5vw, 4.75rem); }

    .vault-question-panel h2,
    .vault-notes-panel h2,
    .vault-tags-panel h2 {
        margin: 0;
        color: var(--pop-ink);
        font-family: "Satoshi-Variable", "Satoshi-Regular", "Poppins", sans-serif;
        font-weight: 620;
        letter-spacing: -0.055em;
        text-wrap: balance;
    }

    .vault-question-panel h2 {
        max-width: 12ch;
        font-size: clamp(2.75rem, 5vw, 5.8rem);
        line-height: 0.88;
    }

    .vault-question-panel__intro > p {
        max-width: 39rem;
        margin: 1.25rem 0 0;
        color: rgba(21, 19, 15, 0.78);
        font-size: clamp(0.96rem, 1.15vw, 1.08rem);
        line-height: 1.48;
    }

    .vault-notes-panel h2,
    .vault-tags-panel h2 {
        margin-top: 0.35rem;
        font-size: clamp(2.3rem, 4vw, 4.25rem);
        line-height: 0.9;
    }

    .vault-count { text-align: right; }

    .vault-topline-meta {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.25rem;
    }

    .vault-browse-all-link {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--pop-purple);
        text-decoration: underline;
        text-underline-offset: 2px;
        transition: color var(--vault-motion);
    }

    .vault-browse-all-link:hover {
        color: var(--pop-ink);
    }

    .vault-directory-link-banner {
        padding: 0.85rem 1rem;
        border-top: 1px solid var(--pop-line);
        background: rgba(255, 255, 255, 0.4);
    }

    .vault-directory-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.92rem;
        font-weight: 650;
        color: var(--pop-ink);
        text-decoration: none;
        transition: color var(--vault-motion);
    }

    .vault-directory-cta:hover {
        text-decoration: underline;
        color: var(--pop-purple);
    }

    .vault-notes-scroll,
    .tag-cloud-wrapper {
        height: clamp(460px, 54vw, 660px);
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-width: thin;
        scrollbar-color: var(--pop-ink) transparent;
    }

    .vault-notes-scroll:focus-visible,
    .tag-cloud-wrapper:focus-visible {
        outline: 3px solid var(--pop-purple);
        outline-offset: 4px;
        border-radius: var(--vault-control-radius);
    }

    /* Keep the final title above the scroll area's bottom fade. */
    .vault-list { display: grid; padding-bottom: 7.5rem; }

    .note-card {
        min-height: 66px;
        padding: 0.85rem 0.85rem 0.85rem 0.25rem;
        display: grid;
        grid-template-columns: 3rem minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.8rem;
        border-bottom: 1px solid var(--pop-line);
        color: var(--pop-ink);
        text-decoration: none;
        transition: background var(--vault-motion), padding var(--vault-motion);
    }

    .note-card:first-child { border-top: 1px solid var(--pop-line); }

    .note-card:hover,
    .note-card:focus-visible {
        padding-left: 0.75rem;
        background: var(--pop-yellow);
        outline: 0;
    }

    .note-card__index {
        font: 700 0.7rem/1 "Satoshi-Variable", "Satoshi-Regular", "Space Mono", monospace;
        letter-spacing: 0.08em;
        opacity: 0.62;
    }

    .note-card h3 {
        margin: 0;
        color: var(--pop-ink);
        font-size: clamp(0.98rem, 1.25vw, 1.16rem);
        font-weight: 560;
        line-height: 1.25;
        letter-spacing: -0.015em;
        text-transform: capitalize;
    }

    .note-card__arrow { font-size: 1.15rem; transition: transform var(--vault-motion); }
    .note-card:hover .note-card__arrow,
    .note-card:focus-visible .note-card__arrow { transform: translateX(4px); }

    .vault-empty-state {
        min-height: 240px;
        display: grid;
        place-items: center;
        border: 1px dashed var(--pop-border);
        border-radius: var(--vault-card-radius);
    }

    .vault-notes-scroll-shell,
    .vault-tags-scroll-shell { position: relative; min-height: 0; flex: 1; }

    .vault-notes-scroll-shell::after,
    .vault-tags-scroll-shell::after {
        content: "";
        position: absolute;
        z-index: 1;
        inset: auto 0 0;
        height: 7.5rem;
        pointer-events: none;
        background: linear-gradient(to bottom, rgba(255, 248, 232, 0), var(--pop-cream) 88%);
    }

    .tag-cloud-wrapper {
        align-content: flex-start;
        padding: 0.15rem 0 6.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
    }

    .vault-tag {
        min-height: 44px;
        padding: 0.72rem 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        border: 1px solid var(--pop-ink);
        border-radius: var(--vault-control-radius);
        background: var(--pop-cream);
        color: var(--pop-ink);
        font-family: "Satoshi-Variable", "Satoshi-Regular", "Poppins", sans-serif;
        font-size: clamp(0.98rem, 1.25vw, 1.16rem);
        font-weight: 560;
        line-height: 1.25;
        letter-spacing: -0.015em;
        font-variant-caps: normal;
        text-decoration: none;
        text-transform: lowercase;
        transition: transform var(--vault-motion), background var(--vault-motion), box-shadow var(--vault-motion);
    }

    .vault-tag:nth-child(4n + 2) { background: var(--pop-yellow); }
    .vault-tag:nth-child(7n + 3) { background: var(--pop-lime); }

    .vault-tag:hover,
    .vault-tag:focus-visible {
        transform: translateY(-2px);
        background: var(--pop-yellow);
        box-shadow: 0 3px 0 var(--pop-ink);
        outline: none;
    }

    .vault-interest-band {
        padding: clamp(4rem, 6.5vw, 7rem) clamp(1rem, 6vw, 6rem);
        border-top: 8px solid var(--pop-blue);
        background: var(--pop-purple);
        color: var(--pop-cream);
    }

    .vault-interest-band .inline-enquiry--pop { width: min(100%, 1480px); }

    .vault-interest-band .inline-enquiry--pop h2 {
        max-width: 9ch;
        color: var(--pop-cream);
        font-size: clamp(3rem, 6.7vw, 7rem);
        line-height: 0.9;
        letter-spacing: -0.065em;
    }

    .vault-interest-band .inline-enquiry--pop .inline-enquiry__intro > p:not(.inline-enquiry__eyebrow) {
        max-width: 31rem;
        color: var(--pop-cream);
    }

    .vault-interest-band .inline-enquiry--pop input,
    .vault-interest-band .inline-enquiry--pop textarea {
        border: 1px solid var(--pop-ink);
        border-radius: var(--vault-control-radius);
        background: var(--pop-cream);
        color: var(--pop-ink);
    }

    .vault-interest-band .inline-enquiry--pop .inline-enquiry__submit-row button {
        min-width: 190px;
        border-radius: var(--vault-control-radius);
        transition: transform var(--vault-motion), box-shadow var(--vault-motion);
    }

    .vault-interest-band .inline-enquiry--pop .inline-enquiry__submit-row button:hover,
    .vault-interest-band .inline-enquiry--pop .inline-enquiry__submit-row button:focus-visible {
        transform: translateY(-2px);
        box-shadow: 0 4px 0 var(--pop-ink);
        outline: 2px solid var(--pop-cream);
        outline-offset: 3px;
    }

    .vault-question-panel .vault-ask-section {
        width: 100%;
        margin: auto 0 0;
        padding: clamp(2rem, 4vw, 3.5rem) 0 0;
    }

    .vault-question-panel .vault-ask-box {
        min-height: 78px;
        padding: 0.8rem 0.8rem 0.8rem 1.25rem;
        border: 1px solid var(--pop-ink);
        border-radius: 18px;
        background: var(--pop-cream);
        box-shadow: none;
        backdrop-filter: none;
    }

    .vault-question-panel .vault-ask-box:focus-within {
        border-color: var(--pop-ink);
        background: var(--pop-cream);
        box-shadow: 0 0 0 3px var(--pop-purple);
    }

    .vault-question-panel .vault-ask-box textarea {
        min-height: 50px;
        box-sizing: border-box;
        padding: 13px 0;
        color: var(--pop-ink);
        font-size: 1rem;
        line-height: 24px;
    }
    .vault-question-panel .vault-ask-box textarea::placeholder { color: rgba(21, 19, 15, 0.58); }

    .vault-question-panel .vault-ask-submit {
        position: static;
        align-self: end;
        min-width: 88px;
        min-height: 50px;
        border: 1px solid var(--pop-ink);
        border-radius: var(--vault-control-radius);
        background: var(--pop-pink);
        color: var(--pop-ink);
    }

    .vault-question-panel .vault-ask-submit:hover:not(:disabled),
    .vault-question-panel .vault-ask-submit:focus-visible {
        transform: translateY(-2px);
        background: var(--pop-lime);
        box-shadow: 0 3px 0 var(--pop-ink);
        outline: none;
    }

    .vault-question-panel .vault-ask-status { color: rgba(21, 19, 15, 0.76); }
    .vault-question-panel .vault-sources-label { color: var(--pop-ink); }
    .vault-question-panel .vault-ask-error { color: #7c0018; }

    .vault-question-panel .vault-result {
        --text-primary: var(--pop-ink);
        --text-secondary: rgba(21, 19, 15, 0.72);
        --type-paragraph-color: var(--pop-ink);
        border: 1px solid var(--pop-ink);
        border-radius: var(--vault-control-radius);
        background: var(--pop-cream);
        color: var(--pop-ink);
        box-shadow: none;
        backdrop-filter: none;
    }

    .vault-question-panel .vault-result__header,
    .vault-question-panel .vault-sources { border-color: var(--pop-line); }

    .vault-question-panel .vault-result__label { color: var(--pop-ink); }

    .vault-question-panel .vault-answer-text,
    .vault-question-panel .vault-answer-text p,
    .vault-question-panel .vault-answer-text li,
    .vault-question-panel .vault-answer-text blockquote,
    .vault-question-panel .vault-answer-text th,
    .vault-question-panel .vault-answer-text td,
    .vault-question-panel .vault-answer-text code,
    .vault-question-panel .vault-answer-text a {
        color: var(--pop-ink);
    }


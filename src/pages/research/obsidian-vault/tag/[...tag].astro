---
export const prerender = false;

import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { findNotesReferencing } from "../../../../lib/vault.js";
import { findIndexedNotesByWikiLink } from "../../../../lib/vault-note-index.js";

const { tag } = Astro.params;

if (!tag) {
    return Astro.redirect("/research/obsidian-vault");
}

const activeTagSlug = decodeURIComponent(tag).replace(/\.md$/i, "");
const activeTagName = activeTagSlug.replace(/-/g, " ");
const displayTagName = activeTagName.replace(/\b\w/g, (letter) => letter.toUpperCase());
const pageTitle = `${displayTagName} | Obsidian Vault`;

let notes = [];

try {
    notes = await findIndexedNotesByWikiLink(activeTagSlug);
} catch (indexError) {
    console.warn("[vault-tag-page] Indexed lookup failed; using GitHub fallback:", indexError);
    const legacyNotes = await findNotesReferencing(activeTagSlug);
    notes = legacyNotes.map((note) => {
        const slug = note.name.replace(/\.md$/i, "");
        return {
            name: note.name,
            title: slug.replace(/-/g, " "),
            slug,
            href: `/research/obsidian-vault/${encodeURIComponent(slug)}`,
        };
    });
}

Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=60, s-maxage=300, stale-while-revalidate=86400",
);
---

<BaseLayout
    title={pageTitle}
    description={`Notes connected to ${activeTagName} in Abodid Sahoo's public Obsidian vault.`}
    fullWidth={true}
    showGlobalGrid={false}
    bodyClass="vault-tag-minimal-page"
>
    <main class="vault-tag-page" aria-labelledby="tag-title">
        <article class="vault-tag-document">
            <div class="vault-tag-inner">
                <a href="/research/obsidian-vault" class="vault-tag-back">
                    <span aria-hidden="true">←</span>
                    <span>Back to Vault</span>
                </a>

                <header class="vault-tag-header">
                    <h1 id="tag-title">Connected notes</h1>
                    <p>Notes tagged with <strong>{displayTagName}</strong>.</p>
                </header>

                <section class="vault-tag-results" aria-labelledby="results-title">
                    <p class="vault-tag-status" aria-live="polite">
                        <span aria-hidden="true"></span>
                        <span>
                            {notes.length === 0
                                ? "No connected notes found."
                                : `${notes.length} connected ${notes.length === 1 ? "note" : "notes"} found.`}
                        </span>
                    </p>

                    <div class="vault-tag-results-heading">
                        <h2 id="results-title">Results</h2>
                        <p>{notes.length} {notes.length === 1 ? "note" : "notes"}</p>
                    </div>

                    <div class="vault-tag-list">
                        {notes.length > 0 ? (
                            notes.map((note) => (
                                <a class="vault-tag-note" href={note.href}>
                                    <span>{note.title}</span>
                                    <span class="vault-tag-note__arrow" aria-hidden="true">→</span>
                                </a>
                            ))
                        ) : (
                            <p class="vault-tag-empty">
                                No public notes currently reference “{activeTagName}”.
                            </p>
                        )}
                    </div>
                </section>
            </div>
        </article>
    </main>
</BaseLayout>

<style is:global>
    :root {
        --pop-blue: #2444ca;
        --pop-yellow: #ffe44f;
        --pop-purple: #5524c7;
        --pop-cream: #fff8e8;
        --pop-ink: #15130f;
        --pop-border: rgba(21, 19, 15, 0.72);
        --pop-line: rgba(21, 19, 15, 0.2);
    }

    body.vault-tag-minimal-page {
        background: var(--pop-blue);
        color: var(--pop-ink);
    }

    .vault-tag-page {
        width: 100%;
        padding: clamp(0.5rem, 2vw, 1.5rem);
        background: var(--pop-blue);
        font-family: "Satoshi-Variable", "Satoshi-Regular", "Poppins", sans-serif;
    }

    .vault-tag-document {
        width: min(100%, 900px);
        margin: 0 auto;
        border: 1px solid var(--pop-border);
        border-radius: clamp(16px, 2vw, 22px);
        background: var(--pop-cream);
    }

    .vault-tag-inner {
        width: min(100%, 720px);
        margin: 0 auto;
        padding: clamp(1.4rem, 5vw, 4.5rem) clamp(1.15rem, 5vw, 3.5rem);
    }

    .vault-tag-back {
        display: inline-flex;
        min-height: 44px;
        align-items: center;
        gap: 0.5rem;
        padding-inline: 0.2rem;
        color: var(--pop-ink);
        text-decoration: none;
        font-size: 1.05rem;
        font-weight: 680;
        line-height: 1;
        transition: background 160ms ease, padding 160ms ease;
    }

    .vault-tag-back:hover {
        padding-inline: 0.7rem;
        background: var(--pop-yellow);
    }

    .vault-tag-back:focus-visible,
    .vault-tag-note:focus-visible {
        outline: 3px solid var(--pop-purple);
        outline-offset: 3px;
    }

    .vault-tag-header {
        margin-top: clamp(2.5rem, 6vw, 4.5rem);
        padding-bottom: clamp(1.75rem, 4vw, 2.75rem);
        border-bottom: 1px solid var(--pop-line);
    }

    .vault-tag-header h1 {
        max-width: 20ch;
        margin: 0;
        color: var(--pop-ink);
        font-size: clamp(2rem, 4vw, 2.9rem);
        font-weight: 560;
        line-height: 1.08;
        letter-spacing: -0.04em;
        text-wrap: balance;
    }

    .vault-tag-header p {
        margin: 0.75rem 0 0;
        color: rgba(21, 19, 15, 0.72);
        font-size: 1rem;
        line-height: 1.5;
    }

    .vault-tag-header strong {
        color: var(--pop-ink);
        font-weight: 620;
    }

    .vault-tag-results {
        padding-top: clamp(1.75rem, 4vw, 2.75rem);
    }

    .vault-tag-status {
        display: flex;
        min-height: 44px;
        align-items: center;
        gap: 0.65rem;
        margin: 0;
        color: var(--pop-ink);
        font-size: 0.88rem;
        line-height: 1.4;
    }

    .vault-tag-status > span:first-child {
        display: block;
        width: 8px;
        height: 8px;
        flex: 0 0 auto;
        border-radius: 50%;
        background: currentColor;
    }

    .vault-tag-results-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1.5rem;
        padding: 0 0 0.85rem;
        border-bottom: 1px solid var(--pop-border);
    }

    .vault-tag-results-heading h2,
    .vault-tag-results-heading p {
        margin: 0;
        color: var(--pop-ink);
    }

    .vault-tag-results-heading h2 {
        font-size: 1rem;
        font-weight: 650;
        letter-spacing: -0.01em;
    }

    .vault-tag-results-heading p {
        color: rgba(21, 19, 15, 0.62);
        font-size: 0.82rem;
    }

    .vault-tag-list {
        display: grid;
    }

    .vault-tag-empty {
        margin: 0;
        padding: 1.25rem 0;
        color: rgba(21, 19, 15, 0.62);
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .vault-tag-note {
        display: flex;
        min-height: 68px;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 0;
        border-bottom: 1px solid var(--pop-line);
        color: var(--pop-ink);
        text-decoration: none;
        font-size: clamp(0.98rem, 1.6vw, 1.08rem);
        font-weight: 520;
        line-height: 1.35;
        letter-spacing: -0.01em;
        transition: background 160ms ease, padding 160ms ease;
    }

    .vault-tag-note:hover {
        padding-inline: 0.75rem;
        background: var(--pop-yellow);
    }

    .vault-tag-note__arrow {
        flex: 0 0 auto;
        font-size: 1.1rem;
    }

    @media (max-width: 720px) {
        .vault-tag-page {
            padding: 5px;
        }

        .vault-tag-document {
            border-radius: 14px;
        }

        .vault-tag-header h1 {
            font-size: clamp(2rem, 9vw, 2.8rem);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .vault-tag-back,
        .vault-tag-note {
            transition: none;
        }
    }
</style>

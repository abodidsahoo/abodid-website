---
export const prerender = false;

const { tag } = Astro.params;

if (!tag) {
    return Astro.redirect("/research/obsidian-vault", 308);
}

const cleanTag = decodeURIComponent(tag).replace(/\.md$/i, "").trim();
return Astro.redirect(`/research/obsidian-vault/topic/${encodeURIComponent(cleanTag)}`, 308);
---

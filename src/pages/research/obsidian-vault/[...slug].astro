---
export const prerender = false;
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getFileContent } from "../../../lib/github";
import {
    extractExplicitTags,
    normalizeWikiLinkTarget,
} from "../../../lib/vault-rag.js";
import { getIndexedNoteBySlug } from "../../../lib/vault-note-index.js";
import { marked } from "marked";
import ShareButtons from "../../../components/ShareButtons.jsx";
import {
    breadcrumbJsonLd,
    personJsonLd,
    seoIdentity,
    vaultNoteJsonLd,
} from "../../../lib/seoData";

const { slug } = Astro.params;
const fromVaultSearchId = Astro.url.searchParams.get("fromVaultSearch") || "";
const vaultSearchHref = fromVaultSearchId
    ? `/research/obsidian-vault?vaultSearch=${encodeURIComponent(fromVaultSearchId)}`
    : "";

if (!slug) {
    Astro.response.status = 404;
    return Astro.rewrite("/404");
}

function extractFirstUsefulParagraph(markdown: string): string {
    if (!markdown) return "";
    const lines = markdown.split("\n");
    const paragraphLines: string[] = [];
    let inFrontmatter = false;

    for (let i = 0; i < lines.length; i++) {
        const line = lines[i].trim();
        if (i === 0 && line === "---") {
            inFrontmatter = true;
            continue;
        }
        if (inFrontmatter) {
            if (line === "---") inFrontmatter = false;
            continue;
        }
        if (
            !line ||
            line.startsWith("#") ||
            line.startsWith("---") ||
            line.startsWith("Tags:") ||
            line.startsWith("tags:") ||
            line.startsWith("Date:") ||
            line.startsWith("date:") ||
            line.startsWith("![[") ||
            line.startsWith("![")
        ) {
            if (paragraphLines.length > 0) break;
            continue;
        }
        paragraphLines.push(line);
    }

    const rawParagraph = paragraphLines.join(" ");
    const cleaned = rawParagraph
        .replace(/\[\[([^\]|]+)\|([^\]]+)\]\]/g, "$2")
        .replace(/\[\[([^\]]+)\]\]/g, "$1")
        .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
        .replace(/[*_`#~]/g, "")
        .replace(/\s+/g, " ")
        .trim();

    if (cleaned.length > 160) {
        const truncated = cleaned.slice(0, 157);
        const lastSpace = truncated.lastIndexOf(" ");
        return (lastSpace > 100 ? truncated.slice(0, lastSpace) : truncated) + "...";
    }
    return cleaned;
}

let htmlContent = "";
let title = slug.split("/").pop() || "Note";
let firstTag = "";
let metaDescription = "";
let noteUpdatedAt: string | undefined = undefined;

try {
    const cleanSlug = slug.endsWith(".md") ? slug : `${slug}.md`;
    const filePathNotes = `6 - Main Notes/${cleanSlug}`;
    const noteSlug = cleanSlug.replace(/\.md$/i, "");
    let indexedNote = null;

    try {
        indexedNote = await getIndexedNoteBySlug(noteSlug);
        if (indexedNote?.updated_at) {
            noteUpdatedAt = indexedNote.updated_at;
        }
    } catch (indexError) {
        console.warn("[vault-note] Supabase content lookup failed; using GitHub fallback:", indexError);
    }

    const rawContent = indexedNote?.markdown_content || await getFileContent(filePathNotes);

    if (rawContent === null) {
        Astro.response.status = 404;
        return Astro.rewrite("/404");
    }

    metaDescription = extractFirstUsefulParagraph(rawContent);

    let content = rawContent;
    const explicitTags = Array.isArray(indexedNote?.tags) && indexedNote.tags.length > 0
        ? indexedNote.tags
        : extractExplicitTags(content);
    const tagSet = new Set(explicitTags.map(normalizeWikiLinkTarget).filter(Boolean));
    firstTag = indexedNote?.first_tag || explicitTags[0] || "";

    content = content.replace(/!\[\[(.*?)\]\]/g, (match, filename) => {
        const cleanFilename = filename.split("|")[0];
        return `![](/research/obsidian-vault/assets/${cleanFilename})`;
    });

    content = content.replace(
        /!\[(.*?)\]\((.*?)(?:7%20-%20Assets|7 - Assets)\/(.*?)\)/g,
        "![$1](/research/obsidian-vault/assets/$3)",
    );

    content = content.replace(/\[\[(.*?)\]\]/g, (match, raw) => {
        const parts = raw.split("|");
        const linkTargetRaw = (parts[0] || "").trim();
        const linkText = (parts[1] || parts[0] || "").trim();
        const linkTarget = linkTargetRaw.replace(/\.md$/i, "");
        const isTag = tagSet.has(normalizeWikiLinkTarget(linkTarget));
        const hrefBase = isTag ? "/research/obsidian-vault/tag/" : "/research/obsidian-vault/";
        return `[${linkText}](${hrefBase}${encodeURIComponent(linkTarget)})`;
    });

    const renderer = new marked.Renderer();
    renderer.image = ({ href, title, text }) => {
        if (
            href &&
            (href.includes("7 - Assets") || href.includes("7%20-%20Assets"))
        ) {
            const parts = href.split("/");
            const filename = parts[parts.length - 1];
            return `<img src="/research/obsidian-vault/assets/${filename}" alt="${text}" title="${title || ""}" />`;
        }
        return `<img src="${href}" alt="${text}" title="${title || ""}" />`;
    };

    htmlContent = await marked.parse(content, { renderer });
    title = cleanSlug.replace(/\.md$/i, "");
} catch (error) {
    console.error(error);
    htmlContent = "<p>Error loading note.</p>";
}

Astro.response.headers.set(
    "Cache-Control",
    fromVaultSearchId
        ? "private, no-store"
        : "public, max-age=60, s-maxage=300, stale-while-revalidate=86400",
);

const displayTitle = title.replace(/-/g, " ");
const currentFilePath = `6 - Main Notes/${title}.md`;
const relatedNoteHref = `/api/vault-related-note?file=${encodeURIComponent(currentFilePath)}${
    firstTag ? `&tag=${encodeURIComponent(firstTag)}` : ""
}`;

const finalMetaDescription =
    metaDescription ||
    `Read ${displayTitle}, a note from Abodid Sahoo's public Obsidian vault.`;
const noteCanonicalUrl = `${seoIdentity.siteUrl}/research/obsidian-vault/${encodeURIComponent(title)}`;

const structuredData = [
    personJsonLd(),
    breadcrumbJsonLd([
        { name: "Home", path: "/" },
        { name: "Research", path: "/research" },
        { name: "Obsidian Vault", path: "/research/obsidian-vault" },
        { name: displayTitle, path: `/research/obsidian-vault/${encodeURIComponent(title)}` },
    ]),
    vaultNoteJsonLd({
        title: displayTitle,
        description: finalMetaDescription,
        url: noteCanonicalUrl,
        dateModified: noteUpdatedAt,
    }),
];
---

<BaseLayout
    title={`${displayTitle} | Obsidian Vault`}
    description={finalMetaDescription}
    fullWidth={true}
    showGlobalGrid={false}
    bodyClass="vault-note-pop-page"
    structuredData={structuredData}
>
    <main class="vault-note-page">
        <article class="vault-note-document" aria-labelledby="note-title">
            <div class="vault-note-inner">
                {vaultSearchHref && (
                    <nav class="vault-note-nav" aria-label="Note navigation">
                        <a href={vaultSearchHref} class="vault-note-link">
                            <span aria-hidden="true">←</span> Back to search
                        </a>
                    </nav>
                )}

                <header class="vault-note-header">
                    <h1 id="note-title">{displayTitle}</h1>
                </header>

                <section class="vault-note-content" aria-label={`Note: ${displayTitle}`}>
                    <div class="markdown-body" set:html={htmlContent} />

                    <div class="vault-note-utility-row">
                        <a href="/research/obsidian-vault" class="vault-note-back-link">
                            <span aria-hidden="true">←</span>
                            <span>Back to Vault</span>
                        </a>

                        <ShareButtons
                            client:only="react"
                            title={displayTitle}
                            url={Astro.url.href}
                        />
                    </div>

                    <nav class="vault-note-end-nav" aria-label="Continue reading">
                        <a href={relatedNoteHref} class="vault-note-end-action vault-note-end-action--related">
                            <span>Read Another Related Note</span>
                            <span aria-hidden="true">→</span>
                        </a>
                    </nav>
                </section>
            </div>
        </article>
    </main>
</BaseLayout>

<style is:global>
    :root {
        --pop-blue: #2444ca;
        --pop-pink: #ff7eb5;
        --pop-yellow: #ffe44f;
        --pop-lime: #caff48;
        --pop-purple: #5524c7;
        --pop-cream: #fff8e8;
        --pop-ink: #15130f;
        --pop-border: rgba(21, 19, 15, 0.72);
        --pop-line: rgba(21, 19, 15, 0.2);
    }

    body.vault-note-pop-page {
        background: var(--pop-blue);
        color: var(--pop-ink);
    }

    .vault-note-pop-page .vault-note-page {
        width: 100%;
        padding: clamp(0.5rem, 2vw, 1.5rem);
        background: var(--pop-blue);
        font-family: "Satoshi-Variable", "Satoshi-Regular", "Poppins", sans-serif;
    }

    .vault-note-document {
        --text-primary: var(--pop-ink);
        --text-secondary: rgba(21, 19, 15, 0.72);
        --type-paragraph-color: var(--pop-ink);
        width: min(100%, 900px);
        margin: 0 auto;
        border: 1px solid var(--pop-border);
        border-radius: clamp(16px, 2vw, 22px);
        background: var(--pop-cream);
    }

    .vault-note-inner {
        width: min(100%, 720px);
        margin: 0 auto;
        padding: clamp(1.4rem, 5vw, 4.5rem) clamp(1.15rem, 5vw, 3.5rem);
    }

    .vault-note-nav,
    .vault-note-end-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem 1.15rem;
    }

    .vault-note-nav {
        margin-bottom: clamp(2.25rem, 6vw, 4.5rem);
    }

    .vault-note-link {
        display: inline-flex;
        min-height: 44px;
        align-items: center;
        gap: 0.4rem;
        color: var(--pop-ink);
        text-decoration: underline;
        text-decoration-color: var(--pop-line);
        text-underline-offset: 4px;
        font-size: 0.82rem;
        font-weight: 620;
        line-height: 1.2;
        transition: text-decoration-color 160ms ease, background 160ms ease;
    }

    .vault-note-link:hover {
        background: var(--pop-yellow);
        text-decoration-color: var(--pop-ink);
    }

    .vault-note-link:focus-visible,
    .markdown-body a:focus-visible {
        outline: 3px solid var(--pop-purple);
        outline-offset: 3px;
    }

    .vault-note-header {
        padding-bottom: clamp(1.75rem, 4vw, 2.75rem);
        border-bottom: 1px solid var(--pop-line);
    }

    .vault-note-header h1 {
        max-width: 22ch;
        margin: 0;
        color: var(--pop-ink);
        font-size: clamp(1.9rem, 4vw, 2.8rem);
        font-weight: 560;
        line-height: 1.1;
        letter-spacing: -0.035em;
        text-wrap: balance;
        overflow-wrap: anywhere;
    }

    .vault-note-content {
        padding-top: clamp(2rem, 5vw, 3.75rem);
    }

    .markdown-body {
        width: 100%;
        color: var(--pop-ink);
        font-family: var(--feature-obsidian-note-body-font, "Satoshi-Variable", "Satoshi-Regular", "Poppins", sans-serif);
        font-size: var(--feature-obsidian-note-body-size, clamp(1rem, 1.2vw, 1.08rem));
        font-weight: var(--feature-obsidian-note-body-weight, 420);
        line-height: var(--feature-obsidian-note-body-line-height, 1.7);
        letter-spacing: var(--feature-obsidian-note-body-letter-spacing, -0.006em);
        overflow-wrap: anywhere;
    }

    .markdown-body > :first-child {
        margin-top: 0;
    }

    .markdown-body > :last-child {
        margin-bottom: 0;
    }

    .markdown-body h1,
    .markdown-body h2,
    .markdown-body h3,
    .markdown-body h4,
    .markdown-body h5,
    .markdown-body h6 {
        color: var(--pop-ink);
        font-family: "Satoshi-Variable", "Satoshi-Regular", "Poppins", sans-serif;
        font-weight: 620;
        letter-spacing: -0.03em;
        text-wrap: balance;
    }

    .markdown-body h1 {
        margin: 2.75rem 0 1rem;
        font-size: clamp(1.85rem, 3.5vw, 2.55rem);
        line-height: 1.08;
    }

    .markdown-body h2 {
        margin: 2.75rem 0 0.9rem;
        font-size: clamp(1.55rem, 2.8vw, 2rem);
        line-height: 1.12;
    }

    .markdown-body h3 {
        margin: 2.25rem 0 0.75rem;
        font-size: clamp(1.25rem, 2vw, 1.55rem);
        line-height: 1.2;
    }

    .markdown-body h4,
    .markdown-body h5,
    .markdown-body h6 {
        margin: 2rem 0 0.7rem;
        font-size: 1.08rem;
        line-height: 1.25;
    }

    .markdown-body p,
    .markdown-body ul,
    .markdown-body ol,
    .markdown-body blockquote,
    .markdown-body pre,
    .markdown-body table {
        margin: 0 0 1.35rem;
    }

    .markdown-body p,
    .markdown-body li,
    .markdown-body th,
    .markdown-body td {
        color: var(--pop-ink);
    }

    .markdown-body ul,
    .markdown-body ol {
        padding-left: 1.35rem;
    }

    .markdown-body li {
        margin: 0.35rem 0;
        padding-left: 0.25rem;
    }

    .markdown-body li::marker {
        color: var(--pop-ink);
    }

    .markdown-body strong {
        font-weight: 720;
    }

    .markdown-body a {
        color: var(--pop-ink);
        text-decoration-line: underline;
        text-decoration-color: var(--pop-purple);
        text-decoration-thickness: 0.12em;
        text-underline-offset: 0.2em;
        transition: background 160ms ease;
    }

    .markdown-body a:hover {
        background: var(--pop-yellow);
    }

    .markdown-body blockquote {
        padding: 0 0 0 1.15rem;
        border-left: 2px solid var(--pop-border);
        color: rgba(21, 19, 15, 0.78);
        font-style: italic;
    }

    .markdown-body blockquote > :last-child {
        margin-bottom: 0;
    }

    .markdown-body blockquote p {
        color: rgba(21, 19, 15, 0.78);
    }

    .markdown-body code {
        padding: 0.12em 0.38em;
        border: 1px solid var(--pop-line);
        border-radius: 4px;
        background: var(--pop-yellow);
        font-family: "Space Mono", "Inconsolata", monospace;
        font-size: 0.87em;
        letter-spacing: -0.025em;
    }

    .markdown-body pre {
        max-width: 100%;
        overflow-x: auto;
        padding: 1.25rem;
        border: 1px solid var(--pop-border);
        border-radius: 8px;
        background: var(--pop-ink);
        color: var(--pop-cream);
    }

    .markdown-body pre code {
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: inherit;
    }

    .markdown-body hr {
        height: 1px;
        margin: clamp(2.5rem, 5vw, 4.5rem) 0;
        border: 0;
        background: var(--pop-border);
    }

    .markdown-body img {
        display: block;
        width: auto;
        max-width: 100%;
        height: auto;
        margin: 2rem auto;
        border: 1px solid var(--pop-border);
        border-radius: 8px;
    }

    .markdown-body table {
        display: block;
        width: 100%;
        overflow-x: auto;
        border-collapse: collapse;
        border: 1px solid var(--pop-border);
    }

    .markdown-body th,
    .markdown-body td {
        min-width: 10rem;
        padding: 0.75rem 0.9rem;
        border: 1px solid var(--pop-line);
        text-align: left;
        vertical-align: top;
    }

    .markdown-body th {
        background: rgba(255, 228, 79, 0.34);
        font-weight: 720;
    }

    .vault-note-utility-row {
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: center;
        gap: 1rem;
        width: 100%;
        margin: clamp(3rem, 6vw, 4.5rem) 0 0;
        padding: 1.5rem 0;
        border-top: 1px solid var(--pop-line);
        border-bottom: 1px solid var(--pop-line);
    }

    .vault-note-back-link {
        display: inline-flex;
        min-height: 52px;
        align-items: center;
        gap: 0.45rem;
        padding: 0.85rem 1.05rem;
        border: 1px solid var(--pop-border);
        border-radius: 14px;
        background: var(--pop-yellow);
        color: var(--pop-ink);
        text-decoration: none;
        font-size: clamp(0.95rem, 2vw, 1.08rem);
        font-weight: 680;
        line-height: 1.2;
        white-space: nowrap;
        transition: transform 180ms ease, background 180ms ease;
    }

    .vault-note-back-link:hover {
        background: var(--pop-lime);
        transform: translateY(-2px);
    }

    .vault-note-back-link:focus-visible {
        outline: 3px solid var(--pop-purple);
        outline-offset: 3px;
    }

    .vault-note-content .share-component {
        justify-self: end;
        width: auto;
        margin: 0;
        padding: 0;
        border: 0;
        font-family: "Satoshi-Variable", "Satoshi-Regular", "Poppins", sans-serif;
    }

    .vault-note-content .share-icons {
        gap: 0.5rem;
    }

    .vault-note-content .share-btn {
        width: 42px;
        height: 42px;
        border: 1px solid var(--pop-line);
        border-radius: 10px;
        background: transparent;
        color: var(--pop-ink);
    }

    .vault-note-content .share-btn:hover {
        border-color: var(--pop-border);
        background: var(--pop-yellow);
        color: var(--pop-ink);
        transform: translateY(-1px);
        box-shadow: none;
    }

    .vault-note-end-nav {
        display: block;
        margin-top: 8px;
    }

    .vault-note-end-action {
        display: flex;
        min-height: 64px;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem 1.1rem;
        border: 1px solid var(--pop-border);
        border-radius: 14px;
        color: var(--pop-ink);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 680;
        line-height: 1.2;
        transition: transform 180ms ease, background 180ms ease;
    }

    .vault-note-end-action--related {
        justify-content: space-between;
        width: 100%;
        min-height: 72px;
        padding-inline: clamp(1.1rem, 4vw, 1.5rem);
        background: var(--pop-pink);
        font-size: clamp(0.95rem, 2vw, 1.08rem);
    }

    .vault-note-end-action:hover {
        transform: translateY(-2px);
        background: var(--pop-yellow);
    }

    .vault-note-end-action:focus-visible {
        outline: 3px solid var(--pop-purple);
        outline-offset: 3px;
    }

    @media (max-width: 720px) {
        .vault-note-pop-page .vault-note-page {
            padding: 5px;
        }

        .vault-note-document {
            border-radius: 14px;
        }

        .vault-note-header h1 {
            font-size: clamp(1.9rem, 9vw, 2.8rem);
        }

        .vault-note-utility-row {
            gap: 0.75rem;
        }

        .vault-note-content .share-icons {
            gap: 0.25rem;
        }

        .vault-note-content .share-btn {
            width: 44px;
            height: 44px;
        }
    }

    @media (max-width: 400px) {
        .vault-note-inner {
            padding-inline: 0.75rem;
        }
    }

    @media (max-width: 340px) {
        .vault-note-utility-row {
            grid-template-columns: 1fr;
        }

        .vault-note-content .share-component {
            justify-self: start;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .vault-note-link,
        .vault-note-back-link,
        .vault-note-end-action,
        .vault-note-content .share-btn {
            transition: none;
        }
    }
</style>

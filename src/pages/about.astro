---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CV_DOWNLOAD_URL, CV_FILE_NAME } from "../lib/cv";
import { personJsonLd, profilePageJsonLd, breadcrumbJsonLd } from "../lib/seoData";

const pageTitle = "About Abodid Sahoo — Creative Director, Artist & Researcher";
const pageDescription =
  "Abodid Sahoo is a Royal College of Art alumnus, Apple Scholar, creative director, artist, and researcher in London building research-driven exhibitions, films, and digital prototypes.";

const structuredData = [
  personJsonLd(),
  profilePageJsonLd("/about", pageDescription),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "About", path: "/about" },
  ]),
];

const offerings = [
  {
    number: "01",
    title: "Spatial & Exhibition Design",
    description:
      "Transforming raw architectural spaces and archives into participatory public exhibitions and sensory environments.",
    highlight: "Into the Flux (10k+ visitors in 48h) · RCA Outernet · Frameless London",
  },
  {
    number: "02",
    title: "Creative Direction & Film",
    description:
      "Human-centred documentary cinema, brand films, and visual storytelling grounded in deep contextual research.",
    highlight: "VH1 & Rolling Stone Broadcast · Wieden+Kennedy · Hermosa Studio",
  },
  {
    number: "03",
    title: "AI Systems & Living Vaults",
    description:
      "Designing gesture-driven interfaces, human-attention experiments, and connected Obsidian knowledge architectures.",
    highlight: "Punctum Visual Attention Study · Gesture Control · AI Vault",
  },
  {
    number: "04",
    title: "Pedagogy & Masterclasses",
    description:
      "Hands-on workshops, autoethnographic writing, and masterclasses on filmmaking ethics, research, and creative workflows.",
    highlight: "Cambridge CDH Scholar · International Workshops · Raw Memoirs",
  },
];

const credentials = [
  {
    institution: "Royal College of Art (RCA), London",
    highlight: "MA Digital Direction · Apple Scholar",
    detail: "Awarded a full tuition scholarship by Apple to pursue an MA. Thesis, photobook, and exhibition showcased at the RCA Graduate Show 2023 in London.",
  },
  {
    institution: "National Institute of Design (NID), Ahmedabad",
    highlight: "M.Des · Film & Video Communication",
    detail: "Crafted short films and audio stories on anxiety, healing, and mental health. Left NID after a year and moved to London for a fully funded master's at the Royal College of Art.",
  },
  {
    institution: "National Institute of Technology (NIT), Rourkela",
    highlight: "B.Tech + M.Tech · Mechanical Engineering",
    detail: "Specialised in Mechatronics and Automation, aerial drone photography, and photogrammetry. President of the filmmaking club and Festival Director for Roots creative conference.",
  },
  {
    institution: "University of Cambridge (CDH)",
    highlight: "Full Bursary Award",
    detail: "Cambridge Digital Humanities — Cultural Heritage Data School research in computational archives and cultural datasets.",
  },
  {
    institution: "British Sociological Association (BSA)",
    highlight: "Session Chair · Poster Presentation · Research Roundtable",
    detail: "Chaired sessions attended by more than 200 participants, and presented a poster and research project in a roundtable to 50+ international delegates.",
  },
  {
    institution: "Selected Clients & Venues",
    highlight: "Creative Direction · Spatial Design",
    detail: "British Film Institute (BFI), Outernet London, Frameless, Wieden+Kennedy, Pursuit of Portraits, Odisha Tourism.",
  },
  {
    institution: "Broadcast & Press Recognition",
    highlight: "VH1 · Rolling Stone India",
    detail: "Music video broadcast on VH1. Featured across Homegrown, The Indian Express, Rolling Stone India, and RCA Official.",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
  fullWidth={true}
  hideWhatsAppButton={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="story-about-page"
>
  <main class="story-about-main">
    <!-- 1. Hero Block with Portrait Card -->
    <section class="about-hero-grid" aria-labelledby="about-name">
      <div class="about-hero-card">
        <div class="about-masthead" style="border-bottom: 0;">
          <p class="about-pill-tag">
            <img src="/images/map-pin.png" alt="" aria-hidden="true" />
            <span>London & Bengaluru</span>
          </p>
        </div>

        <h1 id="about-name" class="about-hero-title">Abodid Sahoo</h1>
        <hr class="about-hero-divider" aria-hidden="true" />
        <p class="about-hero-subtitle">Creative Director, Artist and Researcher.</p>

        <p class="about-hero-statement">
          I turn research, archives, and emerging technology into participatory experiences that help people connect.
        </p>

        <div class="about-actions-row">
          <a class="about-btn about-btn--primary" href={CV_DOWNLOAD_URL} download={CV_FILE_NAME} target="_blank" rel="noopener noreferrer">
            <span>Download 2026 CV (PDF)</span>
            <b aria-hidden="true">↓</b>
          </a>
        </div>
      </div>

      <aside class="about-portrait-wrapper">
        <figure class="about-portrait-card">
          <img
            src="https://photos.abodid.com/variants/landing-page-01/800/35-img-0652-edited-comp-0200b8a693.webp"
            alt="Abodid Sahoo"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </aside>
    </section>

    <!-- 2. Manifesto Core Banner -->
    <section class="about-manifesto-banner" aria-labelledby="manifesto-core-heading">
      <div class="about-manifesto-banner__inner">
        <p class="about-badge">
          The Ethos · Manifesto Core
        </p>
        <h2 id="manifesto-core-heading" class="about-manifesto-quote">
          Why Before What.
        </h2>
        <p class="about-manifesto-text">
          With a medium-agnostic approach, I start with the reason for why the project needs to exist and then figure out the medium which works best for the most effective creative expression.
        </p>
        <div class="about-actions-row about-manifesto-actions">
          <a class="about-btn about-btn--primary" href="/manifesto">
            <span>Read full manifesto</span>
            <b class="link-destination-arrow" aria-hidden="true">↗</b>
          </a>
        </div>
      </div>
    </section>

    <!-- 3. Core Offerings Grid -->
    <section class="about-panel about-panel--cream" aria-labelledby="offerings-heading">
      <header class="about-panel__header">
        <div>
          <p class="about-badge">
            Disciplines & Capabilities
          </p>
          <h2 id="offerings-heading" class="about-panel__title">What I build & direct</h2>
        </div>
        <a class="about-panel__link" href="/services"><span class="link-label">View services detail</span> <span class="link-destination-arrow" aria-hidden="true">↗</span></a>
      </header>

      <div class="about-offerings-grid">
        {offerings.map((item, idx) => (
          <article class={`about-offering-card about-offering-card--${idx + 1}`}>
            <div class="about-offering-card__top">
              <span class="about-offering-card__num">{item.number}</span>
              <h3>{item.title}</h3>
            </div>
            <p class="about-offering-card__desc">{item.description}</p>
            <div class="about-offering-card__footer">
              <span class="about-offering-card__tag">Reference / Proof:</span>
              <p>{item.highlight}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 4. Credentials & Recognition -->
    <section class="about-credentials" aria-labelledby="credentials-heading">
      <header class="about-credentials__header">
        <p class="about-badge" style="color: var(--pop-cream);">
          Education & Academic Recognition
        </p>
        <h2 id="credentials-heading" class="about-credentials__title">Credentials & Honors</h2>
      </header>

      <div class="about-credentials-grid">
        {credentials.map((cred, idx) => (
          <article class={`about-credential-card about-credential-card--${(idx % 6) + 1}`}>
            <div class="about-credential-card__top">
              <span class="about-credential-card__tag">{cred.highlight}</span>
              <h3 class="about-credential-card__title">{cred.institution}</h3>
            </div>
            <p class="about-credential-card__detail">{cred.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- 5. Collaborate / Action Panel -->
    <section class="about-cta-panel" aria-labelledby="cta-heading">
      <div class="about-cta-panel__copy">
        <p class="about-badge">
          Reviewer & Collaborator Direct Line
        </p>
        <h2 id="cta-heading" class="about-cta-panel__title">Let’s build something unforgettable.</h2>
        <p class="about-cta-panel__text">
          Open for creative direction, exhibition and spatial design, AI research prototypes, and brand films worldwide.
        </p>
        <div class="about-actions-row">
          <a class="about-btn about-btn--primary" href="/#enquiry">
            <span>Start a project</span>
            <b class="link-destination-arrow" aria-hidden="true">↗</b>
          </a>
          <a class="about-btn about-btn--secondary" href={CV_DOWNLOAD_URL} download={CV_FILE_NAME} target="_blank" rel="noopener noreferrer">
            <span>Download Complete CV (2026)</span>
            <b aria-hidden="true">↓</b>
          </a>
        </div>
      </div>
    </section>
  </main>


  <style is:global>
  :root {
    --pop-blue: #2444ca;
    --pop-pink: #ff7eb5;
    --pop-yellow: #ffe44f;
    --pop-lime: #caff48;
    --pop-orange: #ff875c;
    --pop-purple: #5524c7;
    --pop-cyan: #62e6ff;
    --pop-cream: #fff8e8;
    --pop-ink: #15130f;
    --pop-border: rgba(21, 19, 15, 0.78);
    --story-ink: var(--pop-ink);
    --story-cream: var(--pop-cream);
    --story-gutter: clamp(1rem, 3vw, 3.5rem);
    --home-next-gap: 8px;
    --home-next-border: 1px solid var(--pop-border);
    --home-next-radius-panel: clamp(18px, 2vw, 28px);
    --home-next-radius-card: clamp(14px, 1.5vw, 22px);
    --home-next-radius-control: 14px;
    --home-next-radius-media: clamp(10px, 1.2vw, 16px);
    --home-next-card-inset: 10px;
    --home-next-motion: 180ms ease;
  }

  html:has(body.story-about-page) {
    background: var(--pop-blue) !important;
  }

  body.story-about-page {
    margin: 0;
    padding: 0 !important;
    background: var(--pop-blue) !important;
    color: var(--pop-ink);
  }

  body.story-about-page main.page-content-full {
    overflow: visible;
    padding: 0 !important;
    max-width: 100% !important;
  }

  body.story-about-page :is(h1, h2, h3, h4, p, figure, dl, dd, ul, ol) {
    margin-top: 0;
  }

  body.story-about-page :is(a, button, summary) {
    -webkit-tap-highlight-color: transparent;
  }

  /* Main Shell Container */
  .story-about-main {
    padding: var(--home-next-gap);
    display: flex;
    flex-direction: column;
    gap: var(--home-next-gap);
    background: var(--pop-blue);
  }

  /* Badges & Dots */
  .about-badge {
    margin: 0 0 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: inherit;
    font: 750 clamp(0.68rem, 0.9vw, 0.78rem)/1.35 var(--font-mono, monospace);
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  /* 1. Hero Grid */
  .about-hero-grid {
    display: grid;
    grid-template-columns: minmax(320px, 0.95fr) minmax(0, 1.45fr);
    gap: var(--home-next-gap);
    align-items: stretch;
  }

  .about-hero-card {
    grid-column: 2;
    grid-row: 1;
    padding: clamp(1.75rem, 3.5vw, 4rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    border: var(--home-next-border);
    border-radius: var(--home-next-radius-panel);
    background: var(--pop-pink);
    color: var(--pop-ink);
  }

  .about-masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1rem, 1.8vw, 1.6rem);
    padding-bottom: clamp(0.75rem, 1.2vw, 1rem);
    border-bottom: 0;
  }

  .about-pill-tag {
    margin: 0;
    padding: 0.5rem 0.72rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--pop-ink);
    border-radius: var(--home-next-radius-control);
    background: var(--pop-yellow);
    color: var(--pop-ink);
    font: 750 0.62rem/1.2 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-pill-tag img {
    width: 15px;
    height: 15px;
    object-fit: contain;
  }

  .about-hero-title {
    margin: 0;
    color: var(--pop-ink) !important;
    font: 720 clamp(2.8rem, 5vw, 5.4rem)/0.86 var(--font-display, sans-serif) !important;
    letter-spacing: -0.07em !important;
  }

  .about-hero-divider {
    width: 100%;
    height: 0;
    margin: clamp(0.75rem, 1.4vw, 1.2rem) 0 clamp(0.7rem, 1.2vw, 1rem);
    border: 0;
    border-top: 1px solid var(--pop-ink);
    opacity: 0.72;
  }

  .about-hero-subtitle {
    margin: 0 0 clamp(1rem, 1.6vw, 1.5rem);
    color: var(--pop-ink) !important;
    font: 500 clamp(1.15rem, 1.8vw, 1.65rem)/1.15 var(--font-display, sans-serif) !important;
    letter-spacing: -0.025em !important;
  }

  .about-hero-statement {
    margin: 0 0 clamp(1rem, 1.6vw, 1.4rem);
    color: var(--pop-ink) !important;
    font: 320 clamp(1.75rem, 2.7vw, 2.85rem)/1.05 var(--font-display, sans-serif) !important;
    letter-spacing: -0.035em !important;
    text-wrap: balance;
  }

  .about-hero-lede {
    max-width: 720px;
    margin: 0 0 clamp(1.5rem, 2.5vw, 2.2rem);
    color: rgba(21, 19, 15, 0.85) !important;
    font: 450 clamp(0.95rem, 1.2vw, 1.08rem)/1.55 var(--font-body, sans-serif) !important;
  }

  .about-actions-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .about-btn {
    min-height: 48px;
    padding: 0 1.15rem;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    border: 1px solid var(--pop-ink);
    border-radius: var(--home-next-radius-control);
    color: var(--pop-ink) !important;
    font: 750 0.72rem/1 var(--font-mono, monospace) !important;
    letter-spacing: 0.08em;
    text-decoration: none !important;
    text-transform: uppercase;
    transition: transform var(--home-next-motion), box-shadow var(--home-next-motion);
  }

  .about-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 0 var(--pop-ink);
  }

  .about-btn--primary {
    background: var(--pop-cream);
  }

  .about-btn--secondary {
    background: var(--pop-yellow);
  }

  .about-btn--ghost {
    background: transparent;
    border: 1px solid currentColor;
  }

  /* Portrait Card */
  .about-portrait-wrapper {
    grid-column: 1;
    grid-row: 1;
    display: flex;
  }

  .about-portrait-card {
    width: 100%;
    margin: 0;
    padding: var(--home-next-card-inset);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    border: var(--home-next-border);
    border-radius: var(--home-next-radius-panel);
    background: var(--pop-cream);
    color: var(--pop-ink);
  }

  .about-portrait-card img {
    width: 100%;
    height: 100%;
    min-height: 380px;
    max-height: 560px;
    display: block;
    object-fit: cover;
    border: 1px solid var(--pop-ink);
    border-radius: var(--home-next-radius-media);
  }

  .about-portrait-card figcaption {
    padding: 1rem 0.5rem 0.4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--pop-ink);
  }

  .about-portrait-card figcaption strong {
    font: 700 1.05rem/1 var(--font-display, sans-serif);
    letter-spacing: -0.02em;
    color: inherit;
  }

  .about-portrait-card figcaption small {
    font: 700 0.65rem/1.2 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: inherit;
    opacity: 0.85;
  }

  /* 2. Manifesto Banner */
  .about-manifesto-banner {
    border: var(--home-next-border);
    border-radius: var(--home-next-radius-panel);
    background: var(--pop-yellow);
    color: var(--pop-ink);
  }

  .about-manifesto-banner__inner {
    padding: clamp(2rem, 4vw, 4.5rem);
    max-width: 1100px;
  }

  .about-manifesto-quote {
    margin: 0 0 clamp(1rem, 2vw, 1.5rem);
    color: var(--pop-ink) !important;
    font: 640 clamp(2rem, 4.5vw, 3.8rem)/0.96 var(--font-display, sans-serif) !important;
    letter-spacing: -0.045em !important;
    text-wrap: balance;
  }

  .about-manifesto-text {
    margin: 0;
    color: rgba(21, 19, 15, 0.9) !important;
    font: 450 clamp(1rem, 1.4vw, 1.22rem)/1.6 var(--font-body, sans-serif) !important;
    max-width: 960px;
  }

  .about-manifesto-actions {
    margin-top: clamp(1.5rem, 2.5vw, 2rem);
  }

  /* 3. Panel Sections */
  .about-panel {
    padding: clamp(1.75rem, 3.5vw, 4rem);
    border: var(--home-next-border);
    border-radius: var(--home-next-radius-panel);
    color: var(--pop-ink);
  }

  .about-panel--cream {
    background: var(--pop-cream);
  }

  .about-panel__header {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem 2rem;
    align-items: end;
  }

  .about-panel__title {
    margin: 0;
    color: var(--pop-ink) !important;
    font: 620 clamp(2.2rem, 4.8vw, 4.5rem)/0.92 var(--font-display, sans-serif) !important;
    letter-spacing: -0.055em !important;
  }

  .about-panel__link {
    padding-bottom: 0.3rem;
    color: var(--pop-ink) !important;
    font: 750 0.72rem/1 var(--font-mono, monospace) !important;
    letter-spacing: 0.08em;
    text-decoration: none !important;
    text-transform: uppercase;
  }

  .about-panel__link > .link-label {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3rem;
  }

  .about-panel__link:hover {
    opacity: 0.7;
  }

  /* Offerings Grid */
  .about-offerings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--home-next-gap);
  }

  .about-offering-card {
    padding: clamp(1.4rem, 2.4vw, 2.2rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 320px;
    border: 1px solid var(--pop-ink);
    border-radius: var(--home-next-radius-card);
    transition: transform var(--home-next-motion);
  }

  .about-offering-card:hover {
    transform: translateY(-2px);
  }

  .about-offering-card--1 {
    background: var(--pop-pink);
    color: var(--pop-ink);
  }

  .about-offering-card--2 {
    background: var(--pop-blue);
    color: var(--pop-cream);
    border-color: var(--pop-ink);
  }

  .about-offering-card--3 {
    background: var(--pop-yellow);
    color: var(--pop-ink);
  }

  .about-offering-card--4 {
    background: var(--pop-lime);
    color: var(--pop-ink);
  }

  .about-offering-card__top {
    margin-bottom: 1rem;
  }

  .about-offering-card__num {
    display: block;
    margin-bottom: 0.35rem;
    font: 750 0.75rem/1 var(--font-mono, monospace);
    letter-spacing: 0.1em;
    opacity: 0.85;
    color: inherit;
  }

  .about-offering-card h3 {
    margin: 0;
    color: inherit !important;
    font: 640 clamp(1.4rem, 2vw, 1.85rem)/1.05 var(--font-display, sans-serif) !important;
    letter-spacing: -0.035em !important;
  }

  .about-offering-card__desc {
    margin: 0 0 1.5rem;
    color: inherit !important;
    font: 450 0.95rem/1.5 var(--font-body, sans-serif) !important;
  }

  .about-offering-card__footer {
    padding-top: 0.85rem;
    border-top: 1px solid currentColor;
  }

  .about-offering-card__tag {
    display: block;
    margin-bottom: 0.25rem;
    font: 750 0.62rem/1.2 var(--font-mono, monospace);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    opacity: 0.8;
    color: inherit;
  }

  .about-offering-card__footer p {
    margin: 0;
    color: inherit !important;
    font: 600 0.85rem/1.4 var(--font-body, sans-serif) !important;
    letter-spacing: -0.01em;
  }

  /* 4. Credentials / Pop Editorial Cards Grid */
  .about-credentials {
    padding: clamp(1.75rem, 3.5vw, 4rem);
    border: var(--home-next-border);
    border-radius: var(--home-next-radius-panel);
    background: var(--pop-blue);
    color: var(--pop-cream);
  }

  .about-credentials__header {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .about-credentials__title {
    margin: 0;
    color: var(--pop-cream) !important;
    font: 620 clamp(2.4rem, 5vw, 4.8rem)/0.94 var(--font-display, sans-serif) !important;
    letter-spacing: -0.04em !important;
  }

  .about-credentials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--home-next-gap);
  }

  .about-credential-card {
    padding: clamp(1.4rem, 2.2vw, 2.1rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 240px;
    border: 1px solid var(--pop-ink);
    border-radius: var(--home-next-radius-card);
    transition: transform var(--home-next-motion), box-shadow var(--home-next-motion);
  }

  .about-credential-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 0 var(--pop-ink);
  }

  /* Pop Editorial Palette Rotation */
  .about-credential-card--1 {
    background: var(--pop-pink);
    color: var(--pop-ink);
  }

  .about-credential-card--2 {
    background: var(--pop-yellow);
    color: var(--pop-ink);
  }

  .about-credential-card--3 {
    background: var(--pop-cream);
    color: var(--pop-ink);
  }

  .about-credential-card--4 {
    background: var(--pop-lime);
    color: var(--pop-ink);
  }

  .about-credential-card--5 {
    background: var(--pop-cyan);

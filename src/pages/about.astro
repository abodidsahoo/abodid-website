---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CV_DOWNLOAD_URL, CV_FILE_NAME } from "../lib/cv";
import { personJsonLd, profilePageJsonLd, breadcrumbJsonLd } from "../lib/seoData";

const pageTitle = "About Abodid Sahoo — Creative Director, Artist & Researcher";
const pageDescription =
  "Abodid Sahoo is a Royal College of Art alumnus, Apple Scholar, creative director, artist, and researcher in London building research-driven exhibitions, films, and digital prototypes.";

const structuredData = [
  personJsonLd(),
  profilePageJsonLd("/about", pageDescription),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "About", path: "/about" },
  ]),
];

const offerings = [
  {
    number: "01",
    title: "Spatial & Exhibition Design",
    description:
      "Transforming raw architectural spaces and archives into participatory public exhibitions and sensory environments.",
    highlight: "Into the Flux (10k+ visitors in 48h) · RCA Outernet · Frameless London",
  },
  {
    number: "02",
    title: "Creative Direction & Film",
    description:
      "Human-centred documentary cinema, brand films, and visual storytelling grounded in deep contextual research.",
    highlight: "VH1 & Rolling Stone Broadcast · Wieden+Kennedy · Hermosa Studio",
  },
  {
    number: "03",
    title: "AI Systems & Living Vaults",
    description:
      "Designing gesture-driven interfaces, human-attention experiments, and connected Obsidian knowledge architectures.",
    highlight: "Punctum Visual Attention Study · Gesture Control · AI Vault",
  },
  {
    number: "04",
    title: "Pedagogy & Masterclasses",
    description:
      "Hands-on workshops, autoethnographic writing, and masterclasses on filmmaking ethics, research, and creative workflows.",
    highlight: "Cambridge CDH Scholar · International Workshops · Raw Memoirs",
  },
];

const credentials = [
  {
    institution: "Royal College of Art (RCA), London",
    badge: "Apple Scholarship · Full Tuition",
    detail: "World's #1 Art & Design institution (QS Ranking). Led and documented major year-end graduate shows across central London.",
  },
  {
    institution: "University of Cambridge (CDH)",
    badge: "Full Bursary Award",
    detail: "Cambridge Digital Humanities — Cultural Heritage Data School research in computational archives and cultural datasets.",
  },
  {
    institution: "Selected Clients & Venues",
    badge: "Creative Direction & Spatial",
    detail: "British Film Institute (BFI), Outernet London, Frameless, Wieden+Kennedy, Pursuit of Portraits, Odisha Tourism.",
  },
  {
    institution: "Broadcast & Press Recognition",
    badge: "VH1 & Rolling Stone",
    detail: "Music video broadcast on VH1. Featured across Homegrown, The Indian Express, Rolling Stone India, and RCA Official.",
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
  fullWidth={true}
  hideHeader={true}
  hideFooter={true}
  hideWhatsAppButton={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="story-about-page"
>
  <!-- Global Top Navigation -->
  <header class="story-nav">
    <a class="story-nav__brand" href="/" aria-label="Abodid Sahoo homepage">abodid.com</a>
    <nav class="story-nav__links" aria-label="Primary navigation">
      <a href="/#selected-work">Work</a>
      <a href="/research">Research</a>
      <a href="/services">Services</a>
      <a href="/experience">Experience</a>
      <a href="/about" class="is-active">About</a>
    </nav>
    <a class="story-nav__contact" href="/#enquiry">Hire me <span aria-hidden="true">↗</span></a>
    <details class="story-nav__mobile">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        <a href="/#selected-work">Work</a>
        <a href="/research">Research</a>
        <a href="/services">Services</a>
        <a href="/experience">Experience</a>
        <a href="/about">About</a>
        <a href="/#enquiry">Hire me ↗</a>
      </nav>
    </details>
  </header>

  <main class="story-about-main">
    <!-- 1. Hero Block with Portrait Card -->
    <section class="about-hero-grid" aria-labelledby="about-name">
      <div class="about-hero-card">
        <div class="about-masthead" style="border-bottom: 0;">
          <p class="about-badge">
            <span class="manifesto-dot" aria-hidden="true"></span>
            about.txt
          </p>
          <p class="about-pill-tag">
            <img src="/images/map-pin.png" alt="" aria-hidden="true" />
            <span>London & Bengaluru</span>
          </p>
        </div>

        <h1 id="about-name" class="about-hero-title">Abodid Sahoo</h1>
        <hr class="about-hero-divider" aria-hidden="true" />
        <p class="about-hero-subtitle">Creative Director, Artist and Researcher.</p>

        <p class="about-hero-statement">
          I turn research, archives, and emerging technology into participatory experiences that help people connect.
        </p>

        <p class="about-hero-lede">
          Royal College of Art alumnus and Apple Scholar. My work bridges spatial design, cinema, AI knowledge systems, and cultural documentation — moving between London underground garage exhibitions, institutional spaces, and interactive web prototypes.
        </p>

        <div class="about-actions-row">
          <a class="about-btn about-btn--primary" href={CV_DOWNLOAD_URL} download={CV_FILE_NAME}>
            <span>Download 2026 CV (PDF)</span>
            <b aria-hidden="true">↓</b>
          </a>
        </div>
      </div>

      <aside class="about-portrait-wrapper">
        <figure class="about-portrait-card">
          <img
            src="https://photos.abodid.com/variants/landing-page-01/800/35-img-0652-edited-comp-0200b8a693.webp"
            alt="Abodid Sahoo"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>
            <strong>Abodid Sahoo</strong>
            <small>RCA Alumnus · Apple Scholar</small>
          </figcaption>
        </figure>
      </aside>
    </section>

    <!-- 2. Manifesto Core Banner -->
    <section class="about-manifesto-banner" aria-labelledby="manifesto-core-heading">
      <div class="about-manifesto-banner__inner">
        <p class="about-badge">
          <span class="manifesto-dot manifesto-dot--pink" aria-hidden="true"></span>
          The Ethos · Manifesto Core
        </p>
        <h2 id="manifesto-core-heading" class="about-manifesto-quote">
          Why Before What.
        </h2>
        <p class="about-manifesto-text">
          With a medium-agnostic approach, I start with the reason for why the project needs to exist and then figure out the medium which works best for the most effective creative expression.
        </p>
        <div class="about-actions-row about-manifesto-actions">
          <a class="about-btn about-btn--primary" href="/manifesto">
            <span>Read full manifesto</span>
            <b aria-hidden="true">↗</b>
          </a>
        </div>
      </div>
    </section>

    <!-- 3. Core Offerings Grid -->
    <section class="about-panel about-panel--cream" aria-labelledby="offerings-heading">
      <header class="about-panel__header">
        <div>
          <p class="about-badge">
            <span class="manifesto-dot manifesto-dot--yellow" aria-hidden="true"></span>
            Disciplines & Capabilities
          </p>
          <h2 id="offerings-heading" class="about-panel__title">What I build & direct</h2>
        </div>
        <a class="about-panel__link" href="/services">View services detail <span aria-hidden="true">↗</span></a>
      </header>

      <div class="about-offerings-grid">
        {offerings.map((item, idx) => (
          <article class={`about-offering-card about-offering-card--${idx + 1}`}>
            <div class="about-offering-card__top">
              <span class="about-offering-card__num">{item.number}</span>
              <h3>{item.title}</h3>
            </div>
            <p class="about-offering-card__desc">{item.description}</p>
            <div class="about-offering-card__footer">
              <span class="about-offering-card__tag">Reference / Proof:</span>
              <p>{item.highlight}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 4. Mature Credentials & Recognition Grid -->
    <section class="about-panel about-panel--lime" aria-labelledby="credentials-heading">
      <header class="about-panel__header">
        <div>
          <p class="about-badge">
            <span class="manifesto-dot manifesto-dot--pink" aria-hidden="true"></span>
            Institutional Track Record
          </p>
          <h2 id="credentials-heading" class="about-panel__title">Mature Credentials & Proof</h2>
        </div>
        <a class="about-panel__link" href="/awards">View awards & honours <span aria-hidden="true">↗</span></a>
      </header>

      <div class="about-credentials-grid">
        {credentials.map((cred, idx) => (
          <article class="about-credential-card">
            <div class="about-credential-card__header">
              <span class="about-credential-card__index">{String(idx + 1).padStart(2, "0")}</span>
              <span class="about-credential-card__badge">{cred.badge}</span>
            </div>
            <h3>{cred.institution}</h3>
            <p>{cred.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- 5. Collaborate / Action Panel -->
    <section class="about-cta-panel" aria-labelledby="cta-heading">
      <div class="about-cta-panel__copy">
        <p class="about-badge">
          <span class="manifesto-dot" aria-hidden="true"></span>
          Reviewer & Collaborator Direct Line
        </p>
        <h2 id="cta-heading" class="about-cta-panel__title">Let’s build something unforgettable.</h2>
        <p class="about-cta-panel__text">
          Open for creative direction, exhibition and spatial design, AI research prototypes, and brand films worldwide.
        </p>
        <div class="about-actions-row">
          <a class="about-btn about-btn--primary" href="/#enquiry">
            <span>Start a project</span>
            <b aria-hidden="true">↗</b>
          </a>
          <a class="about-btn about-btn--secondary" href={CV_DOWNLOAD_URL} download={CV_FILE_NAME}>
            <span>Download Complete CV (2026)</span>
            <b aria-hidden="true">↓</b>
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Global Footer -->
  <footer class="story-footer" aria-label="Site directory and footer">
    <div class="story-footer__grid">
      <div class="story-footer__card story-footer__card--work">
        <div class="story-footer__card-header">
          <h3 class="story-footer__title">Work</h3>
          <span class="story-footer__index">01</span>
        </div>
        <nav aria-label="Work links">
          <a href="/work">All Projects <span aria-hidden="true">↗</span></a>
          <a href="/research">Research <span aria-hidden="true">↗</span></a>
          <a href="/photography">Photography <span aria-hidden="true">↗</span></a>
          <a href="/films">Filmmaking <span aria-hidden="true">↗</span></a>
          <a href="/blog">Writing <span aria-hidden="true">↗</span></a>
        </nav>
      </div>

      <div class="story-footer__card story-footer__card--curation">
        <div class="story-footer__card-header">
          <h3 class="story-footer__title">Curation</h3>
          <span class="story-footer__index">02</span>
        </div>
        <nav aria-label="Curation links">
          <a href="/resources">Resource Hub <span aria-hidden="true">↗</span></a>
          <a href="/moodboard">Visual Moodboard <span aria-hidden="true">↗</span></a>
          <a href="/xr-showcase">XR Showcase <span aria-hidden="true">↗</span></a>
          <a href="/curated-videos">Must Watch Videos <span aria-hidden="true">↗</span></a>
          <a href="/research/obsidian-vault">Obsidian Vault <span aria-hidden="true">↗</span></a>
        </nav>
      </div>

      <div class="story-footer__card story-footer__card--workshops">
        <div class="story-footer__card-header">
          <h3 class="story-footer__title">Workshops</h3>
          <span class="story-footer__index">03</span>
        </div>
        <nav aria-label="Workshops links">
          <a href="/obsidian-tutoring">Obsidian Tutoring <span aria-hidden="true">↗</span></a>
          <a href="/premiere-pro-masterclass">Video Editing Masterclass <span aria-hidden="true">↗</span></a>
          <a href="/workshops">Photography <span aria-hidden="true">↗</span></a>
          <a href="/workshops/video-editing-storytelling-class-1">Filmmaking <span aria-hidden="true">↗</span></a>
          <a href="/workshops">Autoethnography <span aria-hidden="true">↗</span></a>
        </nav>
      </div>

      <div class="story-footer__card story-footer__card--about">
        <div class="story-footer__card-header">
          <h3 class="story-footer__title">About</h3>
          <span class="story-footer__index">04</span>
        </div>
        <nav aria-label="About links">
          <a href="/about">About <span aria-hidden="true">↗</span></a>
          <a href="/awards">Awards <span aria-hidden="true">↗</span></a>
          <a href="/press">Press Mentions <span aria-hidden="true">↗</span></a>
          <a href="/manifesto">Manifesto <span aria-hidden="true">↗</span></a>
          <a href={CV_DOWNLOAD_URL} target="_blank" rel="noopener noreferrer">Resume <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </div>

    <div class="story-footer__bottom-card">
      <div class="story-footer__brand-group">
        <a class="story-footer__brand" href="/" aria-label="Abodid Sahoo homepage">abodid.com</a>
        <span class="story-footer__copyright">© {new Date().getFullYear()} Abodid Sahoo. All rights reserved.</span>
      </div>

      <div class="story-footer__social">
        <a href="https://www.instagram.com/abodid.sahoo" target="_blank" rel="noopener noreferrer">Instagram ↗</a>
        <a href="https://uk.linkedin.com/in/abodidsahoo" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a href="https://vimeo.com/abodidsahoo" target="_blank" rel="noopener noreferrer">Vimeo ↗</a>
        <a href="https://github.com/abodidsahoo" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>

      <div class="story-footer__legal">
        <a href="/privacy">Privacy Policy</a>
        <span aria-hidden="true">·</span>
        <a href="/sitemap">Sitemap</a>
        <span aria-hidden="true">·</span>
        <a href="/architecture">Architecture</a>
      </div>
    </div>
  </footer>

  <style is:global>
  :root {
    --pop-blue: #2444ca;
    --pop-pink: #ff7eb5;
    --pop-yellow: #ffe44f;
    --pop-lime: #caff48;
    --pop-orange: #ff875c;
    --pop-purple: #5524c7;
    --pop-cyan: #62e6ff;
    --pop-cream: #fff8e8;
    --pop-ink: #15130f;
    --pop-border: rgba(21, 19, 15, 0.78);
    --story-ink: var(--pop-ink);
    --story-cream: var(--pop-cream);
    --story-gutter: clamp(1rem, 3vw, 3.5rem);
    --home-next-gap: 8px;
    --home-next-border: 1px solid var(--pop-border);
    --home-next-radius-panel: clamp(18px, 2vw, 28px);
    --home-next-radius-card: clamp(14px, 1.5vw, 22px);
    --home-next-radius-control: 14px;
    --home-next-radius-media: clamp(10px, 1.2vw, 16px);
    --home-next-card-inset: 10px;
    --home-next-motion: 180ms ease;
  }

  html:has(body.story-about-page) {
    background: var(--pop-blue) !important;
  }

  body.story-about-page {
    margin: 0;
    padding: 0 !important;
    background: var(--pop-blue) !important;
    color: var(--pop-ink);
  }

  body.story-about-page main.page-content-full {
    overflow: visible;
    padding: 0 !important;
    max-width: 100% !important;
  }

  body.story-about-page :is(h1, h2, h3, h4, p, figure, dl, dd, ul, ol) {
    margin-top: 0;
  }

  body.story-about-page :is(a, button, summary) {
    -webkit-tap-highlight-color: transparent;
  }

  /* Sticky Header */
  body.story-about-page .story-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    min-height: 72px;
    padding: 0 var(--story-gutter);
    display: grid;
    grid-template-columns: minmax(140px, 1fr) auto minmax(220px, 1fr);
    align-items: center;
    gap: 1.5rem;
    border-bottom: 0;
    background: var(--pop-blue);
    color: var(--pop-cream);
  }

  body.story-about-page .story-nav a,
  body.story-about-page .story-nav summary {
    color: inherit;
    font: 700 0.72rem/1 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  body.story-about-page .story-nav__brand {
    width: fit-content;
    min-height: 42px;
    padding: 0 0.9rem;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--pop-ink);
    border-radius: var(--home-next-radius-control);
    background: var(--pop-yellow);
    color: var(--pop-ink) !important;
  }

  body.story-about-page .story-nav__links {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 2.5vw, 2.5rem);
  }

  body.story-about-page .story-nav__links a.is-active,
  body.story-about-page .story-nav__mobile nav a.is-active {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  body.story-about-page .story-nav__links a:hover,
  body.story-about-page .story-nav__links a:focus-visible {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  body.story-about-page .story-nav__contact {
    justify-self: end;
    min-height: 44px;
    padding: 0 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--pop-ink);
    border-radius: var(--home-next-radius-control);
    background: var(--pop-pink);
    color: var(--pop-ink) !important;
    transition: transform var(--home-next-motion), box-shadow var(--home-next-motion);
  }

  body.story-about-page .story-nav__contact:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 0 var(--story-ink);
  }

  body.story-about-page .story-nav__mobile {
    display: none;
  }

  /* Main Shell Container */
  .story-about-main {
    padding: var(--home-next-gap);
    display: flex;
    flex-direction: column;
    gap: var(--home-next-gap);
    background: var(--pop-blue);
  }

  /* Badges & Dots */
  .about-badge {
    margin: 0 0 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: inherit;
    font: 750 clamp(0.68rem, 0.9vw, 0.78rem)/1.35 var(--font-mono, monospace);
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .manifesto-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1px solid currentColor;
    background: var(--pop-yellow);
    display: inline-block;
    flex-shrink: 0;
  }

  .manifesto-dot--pink {
    background: var(--pop-pink);
  }

  .manifesto-dot--yellow {
    background: var(--pop-yellow);
  }

  /* 1. Hero Grid */
  .about-hero-grid {
    display: grid;
    grid-template-columns: minmax(320px, 0.95fr) minmax(0, 1.45fr);
    gap: var(--home-next-gap);
    align-items: stretch;
  }

  .about-hero-card {
    grid-column: 2;
    grid-row: 1;
    padding: clamp(1.75rem, 3.5vw, 4rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    border: var(--home-next-border);
    border-radius: var(--home-next-radius-panel);
    background: var(--pop-pink);
    color: var(--pop-ink);
  }

  .about-masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1rem, 1.8vw, 1.6rem);
    padding-bottom: clamp(0.75rem, 1.2vw, 1rem);
    border-bottom: 0;
  }

  .about-pill-tag {
    margin: 0;
    padding: 0.5rem 0.72rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--pop-ink);
    border-radius: var(--home-next-radius-control);
    background: var(--pop-yellow);
    color: var(--pop-ink);
    font: 750 0.62rem/1.2 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-pill-tag img {
    width: 15px;
    height: 15px;
    object-fit: contain;
  }

  .about-hero-title {
    margin: 0;
    color: var(--pop-ink) !important;
    font: 720 clamp(2.8rem, 5vw, 5.4rem)/0.86 var(--font-display, sans-serif) !important;
    letter-spacing: -0.07em !important;
  }

  .about-hero-divider {
    width: 100%;
    height: 0;
    margin: clamp(0.75rem, 1.4vw, 1.2rem) 0 clamp(0.7rem, 1.2vw, 1rem);
    border: 0;
    border-top: 1px solid var(--pop-ink);
    opacity: 0.72;
  }

  .about-hero-subtitle {
    margin: 0 0 clamp(1rem, 1.6vw, 1.5rem);
    color: var(--pop-ink) !important;
    font: 500 clamp(1.15rem, 1.8vw, 1.65rem)/1.15 var(--font-display, sans-serif) !important;
    letter-spacing: -0.025em !important;
  }

  .about-hero-statement {
    margin: 0 0 clamp(1rem, 1.6vw, 1.4rem);
    color: var(--pop-ink) !important;
    font: 320 clamp(1.75rem, 2.7vw, 2.85rem)/1.05 var(--font-display, sans-serif) !important;
    letter-spacing: -0.035em !important;
    text-wrap: balance;
  }

  .about-hero-lede {
    max-width: 720px;
    margin: 0 0 clamp(1.5rem, 2.5vw, 2.2rem);
    color: rgba(21, 19, 15, 0.85) !important;
    font: 450 clamp(0.95rem, 1.2vw, 1.08rem)/1.55 var(--font-body, sans-serif) !important;
  }

  .about-actions-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .about-btn {
    min-height: 48px;
    padding: 0 1.15rem;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    border: 1px solid var(--pop-ink);
    border-radius: var(--home-next-radius-control);
    color: var(--pop-ink) !important;
    font: 750 0.72rem/1 var(--font-mono, monospace) !important;
    letter-spacing: 0.08em;
    text-decoration: none !important;
    text-transform: uppercase;
    transition: transform var(--home-next-motion), box-shadow var(--home-next-motion);
  }

  .about-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 0 var(--pop-ink);
  }

  .about-btn--primary {
    background: var(--pop-cream);
  }

  .about-btn--secondary {
    background: var(--pop-yellow);
  }

  .about-btn--ghost {
    background: transparent;
    border: 1px solid currentColor;
  }

  /* Portrait Card */
  .about-portrait-wrapper {
    grid-column: 1;
    grid-row: 1;
    display: flex;
  }

  .about-portrait-card {
    width: 100%;
    margin: 0;
    padding: var(--home-next-card-inset);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    border: var(--home-next-border);

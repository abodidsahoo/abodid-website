---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InlineInquiryForm from "../../components/InlineInquiryForm.astro";
import HeroVaultTagsCard from "../../components/HeroVaultTagsCard";
import {
  cloudflareExhibitionFallbacks,
  getHomeStorytellingContent,
} from "../../lib/homeStorytellingContent";

export const prerender = false;

const content = await getHomeStorytellingContent();
const title = "Work — Abodid Sahoo";
const description = "A curated portfolio of multidisciplinary projects spanning research, creative direction, photography, film, exhibitions and technology.";

const heroSlideCopy: Record<string, { category: string; outcome: string }> = {
  "into-the-flux": {
    category: "Exhibition experience design",
    outcome: "10,000+ visitors",
  },
  punctum: {
    category: "Sociological research",
    outcome: "180,000+ images",
  },
  "gesture-control": {
    category: "Interaction prototype",
    outcome: "Interactive playful app",
  },
  "obsidian-vault": {
    category: "Knowledge ecosystem",
    outcome: "1,000+ interconnected notes",
  },
  "show-me-the-way": {
    category: "Music video",
    outcome: "Broadcast on VH1 & Rolling Stone",
  },
};
const heroSlides = content.projects.map((project) => ({
  ...project,
  ...heroSlideCopy[project.id],
}));
const heroProject = heroSlides[0] || content.projects[0];
const letterboxedHeroSlideIds = new Set(["gesture-control"]);
---

<BaseLayout
  title={title}
  description={description}
  fullWidth={true}
  hideWhatsAppButton={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="story-home-page"
>
  <link slot="head" rel="preload" as="image" href={heroProject.heroImage || heroProject.image} />

  <main class="story-home">
    <section class="story-hero" aria-labelledby="story-hero-heading">
      <div class="story-hero__copy" data-auto-contrast>
        <div class="story-hero__masthead">
          <p class="story-hero__name">Abodid Sahoo</p>
          <p class="story-hero__availability">
            <img src="/images/map-pin.png" alt="" aria-hidden="true" />
            <span>06 Selected Projects</span>
          </p>
        </div>
        <h1 id="story-hero-heading">
          Selected Work
        </h1>
        <p class="story-hero__statement">
          All of my projects begin with a question. And the question is usually a “Why?”
        </p>
        <p class="story-hero__lede">
          From there, I follow the idea into whatever form it needs: a film, a photo series, a piece of writing, a performance, an exhibition, or even an interactive digital experience.
        </p>
        <div class="story-actions">
          <a class="story-button story-button--primary" href="#selected-work">
            <span>Explore projects</span>
            <b aria-hidden="true">↓</b>
          </a>
          <a class="story-button story-button--secondary" href="/#enquiry">
            <span>Let’s build together</span>
            <span class="link-destination-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <aside class="story-hero__rail" aria-label="Featured work and interactive tags">
        <div class="story-hero__visual" aria-label="Selected projects showcase" data-auto-contrast data-hero-slider>
          <div class="story-hero__slider-track" role="region" aria-label="Featured projects carousel" aria-live="polite">
            {heroSlides.map((project, index) => (
              <a
                class={`story-hero__slide ${letterboxedHeroSlideIds.has(project.id) ? "story-hero__slide--letterboxed" : ""} ${index === 0 ? "is-active" : ""}`}
                href={project.href}
                data-hero-slide={index}
                aria-hidden={index === 0 ? "false" : "true"}
                tabindex={index === 0 ? "0" : "-1"}
                data-auto-contrast
              >
                {project.heroImage ? (
                  <img
                    src={project.heroImage}
                    alt={project.alt}
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                    decoding={index === 0 ? "sync" : "async"}
                  />
                ) : project.video ? (
                  <video
                    src={project.video}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="auto"
                    aria-label={project.alt}
                  />
                ) : (
                  <img
                    src={project.image}
                    alt={project.alt}
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                    decoding={index === 0 ? "sync" : "async"}
                    data-cloudflare-fallback
                  />
                )}
                <span data-auto-contrast>
                  <b>{project.title}</b>
                  <small>{project.category} · {project.outcome}</small>
                </span>
              </a>
            ))}
          </div>
        </div>

        <HeroVaultTagsCard client:load />
      </aside>
    </section>

    <section class="story-work" id="selected-work" aria-label="Selected work">
      <div class="story-work__grid">
        {content.projects.map((project, index) => (
          <a class={`story-project story-project--${index + 1}`} href={project.href} data-auto-contrast>
            <figure>
              {project.heroImage ? (
                <img
                  src={project.heroImage}
                  alt={project.alt}
                  loading="lazy"
                  decoding="async"
                />
              ) : project.video ? (
                <video
                  src={project.video}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="auto"
                  aria-label={project.alt}
                />
              ) : (
                <img src={project.image} alt={project.alt} loading="lazy" decoding="async" data-cloudflare-fallback />
              )}
            </figure>
            <div class="story-project__copy">
              <p><span>{String(index + 1).padStart(2, "0")}</span> <span>{project.category}</span></p>
              <h3>{project.title}</h3>
              <p class="story-project__summary">{project.summary}</p>
              <dl>
                <div><dt>Role</dt><dd>{project.role}</dd></div>
                <div><dt>Outcome</dt><dd>{project.outcome}</dd></div>
              </dl>
              <span class="story-project__link"><span>View project</span> <b class="link-destination-arrow" aria-hidden="true">↗</b></span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="story-enquiry" aria-label="Project enquiry">
      <InlineInquiryForm
        id="enquiry"
        heading="Write to me."
        intro=""
        sourceName="work-page-storytelling"
        variant="pop"
        interestOptions={[
          "Creative direction and experience design",
          "Exhibition or installation",
          "Storytelling product or prototype",
          "Photography, film or cultural documentation",
          "Ecosystem mapping or creative consulting",
          "Speaking, teaching or workshop",
          "Something else",
        ]}
      />
    </section>
  </main>

  <script is:inline define:vars={{ cloudflareExhibitionFallbacks }}>
    (() => {
      const localSafetyImage = "/images/exhibition-image-fallback.svg";
      const fallbackPool = Array.isArray(cloudflareExhibitionFallbacks)
        ? cloudflareExhibitionFallbacks.filter(Boolean)
        : [];

      document.querySelectorAll("img[data-cloudflare-fallback]").forEach((image) => {
        const startAt = fallbackPool.length
          ? Math.floor(Math.random() * fallbackPool.length)
          : 0;

        const useNextFallback = () => {
          const attempt = Number(image.dataset.fallbackAttempt || "0");
          const currentUrl = image.currentSrc || image.src;

          for (let offset = attempt; offset < fallbackPool.length; offset += 1) {
            const candidate = fallbackPool[(startAt + offset) % fallbackPool.length];
            image.dataset.fallbackAttempt = String(offset + 1);
            if (candidate && candidate !== currentUrl) {
              image.src = candidate;
              return;
            }
          }

          if (!image.dataset.localSafetyApplied) {
            image.dataset.localSafetyApplied = "true";
            image.src = localSafetyImage;
          }
        };

        image.addEventListener("error", useNextFallback);
        image.addEventListener("load", () => {
          if (image.naturalWidth < 2 || image.naturalHeight < 2) useNextFallback();
        });

        if (image.complete && (image.naturalWidth < 2 || image.naturalHeight < 2)) {
          useNextFallback();
        }
      });

      const parseRgb = (value) => {
        const channels = String(value).match(/[\d.]+/g)?.map(Number) || [];
        if (channels.length < 3 || (channels.length > 3 && channels[3] === 0)) return null;
        return channels.slice(0, 3);
      };

      const luminance = (channels) => channels
        .map((channel) => channel / 255)
        .map((channel) => channel <= 0.03928 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4)
        .reduce((sum, channel, index) => sum + channel * [0.2126, 0.7152, 0.0722][index], 0);

      const contrast = (first, second) => {
        const lighter = Math.max(first, second);
        const darker = Math.min(first, second);
        return (lighter + 0.05) / (darker + 0.05);
      };

      const ink = { colour: "#15130f", luminance: luminance([21, 19, 15]) };
      const cream = { colour: "#fff8e8", luminance: luminance([255, 248, 232]) };

      const applySurfaceContrast = () => {
        document.querySelectorAll("[data-auto-contrast]").forEach((surface) => {
          const background = parseRgb(getComputedStyle(surface).backgroundColor);
          if (!background) return;
          const surfaceLuminance = luminance(background);
          const inkRatio = contrast(surfaceLuminance, ink.luminance);
          const creamRatio = contrast(surfaceLuminance, cream.luminance);
          const foreground = inkRatio >= creamRatio ? ink : cream;
          surface.style.setProperty("--surface-foreground", foreground.colour);
          surface.style.color = foreground.colour;
          surface.dataset.contrastRatio = Math.max(inkRatio, creamRatio).toFixed(2);
        });
      };

      const initialiseHeroSlider = () => {
        const slider = document.querySelector("[data-hero-slider]");
        if (!slider) return;

        const slides = Array.from(slider.querySelectorAll("[data-hero-slide]"));
        if (slides.length <= 1) return;

        let currentIndex = 0;
        let timer = null;
        const INTERVAL_MS = 3800;

        const goToSlide = (nextIndex) => {
          const targetIndex = (nextIndex + slides.length) % slides.length;
          if (targetIndex === currentIndex) return;

          slides[currentIndex]?.classList.remove("is-active");
          slides[currentIndex]?.setAttribute("aria-hidden", "true");
          slides[currentIndex]?.setAttribute("tabindex", "-1");

          currentIndex = targetIndex;

          slides[currentIndex]?.classList.add("is-active");
          slides[currentIndex]?.setAttribute("aria-hidden", "false");
          slides[currentIndex]?.setAttribute("tabindex", "0");

          if (typeof applySurfaceContrast === "function") {
            applySurfaceContrast();
          }
        };

        const startTimer = () => {
          stopTimer();
          timer = setInterval(() => {
            goToSlide(currentIndex + 1);
          }, INTERVAL_MS);
        };

        const stopTimer = () => {
          if (timer) {
            clearInterval(timer);
            timer = null;
          }
        };

        let touchStartX = 0;
        let touchEndX = 0;

        slider.addEventListener("touchstart", (e) => {
          touchStartX = e.changedTouches && e.changedTouches[0] ? e.changedTouches[0].screenX : 0;
        }, { passive: true });

        slider.addEventListener("touchend", (e) => {
          touchEndX = e.changedTouches && e.changedTouches[0] ? e.changedTouches[0].screenX : 0;
          const diff = touchStartX - touchEndX;
          if (Math.abs(diff) > 40) {
            if (diff > 0) {
              goToSlide(currentIndex + 1);
            } else {
              goToSlide(currentIndex - 1);
            }
            startTimer();
          }
        }, { passive: true });

        slider.addEventListener("keydown", (e) => {
          if (e.key === "ArrowLeft") {
            goToSlide(currentIndex - 1);
            startTimer();
          } else if (e.key === "ArrowRight") {
            goToSlide(currentIndex + 1);
            startTimer();
          }
        });

        startTimer();
      };

      const ensureVideosPlay = () => {
        document.querySelectorAll("video[autoplay]").forEach((element) => {
          if (!(element instanceof HTMLVideoElement)) return;
          const video = element;
          const playVideo = () => {
            if (video.paused) video.play().catch(() => {});
          };

          if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
            playVideo();
          } else {
            video.addEventListener("canplay", playVideo, { once: true });
            if (video.readyState === HTMLMediaElement.HAVE_NOTHING) video.load();
          }

          if (video.dataset.viewportPlaybackReady !== "true") {
            video.dataset.viewportPlaybackReady = "true";
            const observer = new IntersectionObserver((entries) => {
              if (entries.some((entry) => entry.isIntersecting)) playVideo();
            }, { threshold: 0.1 });
            observer.observe(video);
          }
        });
      };

      const initialisePage = () => {
        applySurfaceContrast();
        initialiseHeroSlider();
        ensureVideosPlay();
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initialisePage);
      } else {
        requestAnimationFrame(initialisePage);
      }
      document.addEventListener("astro:page-load", initialisePage);
      window.addEventListener("pageshow", ensureVideosPlay);
    })();
  </script>
</BaseLayout>

<style is:global>
  :root {
    --pop-blue: #2444ca;
    --pop-pink: #ff7eb5;
    --pop-yellow: #ffe44f;
    --pop-lime: #caff48;
    --pop-orange: #ff875c;
    --pop-purple: #5524c7;
    --pop-cyan: #62e6ff;
    --pop-cream: #fff8e8;
    --pop-ink: #15130f;
    --pop-border: rgba(21, 19, 15, 0.78);
    --story-ink: var(--pop-ink);
    --story-cream: var(--pop-cream);
    --story-paper: var(--pop-cream);
    --story-cobalt: var(--pop-blue);
    --story-coral: var(--pop-orange);
    --story-yellow: var(--pop-yellow);
    --story-green: var(--pop-lime);
    --story-line: rgba(21, 19, 15, 0.24);
    --story-gutter: clamp(1rem, 3vw, 3.5rem);
    --home-next-gap: 8px;
    --home-next-border: 1px solid var(--pop-border);
    --home-next-radius-panel: clamp(18px, 2vw, 28px);
    --home-next-radius-card: clamp(14px, 1.5vw, 22px);
    --home-next-radius-control: 14px;
    --home-next-radius-media: clamp(10px, 1.2vw, 16px);
    --home-next-card-inset: 10px;
    --home-next-control-height: 52px;
    --home-next-motion: 180ms ease;

    /* Hero Typography Tokens */
    --home-next-hero-name-font: 720 clamp(2.2rem, 3.8vw, 4.2rem)/.85 var(--font-display, sans-serif);
    --home-next-hero-name-spacing: -.06em;
    --home-next-hero-title-font: 480 clamp(1.15rem, 1.6vw, 1.7rem)/1.15 var(--font-display, sans-serif);
    --home-next-hero-title-spacing: -.02em;
    --home-next-hero-statement-font: 300 clamp(1.85rem, 3vw, 3.2rem)/.98 var(--font-display, sans-serif);
    --home-next-hero-statement-spacing: -.025em;
    --home-next-hero-lede-font: 450 clamp(.92rem, 1.05vw, 1.05rem)/1.45 var(--font-body, sans-serif);
    --home-next-hero-badge-font: 750 .62rem/1.2 var(--font-mono, monospace);
  }

  body.story-home-page {
    margin: 0;
    padding: 0 !important;
    background: var(--pop-blue) !important;
    color: var(--story-ink);
  }
  body.story-home-page main.page-content-full {
    overflow: visible;
  }
  body.story-home-page :is(h1, h2, h3, p, figure, dl, dd, ul) {
    margin-top: 0;
  }
  body.story-home-page :is(a, button, summary) {
    -webkit-tap-highlight-color: transparent;
  }
  [data-auto-contrast] {
    color: var(--surface-foreground, inherit);
  }
  [data-auto-contrast] :where(h1, h2, h3, h4, p, span, small, strong, b, dt, dd, a) {
    color: inherit;
  }

  .story-home {
    overflow: clip;
  }
  .story-hero {
    min-height: auto;
    padding: var(--home-next-gap);
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(340px, 1fr);
    gap: var(--home-next-gap);
    align-items: stretch;
    background: var(--pop-blue);
  }
  .story-hero__copy {
    max-width: none;
    padding: clamp(1.75rem, 3vw, 3.2rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    border: var(--home-next-border);
    border-radius: var(--home-next-radius-panel);
    background: var(--pop-pink);
    color: var(--pop-ink);
  }
  .story-eyebrow {
    margin-bottom: 1.25rem;
    font: 750 clamp(.68rem, .9vw, .78rem)/1.35 var(--font-mono, monospace);
    letter-spacing: .11em;
    text-transform: uppercase;
  }
  .story-hero__masthead {
    margin-bottom: clamp(1.15rem, 2vw, 1.8rem);
    padding-bottom: clamp(.85rem, 1.4vw, 1.2rem);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid currentColor;
  }
  .story-hero__name {
    margin: 0;
    color: inherit;
    font: var(--home-next-hero-name-font);
    letter-spacing: var(--home-next-hero-name-spacing);
  }
  .story-hero__availability {
    margin: 0;
    padding: .55rem .72rem;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: .34rem;
    border: 1px solid var(--pop-ink);
    border-radius: var(--home-next-radius-control);
    background: var(--pop-yellow);
    color: var(--pop-ink) !important;
    font: var(--home-next-hero-badge-font);
    letter-spacing: .08em;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .story-hero__availability img {
    width: 17px;
    height: 17px;
    flex: 0 0 auto;
    display: block;
    object-fit: contain;
  }
  .story-hero h1 {
    max-width: 36ch;
    margin-bottom: clamp(.75rem, 1.1vw, 1rem);
    color: inherit;
    font: var(--home-next-hero-title-font);
    letter-spacing: var(--home-next-hero-title-spacing);
    text-wrap: balance;
  }
  .story-hero__statement {
    max-width: 24ch;
    margin: 0 0 clamp(1.2rem, 1.8vw, 1.6rem);
    color: inherit;
    font: var(--home-next-hero-statement-font);
    letter-spacing: var(--home-next-hero-statement-spacing);
    text-wrap: balance;
  }
  .story-hero__lede {
    max-width: 820px;
    margin-bottom: clamp(1.25rem, 2vw, 1.6rem);
    color: rgba(23, 21, 15, .78);
    font: var(--home-next-hero-lede-font);
  }
  .story-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: auto;
    padding-top: 1rem;
  }
  .story-button {
    min-height: 48px;
    padding: 0 1.05rem;
    display: inline-flex;
    align-items: center;
    gap: .7rem;
    border: 1px solid var(--pop-ink);
    border-radius: var(--home-next-radius-control);
    color: var(--pop-ink);
    font: 750 .72rem/1 var(--font-mono, monospace);
    letter-spacing: .08em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .story-button--primary {
    background: var(--pop-cream);
    color: var(--pop-ink);
  }
  .story-button--secondary {
    background: var(--pop-yellow);
  }
  .story-button:hover {
    transform: translateY(-2px);
  }

  .story-hero__rail {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--home-next-gap);
  }
  .story-hero__visual {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    min-height: 240px;
    max-height: 360px;
    padding: var(--home-next-card-inset);
    border: var(--home-next-border);
    border-radius: var(--home-next-radius-panel);
    background: var(--pop-blue);
    overflow: hidden;
    display: flex;
  }
  .story-hero__visual a {
    color: inherit;
    text-decoration: none;
  }
  .story-hero__slider-track {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    display: block;
    overflow: hidden;
    border: 1px solid var(--pop-ink);
    border-radius: var(--home-next-radius-media);
    background: var(--pop-pink);
    box-shadow: none;
  }
  .story-hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 550ms cubic-bezier(0.2, 0.8, 0.2, 1), transform 550ms cubic-bezier(0.2, 0.8, 0.2, 1);
    transform: scale(1.02);
    overflow: hidden;
  }
  .story-hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: scale(1);
    z-index: 2;
  }
  .story-hero__slide img,
  .story-hero__slide video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 600ms ease;
    pointer-events: none;
  }
  .story-hero__slide:hover img,
  .story-hero__slide:hover video {
    transform: scale(1.025);
  }
  .story-hero__slide > span {
    position: absolute;
    inset: auto 0 0;
    padding: 0.85rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    background: var(--pop-pink);
    border-top: 1px solid var(--pop-ink);
    z-index: 3;
  }
  .story-hero__slide:nth-child(6n + 1) > span { background: var(--pop-pink); color: var(--pop-ink); }
  .story-hero__slide:nth-child(6n + 2) > span { background: var(--pop-cream); color: var(--pop-ink); }
  .story-hero__slide:nth-child(6n + 3) > span { background: var(--pop-yellow); color: var(--pop-ink); }
  .story-hero__slide:nth-child(6n + 4) > span { background: var(--pop-lime); color: var(--pop-ink); }
  .story-hero__slide:nth-child(6n + 5) > span { background: var(--pop-pink); color: var(--pop-ink); }
  .story-hero__slide:nth-child(6n + 6) > span { background: var(--pop-yellow); color: var(--pop-ink); }
  .story-hero__slide b { font: 700 0.95rem/1.1 var(--font-display, sans-serif); }
  .story-hero__slide small { font: 700 .62rem/1.3 var(--font-mono, monospace); text-align: right; text-transform: uppercase; }
  .story-hero__slide--letterboxed { display: grid; grid-template-rows: minmax(0, 1fr) auto; background: var(--pop-pink); }
  .story-hero__slide--letterboxed img,
  .story-hero__slide--letterboxed video { max-width: calc(100% - 24px); max-height: calc(100% - 24px); width: auto; height: auto; min-height: 0; place-self: center; object-fit: contain; border-radius: clamp(10px, 1.2vw, 14px); border: 1px solid var(--pop-ink); box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08); }
  .story-hero__slide--letterboxed > span { position: static; }
  .story-hero__slide--letterboxed:hover img,
  .story-hero__slide--letterboxed:hover video { transform: scale(1.015); }

  body.story-home-page a:hover,
  body.story-home-page a:focus-visible {
    color: inherit;
    text-decoration: none;
  }

  .story-work {
    padding: var(--home-next-gap);
    background: var(--pop-blue);
    color: var(--pop-cream);
  }
  .story-work__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));

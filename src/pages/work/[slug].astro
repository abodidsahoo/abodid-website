---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import PortfolioProjectRenderer from "../../components/portfolio/PortfolioProjectRenderer.jsx";
import { getPortfolioSlugRedirect, getPublishedPortfolioProject } from "../../lib/portfolio/services";
import {
  breadcrumbJsonLd,
  creativeWorkJsonLd,
  personJsonLd,
  seoIdentity,
} from "../../lib/seoData";

import { storytellingProjects } from "../../lib/homeStorytellingContent";
import { researchProjectBySlug } from "../../data/researchPortfolio";

const { slug } = Astro.params;
let project = slug ? await getPublishedPortfolioProject(slug) : null;

if (!project && slug) {
  const redirectSlug = await getPortfolioSlugRedirect(slug);
  if (redirectSlug) return Astro.redirect(`/work/${redirectSlug}`, 301);

  // Fallback to storytellingProjects or researchProjects
  const fallbackStory = storytellingProjects.find((p) => p.id === slug || p.href === `/work/${slug}`);
  const fallbackResearch = researchProjectBySlug[slug];
  if (fallbackStory) {
    project = {
      id: fallbackStory.id,
      slug: fallbackStory.id,
      title: fallbackStory.title,
      oneLineDescription: fallbackStory.summary,
      context: fallbackStory.summary,
      role: fallbackStory.role,
      outcomeHeading: fallbackStory.category,
      outcomeText: fallbackStory.outcome,
      coverUrl: fallbackStory.image,
      video: fallbackStory.video,
      coverAlt: fallbackStory.alt,
      taxonomies: [
        { groupType: "role", label: fallbackStory.role },
        { groupType: "genre", label: fallbackStory.category },
      ],
      blocks: [],
      searchVisible: true,
    };
  } else if (fallbackResearch) {
    project = {
      id: fallbackResearch.slug,
      slug: fallbackResearch.slug,
      title: fallbackResearch.title,
      oneLineDescription: fallbackResearch.premise || fallbackResearch.intro,
      context: fallbackResearch.deeper,
      role: fallbackResearch.role,
      outcomeHeading: fallbackResearch.metaValue,
      outcomeText: fallbackResearch.outcome,
      coverUrl: fallbackResearch.images[0]?.src,
      coverAlt: fallbackResearch.images[0]?.alt,
      taxonomies: (fallbackResearch.themes || []).map((t) => ({ groupType: "theme", label: t })),
      blocks: [],
      searchVisible: true,
    };
  } else {
    Astro.response.status = 404;
    return Astro.rewrite("/404");
  }
}

// Compute next project for footer navigation
const currentIndex = storytellingProjects.findIndex((p) => p.id === slug || p.href === `/work/${slug}`);
const nextProject = currentIndex >= 0
  ? storytellingProjects[(currentIndex + 1) % storytellingProjects.length]
  : storytellingProjects.length > 0
  ? storytellingProjects[0]
  : null;

const title = project.seoTitle || project.title;
const description = project.metaDescription || project.oneLineDescription;
const image = project.socialImageUrl || project.coverUrl;
const canonicalUrl = `${seoIdentity.siteUrl}/work/${project.slug}`;

const taxonomiesList = Array.isArray(project.taxonomies)
  ? project.taxonomies.map((t: any) => t?.title || t?.name || "").filter(Boolean)
  : [];

const structuredData = [
  personJsonLd(),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Work", path: "/work" },
    { name: project.title, path: `/work/${project.slug}` },
  ]),
  creativeWorkJsonLd({
    title: project.title,
    description: description || project.title,
    url: canonicalUrl,
    image: image || undefined,
    dateCreated: project.yearStart ? String(project.yearStart) : undefined,
    dateModified: (project as any).updatedAt || (project as any).updated_at || undefined,
    keywords: taxonomiesList.length > 0 ? taxonomiesList : undefined,
  }),
];
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={project.coverAlt}
  type="article"
  noindex={!project.searchVisible}
  structuredData={structuredData}
  useDynamicOgImage={!project.socialImageUrl}
  fullWidth={true}
  bodyClass="work-project-page"
  analyticsProjectId={project.id}
>
  <PortfolioProjectRenderer project={project} nextProject={nextProject} client:load />
</BaseLayout>

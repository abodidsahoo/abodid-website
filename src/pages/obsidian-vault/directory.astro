---

import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllPublicVaultNotes } from "../../lib/vault-note-index.js";
import {
  breadcrumbJsonLd,
  personJsonLd,
  seoIdentity,
} from "../../lib/seoData";

const notes = await getAllPublicVaultNotes().catch(() => []);

// Group notes by first alphanumeric letter
const groupedNotes = new Map<string, typeof notes>();

for (const note of notes) {
  const firstChar = (note.title.trim()[0] || "#").toUpperCase();
  const groupKey = /[A-Z]/.test(firstChar) ? firstChar : "#";
  if (!groupedNotes.has(groupKey)) {
    groupedNotes.set(groupKey, []);
  }
  groupedNotes.get(groupKey)!.push(note);
}

const sortedGroups = Array.from(groupedNotes.keys()).sort((a, b) => {
  if (a === "#") return 1;
  if (b === "#") return -1;
  return a.localeCompare(b);
});

const pageTitle = "Complete Notes Directory | Obsidian Vault";
const pageDescription = `Browse all ${notes.length} public notes from Abodid Sahoo’s public Obsidian vault and second brain.`;

const structuredData = [
  personJsonLd(),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Obsidian Vault", path: "/obsidian-vault" },
    { name: "Notes Directory", path: "/obsidian-vault/directory" },
  ]),
];

// Vercel purges CDN caches on every deployment, so s-maxage can be very high.
// The first visitor after each deploy pays the Supabase cost; every subsequent
// visitor within the same deploy lifecycle is served instantly from the edge.
// max-age is kept short (60s) because browser caches are NOT purged on deploy.
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, s-maxage=31536000, stale-while-revalidate=31536000"
);
Astro.response.headers.set(
  "Vercel-CDN-Cache-Control",
  "s-maxage=31536000, stale-while-revalidate=31536000"
);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  fullWidth={true}
  showGlobalGrid={false}
  bodyClass="vault-directory-page"
  structuredData={structuredData}
>
  <main class="directory-shell">
    <div class="directory-card">
      <nav class="directory-nav" aria-label="Breadcrumb navigation">
        <a href="/obsidian-vault" class="directory-back-link">
          <span aria-hidden="true">←</span>
          <span>Back to Vault Home</span>
        </a>
      </nav>

      <header class="directory-header">
        <p class="directory-eyebrow">Public Knowledge Base</p>
        <h1>Complete Notes Directory</h1>
        <p class="directory-intro">
          A server-rendered index of all {notes.length} public notes from Abodid Sahoo’s Obsidian vault.
        </p>

        <nav class="letter-quicknav" aria-label="Alphabetical jump navigation">
          {sortedGroups.map((letter) => (
            <a href={`#group-${letter}`} class="letter-jump-link">
              {letter}
            </a>
          ))}
        </nav>
      </header>

      <div class="directory-body">
        {notes.length === 0 ? (
          <p class="directory-empty">No notes currently available.</p>
        ) : (
          sortedGroups.map((letter) => {
            const letterNotes = groupedNotes.get(letter) || [];
            return (
              <section class="letter-section" id={`group-${letter}`} aria-labelledby={`letter-heading-${letter}`}>
                <div class="letter-header">
                  <h2 id={`letter-heading-${letter}`} class="letter-badge">{letter}</h2>
                  <span class="letter-count">{letterNotes.length} {letterNotes.length === 1 ? 'note' : 'notes'}</span>
                </div>
                <ul class="notes-directory-list">
                  {letterNotes.map((note) => (
                    <li class="directory-item">
                      <a href={note.href} class="directory-note-link" title={note.title}>
                        <span class="directory-note-title">{note.title}</span>
                        <span class="directory-note-arrow" aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            );
          })
        )}
      </div>
    </div>
  </main>
</BaseLayout>

<style is:global>
  :root {
    --pop-border: color-mix(in srgb, var(--color-text) 78%, transparent);
    --pop-line: color-mix(in srgb, var(--color-text) 20%, transparent);
  }

  html:has(body.vault-directory-page),
  html body.vault-directory-page,
  body.vault-directory-page {
    background: var(--color-primary) !important;
    background-color: var(--color-primary) !important;
    color: var(--color-text);
  }

  body.vault-directory-page main.page-content-full {
    background: var(--color-primary) !important;
    overflow: visible;
  }

  body.vault-directory-page .site-footer {
    --footer-bg: var(--color-primary);
    --footer-text-header: var(--color-background);
    --footer-text-dim: color-mix(in srgb, var(--color-primary-text) 82%, transparent);
    --footer-border: color-mix(in srgb, var(--color-primary-text) 30%, transparent);
  }

  body.vault-directory-page .brands-zone {
    border-top: 1px solid var(--color-text);
    background: var(--color-primary) !important;
  }

  .directory-shell {
    width: 100%;
    padding: clamp(0.75rem, 2.5vw, 2rem);
    background: var(--color-primary);
    font-family: "Satoshi-Variable", "Satoshi-Regular", "Poppins", sans-serif;
  }

  .directory-card {
    width: min(100%, 1100px);
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    border: 1px solid var(--pop-border);
    border-radius: clamp(16px, 2vw, 24px);
    background: var(--color-background);
  }

  .directory-nav {
    margin-bottom: 2rem;
  }

  .directory-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    text-decoration: none;
    font-size: 1.05rem;
    font-weight: 680;
    transition: background 160ms ease, padding 160ms ease;
  }

  .directory-back-link:hover {
    padding-inline: 0.5rem;
    background: var(--color-button);
  }

  .directory-eyebrow {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-additional-2);
    margin: 0 0 0.5rem;
  }

  .directory-header h1 {
    font-size: var(--type-role-page-title-size);
    font-weight: var(--type-role-page-title-weight);
    line-height: var(--type-role-page-title-line);
    letter-spacing: var(--type-role-page-title-track);
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0 0 1rem;
    color: var(--color-text);
  }

  .directory-intro {
    font-size: 1.15rem;
    color: color-mix(in srgb, var(--color-text) 78%, transparent);
    margin: 0 0 2rem;
    max-width: 45ch;
  }

  .letter-quicknav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 1rem 0;
    margin-bottom: 2.5rem;
    border-top: 1px solid var(--pop-line);
    border-bottom: 1px solid var(--pop-line);
  }

  .letter-jump-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    font-weight: 650;
    font-size: 0.95rem;
    color: var(--color-text);
    text-decoration: none;
    border-radius: 6px;
    border: 1px solid var(--pop-line);
    transition: background 140ms ease, border-color 140ms ease;
  }

  .letter-jump-link:hover {
    background: var(--color-button);
    border-color: var(--color-text);
  }

  .letter-section {
    margin-bottom: 3rem;
  }

  .letter-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--color-text);
    margin-bottom: 1rem;
  }

  .letter-badge {
    font-size: var(--type-role-card-title-size);
    font-weight: var(--type-role-card-title-weight);
    line-height: var(--type-role-card-title-line);
    margin: 0;
    color: var(--color-text);
  }

  .letter-count {
    font-size: 0.88rem;
    color: color-mix(in srgb, var(--color-text) 62%, transparent);
  }

  .notes-directory-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 0.75rem;
    align-items: stretch;
  }

  .directory-item {
    display: flex;
    height: 100%;
  }

  .directory-note-link {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    padding: 0.75rem 0.95rem;
    border-radius: 10px;
    border: 1px solid var(--pop-line);
    background: color-mix(in srgb, var(--color-surface) 75%, transparent);
    color: var(--color-text);
    text-decoration: none;
    transition: background 140ms ease, border-color 140ms ease, transform 140ms ease, box-shadow 140ms ease;
    box-shadow: 0 1px 2px color-mix(in srgb, var(--color-text) 4%, transparent);
  }

  .directory-note-link:hover {
    background: var(--color-button);
    border-color: var(--color-text);
    transform: translateY(-1px);
    box-shadow: 0 3px 6px color-mix(in srgb, var(--color-text) 8%, transparent);
  }

  .directory-note-title {
    flex: 1;
    font-size: 0.94rem;
    font-weight: 560;
    line-height: 1.4;
    min-height: calc(2 * 1.4em); /* Standard 2-line height: 1-line titles keep the 2nd line as clean empty space */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-wrap: pretty;
  }

  .directory-note-arrow {
    font-size: 1.05rem;
    flex-shrink: 0;
    color: color-mix(in srgb, var(--color-text) 45%, transparent);
    transition: transform 140ms ease, color 140ms ease;
  }

  .directory-note-link:hover .directory-note-arrow {
    color: var(--color-text);
    transform: translateX(3px);
  }

  .directory-empty {
    font-size: 1.1rem;
    color: color-mix(in srgb, var(--color-text) 65%, transparent);
    padding: 2rem 0;
  }
</style>

---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { findNotesReferencing } from "../../../lib/vault.js";
import { findIndexedNotesByWikiLink } from "../../../lib/vault-note-index.js";

const { topic } = Astro.params;

if (!topic) {
    return Astro.redirect("/obsidian-vault");
}

const activeTopicSlug = decodeURIComponent(topic).replace(/\.md$/i, "");
const activeTopicName = activeTopicSlug.replace(/-/g, " ");
const displayTopicName = activeTopicName.replace(/\b\w/g, (letter) =>
    letter.toUpperCase(),
);

function preventOrphans(text: string): string {
    const words = String(text || "")
        .trim()
        .split(/\s+/);
    if (words.length <= 3) return text;
    const lastWord = words.pop();
    const secondLast = words.pop();
    return `${words.join(" ")} ${secondLast}\u00A0${lastWord}`;
}

const displayTopicNameFormatted = preventOrphans(displayTopicName);
const pageTitle = `${displayTopicName} | Obsidian Vault`;

let notes = [];

try {
    notes = await findIndexedNotesByWikiLink(activeTopicSlug);
} catch (indexError) {
    console.warn(
        "[vault-topic-page] Indexed lookup failed; using GitHub fallback:",
        indexError,
    );
    const legacyNotes = await findNotesReferencing(activeTopicSlug);
    notes = legacyNotes.map((note) => {
        const slug = note.name.replace(/\.md$/i, "");
        return {
            name: note.name,
            title: slug.replace(/-/g, " "),
            slug,
            href: `/obsidian-vault/${encodeURIComponent(slug)}`,
        };
    });
}

Astro.response.headers.set(
    "Cache-Control",
    import.meta.env.DEV
        ? "no-cache, no-store, must-revalidate"
        : "public, max-age=60, s-maxage=31536000, stale-while-revalidate=31536000",
);

const isIndexable = notes.length >= 3;
const robotsDirective = isIndexable ? undefined : "noindex, follow";
---

<BaseLayout
    title={pageTitle}
    description={`Notes exploring ${activeTopicName} in Abodid Sahoo's public Obsidian vault.`}
    fullWidth={true}
    showGlobalGrid={false}
    bodyClass="vault-topic-minimal-page"
    noindex={!isIndexable}
    robots={robotsDirective}
>
    <main class="vault-topic-page" aria-labelledby="topic-title">
        <article class="vault-topic-document" data-vault-topic-document>
            <div class="vault-topic-inner">
                <header class="vault-topic-header">
                    <div class="vault-topic-header__row">
                        <h1 id="topic-title">{displayTopicNameFormatted}</h1>
                        <button
                            type="button"
                            class="vault-topic-back-btn"
                            data-vault-topic-top-back
                            onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/obsidian-vault'; }"
                            aria-label="Go back to previous page"
                            hidden
                        >
                            <span aria-hidden="true">←</span>
                            <span>Back to previous page</span>
                        </button>
                    </div>
                </header>

                <section
                    class="vault-topic-results"
                    aria-labelledby="results-title"
                >
                    <div class="vault-topic-results-heading">
                        <h2 id="results-title">
                            {notes.length} {notes.length === 1 ? "note" : "notes"} exploring “{displayTopicName}” in <a href="/" class="vault-topic-author-link">Abodid Sahoo’s</a> Journal Notes
                        </h2>
                    </div>

                    <div class="vault-topic-list">
                        {
                            notes.length > 0 ? (
                                notes.map((note) => (
                                    <a
                                        class="vault-topic-note"
                                        href={note.href}
                                    >
                                        <span>{note.title}</span>
                                        <span
                                            class="vault-topic-note__arrow"
                                            aria-hidden="true"
                                        >
                                            →
                                        </span>
                                    </a>
                                ))
                            ) : (
                                <p class="vault-topic-empty">
                                    No public notes currently reference “
                                    {activeTopicName}”.
                                </p>
                            )
                        }
                    </div>
                </section>

                <!-- Soft Trigger: 1-on-1 Obsidian Tutoring -->
                <aside
                    class="vault-note-tutoring-trigger"
                    aria-label="1:1 Obsidian Tutoring"
                >
                    <div class="vault-note-tutoring-trigger__badge">
                        <span>1:1 Obsidian Mentorship</span>
                    </div>
                    <div class="vault-note-tutoring-trigger__body">
                        <h2 class="vault-note-tutoring-trigger__heading">
                            Want to organise your notes and ideas effectively?
                        </h2>
                        <p class="vault-note-tutoring-trigger__text">
                            I help founders, researchers, and creators build
                            note-taking systems that helps them retain and
                            recall important information and ideas effectively.
                        </p>
                    </div>
                    <a
                        href="/obsidian-tutoring"
                        class="vault-note-tutoring-trigger__cta"
                    >
                        <span>Explore 1:1 Tutoring</span>
                        <span
                            class="vault-note-tutoring-trigger__arrow"
                            aria-hidden="true">→</span
                        >
                    </a>
                </aside>

                <div class="vault-topic-nav-row">
                    <button
                        type="button"
                        class="vault-topic-nav-btn vault-topic-nav-btn--prev"
                        onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/obsidian-vault'; }"
                        aria-label="Back to previous page"
                    >
                        <span aria-hidden="true">←</span>
                        <span>Back to previous page</span>
                    </button>

                    <a
                        href="/obsidian-vault"
                        class="vault-topic-nav-btn vault-topic-nav-btn--main"
                    >
                        <span>Go to Main Vault</span>
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>
        </article>
    </main>
</BaseLayout>

<script is:inline>
    (function () {
        function initialiseTopicBackButton() {
            var topicDocument = document.querySelector(
                "[data-vault-topic-document]",
            );
            var topBackButton = document.querySelector(
                "[data-vault-topic-top-back]",
            );
            if (
                !topicDocument ||
                !topBackButton ||
                topicDocument.dataset.fitCheckReady === "true"
            )
                return;

            topicDocument.dataset.fitCheckReady = "true";
            var lifecycle = new AbortController();
            var updateFrame = 0;

            function updateTopBackButton() {
                if (updateFrame) window.cancelAnimationFrame(updateFrame);
                topBackButton.hidden = true;

                updateFrame = window.requestAnimationFrame(function () {
                    updateFrame = 0;
                    var documentTopAtPageStart =
                        topicDocument.getBoundingClientRect().top +
                        window.scrollY;
                    var documentBottomAtPageStart =
                        documentTopAtPageStart + topicDocument.offsetHeight;
                    topBackButton.hidden =
                        documentBottomAtPageStart <= window.innerHeight + 1;
                });
            }

            window.addEventListener("resize", updateTopBackButton, {
                signal: lifecycle.signal,
            });
            window.addEventListener("orientationchange", updateTopBackButton, {
                signal: lifecycle.signal,
            });

            if (document.fonts?.ready) {
                document.fonts.ready.then(updateTopBackButton);
            }
            updateTopBackButton();

            document.addEventListener(
                "astro:before-swap",
                function () {
                    if (updateFrame) window.cancelAnimationFrame(updateFrame);
                    lifecycle.abort();
                    delete topicDocument.dataset.fitCheckReady;
                },
                { once: true, signal: lifecycle.signal },
            );
        }

        initialiseTopicBackButton();
        document.addEventListener("astro:page-load", initialiseTopicBackButton);
    })();
</script>

<style is:global>
    :root {
        --pop-blue: #2444ca;
        --pop-yellow: #ffe44f;
        --pop-purple: #5524c7;
        --pop-pink: #ff4d8d;
        --pop-lime: #b8f044;
        --pop-cream: #fff8e8;
        --pop-ink: #15130f;
        --pop-border: rgba(21, 19, 15, 0.72);
        --pop-line: rgba(21, 19, 15, 0.2);
    }

    html:has(body.vault-topic-minimal-page),
    html body.vault-topic-minimal-page,
    body.vault-topic-minimal-page {
        background: #2444ca !important;
        background-color: #2444ca !important;
        color: var(--pop-ink);
    }

    body.vault-topic-minimal-page main.page-content-full {
        background: #2444ca !important;
        overflow: visible;
    }

    body.vault-topic-minimal-page .site-footer {
        --footer-bg: #2444ca;
        --footer-text-header: #fff8e8;
        --footer-text-dim: rgba(255, 248, 232, 0.82);
        --footer-border: rgba(255, 248, 232, 0.3);
    }

    body.vault-topic-minimal-page .brands-zone {
        border-top: 1px solid #15130f;
        background: #2444ca !important;
    }

    .vault-topic-page {
        width: 100%;
        padding: clamp(0.5rem, 2vw, 1.5rem);
        background: var(--pop-blue);
        font-family:
            "Satoshi-Variable", "Satoshi-Regular", "Poppins", sans-serif;
    }

    .vault-topic-document {
        width: min(100%, 900px);
        margin: 0 auto;
        border: 1px solid var(--pop-border);
        border-radius: clamp(16px, 2vw, 22px);
        background: var(--pop-cream);
    }

    .vault-topic-inner {
        width: min(100%, 720px);
        margin: 0 auto;
        padding: clamp(1.4rem, 5vw, 4.5rem) clamp(1.15rem, 5vw, 3.5rem);
    }

    .vault-topic-header {
        margin-top: 0;
        padding-bottom: clamp(1.25rem, 3vw, 2rem);
        border-bottom: 1px solid var(--pop-line);
    }

    .vault-topic-header__row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
    }

    .vault-topic-header h1 {
        max-width: none;
        margin: 0;
        color: var(--pop-ink);
        font-size: clamp(2rem, 4vw, 2.9rem);
        font-weight: 560;
        line-height: 1.08;
        letter-spacing: -0.04em;
        text-wrap: pretty;
        overflow-wrap: break-word;
    }

    a.vault-topic-back-btn,
    button.vault-topic-back-btn,
    .vault-topic-back-btn {
        display: inline-flex;
        min-height: 48px;
        align-items: center;
        gap: 0.45rem;
        padding: 0.75rem 1.15rem;
        border: 1px solid var(--pop-border);
        border-radius: 12px;
        background: var(--pop-yellow);
        color: var(--pop-ink);
        font-family: inherit;
        font-size: clamp(0.92rem, 1.8vw, 1rem);
        font-weight: 680;
        line-height: 1.2;
        white-space: nowrap;
        text-decoration: none;
        cursor: pointer;
        transition:
            transform 180ms ease,
            background 180ms ease;
    }

    .vault-topic-back-btn[hidden] {
        display: none;
    }

    a.vault-topic-back-btn:hover,
    button.vault-topic-back-btn:hover,
    .vault-topic-back-btn:hover {
        background: var(--pop-lime);
        color: var(--pop-ink);
        transform: translateY(-2px);
    }

    .vault-topic-back-btn:focus-visible,
    .vault-topic-note:focus-visible,
    .vault-topic-nav-btn:focus-visible {
        outline: 3px solid var(--pop-purple);
        outline-offset: 3px;
    }

    .vault-topic-results {
        padding-top: clamp(1.4rem, 3.2vw, 2.25rem);
    }

    .vault-topic-results-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 0;
        padding: 0 0 clamp(1.1rem, 2.4vw, 1.5rem);
        border-bottom: 1px solid var(--pop-border);
    }

    .vault-topic-results-heading h2 {
        margin: 0;
        color: var(--pop-ink);
        font-size: clamp(1.02rem, 1.8vw, 1.15rem);
        font-weight: 700;
        line-height: 1.4;
        letter-spacing: -0.015em;
    }

    .vault-topic-author-link {
        color: var(--pop-ink) !important;
        font-weight: 750;
        text-decoration: underline;
        text-decoration-color: var(--pop-line);
        text-underline-offset: 3px;
        transition: text-decoration-color 150ms ease, background 150ms ease;
    }

    .vault-topic-author-link:hover {
        background: var(--pop-yellow);
        text-decoration-color: var(--pop-ink);
    }

    .vault-topic-author-link:focus-visible {
        outline: 2px solid var(--pop-purple);
        outline-offset: 2px;
    }

    .vault-topic-list {
        display: grid;
    }

    .vault-topic-empty {
        margin: 0;
        padding: 1.25rem 0;
        color: rgba(21, 19, 15, 0.62);
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .vault-topic-note {
        display: flex;
        min-height: 68px;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 0;
        border-bottom: 1px solid var(--pop-line);
        color: var(--pop-ink);
        text-decoration: none;
        font-size: clamp(0.98rem, 1.6vw, 1.08rem);
        font-weight: 520;
        line-height: 1.35;
        letter-spacing: -0.01em;
        transition:
            background 160ms ease,
            padding 160ms ease;
    }

    .vault-topic-note:hover {
        padding-inline: 0.75rem;
        background: var(--pop-yellow);
    }

    .vault-topic-note__arrow {
        flex: 0 0 auto;
        font-size: 1.1rem;
    }

    .vault-topic-nav-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: clamp(2rem, 4vw, 3rem);
        padding-top: 1.5rem;
        border-top: 1px solid var(--pop-border);
        flex-wrap: wrap;
    }

    a.vault-topic-nav-btn,
    button.vault-topic-nav-btn,
    .vault-topic-nav-btn {
        display: inline-flex;
        min-height: 48px;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.15rem;
        border: 1px solid var(--pop-border);
        border-radius: 12px;
        background: var(--pop-yellow);
        color: var(--pop-ink);
        font-family: inherit;
        font-size: clamp(0.92rem, 1.8vw, 1rem);
        font-weight: 680;
        line-height: 1.2;
        white-space: nowrap;
        text-decoration: none;
        cursor: pointer;
        transition:
            transform 180ms ease,
            background 180ms ease;
    }

    a.vault-topic-nav-btn:hover,
    button.vault-topic-nav-btn:hover,
    .vault-topic-nav-btn:hover {
        background: var(--pop-lime);
        color: var(--pop-ink);
        transform: translateY(-2px);
    }

    .vault-topic-nav-btn:focus-visible {
        outline: 3px solid var(--pop-purple);
        outline-offset: 3px;
    }

    @media (max-width: 720px) {
        .vault-topic-page {
            padding: 5px;
        }

        .vault-topic-document {
            border-radius: 14px;
        }

        .vault-topic-header h1 {
            font-size: clamp(2rem, 9vw, 2.8rem);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .vault-topic-back-btn,
        .vault-topic-note,
        .vault-topic-nav-btn,
        .vault-note-tutoring-trigger__cta {
            transition: none;
        }
    }

    /* ---------------- Soft Trigger: 1:1 Obsidian Tutoring ---------------- */
    .vault-note-tutoring-trigger {
        margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
        margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
        padding: clamp(1.25rem, 3vw, 1.65rem);
        background: #ffffff;
        border: 1.5px solid var(--pop-border);
        border-radius: clamp(12px, 1.5vw, 16px);
        box-shadow: 0 4px 16px rgba(21, 19, 15, 0.04);
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        position: relative;
        overflow: hidden;
    }

    .vault-note-tutoring-trigger::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 5px;
        height: 100%;
        background: var(--pop-blue);
    }

    .vault-note-tutoring-trigger__badge {
        display: inline-flex;
    }

    .vault-note-tutoring-trigger__badge span {
        display: inline-block;
        padding: 0.2rem 0.55rem;
        background: var(--pop-yellow);
        border: 1px solid rgba(21, 19, 15, 0.45);
        border-radius: 4px;
        font-size: 0.72rem;
        font-weight: 750;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--pop-ink);
    }

    .vault-note-tutoring-trigger__heading {
        font-size: clamp(1.1rem, 2.2vw, 1.3rem);
        font-weight: 700;
        color: var(--pop-ink);
        line-height: 1.3;
        margin: 0 0 0.35rem 0;
    }

    .vault-note-tutoring-trigger__text {
        font-size: 0.92rem;
        color: rgba(21, 19, 15, 0.8);
        line-height: 1.5;
        margin: 0;
    }

    .vault-note-tutoring-trigger__cta {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.65rem;
        margin-top: 0.25rem;
        padding: 0.6rem 1.15rem;
        background: var(--pop-blue);
        color: #ffffff !important;
        font-size: 0.9rem;
        font-weight: 650;
        border-radius: 8px;
        text-decoration: none !important;
        align-self: flex-start;
        transition:
            background 150ms ease,
            transform 150ms ease;
    }

    .vault-note-tutoring-trigger__cta:hover {
        background: var(--pop-purple);
        transform: translateX(3px);
    }

    .vault-note-tutoring-trigger__arrow {
        font-size: 1.05rem;
        line-height: 1;
        transition: transform 150ms ease;
    }

    .vault-note-tutoring-trigger__cta:hover
        .vault-note-tutoring-trigger__arrow {
        transform: translateX(3px);
    }
</style>

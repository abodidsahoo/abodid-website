---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { findNotesReferencing } from "../../../lib/vault.js";
import { findIndexedNotesByWikiLink } from "../../../lib/vault-note-index.js";

const { topic } = Astro.params;

if (!topic) {
    return Astro.redirect("/obsidian-vault");
}

const activeTopicSlug = decodeURIComponent(topic).replace(/\.md$/i, "");
const activeTopicName = activeTopicSlug.replace(/-/g, " ");
const displayTopicName = activeTopicName.replace(/\b\w/g, (letter) => letter.toUpperCase());

function preventOrphans(text: string): string {
    const words = String(text || "").trim().split(/\s+/);
    if (words.length <= 3) return text;
    const lastWord = words.pop();
    const secondLast = words.pop();
    return `${words.join(" ")} ${secondLast}\u00A0${lastWord}`;
}

const displayTopicNameFormatted = preventOrphans(displayTopicName);
const pageTitle = `${displayTopicName} | Obsidian Vault`;

let notes = [];

try {
    notes = await findIndexedNotesByWikiLink(activeTopicSlug);
} catch (indexError) {
    console.warn("[vault-topic-page] Indexed lookup failed; using GitHub fallback:", indexError);
    const legacyNotes = await findNotesReferencing(activeTopicSlug);
    notes = legacyNotes.map((note) => {
        const slug = note.name.replace(/\.md$/i, "");
        return {
            name: note.name,
            title: slug.replace(/-/g, " "),
            slug,
            href: `/obsidian-vault/${encodeURIComponent(slug)}`,
        };
    });
}

Astro.response.headers.set(
    "Cache-Control",
    import.meta.env.DEV
        ? "no-cache, no-store, must-revalidate"
        : "public, max-age=60, s-maxage=300, stale-while-revalidate=86400",
);

const isIndexable = notes.length >= 3;
const robotsDirective = isIndexable ? undefined : "noindex, follow";
---

<BaseLayout
    title={pageTitle}
    description={`Notes exploring ${activeTopicName} in Abodid Sahoo's public Obsidian vault.`}
    fullWidth={true}
    showGlobalGrid={false}
    bodyClass="vault-topic-minimal-page"
    noindex={!isIndexable}
    robots={robotsDirective}
>
    <main class="vault-topic-page" aria-labelledby="topic-title">
        <article class="vault-topic-document" data-vault-topic-document>
            <div class="vault-topic-inner">
                <header class="vault-topic-header">
                    <div class="vault-topic-header__row">
                        <h1 id="topic-title">{displayTopicNameFormatted}</h1>
                        <button
                            type="button"
                            class="vault-topic-back-btn"
                            data-vault-topic-top-back
                            onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/obsidian-vault'; }"
                            aria-label="Go back to previous page"
                            hidden
                        >
                            <span aria-hidden="true">←</span>
                            <span>Back to previous page</span>
                        </button>
                    </div>
                </header>

                <section class="vault-topic-results" aria-labelledby="results-title">
                    <div class="vault-topic-results-heading">
                        <h2 id="results-title">Results</h2>
                        <p>{notes.length} {notes.length === 1 ? "note" : "notes"}</p>
                    </div>

                    <div class="vault-topic-list">
                        {notes.length > 0 ? (
                            notes.map((note) => (
                                <a class="vault-topic-note" href={note.href}>
                                    <span>{note.title}</span>
                                    <span class="vault-topic-note__arrow" aria-hidden="true">→</span>
                                </a>
                            ))
                        ) : (
                            <p class="vault-topic-empty">
                                No public notes currently reference “{activeTopicName}”.
                            </p>
                        )}
                    </div>
                </section>

                <div class="vault-topic-nav-row">
                    <button
                        type="button"
                        class="vault-topic-nav-btn vault-topic-nav-btn--prev"
                        onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/obsidian-vault'; }"
                        aria-label="Back to previous page"
                    >
                        <span aria-hidden="true">←</span>
                        <span>Back to previous page</span>
                    </button>

                    <a href="/obsidian-vault" class="vault-topic-nav-btn vault-topic-nav-btn--main">
                        <span>Go to Main Vault</span>
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>
        </article>
    </main>
</BaseLayout>

<script is:inline>
    (function () {
        function initialiseTopicBackButton() {
            var topicDocument = document.querySelector("[data-vault-topic-document]");
            var topBackButton = document.querySelector("[data-vault-topic-top-back]");
            if (!topicDocument || !topBackButton || topicDocument.dataset.fitCheckReady === "true") return;

            topicDocument.dataset.fitCheckReady = "true";
            var lifecycle = new AbortController();
            var updateFrame = 0;

            function updateTopBackButton() {
                if (updateFrame) window.cancelAnimationFrame(updateFrame);
                topBackButton.hidden = true;

                updateFrame = window.requestAnimationFrame(function () {
                    updateFrame = 0;
                    var documentTopAtPageStart = topicDocument.getBoundingClientRect().top + window.scrollY;
                    var documentBottomAtPageStart = documentTopAtPageStart + topicDocument.offsetHeight;
                    topBackButton.hidden = documentBottomAtPageStart <= window.innerHeight + 1;
                });
            }

            window.addEventListener("resize", updateTopBackButton, { signal: lifecycle.signal });
            window.addEventListener("orientationchange", updateTopBackButton, { signal: lifecycle.signal });

            if (document.fonts?.ready) {
                document.fonts.ready.then(updateTopBackButton);
            }
            updateTopBackButton();

            document.addEventListener("astro:before-swap", function () {
                if (updateFrame) window.cancelAnimationFrame(updateFrame);
                lifecycle.abort();
                delete topicDocument.dataset.fitCheckReady;
            }, { once: true, signal: lifecycle.signal });
        }

        initialiseTopicBackButton();
        document.addEventListener("astro:page-load", initialiseTopicBackButton);
    })();
</script>

<style is:global>
    :root {
        --pop-blue: #2444ca;
        --pop-yellow: #ffe44f;
        --pop-purple: #5524c7;
        --pop-pink: #ff4d8d;
        --pop-lime: #b8f044;
        --pop-cream: #fff8e8;
        --pop-ink: #15130f;
        --pop-border: rgba(21, 19, 15, 0.72);
        --pop-line: rgba(21, 19, 15, 0.2);
    }

    html:has(body.vault-topic-minimal-page),
    html body.vault-topic-minimal-page,
    body.vault-topic-minimal-page {
        background: #2444ca !important;
        background-color: #2444ca !important;
        color: var(--pop-ink);
    }

    body.vault-topic-minimal-page main.page-content-full {
        background: #2444ca !important;
        overflow: visible;
    }

    body.vault-topic-minimal-page .site-footer {
        --footer-bg: #2444ca;
        --footer-text-header: #fff8e8;
        --footer-text-dim: rgba(255, 248, 232, 0.82);
        --footer-border: rgba(255, 248, 232, 0.3);
    }

    body.vault-topic-minimal-page .brands-zone {
        border-top: 1px solid #15130f;
        background: #2444ca !important;
    }

    .vault-topic-page {
        width: 100%;
        padding: clamp(0.5rem, 2vw, 1.5rem);
        background: var(--pop-blue);
        font-family: "Satoshi-Variable", "Satoshi-Regular", "Poppins", sans-serif;
    }

    .vault-topic-document {
        width: min(100%, 900px);
        margin: 0 auto;
        border: 1px solid var(--pop-border);
        border-radius: clamp(16px, 2vw, 22px);
        background: var(--pop-cream);
    }

    .vault-topic-inner {
        width: min(100%, 720px);
        margin: 0 auto;
        padding: clamp(1.4rem, 5vw, 4.5rem) clamp(1.15rem, 5vw, 3.5rem);
    }

    .vault-topic-header {
        margin-top: 0;
        padding-bottom: clamp(1.25rem, 3vw, 2rem);
        border-bottom: 1px solid var(--pop-line);
    }

    .vault-topic-header__row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
    }

    .vault-topic-header h1 {
        max-width: none;
        margin: 0;
        color: var(--pop-ink);
        font-size: clamp(2rem, 4vw, 2.9rem);
        font-weight: 560;
        line-height: 1.08;
        letter-spacing: -0.04em;
        text-wrap: pretty;
        overflow-wrap: break-word;
    }

    a.vault-topic-back-btn,
    button.vault-topic-back-btn,
    .vault-topic-back-btn {
        display: inline-flex;
        min-height: 48px;
        align-items: center;
        gap: 0.45rem;
        padding: 0.75rem 1.15rem;
        border: 1px solid var(--pop-border);
        border-radius: 12px;
        background: var(--pop-yellow);
        color: var(--pop-ink);
        font-family: inherit;
        font-size: clamp(0.92rem, 1.8vw, 1rem);
        font-weight: 680;
        line-height: 1.2;
        white-space: nowrap;
        text-decoration: none;
        cursor: pointer;
        transition: transform 180ms ease, background 180ms ease;
    }

    .vault-topic-back-btn[hidden] {
        display: none;
    }

    a.vault-topic-back-btn:hover,
    button.vault-topic-back-btn:hover,
    .vault-topic-back-btn:hover {
        background: var(--pop-lime);
        color: var(--pop-ink);
        transform: translateY(-2px);
    }

    .vault-topic-back-btn:focus-visible,
    .vault-topic-note:focus-visible,
    .vault-topic-nav-btn:focus-visible {
        outline: 3px solid var(--pop-purple);
        outline-offset: 3px;
    }

    .vault-topic-results {
        padding-top: clamp(1rem, 2.5vw, 1.75rem);
    }

    .vault-topic-results-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 0;
        padding: 0 0 0.85rem;
        border-bottom: 1px solid var(--pop-border);
    }

    .vault-topic-results-heading h2,
    .vault-topic-results-heading p {
        margin: 0;
        color: var(--pop-ink);
    }

    .vault-topic-results-heading h2 {
        font-size: 1rem;
        font-weight: 650;
        letter-spacing: -0.01em;
    }

    .vault-topic-results-heading p {
        color: rgba(21, 19, 15, 0.62);
        font-size: 0.82rem;
    }

    .vault-topic-list {
        display: grid;
    }

    .vault-topic-empty {
        margin: 0;
        padding: 1.25rem 0;
        color: rgba(21, 19, 15, 0.62);
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .vault-topic-note {
        display: flex;
        min-height: 68px;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 0;
        border-bottom: 1px solid var(--pop-line);
        color: var(--pop-ink);
        text-decoration: none;
        font-size: clamp(0.98rem, 1.6vw, 1.08rem);
        font-weight: 520;
        line-height: 1.35;
        letter-spacing: -0.01em;
        transition: background 160ms ease, padding 160ms ease;
    }

    .vault-topic-note:hover {
        padding-inline: 0.75rem;
        background: var(--pop-yellow);
    }

    .vault-topic-note__arrow {
        flex: 0 0 auto;
        font-size: 1.1rem;
    }

    .vault-topic-nav-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: clamp(2rem, 4vw, 3rem);
        padding-top: 1.5rem;
        border-top: 1px solid var(--pop-border);
        flex-wrap: wrap;
    }

    a.vault-topic-nav-btn,
    button.vault-topic-nav-btn,
    .vault-topic-nav-btn {
        display: inline-flex;
        min-height: 48px;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.15rem;
        border: 1px solid var(--pop-border);
        border-radius: 12px;
        background: var(--pop-yellow);
        color: var(--pop-ink);
        font-family: inherit;
        font-size: clamp(0.92rem, 1.8vw, 1rem);
        font-weight: 680;
        line-height: 1.2;
        white-space: nowrap;
        text-decoration: none;
        cursor: pointer;
        transition: transform 180ms ease, background 180ms ease;
    }

    a.vault-topic-nav-btn:hover,
    button.vault-topic-nav-btn:hover,
    .vault-topic-nav-btn:hover {
        background: var(--pop-lime);
        color: var(--pop-ink);
        transform: translateY(-2px);
    }

    .vault-topic-nav-btn:focus-visible {
        outline: 3px solid var(--pop-purple);
        outline-offset: 3px;
    }

    @media (max-width: 720px) {
        .vault-topic-page {
            padding: 5px;
        }

        .vault-topic-document {
            border-radius: 14px;
        }

        .vault-topic-header h1 {
            font-size: clamp(2rem, 9vw, 2.8rem);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .vault-topic-back-btn,
        .vault-topic-note,
        .vault-topic-nav-btn {
            transition: none;
        }
    }
</style>

---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getFileContent } from "../../lib/github";
import {
    extractVaultNoteMetadata,
    normalizeWikiLinkTarget,
    stripLegacyVaultMetadata,
} from "../../lib/vault-rag.js";
import {
    findIndexedNotesByWikiLink,
    getIndexedNoteBySlug,
    getRelatedVaultNote,
} from "../../lib/vault-note-index.js";
import { marked } from "marked";
import ShareButtons from "../../components/ShareButtons.jsx";
import {
    breadcrumbJsonLd,
    personJsonLd,
    seoIdentity,
    vaultNoteJsonLd,
} from "../../lib/seoData";
import "../../styles/vault-note.css";

const { slug } = Astro.params;
const fromVaultSearchId = Astro.url.searchParams.get("fromVaultSearch") || "";

if (!slug) {
    return Astro.redirect("/404");
}

function metadataHref(value: string): string {
    const target = String(value || "")
        .replace(/^#/, "")
        .replace(/^\[\[/, "")
        .replace(/\]\]$/, "")
        .split("|")[0]
        .split("#")[0]
        .replace(/\.md$/i, "")
        .trim();
    return `/obsidian-vault/topic/${encodeURIComponent(target)}`;
}

function formatMetadataDate(value: unknown): string {
    if (!value) return "";
    const stringValue = String(value);
    const dateOnly = stringValue.match(/^(\d{4}-\d{2}-\d{2})/i)?.[1];
    const raw = value instanceof Date
        ? value
        : new Date(dateOnly ? `${dateOnly}T00:00:00Z` : stringValue);
    if (Number.isNaN(raw.getTime())) return String(value);
    return new Intl.DateTimeFormat("en-GB", {
        day: "numeric",
        month: "long",
        year: "numeric",
        timeZone: "UTC",
    }).format(raw);
}

function preventOrphans(text: string): string {
    const words = String(text || "").trim().split(/\s+/);
    if (words.length <= 3) return text;
    const lastWord = words.pop();
    const secondLast = words.pop();
    return `${words.join(" ")} ${secondLast}\u00A0${lastWord}`;
}

function extractFirstUsefulParagraph(markdown: string): string {
    if (!markdown) return "";
    const lines = markdown.split("\n");
    const paragraphLines: string[] = [];
    let inFrontmatter = false;

    for (let i = 0; i < lines.length; i++) {
        const line = lines[i].trim();
        if (i === 0 && line === "---") {
            inFrontmatter = true;
            continue;
        }
        if (inFrontmatter) {
            if (line === "---") inFrontmatter = false;
            continue;
        }
        if (
            !line ||
            line.startsWith("#") ||
            line.startsWith("---") ||
            line.startsWith("Tags:") ||
            line.startsWith("tags:") ||
            line.startsWith("Topics:") ||
            line.startsWith("topics:") ||
            line.startsWith("Date:") ||
            line.startsWith("date:") ||
            line.startsWith("![[") ||
            line.startsWith("![")
        ) {
            if (paragraphLines.length > 0) break;
            continue;
        }
        paragraphLines.push(line);
    }

    const rawParagraph = paragraphLines.join(" ");
    const cleaned = rawParagraph
        .replace(/\[\[([^\]|]+)\|([^\]]+)\]\]/g, "$2")
        .replace(/\[\[([^\]]+)\]\]/g, "$1")
        .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
        .replace(/==([^=]+)==/g, "$1")
        .replace(/%%[\s\S]*?%%/g, "")
        .replace(/[*_`#~]/g, "")
        .replace(/\s+/g, " ")
        .trim();

    if (cleaned.length > 160) {
        const truncated = cleaned.slice(0, 157);
        const lastSpace = truncated.lastIndexOf(" ");
        return (lastSpace > 100 ? truncated.slice(0, lastSpace) : truncated) + "...";
    }
    return cleaned;
}

let htmlContent = "";
let title = slug.split("/").pop() || "Note";
let firstTag = "";
let metaDescription = "";
let noteUpdatedAt: string | undefined = undefined;
let noteTypes: string[] = [];
let topicTags: string[] = [];
let noteDate = "";

try {
    const cleanSlug = slug.endsWith(".md") ? slug : `${slug}.md`;
    const filePathNotes = `06-main-notes/${cleanSlug}`;
    const noteSlug = cleanSlug.replace(/\.md$/i, "");
    let indexedNote = null;

    try {
        indexedNote = await getIndexedNoteBySlug(noteSlug);
        if (indexedNote?.updated_at) {
            noteUpdatedAt = indexedNote.updated_at;
        }
    } catch (indexError) {
        console.warn("[vault-note] Supabase content lookup failed; using GitHub fallback:", indexError);
    }

    let rawContent = indexedNote?.markdown_content || await getFileContent(filePathNotes);
    if (rawContent === null && !cleanSlug.includes("?")) {
        rawContent = await getFileContent(`06-main-notes/${noteSlug}?.md`);
    }

    if (rawContent === null) {
        try {
            const legacyTagMatches = await findIndexedNotesByWikiLink(noteSlug);
            if (legacyTagMatches.length > 0) {
                return Astro.redirect(metadataHref(noteSlug), 308);
            }
        } catch (tagLookupError) {
            console.warn("[vault-note] Legacy tag redirect lookup failed:", tagLookupError);
        }
        return Astro.redirect("/404");
    }

    metaDescription = extractFirstUsefulParagraph(rawContent);

    const metadata = extractVaultNoteMetadata(rawContent);
    noteTypes = metadata.noteTypes;
    topicTags = metadata.tags;
    noteDate = formatMetadataDate(metadata.date);
    let content = stripLegacyVaultMetadata(metadata.content);
    // Deliberately strip any leading blank lines, HTML line breaks (<br>, <br/>), &nbsp;, or empty paragraphs from Obsidian notes
    content = content
        .replace(/^(?:\s*<br\s*\/?>|\s*&nbsp;|\s*\r?\n)+/gi, "")
        .trimStart();

    // Strip Obsidian comments %% ... %%
    content = content.replace(/%%[\s\S]*?%%/g, "");

    // Convert Obsidian highlight syntax ==highlighted text== to HTML <mark>
    content = content.replace(/==([^=\r\n]+)==/g, "<mark>$1</mark>");

    const tagSet = new Set(
        [...noteTypes, ...topicTags].map(normalizeWikiLinkTarget).filter(Boolean),
    );
    firstTag = indexedNote?.first_tag || topicTags[0] || noteTypes[0] || "";

    // Clean stray unclosed brackets before image tags (e.g. [![alt](url) without closing ])
    content = content.replace(/^\[(!\[[^\]]+\]\([^)]+\))(?!\s*\]\([^)]+\))/gm, "$1");

    content = content.replace(/!\[\[(.*?)\]\]/g, (match, filename) => {
        const cleanFilename = filename.split("|")[0];
        return `![](/obsidian-vault/assets/${cleanFilename})`;
    });

    content = content.replace(
        /!\[(.*?)\]\((.*?)(?:07-assets|07%20-%20assets|7%20-%20Assets|7 - Assets)\/(.*?)\)/g,
        "![$1](/obsidian-vault/assets/$3)",
    );

    content = content.replace(/\[\[(.*?)\]\]/g, (match, raw) => {
        const parts = raw.split("|");
        const linkTargetRaw = (parts[0] || "").trim();
        const linkText = (parts[1] || parts[0] || "").trim();
        const linkTarget = linkTargetRaw.replace(/\.md$/i, "");
        const isTag = tagSet.has(normalizeWikiLinkTarget(linkTarget));
        const hrefBase = isTag ? "/obsidian-vault/topic/" : "/obsidian-vault/";
        return `[${linkText}](${hrefBase}${encodeURIComponent(linkTarget)})`;
    });

    const renderer = new marked.Renderer();
    renderer.link = ({ href, title, text }) => {
        const titleAttr = title ? ` title="${title}"` : "";
        const isExternal = /^https?:\/\//i.test(href || "");
        const targetAttrs = isExternal ? ' target="_blank" rel="noopener noreferrer"' : "";
        return `<a href="${href}"${titleAttr}${targetAttrs}>${text}</a>`;
    };
    renderer.image = ({ href, title, text }) => {
        if (
            href &&
            (href.includes("07-assets") || href.includes("07%20-%20assets") || href.includes("7 - Assets") || href.includes("7%20-%20Assets"))
        ) {
            const parts = href.split("/");
            const filename = parts[parts.length - 1];
            return `<img src="/obsidian-vault/assets/${filename}" alt="${text}" title="${title || ""}" />`;
        }
        return `<img src="${href}" alt="${text}" title="${title || ""}" />`;
    };

    htmlContent = await marked.parse(content, { renderer });
    // Remove any leading empty paragraphs, break tags, or whitespace from the rendered HTML
    htmlContent = htmlContent
        .replace(/^(?:\s*<p>(?:\s*<br\s*\/?>|\s*&nbsp;|\s*)*<\/p>|\s*<br\s*\/?>)+/gi, "")
        .trim();

    title =
        (typeof metadata.frontmatter.title === "string" && metadata.frontmatter.title.trim()) ||
        cleanSlug.replace(/\.md$/i, "");
} catch (error) {
    console.error(error);
    htmlContent = "<p>Error loading note.</p>";
}

Astro.response.headers.set(
    "Cache-Control",
    import.meta.env.DEV
        ? "no-cache, no-store, must-revalidate"
        : fromVaultSearchId
            ? "private, no-store"
            : "public, max-age=60, s-maxage=300, stale-while-revalidate=86400",
);

const routeSlug = slug.replace(/\.md$/i, "");
const displayTitle = title === routeSlug ? title.replace(/-/g, " ") : title;
const displayTitleFormatted = preventOrphans(displayTitle);
const currentFilePath = `06-main-notes/${routeSlug}.md`;

let relatedNote = null;
try {
    relatedNote = await getRelatedVaultNote({
        slug: routeSlug,
        tags: [...topicTags, ...noteTypes],
        firstTag,
        filePath: currentFilePath,
    });
} catch (relatedErr) {
    console.warn("[vault-note] Server-side related note lookup failed:", relatedErr);
}

const relatedNoteTitle =
    relatedNote?.title ||
    (relatedNote?.slug ? relatedNote.slug.replace(/-/g, " ") : "Explore Another Related Note");
const relatedNoteHref =
    relatedNote?.href ||
    `/api/vault-related-note?file=${encodeURIComponent(currentFilePath)}${
        firstTag ? `&tag=${encodeURIComponent(firstTag)}` : ""
    }`;

const finalMetaDescription =
    metaDescription ||
    `Read ${displayTitle}, a note from Abodid Sahoo's public Obsidian vault.`;
const noteCanonicalUrl = `${seoIdentity.siteUrl}/obsidian-vault/${encodeURIComponent(routeSlug)}`;

const structuredData = [
    personJsonLd(),
    breadcrumbJsonLd([
        { name: "Home", path: "/" },
        { name: "Obsidian Vault", path: "/obsidian-vault" },
        { name: displayTitle, path: `/obsidian-vault/${encodeURIComponent(routeSlug)}` },
    ]),
    vaultNoteJsonLd({
        title: displayTitle,
        description: finalMetaDescription,
        url: noteCanonicalUrl,
        dateModified: noteUpdatedAt,
    }),
];
---

<BaseLayout
    title={`${displayTitle} | Obsidian Vault`}
    description={finalMetaDescription}
    fullWidth={true}
    showGlobalGrid={false}
    bodyClass="vault-note-pop-page"
    structuredData={structuredData}
>
    <main class="vault-note-page">
        <article class="vault-note-document" aria-labelledby="note-title">
            <div class="vault-note-inner">
                <header class="vault-note-header">
                    <!-- Eyebrow Note Type (Classification kicker above title) -->
                    {noteTypes.length > 0 && (
                        <div class="vault-note-eyebrow">
                            {noteTypes.map((noteType) => (
                                <a href={metadataHref(noteType)} class="vault-note-type-tag">{noteType.replace(/-/g, " ")}</a>
                            ))}
                        </div>
                    )}

                    <h1 id="note-title">{displayTitleFormatted}</h1>

                    <!-- Supplementary Metadata Below Title (Date + Topics) -->
                    {(noteDate || topicTags.length > 0) && (
                        <div class="vault-note-meta" aria-label="Note metadata">
                            {noteDate && (
                                <time class="vault-note-date" datetime={noteDate}>{noteDate}</time>
                            )}
                            {topicTags.length > 0 && (
                                <>
                                    {noteDate && <span class="vault-note-meta-sep" aria-hidden="true">·</span>}
                                    <div class="vault-note-topics">
                                        {topicTags.map((tag, idx) => (
                                            <span class="vault-note-topic-item">
                                                {idx > 0 && <span class="vault-note-meta-sep-slash" aria-hidden="true">/</span>}
                                                <a href={metadataHref(tag)} class="vault-note-topic-link">{tag.replace(/-/g, " ")}</a>
                                            </span>
                                        ))}
                                    </div>
                                </>
                            )}
                        </div>
                    )}
                </header>

                <section class="vault-note-content" aria-label={`Note: ${displayTitle}`}>
                    <div class="markdown-body" set:html={htmlContent} />

                    <!-- Tier 1: Share bar directly below content -->
                    <div class="vault-note-share-bar">
                        <span class="vault-note-share-label">Share</span>
                        <ShareButtons
                            client:only="react"
                            title={displayTitle}
                            url={Astro.url.href}
                        />
                    </div>

                    <!-- Tier 2: Read related note -->
                    <nav class="vault-note-end-nav" aria-label="Continue reading">
                        <a href={relatedNoteHref} class="vault-note-end-action vault-note-end-action--related">
                            <div class="vault-note-end-action__content">
                                <span class="vault-note-end-action__kicker">Read Related Note</span>
                                <span class="vault-note-end-action__title">{relatedNoteTitle}</span>
                            </div>
                            <div class="vault-note-end-action__arrow-circle" aria-hidden="true">
                                <span>→</span>
                            </div>
                        </a>
                    </nav>

                    <!-- Tier 3: Bottom Navigation buttons -->
                    <div class="vault-note-nav-row">
                        <button
                            type="button"
                            class="vault-note-nav-btn vault-note-nav-btn--prev"
                            onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/obsidian-vault'; }"
                            aria-label="Back to previous page"
                        >
                            <span aria-hidden="true">←</span>
                            <span>Back to previous page</span>
                        </button>

                        <a href="/obsidian-vault" class="vault-note-nav-btn vault-note-nav-btn--main">
                            <span>Go to Main Vault</span>
                            <span aria-hidden="true">→</span>
                        </a>
                    </div>
                </section>
            </div>
        </article>
    </main>
</BaseLayout>

<script is:inline>
  (function () {
    function setupVaultRelatedNotePreload() {
      var btn = document.querySelector(".vault-note-end-action--related");
      if (!btn) return;

      var rawHref = btn.getAttribute("href");
      if (!rawHref) return;

      // If it's already a direct note link, prefetch it directly
      if (!rawHref.includes("/api/vault-related-note")) {
        if (!document.querySelector('link[rel="prefetch"][href="' + rawHref + '"]')) {
          var link = document.createElement("link");
          link.rel = "prefetch";
          link.href = rawHref;
          document.head.appendChild(link);
        }
        return;
      }

      var fetchUrl = rawHref.includes("json=true")
        ? rawHref
        : rawHref + (rawHref.includes("?") ? "&json=true" : "?json=true");

      fetch(fetchUrl, { priority: "low" })
        .then(function (res) {
          return res.json();
        })
        .then(function (data) {
          if (data && data.href) {
            btn.setAttribute("href", data.href);
            var titleEl = btn.querySelector(".vault-note-end-action__title");
            if (titleEl && data.displayTitle) {
              titleEl.textContent = data.displayTitle;
            }
            if (!document.querySelector('link[rel="prefetch"][href="' + data.href + '"]')) {
              var link = document.createElement("link");
              link.rel = "prefetch";
              link.href = data.href;
              document.head.appendChild(link);
            }
          }
        })
        .catch(function () {});
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupVaultRelatedNotePreload);
    } else {
      setupVaultRelatedNotePreload();
    }
    document.addEventListener("astro:page-load", setupVaultRelatedNotePreload);
  })();
</script>

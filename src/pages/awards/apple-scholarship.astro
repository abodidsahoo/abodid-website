---
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageTitle = "Apple Scholarship";
---

<BaseLayout
  title={pageTitle}
  fullWidth={true}
  showGlobalGrid={false}
  navigationVariant="next"
  bodyClass="blog-post-pop-page"
>
  <main class="blog-post-page">
    <article class="blog-post-document" aria-labelledby="award-title">
      <div class="blog-post-inner">
        <header class="blog-post-header">
          <div class="blog-post-meta-bar">
            <span class="blog-post-tag">Higher Education</span>
            <span class="blog-post-date">Full Scholarship (£28,000)</span>
          </div>

          <h1 id="award-title" class="blog-post-title">{pageTitle}</h1>
          <p class="blog-post-excerpt">Royal College of Art, London — Full Tuition & Living Scholarship by Apple.</p>
        </header>

        <section class="blog-post-content" aria-label="Scholarship Details">
          <div class="prose">
            <h2>Journey Highlights</h2>
            <ul>
              <li>
                <strong>Freedom from Fear:</strong> The scholarship didn't just pay fees; it liberated me from financial anxiety, allowing me to fully immerse in the RCA experience.
              </li>
              <li>
                <strong>Living vs. Studying:</strong> Instead of budgeting every decision, I used the time to explore galleries, music gigs, and London itself.
              </li>
              <li>
                <strong>Deep Emotional Research:</strong> I poured my energy into conversations about healing, therapy, and identity, using visual tools and soundscapes as inquiry.
              </li>
            </ul>
          </div>

          <div class="blog-post-utility-row">
            <a href="/blog/how-apple-funded-my-dream-at-rca" class="blog-back-pill">
              <span>Read Full RCA Story</span>
              <span aria-hidden="true">→</span>
            </a>

            <a
              href="https://www.rca.ac.uk/study/apply-to-study/funding-your-studies/rca-scholarships-and-awards/"
              target="_blank"
              rel="noopener noreferrer"
              class="blog-back-pill"
              style="background: var(--pop-cream); shadow: 0 3px 0 var(--pop-ink);"
            >
              <span>View RCA Scholarships ↗</span>
            </a>
          </div>

          <nav class="blog-post-nav" aria-label="Navigation">
            <a href="/blog" class="blog-nav-link blog-nav-link--back">
              <span aria-hidden="true">←</span>
              <span>Back to Blog</span>
            </a>
          </nav>
        </section>
      </div>
    </article>
  </main>
</BaseLayout>

<style is:global>
  /* Shares exact same Pop Editorial styles as blog [...slug].astro */
</style>

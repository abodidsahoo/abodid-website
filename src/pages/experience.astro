---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getWorkExperience } from "../lib/services/content";
import photographyPortfolios from "../data/photographyPortfolios.generated.json";

export const prerender = false;

const allExperience = await getWorkExperience();
const workExperience = allExperience.filter((item) => !item.category || item.category === "work");
const education = allExperience.filter((item) => item.category === "education");
const recognition = allExperience.filter((item) => ["award", "conference"].includes(item.category || ""));

const photoBySlug = new Map(photographyPortfolios.stories.map((story) => [story.slug, story]));
const selectedContexts = [
  {
    slug: "outernet-london-2025",
    eyebrow: "Cultural venue · London",
    title: "Outernet London",
    role: "Trusted for last-minute documentation without a detailed brief at a cultural landmark visited by audiences from 100+ countries.",
  },
  {
    slug: "british-film-institute-london",
    eyebrow: "Film institution · London",
    title: "British Film Institute",
    role: "Recommended to RCA's brand team for human-centred photography; featured on its homepage and internal pages for a four-day programme welcoming 20,000+ visitors.",
  },
  {
    slug: "into-the-flux",
    eyebrow: "International Body of Art · London",
    title: "Into the Flux",
    role: "Commissioned for space design, lighting, technical troubleshooting, health and safety, installation and archival photography for 10,000+ visitors.",
  },
  {
    slug: "digital-direction-rca-gradshow-in-white-city",
    eyebrow: "Arts education · London",
    title: "Royal College of Art",
    role: "Graduate-show photography and exhibition production during a week attracting 100,000+ visitors.",
  },
].map((context) => {
  const story = photoBySlug.get(context.slug);
  return {
    ...context,
    href: story?.projectHref || `/photography/${context.slug}`,
    image: story?.coverImage,
  };
});

const title = "Experience — Abodid Sahoo";
const description = "Selected experience across cultural photography, exhibition production, creative technology, research and visual storytelling in London and India.";
---

<BaseLayout
  title={title}
  description={description}
  fullWidth={true}
  hideHeader={true}
  hideFooter={true}
  hideWhatsAppButton={true}
  showNewsletterPopup={false}
  showGlobalGrid={false}
  showCursorFollower={false}
  bodyClass="experience-next-page"
>
  <header class="story-nav">
    <a class="story-nav__brand" href="/" aria-label="Abodid Sahoo homepage">abodid.com</a>
    <nav class="story-nav__links" aria-label="Primary navigation">
      <a href="/#selected-work">Work</a>
      <a href="/research">Research</a>
      <a href="/services">Services</a>
      <a href="/experience" class="is-active">Experience</a>
      <a href="/about">About</a>
    </nav>
    <a class="story-nav__contact" href="/#enquiry">Hire me <span aria-hidden="true">↗</span></a>
    <details class="story-nav__mobile">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        <a href="/#selected-work">Work</a>
        <a href="/research">Research</a>
        <a href="/services">Services</a>
        <a href="/experience" class="is-active">Experience</a>
        <a href="/about">About</a>
        <a href="/#enquiry">Hire me ↗</a>
      </nav>
    </details>
  </header>

  <main class="experience-next">
    <section class="experience-next__hero" aria-labelledby="experience-next-heading">
      <div class="experience-next__hero-copy">
        <p class="experience-eyebrow">Experience · London and India</p>
        <h1 id="experience-next-heading">A cross-disciplinary practice built between culture, images, spaces and systems.</h1>
        <p>I work across photography, cultural documentation, exhibition production, research and creative technology—bringing together the people and practical details required to make ambitious work visible.</p>
        <div class="experience-actions">
          <a href="/#enquiry">Start a conversation <span aria-hidden="true">↗</span></a>
          <a href="/resume">View full resume / CV <span aria-hidden="true">↗</span></a>
          <a href="/research">View research practice <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="experience-next__hero-mosaic">
        {selectedContexts.slice(0, 3).map((context, index) => (
          <figure class={`experience-next__hero-photo experience-next__hero-photo--${index + 1}`}>
            <img src={context.image} alt={context.title} loading={index === 0 ? "eager" : "lazy"} />
            <figcaption>{context.title}</figcaption>
          </figure>
        ))}
        <div class="experience-next__hero-note">
          <span>London</span><b>↔</b><span>Bangalore</span><b>↔</b><span>Mumbai</span>
        </div>
      </div>
    </section>

    <section class="experience-next__position" aria-labelledby="position-heading">
      <div class="experience-next__position-header">
        <p class="experience-eyebrow">What I bring</p>
        <h2 id="position-heading">A photographer's eye, a researcher's curiosity and the production instinct to make things happen.</h2>
      </div>
      <div class="experience-next__position-track-wrapper">
        <div class="experience-next__position-grid" role="region" aria-label="Key capabilities and perspective">
          <article class="experience-next__position-card">
            <div class="experience-next__position-card-top">
              <span class="experience-next__card-index">01</span>
            </div>
            <div class="experience-next__position-card-body">
              <h3>Cultural sensitivity</h3>
              <p>Experience working around artists, institutions, graduate shows, cultural venues and public audiences.</p>
            </div>
          </article>
          <article class="experience-next__position-card">
            <div class="experience-next__position-card-top">
              <span class="experience-next__card-index">02</span>
            </div>
            <div class="experience-next__position-card-body">
              <h3>Visual documentation</h3>
              <p>Images that preserve the essence of a space while giving communications teams material they can use.</p>
            </div>
          </article>
          <article class="experience-next__position-card">
            <div class="experience-next__position-card-top">
              <span class="experience-next__card-index">03</span>
            </div>
            <div class="experience-next__position-card-body">
              <h3>Systems thinking</h3>
              <p>Research and knowledge structures that connect references, decisions and creative development over time.</p>
            </div>
          </article>
          <article class="experience-next__position-card">
            <div class="experience-next__position-card-top">
              <span class="experience-next__card-index">04</span>
            </div>
            <div class="experience-next__position-card-body">
              <h3>Cross-cultural networks</h3>
              <p>A working perspective, active relationships and creative ecosystem spanning communities in the UK and India.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="experience-next__contexts" aria-labelledby="contexts-heading">
      <header>
        <p class="experience-eyebrow">Selected professional contexts</p>
        <h2 id="contexts-heading">Work inside spaces where culture is being made.</h2>
      </header>
      <div class="experience-next__context-grid">
        {selectedContexts.map((context, index) => (
          <a class="experience-next__context" href={context.href}>
            <figure><img src={context.image} alt={context.title} loading="lazy" /></figure>
            <div>
              <span class="experience-eyebrow">{String(index + 1).padStart(2, "0")} · {context.eyebrow}</span>
              <h3>{context.title}</h3>
              <p>{context.role}</p>
              <strong>View the work ↗</strong>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="experience-next__timeline" aria-labelledby="timeline-heading">
      <header>
        <p class="experience-eyebrow">Professional timeline</p>
        <h2 id="timeline-heading">Roles, responsibilities and places of learning.</h2>
      </header>
      <div class="experience-next__timeline-list">
        {workExperience.map((item, index) => (
          <article>
            <span class="experience-next__timeline-index">{String(index + 1).padStart(2, "0")}</span>
            <div><p class="experience-eyebrow">{item.duration}</p><h3>{item.role}</h3></div>
            <div><strong>{item.company}</strong><p>{item.description}</p></div>
          </article>
        ))}
      </div>
    </section>

    {(education.length > 0 || recognition.length > 0) && (
      <section class="experience-next__learning" aria-labelledby="learning-heading">
        <header>
          <p class="experience-eyebrow">Education and recognition</p>
          <h2 id="learning-heading">The academic practice behind the commercial work.</h2>
        </header>
        <div class="experience-next__learning-grid">
          {[...education, ...recognition].map((item, index) => (
            <article>
              <span class="experience-eyebrow">{String(index + 1).padStart(2, "0")} · {item.duration}</span>
              <h3>{item.role}</h3>
              <strong>{item.company}</strong>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="experience-next__future" aria-labelledby="future-heading">
      <div>
        <p class="experience-eyebrow">What comes next</p>
        <h2 id="future-heading">A full-time creative technology role in London—with space to keep making cultural experiments.</h2>
        <p>I am especially interested in teams shaping how technology participates in media, culture and public imagination. I can contribute across research, visual direction, prototyping and the translation of complex ideas into experiences.</p>
        <div class="experience-actions">
          <a href="/research">Explore research and experiments <span aria-hidden="true">↗</span></a>
          <a href="/resume">View full resume / CV <span aria-hidden="true">↗</span></a>
          <a href="/#enquiry">Hire me <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <figure>
        <img src="https://photos.abodid.com/originals/exhibition-photos/rca-digital-direction-2024-gradshow-abodid-346.jpg" alt="A photographed installation from an RCA graduate exhibition" loading="lazy" />
      </figure>
    </section>
  </main>
</BaseLayout>

<style is:global>
  body.experience-next-page {
    --pop-blue: #2444ca;
    --pop-pink: #ff7eb5;
    --pop-yellow: #ffe44f;
    --pop-lime: #caff48;
    --pop-orange: #ff875c;
    --pop-purple: #5524c7;
    --pop-cyan: #62e6ff;
    --pop-cream: #fff8e8;
    --pop-ink: #15130f;
    --pop-border: rgba(21, 19, 15, 0.78);
    --story-ink: var(--pop-ink);
    --story-cream: var(--pop-cream);
    --story-gutter: clamp(1rem, 3vw, 3.5rem);

    --experience-ink: var(--pop-ink);
    --experience-cream: var(--pop-cream);
    --experience-lime: var(--pop-lime);
    --experience-pink: var(--pop-pink);
    --experience-yellow: var(--pop-yellow);
    --experience-blue: var(--pop-blue);
    --experience-purple: var(--pop-purple);
    --experience-cyan: var(--pop-cyan);
    --experience-orange: var(--pop-orange);
    --color-brand-red: var(--pop-purple);
    --link-hover-color: var(--pop-purple);
    --theme-color-primary: var(--pop-blue);
    --theme-color-accent: var(--pop-purple);

    /* Layout Tokens */
    --experience-gap: 8px;
    --experience-page-padding: 8px;
    --experience-panel-radius: 28px;
    --experience-card-radius: 22px;
    --experience-panel-padding: clamp(1.5rem, 4vw, 4rem);

    /* Typography Tokens - Desktop */
    --experience-hero-h1-family: var(--font-display, sans-serif);
    --experience-hero-h1-size: clamp(2.4rem, 4.4vw, 5.2rem);
    --experience-hero-h1-weight: 700;
    --experience-hero-h1-line-height: 0.92;
    --experience-hero-h1-spacing: -0.055em;
    --experience-hero-h1-max-width: 14ch;

    --experience-section-h2-family: var(--font-display, sans-serif);
    --experience-section-h2-size: clamp(2rem, 3.5vw, 4.2rem);
    --experience-section-h2-weight: 700;
    --experience-section-h2-line-height: 0.94;
    --experience-section-h2-spacing: -0.045em;

    --experience-card-h3-family: var(--font-display, sans-serif);
    --experience-card-h3-size: clamp(1.5rem, 2.2vw, 2.8rem);
    --experience-card-h3-weight: 700;
    --experience-card-h3-line-height: 0.98;
    --experience-card-h3-spacing: -0.04em;

    --experience-future-h2-family: var(--font-display, sans-serif);
    --experience-future-h2-size: clamp(2.5rem, 4.2vw, 5.2rem);
    --experience-future-h2-weight: 700;
    --experience-future-h2-line-height: 0.9;
    --experience-future-h2-spacing: -0.055em;

    --experience-font-body-family: var(--font-sans, sans-serif);
    --experience-font-body-size: clamp(0.92rem, 1.05vw, 1.15rem);
    --experience-font-body-weight: 450;
    --experience-font-body-line-height: 1.5;

    --experience-font-eyebrow-family: var(--font-ui, sans-serif);
    --experience-font-eyebrow-size: 0.72rem;
    --experience-font-eyebrow-weight: 700;
    --experience-font-eyebrow-line-height: 1.2;
    --experience-font-eyebrow-spacing: 0.06em;

    --experience-font-action-family: var(--font-ui, sans-serif);
    --experience-font-action-size: 0.82rem;
    --experience-font-action-weight: 700;
    --experience-font-action-line-height: 1;

    background: var(--pop-pink);
    color: var(--pop-ink);
  }

  /* Lock each panel to its intended contrast pair so global theme colours do
     not turn headings and supporting copy white on bright backgrounds. */
  body.experience-next-page .experience-next {
    color: var(--pop-ink);
  }

  body.experience-next-page .experience-next :is(h1, h2, h3, p, li, dt, dd, strong, span) {
    color: inherit;
  }

  body.experience-next-page .page-content-full { padding: 0; }

  /* Top Navigation */
  .story-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    min-height: 72px;
    padding: 0 var(--story-gutter);
    display: grid;
    grid-template-columns: minmax(140px, 1fr) auto minmax(220px, 1fr);
    align-items: center;
    gap: 1.5rem;
    border-bottom: 0;
    background: var(--pop-pink);
    color: var(--pop-ink);
  }

  .story-nav a,
  .story-nav summary {
    color: inherit;
    font: 700 .72rem/1 var(--font-mono, monospace);
    letter-spacing: .08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .story-nav__brand {
    width: fit-content;
    min-height: 42px;
    padding: 0 .9rem;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--pop-ink);
    border-radius: 14px;
    background: var(--pop-yellow);
    color: var(--pop-ink) !important;
  }

  .story-nav__links {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 2.5vw, 2.5rem);
  }

  .story-nav__links a {
    opacity: 1;
    transition: text-decoration-color 160ms ease;
  }

  .story-nav__links a.is-active,
  .story-nav__mobile nav a.is-active {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  .story-nav__links a:hover,
  .story-nav__links a:focus-visible {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  .story-nav__contact {
    justify-self: end;
    min-height: 44px;
    padding: 0 1rem;
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    border: 1px solid var(--pop-ink);
    border-radius: 14px;
    background: var(--pop-yellow);
    color: var(--pop-ink) !important;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .story-nav__contact:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 0 var(--pop-ink);
  }

  .story-nav__mobile {
    display: none;
  }

  .experience-next { padding: var(--experience-page-padding); background: var(--pop-pink); }
  .experience-next :is(h1, h2, h3, p) { margin-top: 0; }
  .experience-eyebrow {
    margin: 0;
    font-family: var(--experience-font-eyebrow-family);
    font-size: var(--experience-font-eyebrow-size);
    font-weight: var(--experience-font-eyebrow-weight);
    line-height: var(--experience-font-eyebrow-line-height);
    letter-spacing: var(--experience-font-eyebrow-spacing);
    text-transform: uppercase;
  }
  .experience-actions { display: flex; flex-wrap: wrap; gap: .55rem; }
  .experience-actions a {
    min-height: 54px;
    padding: 0 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid currentColor;
    border-radius: 14px;
    color: inherit;
    text-decoration: none;
    font-family: var(--experience-font-action-family);
    font-size: var(--experience-font-action-size);
    font-weight: var(--experience-font-action-weight);
    line-height: var(--experience-font-action-line-height);
  }
  .experience-actions a:first-child { background: var(--experience-cream); }

  .experience-next__hero { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(430px, .92fr); gap: var(--experience-gap); }
  .experience-next__hero-copy, .experience-next__hero-mosaic { min-height: calc(100svh - 88px); border: 1px solid rgba(21,19,15,.3); border-radius: var(--experience-panel-radius); overflow: hidden; }
  .experience-next__hero-copy { padding: var(--experience-panel-padding); display: flex; flex-direction: column; background: var(--experience-yellow); }
  .experience-next__hero-copy h1 {
    max-width: var(--experience-hero-h1-max-width);
    margin: auto 0 1.5rem;
    font-family: var(--experience-hero-h1-family);
    font-size: var(--experience-hero-h1-size);
    font-weight: var(--experience-hero-h1-weight);
    line-height: var(--experience-hero-h1-line-height);
    letter-spacing: var(--experience-hero-h1-spacing);
    overflow-wrap: break-word;
    word-break: normal;
    text-wrap: balance;
  }
  .experience-next__hero-copy > p:not(:first-child) {
    max-width: 64ch;
    margin-bottom: 1.5rem;
    font-family: var(--experience-font-body-family);
    font-size: clamp(1.05rem, 1.3vw, 1.3rem);
    line-height: 1.5;
  }
  .experience-next__hero-mosaic { position: relative; background: var(--experience-blue); }
  .experience-next__hero-photo { position: absolute; margin: 0; overflow: hidden; border: 1px solid var(--experience-ink); border-radius: 18px; background: var(--experience-cream); box-shadow: 0 14px 36px rgba(21,19,15,.27); }
  .experience-next__hero-photo img { width: 100%; height: 100%; display: block; object-fit: cover; }
  .experience-next__hero-photo figcaption { position: absolute; left: 10px; bottom: 10px; padding: .45rem .6rem; border-radius: 999px; background: rgba(21,19,15,.78); color: var(--experience-cream); font: 700 .65rem/1 var(--font-ui, sans-serif); }
  .experience-next__hero-photo--1 { inset: 5% 8% 45% 6%; transform: rotate(1.5deg); }
  .experience-next__hero-photo--2 { inset: 41% 38% 8% 4%; transform: rotate(-2deg); }
  .experience-next__hero-photo--3 { inset: 48% 4% 5% 51%; transform: rotate(2.5deg); }
  .experience-next__hero-note { position: absolute; z-index: 5; top: 28px; right: 28px; padding: .7rem .8rem; display: flex; gap: .55rem; border: 1px solid var(--experience-ink); border-radius: 999px; background: var(--experience-lime); font: 700 .65rem/1 var(--font-ui, sans-serif); }

  .experience-next__position { margin-top: var(--experience-gap); padding: var(--experience-panel-padding); border: 1px solid rgba(21,19,15,.3); border-radius: var(--experience-panel-radius); background: var(--experience-lime); }
  .experience-next__position-header { margin-bottom: clamp(2rem, 3.5vw, 3.5rem); }
  .experience-next__position-header h2 {
    max-width: 16ch;
    margin: 1.5rem 0 0;
    font-family: var(--experience-section-h2-family);
    font-size: var(--experience-section-h2-size);
    font-weight: var(--experience-section-h2-weight);
    line-height: var(--experience-section-h2-line-height);
    letter-spacing: var(--experience-section-h2-spacing);
    overflow-wrap: break-word;
  }
  
  .experience-next__position-track-wrapper { width: 100%; }
  .experience-next__position-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(14px, 1.6vw, 22px); align-items: stretch; }
  .experience-next__position-card { height: 100%; min-height: 0; padding: clamp(1.35rem, 1.7vw, 1.8rem); display: flex; flex-direction: column; justify-content: flex-start; gap: 1.25rem; border: 1px solid rgba(21,19,15,.28); border-radius: 20px; background: var(--experience-cream); box-shadow: 0 4px 18px rgba(21,19,15,.04); transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 220ms cubic-bezier(0.16, 1, 0.3, 1), border-color 220ms ease; }
  .experience-next__position-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(21,19,15,.1); border-color: rgba(21,19,15,.55); }
  .experience-next__position-card-top { display: flex; align-items: center; justify-content: space-between; }
  .experience-next__card-index { display: inline-flex; align-items: center; justify-content: center; padding: .35rem .65rem; border-radius: 999px; background: rgba(21,19,15,.06); border: 1px solid rgba(21,19,15,.12); font: 700 .75rem/1 var(--font-ui, sans-serif); letter-spacing: .04em; }
  .experience-next__position-card-body { display: flex; flex-direction: column; gap: 0.75rem; flex: 1; }
  .experience-next__position-card-body h3 { margin: 0; min-height: 2.3em; display: flex; align-items: flex-end; font: 700 clamp(1.25rem, 1.55vw, 1.65rem)/1.12 var(--font-display, sans-serif); letter-spacing: -.04em; }
  .experience-next__position-card-body p { margin: 0; font-size: clamp(.9rem, 1vw, 1rem); line-height: 1.5; color: rgba(21,19,15,.84); }

  @media (max-width: 1120px) {
    .experience-next__position-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .experience-next__position-card-body h3 { min-height: 0; }
  }

  .experience-next__contexts { margin-top: var(--experience-gap); padding: var(--experience-panel-padding); border: 1px solid rgba(255,248,232,.25); border-radius: var(--experience-panel-radius); background: var(--experience-purple); color: var(--experience-cream); }
  .experience-next__contexts > header, .experience-next__timeline > header, .experience-next__learning > header { display: grid; grid-template-columns: .5fr 1.5fr; gap: 2rem; margin-bottom: 3rem; }
  .experience-next__contexts > header h2, .experience-next__timeline > header h2, .experience-next__learning > header h2 {
    max-width: 12ch;
    font-family: var(--experience-section-h2-family);
    font-size: var(--experience-section-h2-size);
    font-weight: var(--experience-section-h2-weight);
    line-height: var(--experience-section-h2-line-height);
    letter-spacing: var(--experience-section-h2-spacing);
    overflow-wrap: break-word;
  }
  .experience-next__context-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--experience-gap); }
  .experience-next__context { min-height: 650px; display: grid; grid-template-rows: clamp(320px, 34vw, 480px) 1fr; overflow: hidden; border: 1px solid rgba(21,19,15,.3); border-radius: var(--experience-card-radius); background: var(--experience-cream); color: var(--experience-ink); text-decoration: none; }
  .experience-next__context figure { min-height: 0; margin: 0; overflow: hidden; }
  .experience-next__context img { width: 100%; height: 100%; display: block; object-fit: cover; transition: transform 400ms ease; }

const snapshots = {
  "text-led-portfolio": "/july-backup",
  "visual-work-grid": "/landing-grid-test",
  "storytelling-crossover": "/archive-storytelling-crossover",
};

const slug = Astro.params.slug || "";
const snapshotPath = snapshots[slug];

if (!snapshotPath) {
  return new Response("Homepage archive version not found", { status: 404 });
}

return Astro.rewrite(snapshotPath);
---

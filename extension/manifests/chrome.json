{
  "manifest_version": 3,
  "name": "NextUp by Abodid",
  "version": "2.0.0",
  "description": "Save opportunities to your private, deadline-aware Abodid collection.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "identity"],
  "host_permissions": ["https://abodid.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Save Opportunity" },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}

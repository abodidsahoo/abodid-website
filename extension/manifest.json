{
  "manifest_version": 3,
  "name": "Abodid Opportunity Capture",
  "version": "1.0.0",
  "description": "One-click opportunity capture into your private Abodid Opportunity Assistant.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://abodid.com/*",
    "http://localhost:4321/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save Opportunity",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}

{
  "trailingSlash": false,
  "proxy": {
    "entrypoint": "middleware.ts"
  },
  "redirects": [
    {
      "source": "/punctum",
      "destination": "/lab/punctum",
      "permanent": true
    },
    {
      "source": "/punctum/:path*",
      "destination": "/lab/punctum/:path*",
      "permanent": true
    },
    {
      "source": "/research/lab",
      "destination": "/lab",
      "permanent": true
    },
    {
      "source": "/research/punctum",
      "destination": "/lab/punctum",
      "permanent": true
    },
    {
      "source": "/research/punctum/:path*",
      "destination": "/lab/punctum/:path*",
      "permanent": true
    },
    {
      "source": "/research/gesture-image-preview",
      "destination": "/lab/image-flick",
      "permanent": true
    },
    {
      "source": "/research/gesture-image-preview/:path*",
      "destination": "/lab/image-flick",
      "permanent": true
    },
    {
      "source": "/research/polaroid-hub",
      "destination": "/lab/photo-board",
      "permanent": true
    },
    {
      "source": "/research/polaroid-hub/:path*",
      "destination": "/lab/photo-board",
      "permanent": true
    },
    {
      "source": "/research/obsidian-vault/tag/:path*",
      "destination": "/obsidian-vault/topic/:path*",
      "permanent": true
    },
    {
      "source": "/research/obsidian-vault",
      "destination": "/obsidian-vault",
      "permanent": true
    },
    {
      "source": "/research/obsidian-vault/:path*",
      "destination": "/obsidian-vault/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "photos.abodid.com"
        }
      ],
      "destination": "/photography-portfolio"
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "photos.abodid.com"
        }
      ],
      "destination": "/photography-portfolio/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "photos.abodid.com"
        }
      ],
      "destination": "/photography-portfolio/sitemap.xml"
    }
  ]
}
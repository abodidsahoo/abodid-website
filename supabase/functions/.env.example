OPENAI_API_KEY=sk-proj_replace_me
# Optional OpenAI-compatible provider. In auto mode, OpenRouter is preferred
# when both keys are present so the digest can use the lower-cost model tiers.
OPENROUTER_API_KEY=sk-or-v1-replace_me
READING_DIGEST_AI_PROVIDER=auto
READING_DIGEST_OPENROUTER_MODEL=openai/gpt-5.6-terra
READING_DIGEST_OPENROUTER_FALLBACK_MODEL=openai/gpt-5.6-sol
RESEND_API_KEY=re_replace_me
READING_DIGEST_CRON_SECRET=generate_a_long_random_value

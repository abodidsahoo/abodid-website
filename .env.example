# Browser-safe Supabase configuration.
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only. Never expose this value through a PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Server-only Cloudflare R2 configuration. Never prefix the credentials with PUBLIC_.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=photos
R2_PUBLIC_BASE_URL=https://photos.example.com
RESEND_API_KEY=re_your-resend-api-key-here
# Server-only credentials used by the Supabase daily-reading-digest Edge Function.
# Supply at least one AI key. In auto mode, OpenRouter is preferred so the
# digest can use Terra routinely and reserve Sol for a rescue round.
OPENAI_API_KEY=sk-proj_your-openai-api-key-here
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
READING_DIGEST_AI_PROVIDER=auto
READING_DIGEST_OPENROUTER_MODEL=openai/gpt-5.6-terra
READING_DIGEST_OPENROUTER_FALLBACK_MODEL=openai/gpt-5.6-sol
READING_DIGEST_CRON_SECRET=generate-a-long-random-value
CONTACT_FORM_TO_EMAIL=hello@example.com
CONTACT_NOTIFICATION_FROM_EMAIL=Website Contact <contact@example.com>
# Public production origin used for the admin analytics link in contact emails.
PUBLIC_SITE_URL=https://example.com
PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_CSE_ID=your-programmable-search-engine-id-here
OWNER_NOTIFICATION_EMAIL=you@example.com
OPENALEX_API_KEY=your-openalex-api-key-here
RESEARCH_WORKSPACE_CONTACT_EMAIL=you@example.com
GEMINI_API_KEY=your-gemini-api-key-here
OPENROUTER_RESEARCH_MODELS=openrouter/auto,openai/gpt-4o-mini,google/gemini-2.5-flash
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSIONS=1536
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash
PUNCTUM_IMAGE_PROVIDER=auto
PUNCTUM_GEMINI_MODELS=gemini-3-pro-image,gemini-3.1-flash-image,gemini-2.5-flash-image
PUNCTUM_OPENROUTER_IMAGE_MODELS=google/gemini-3-pro-image,google/gemini-3.1-flash-image,google/gemini-2.5-flash-image
PUNCTUM_IMAGE_RESOLUTION=2K
# Production budget per browser session. Local development defaults to 16.
PUNCTUM_GENERATION_MAX_PER_HOUR=6
PUNCTUM_GENERATION_DEV_MAX_PER_HOUR=16
OPENROUTER_NETWORK_MODELS=openrouter/auto,google/gemini-2.5-flash,openai/gpt-4.1-mini
OPENROUTER_NETWORK_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_NETWORK_BATCH_SIZE=64
OPENROUTER_NETWORK_BATCH_DELAY_MS=120
OPENROUTER_VAULT_CHAT_MODELS=google/gemini-2.5-flash,openai/gpt-4.1-mini,google/gemini-2.5-pro,openai/gpt-4o-mini,openai/gpt-4.1
VAULT_CHAT_ENABLE_QUERY_REWRITE=true
VAULT_CHAT_ALLOW_MODEL_KNOWLEDGE=true
GITHUB_OWNER=abodidsahoo
GITHUB_REPO=obsidian-vault
GITHUB_BRANCH=main
OBSIDIAN_VAULT_INDEX_PATHS=6 - Main Notes
OBSIDIAN_VAULT_EXCLUDE_PATHS=.git,.obsidian,node_modules,.trash,trash,7 - Assets,Attachments,attachments
OBSIDIAN_VAULT_PRIVATE_PATHS=
OBSIDIAN_VAULT_PATH=
